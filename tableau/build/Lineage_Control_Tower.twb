            <column caption='Table Heading' datatype='string' name='[Calculation_1902596015588322944]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Table Heading&#13;&#10;// Column title of the lineage table.&#13;&#10;CASE [Calculation_2977506763130055823]&#13;&#10;WHEN 1 THEN &quot;NODE&quot;&#13;&#10;WHEN 2 THEN &quot;LAYER&quot;&#13;&#10;WHEN 3 THEN &quot;PLATFORM&quot;&#13;&#10;WHEN 4 THEN &quot;STATUS&quot;&#13;&#10;WHEN 5 THEN &quot;HOPS&quot;&#13;&#10;WHEN 6 THEN &quot;LAST RUN OR CHECK&quot;&#13;&#10;WHEN 7 THEN &quot;RUNTIME&quot;&#13;&#10;WHEN 8 THEN &quot;TESTS&quot;&#13;&#10;WHEN 9 THEN &quot;OWNER&quot;&#13;&#10;END' />
            </column>
            <column caption='Table Heading Point' datatype='spatial' name='[Calculation_2046072740054445396]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Table Heading Point&#13;&#10;// Middle of a column title.&#13;&#10;IF NOT ISNULL([Calculation_2977506763130055823]) THEN MAKEPOINT(0, ((CASE [Calculation_2977506763130055823] WHEN 1 THEN 21.5 WHEN 2 THEN 214.5 WHEN 3 THEN 332.7 WHEN 4 THEN 419.1 WHEN 5 THEN 506.7 WHEN 6 THEN 586.0 WHEN 7 THEN 704.6 WHEN 8 THEN 794.9 WHEN 9 THEN 844.0 END) - 454.5) / 100) END' />
