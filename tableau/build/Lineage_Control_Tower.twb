        <calculation class='tableau' formula='// BR Who Row Point&#13;&#10;// The row (takes the click).&#13;&#10;MAKEPOINT(&#13;&#10;    (0.5 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 15 + 0 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((0) + (593) / 2) + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((593) / 2 - 0) + 0 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22))) - 296.5) / 100&#13;&#10;)' />
      </column>
