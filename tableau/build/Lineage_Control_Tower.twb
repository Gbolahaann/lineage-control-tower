          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Panel Node Id' datatype='string' name='[Calculation_1386184292960313328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Node Id&#13;&#10;// Node shown in the side panel: the clicked node, or the exposure itself until a node is clicked.&#13;&#10;IF [Parameters].[Parameter 4] = &quot;&quot; THEN [Parameters].[Parameter 3]&#13;&#10;ELSE [Parameters].[Parameter 4]&#13;&#10;END' />
            </column>
            <column caption='Is Panel Node Daily' datatype='boolean' name='[Calculation_2646987086833843320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Panel Node Daily&#13;&#10;// Filter for the Node Daily panel sheets (row-level compare on the fact&apos;s own key).&#13;&#10;[node_id] = [Calculation_1386184292960313328]' />
            </column>
            <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
            </column>
            <column caption='Bullet Good Point' datatype='spatial' name='[Calculation_2917886856601150780]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Good Point&#13;&#10;// Freshness bullet: on-time zone, 0 to warn.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN ((0) - 151) / 100 WHEN 1 THEN (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 2 THEN (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 ELSE ((0) - 151) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Bullet Warn Point' datatype='spatial' name='[Calculation_1544498994739950646]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Warn Point&#13;&#10;// Freshness bullet: warn zone.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 1 THEN (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 2 THEN (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 ELSE (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Bullet Error Point' datatype='spatial' name='[Calculation_2583197384628426240]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Error Point&#13;&#10;// Freshness bullet: error zone, up to 1.25 x the error threshold.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 1 THEN ((302) - 151) / 100 WHEN 2 THEN ((302) - 151) / 100 ELSE (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
            </column>
            <column caption='Bullet Lag Point' datatype='spatial' name='[Calculation_4634444041752179346]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Lag Point&#13;&#10;// Freshness bullet: the lag now, as a bar in the status colour.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0400 WHEN 1 THEN 0.0400 WHEN 2 THEN 0.0000 ELSE 0.0000 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN ((0) - 151) / 100 WHEN 1 THEN ((MIN(302, ZN([freshness_lag_min]) * (302 / (1.25 * [error_after_minutes])))) - 151) / 100 WHEN 2 THEN ((MIN(302, ZN([freshness_lag_min]) * (302 / (1.25 * [error_after_minutes])))) - 151) / 100 ELSE ((0) - 151) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Current Status Code' datatype='integer' name='[current_status_code]' role='dimension' type='ordinal' />
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Error After Minutes' datatype='real' name='[error_after_minutes]' role='measure' type='quantitative' />
            <column caption='Freshness Lag Min' datatype='real' name='[freshness_lag_min]' role='measure' type='quantitative' />
            <column caption='Node Id' datatype='string' name='[node_id]' role='dimension' type='nominal' />
            <column caption='Warn After Minutes' datatype='real' name='[warn_after_minutes]' role='measure' type='quantitative' />
