          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='BR Who Order' datatype='integer' name='[Calculation_1249143065364430041]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// BR Who Order&#13;&#10;// Most daily consumers first (per period).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|exposure.acme_core.partner_revenue_share&quot; THEN 1&#13;&#10;WHEN &quot;7|exposure.acme_core.merchandising_copilot&quot; THEN 2&#13;&#10;WHEN &quot;7|exposure.acme_core.executive_revenue_dashboard&quot; THEN 3&#13;&#10;WHEN &quot;7|exposure.acme_product.demand_forecast_app&quot; THEN 4&#13;&#10;WHEN &quot;7|exposure.acme_core.customer_360&quot; THEN 5&#13;&#10;WHEN &quot;7|exposure.acme_core.store_ops_hub&quot; THEN 6&#13;&#10;WHEN &quot;7|exposure.acme_marketing.marketing_campaign_performance&quot; THEN 7&#13;&#10;WHEN &quot;7|exposure.acme_core.supply_chain_ops&quot; THEN 8&#13;&#10;WHEN &quot;7|exposure.acme_product.support_sla_tracker&quot; THEN 9&#13;&#10;WHEN &quot;7|exposure.acme_core.finance_qa_agent&quot; THEN 10&#13;&#10;WHEN &quot;7|exposure.acme_product.product_engagement&quot; THEN 11&#13;&#10;WHEN &quot;7|exposure.acme_core.inventory_health&quot; THEN 12&#13;&#10;WHEN &quot;7|exposure.acme_marketing.sales_pipeline&quot; THEN 13&#13;&#10;WHEN &quot;7|exposure.acme_core.q3_sales_summary_ai&quot; THEN 14&#13;&#10;WHEN &quot;7|exposure.acme_core.finance_close_tracker&quot; THEN 15&#13;&#10;WHEN &quot;7|exposure.acme_core.lineage_control_tower&quot; THEN 16&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_dashboard_copy&quot; THEN 17&#13;&#10;WHEN &quot;7|exposure.acme_core.board_kpi_pack&quot; THEN 18&#13;&#10;WHEN &quot;7|exposure.acme_product.pricing_experiment_analysis&quot; THEN 19&#13;&#10;WHEN &quot;7|exposure.acme_core.daily_sales_snapshot&quot; THEN 20&#13;&#10;WHEN &quot;7|exposure.acme_product.churn_prediction_model&quot; THEN 21&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_pricing_agent&quot; THEN 22&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_regional_hub&quot; THEN 23&#13;&#10;WHEN &quot;7|exposure.o