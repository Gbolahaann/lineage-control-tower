    <worksheet name='HO MTTR KPI Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='MTTR - Trend' datatype='real' name='[Calculation_7021360273238040373]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Trend&#13;&#10;// Bars: mean recovery time of episodes that started each day. Days with no episodes stay empty.&#13;&#10;AVG(IF NOT [is_open] THEN [hours_to_recover] END)' />
            </column>
            <column caption='MTTR - Trend In Period' datatype='real' name='[Calculation_2182700666057493534]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_7021360273238040373] END' />
            </column>
            <column caption='MTTR - Trend Out Period' datatype='real' name='[Calculation_2828040696381880192]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_7021360273238040373] END' />
            </column>
            <column caption='Is Platform Match Day (Episodes)' datatype='boolean' name='[Calculation_3348788321593585024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Day (Episodes)&#13;&#10;// Same rule for Recovery Episodes: the platform the node was on when the failure started.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day (mart_recovery_episodes.csv)] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Date (Dates)' datatype='date' name='[date (dim_date.csv)]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Hours To Recover' datatype='real' name='[hours_to_recover]' role='measure' type='quantitative' />
            <column caption='Is Open' datatype='boolean' name='[is_open]' role='dimension' type='nominal' />
            <column caption='Platform On Day (Recovery Episodes)' datatype='string' name='[platform_on_day (mart_recovery_episodes.csv)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2182700666057493534]' derivation='User' name='[usr:Calculation_2182700666057493534:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2828040696381880192]' derivation='User' name='[usr:Calculation_2828040696381880192:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date (dim_date.csv)]' derivation='None' name='[none:date (dim_date.csv):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3348788321593585024]' derivation='None' name='[none:Calculation_3348788321593585024:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_3348788321593585024:nk]'>
            <groupfilter function='member' level='[none:Calculation_3348788321593585024:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
