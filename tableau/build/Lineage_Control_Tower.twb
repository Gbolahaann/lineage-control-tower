              <calculation class='tableau' formula='// GOV Hygiene Rect Key&#13;&#10;// Rectangle colour.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR(INT([day_index] / 4))&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;All|3&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;All|4&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;All|5&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;All|6&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;All|7&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|8&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;All|9&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|10&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;All|11&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;All|12&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;All|13&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;snowflake|3&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;snowflake|4&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;snowflake|5&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;snowflake|6&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;snowflake|7&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|8&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;snowflake|9&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|10&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;snowflake|11&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;databricks|2&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;databricks|3&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;databricks|4&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;databricks|5&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;databricks|6&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;databricks|7&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;redshift|1&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;redshift|2&quot; THEN &quot;Track&quot;&#13;&#10;WHEN &quot;redshift|3&quot; THEN &quot;Good&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Hygiene Rect Point' datatype='spatial' name='[Calculation_5956554567866245118]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Hygiene Rect Point&#13;&#10;// Rectangles of the scene, 4 date rows each (written by the build).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.8650, -1.9500)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.8650, 1.9500)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.8250, 1.9500)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(0.8250, -1.9500)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(0.8650, -1.9500)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(0.8650, 0.3250)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(0.8250, 0.3250)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(0.8250, -1.9500)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(0.5550, -1.9500)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(0.5550, 1.9500)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(0.5150, 1.9500)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(0.5150, -1.9500)&#13;&#10;WHEN &quot;All|12&quot; THEN MAKEPOINT(0.5550, -1.9500)&#13;&#10;WHEN &quot;All|13&quot; THEN MAKEPOINT(0.5550, 0.6500)&#13;&#10;WHEN &quot;All|14&quot; THEN MAKEPOINT(0.5150, 0.6500)&#13;&#10;WHEN &quot;All|15&quot; THEN MAKEPOINT(0.5150, -1.9500)&#13;&#10;WHEN &quot;All|16&quot; THEN MAKEPOINT(0.2450, -1.9500)&#13;&#10;WHEN &quot;All|17&quot; THEN MAKEPOINT(0.2450, 1.9500)&#13;&#10;WHEN &quot;All|18&quot; THEN MAKEPOINT(0.2050, 1.9500)&#13;&#10;WHEN &quot;All|19&quot; THEN MAKEPOINT(0.2050, -1.9500)&#13;&#10;WHEN &quot;All|20&quot; THEN MAKEPOINT(0.2450, -1.9500)&#13;&#10;WHEN &quot;All|21&quot; THEN MAKEPOINT(0.2450, 0.7312)&#13;&#10;WHEN &quot;All|22&quot; THEN MAKEPOINT(0.2050, 0.7312)&#13;&#10;WHEN &quot;All|23&quot; THEN MAKEPOINT(0.2050, -1.9500)&#13;&#10;WHEN &quot;All|24&quot; THEN MAKEPOINT(-0.0650, -1.9500)&#13;&#10;WHEN &quot;All|25&quot; THEN MAKEPOINT(-0.0650, 1.9500)&#13;&#10;WHEN &quot;All|26&quot; THEN MAKEPOINT(-0.1050, 1.9500)&#13;&#10;WHEN &quot;All|27&quot; T