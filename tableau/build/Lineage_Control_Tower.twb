              <calculation class='tableau' formula='// Late Chip Exposure&#13;&#10;// The data product a chip opens (p_selected_exposure).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;exposure.acme_core.executive_revenue_dashboard&quot;&#13;&#10;WHEN 2 THEN &quot;exposure.acme_core.board_kpi_pack&quot;&#13;&#10;WHEN 3 THEN &quot;exposure.acme_core.supply_chain_ops&quot;&#13;&#10;WHEN 4 THEN &quot;exposure.acme_core.inventory_health&quot;&#13;&#10;WHEN 5 THEN &quot;exposure.acme_product.demand_forecast_app&quot;&#13;&#10;WHEN 6 THEN &quot;exposure.acme_core.merchandising_copilot&quot;&#13;&#10;WHEN 7 THEN &quot;exposure.acme_core.store_ops_hub&quot;&#13;&#10;WHEN 8 THEN &quot;exposure.observed.undeclared_pricing_agent&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Chip Status' datatype='integer' name='[Calculation_1407047436052111403]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Late Chip Status&#13;&#10;// Its status code, for the Lineage panel (p_panel_status).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN 3&#13;&#10;WHEN 2 THEN 3&#13;&#10;WHEN 3 THEN 2&#13;&#10;WHEN 4 THEN 2&#13;&#10;WHEN 5 THEN 2&#13;&#10;WHEN 6 THEN 2&#13;&#10;WHEN 7 THEN 2&#13;&#10;WHEN 8 THEN 2&#13;&#10;END' />
            </column>
            <column caption='Late Chip Type' datatype='string' name='[Calculation_1504662037100545342]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Chip Type&#13;&#10;// Its type, for the Lineage panel (p_panel_type).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;exposure&quot;&#13;&#10;WHEN 2 THEN &quot;exposure&quot;&#13;&#10;WHEN 3 THEN &quot;exposure&quot;&#13;&#10;WHEN 4 THEN &quot;exposure&quot;&#13;&#10;WHEN 5 THEN &quot;exposure&quot;&#13;&#10;WHEN 6 THEN &quot;exposure&quot;&#13;&#10;WHEN 7 THEN &quot;exposure&quot;&#13;&#10;WHEN 8 THEN &quot;exposure&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Chip Platform' datatype='string' name='[Calculation_1833500224696775779]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Chip Platform&#13;&#10;// Its platform, for the Lineage panel (p_panel_platform).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;snowflake&quot;&#13;&#10;WHEN 2 THEN &quot;snowflake&quot;&#13;&#10;WHEN 3 THEN &quot;snowflake&quot;&#13;&#10;WHEN 4 THEN &quot;snowflake&quot;&#13;&#10;WHEN 5 THEN &quot;databricks&quot;&#13;&#10;WHEN 6 THEN &quot;snowflake&quot;&#13;&#10;WHEN 7 THEN &quot;snowflake&quot;&#13;&#10;WHEN 8 THEN &quot;snowflake&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Chip Tags' datatype='string' name='[Calculation_1812376704710986453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Chip Tags&#13;&#10;// Its tags, for the Lineage panel (p_panel_tags).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;|&quot;&#13;&#10;WHEN 2 THEN &quot;|&quot;&#13;&#10;WHEN 3 THEN &quot;|&quot;&#13;&#10;WHEN 4 THEN &quot;|&quot;&#13;&#10;WHEN 5 THEN &quot;|&quot;&#13;&#10;WHEN 6 THEN &quot;|ai|&quot;&#13;&#10;WHEN 7 THEN &quot;|ai|&quot;&#13;&#10;WHEN 8 THEN &quot;|ai|unregistered|&quot;&#13;&#10;END' />
            </column>
            <column caption='Clear Node Value' datatype='string' name='[Calculation_1962397006096080865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Clear Node Value&#13;&#10;// Empty string a parameter action can write into p_selected_node, to clear it (prototype: opening an exposure clears the node).&#13;&#10;&quot;&quot;' />
            </column>
            <column caption='Clear Node Key Value' datatype='integer' name='[Calculation_7177065549275409274]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Clear Node Key Value&#13;&#10;// Companion to Clear Node Value for p_selected_node_key. -1 matches no node.&#13;&#10;-1' />
            </column>
            <column caption='Late Chip Text' datatype='string' name='[Calculation_3245556163370616280]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Chip Text&#13;&#10;// The chip texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 3 THEN &quot;Executive Revenue Dashboard&quot;&#13;&#10;WHEN 4 THEN &quot;Board KPI Pack&quot;&#13;&#10;WHEN 5 THEN &quot;Supply Chain Ops&quot;&#13;&#10;WHEN 6 THEN &quot;Inventory Health&quot;&#13;&#10;WHEN 7 THEN &quot;Demand Forecast App&quot;&#13;&#10;WHEN 8 THEN &quot;Merchandising Copilot&quot;&#13;&#10;WHEN 9 THEN &quot;Store Ops Hub&quot;&#13;&#10;WHEN 10 THEN &quot;Unregistered: pricing agent&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Pill Text' datatype='string' name='[Calculation_1764489920114139474]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Pill Text&#13;&#10;// The pill texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;▲  Warning&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Text Point' datatype='spatial' name='[Calculation_2282167173564098285]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Text Point&#13;&#10;// Every text on the card, one scaffold row each (centred at half its measured width).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4800, -1.2168), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4800, -0.3056), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.2900, -0.5244), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1000, -0.8487), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1000, 0.2885), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.1000, -1.1171), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.1000, -0.2379), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.1000, 0.7299), NULL)&#13;&#10;WHEN 8 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.3000, -1.0312), NULL)&#13;&#10;WHEN 9 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.3000, -0.0973), NULL)&#13;&#10;WHEN 10 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.5000, -0.9321), NULL)&#13;&#10;END' />
            </column>
            <column caption='Late Name Text' datatype='string' name='[Calculation_1531619695946605715]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Name Text&#13;&#10;// The name texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 1 THEN &quot;raw_wms.inventory&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Reason Text' datatype='string' name='[Calculation_1687637932258375271]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Reason Text&#13;&#10;// The reason texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 2 THEN &quot;Loading late, 6.0 h behind (warn after 3.0 h)&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Empty Text' datatype='string' name='[Calculation_1133191930404812511]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Empty Text&#13;&#10;// The empty state.&#13;&#10;&quot;Every source is on time.&quot;' />
            </column>
            <column caption='Late Empty Point' datatype='spatial' name='[Calculation_2931406528209753795]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Empty Point&#13;&#10;// &quot;Every source is on time.&quot; when no late source is in the platform filter.&#13;&#10;IF [day_index] = 0 AND NOT (([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;)) THEN MAKEPOINT(0.4800, -0.9882) END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
