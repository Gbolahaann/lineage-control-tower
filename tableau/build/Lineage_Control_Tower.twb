          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is First Date Row' datatype='boolean' name='[Calculation_7201951502715406386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is First Date Row&#13;&#10;// One-row scaffold (the first day) for the Gantt day buttons and label. Put on Filters (True).&#13;&#10;[day_index] = 0' />
            </column>
            <column caption='BR Chip Unregistered Red' datatype='string' name='[Calculation_1726074987130000502]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// BR Chip Unregistered Red&#13;&#10;// Unregistered readers, red when there are any.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;7|source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|source.acme_core.raw_pos.store_sales&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|source.acme_core.raw_shopify.order_items&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;7|source.acme_core.raw_shopify.orders&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;7|source.acme_core.raw_shopify.products&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;7|source.acme_core.raw_wms.inventory&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|source.acme_core.raw_wms.warehouses&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|model.acme_marketing.stg_google_ads__ad_stats&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|model.acme_marketing.stg_google_ads__campaigns&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|model.acme_marketing.stg_meta_ads__ad_insights&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|model.acme_core.stg_pos__store_sales&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|model.acme_core.stg_shopify__order_discounts&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;7|model.acme_core.stg_shopify__order_items&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;7|model.acme_core.stg_shopify__orders&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;7|model.acme_core.stg_shopify__products&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;7|model.acme_core.stg_wms__inventory&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|model.acme_core.stg_wms__warehouses&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|model.acme_marketing.int_ads__unified&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|