      <column caption='Slack Channel (Blast Radius)' datatype='string' name='[slack_channel (mart_blast_radius.csv)]' role='dimension' type='nominal' />
      <column caption='Slack Channel' datatype='string' name='[slack_channel]' role='dimension' type='nominal' />
      <column caption='Start Date (Incidents)' datatype='date' name='[start_date (fct_incidents.csv)]' role='dimension' type='ordinal' />
      <column caption='Start Date' datatype='date' name='[start_date]' role='dimension' type='ordinal' />
      <column caption='Start Minute Of Day' datatype='integer' name='[start_minute_of_day]' role='dimension' type='quantitative' />
      <column caption='Started At' datatype='datetime' name='[started_at]' role='dimension' type='ordinal' />
      <column caption='Status' datatype='string' name='[status]' role='dimension' type='nominal' />
      <column caption='Status Eod' datatype='string' name='[status_eod]' role='dimension' type='nominal' />
      <column caption='Status Eod Code' datatype='integer' name='[status_eod_code]' role='dimension' type='ordinal' />
      <column caption='Status Reason' datatype='string' name='[status_reason]' role='dimension' type='nominal' />
      <column caption='Status Worst Code' datatype='integer' name='[status_worst_code]' role='dimension' type='ordinal' />
      <column caption='Tags' datatype='string' hidden='true' name='[tags]' role='dimension' type='nominal' />
      <column caption='Test Count' datatype='integer' name='[test_count]' role='measure' type='quantitative' />
      <column caption='Test Id' datatype='string' name='[test_id]' role='dimension' type='nominal' />
      <column caption='Test Name' datatype='string' name='[test_name]' role='dimension' type='nominal' />
      <column caption='Test Type' datatype='string' name='[test_type]' role='dimension' type='nominal' />
      <column caption='Tests Fail' datatype='real' name='[tests_fail]' role='measure' type='quantitative' />
      <column caption='Tests Failed' datatype='integer' name='[tests_failed]' role='measure' type='quantitative' />
      <column caption='Tests Failing' datatype='real' name='[tests_failing]' role='measure' type='quantitative' />
      <column caption='Tests Pass' datatype='real' name='[tests_pass]' role='measure' type='quantitative' />
      <column caption='Tests Passing' datatype='real' name='[tests_passing]' role='measure' type='quantitative' />
      <column caption='Tests Warn' datatype='real' name='[tests_warn]' role='measure' type='quantitative' />
      <column caption='Tests Warning' datatype='real' name='[tests_warning]' role='measure' type='quantitative' />
      <column caption='Title' datatype='string' name='[title]' role='dimension' type='nominal' />
      <column caption='Triggered By' datatype='string' name='[triggered_by]' role='dimension' type='nominal' />
      <column caption='Trust Badge' datatype='string' name='[trust_badge]' role='dimension' type='nominal' />
      <column aggregation='Avg' datatype='real' name='[trust_lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
      <column aggregation='Avg' datatype='real' name='[trust_lon]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
      <column caption='Unique Consumers' datatype='integer' name='[unique_consumers]' role='measure' type='quantitative' />
      <column caption='Upstream Node Count' datatype='real' name='[upstream_node_count]' role='measure' type='quantitative' />
      <column caption='Warn After Minutes' datatype='real' name='[warn_after_minutes]' role='measure' type='quantitative' />
      <column caption='Warns' datatype='integer' name='[warns]' role='measure' type='quantitative' />
      <column caption='Week Start' datatype='date' name='[week_start]' role='dimension' type='ordinal' />
      <column caption='Weekday' datatype='string' name='[weekday]' role='dimension' type='nominal' />
      <column caption='Worst Test Code' datatype='integer' name='[worst_test_code]' role='dimension' type='ordinal' />
      <column caption='X' datatype='real' name='[x]' role='measure' type='quantitative' />
      <column caption='X Label' datatype='real' hidden='true' name='[x_label]' role='measure' type='quantitative' />
      <column caption='Y' datatype='real' name='[y]' role='measure' type='quantitative' />
      <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
      <column caption='Period Option' datatype='integer' name='[Calculation_1395152531449864650]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Period Option&#13;&#10;// Scaffold: turns the first 3 days of dim_date into the 3 period buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN 7&#13;&#10;WHEN 1 THEN 30&#13;&#10;WHEN 2 THEN 90&#13;&#10;END' />
      </column>
      <column caption='Is Period Button Row' datatype='boolean' name='[Calculation_1896708728705539988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Period Button Row&#13;&#10;// Keeps the 3 scaffold rows that carry a period button. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1395152531449864650])' />
      </column>
      <column caption='Is Active Period Option' datatype='boolean' name='[Calculation_1290101426377148290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Period Option&#13;&#10;// Colours the selected period button (Navy fill, white text) against the rest.&#13;&#10;[Calculation_1395152531449864650] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Period Option Label' datatype='string' name='[Calculation_3141427238531064247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;&quot;Last &quot; + STR([Calculation_1395152531449864650]) + &quot; days&quot;' />
      </column>
      <column caption='Period Label Active' datatype='string' name='[Calculation_2018629980644388562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Label Active&#13;&#10;// Button text when this button is the selected period (Semibold Navy run).&#13;&#10;IF [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
      </column>
      <column caption='Period Label Inactive' datatype='string' name='[Calculation_3943248154185459554]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Label Inactive&#13;&#10;// Button text when this button is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Option Order' datatype='integer' name='[Calculation_1997623788981524034]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Platform Option Order&#13;&#10;// Keeps the platform buttons in prototype order (All, Snowflake, Databricks, Redshift) instead of A to Z.&#13;&#10;[day_index]' />
      </column>
      <column caption='Platform Option' datatype='string' name='[Calculation_1708304674625620149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Option&#13;&#10;// Scaffold: turns the first 4 days of dim_date into the 4 platform buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;snowflake&quot;&#13;&#10;WHEN 2 THEN &quot;databricks&quot;&#13;&#10;WHEN 3 THEN &quot;redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Platform Button Row' datatype='boolean' name='[Calculation_1766699502863314635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Button Row&#13;&#10;// Keeps the 4 scaffold rows that carry a platform button. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1708304674625620149])' />
      </column>
      <column caption='Is Active Platform Option' datatype='boolean' name='[Calculation_1733161848805935888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Platform Option&#13;&#10;// Colours the selected platform button.&#13;&#10;[Calculation_1708304674625620149] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Platform Dot Snowflake' datatype='string' name='[Calculation_1113706873550636432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Snowflake&#13;&#10;// Coloured square before &quot;Snowflake&quot; on its button. Each platform has its own field so each gets its own run colour.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;snowflake&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Dot Databricks' datatype='string' name='[Calculation_2812498324364876413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Databricks&#13;&#10;// Coloured square before &quot;Databricks&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;databricks&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Dot Redshift' datatype='string' name='[Calculation_2114073437937435113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Redshift&#13;&#10;// Coloured square before &quot;Redshift&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;redshift&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Option Label' datatype='string' name='[Calculation_1669066058101174507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;CASE [Calculation_1708304674625620149]&#13;&#10;WHEN &quot;All&quot;        THEN &quot;All&quot;&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Platform Label Active' datatype='string' name='[Calculation_1615833699327644939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Label Active&#13;&#10;// Button text when this button is the selected platform (Semibold Navy run).&#13;&#10;IF [Calculation_1733161848805935888] THEN [Calculation_1669066058101174507] ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Label Inactive' datatype='string' name='[Calculation_3045694386135075059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Label Inactive&#13;&#10;// Button text when this button is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1733161848805935888] THEN [Calculation_1669066058101174507] ELSE &quot;&quot; END' />
      </column>
      <column caption='Has Prior Period' datatype='boolean' name='[Calculation_1497969784006078758]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Has Prior Period&#13;&#10;// FALSE at 90 days, when there is no earlier window in the data.&#13;&#10;// Drives the &quot;no earlier period&quot; wording. Measures don&apos;t need it: their Prior is NULL anyway.&#13;&#10;2 * [Parameters].[Parameter 1] &lt;= { MAX([day_index]) } + 1' />
      </column>
      <column caption='Period Hint Label' datatype='string' name='[Calculation_2651474984799504069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Hint Label&#13;&#10;// Hint text at the right of the filter band, as in the prototype.&#13;&#10;IF [Calculation_1497969784006078758]&#13;&#10;    THEN &quot;Changes compare with the &quot; + STR([Parameters].[Parameter 1]) + &quot; days before&quot;&#13;&#10;ELSE &quot;No earlier period in the data to compare with&quot;&#13;&#10;END' />
      </column>
      <column caption='Data Updated Date Text' datatype='string' name='[Calculation_2445757024107576062]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Data Updated Date Text&#13;&#10;// The date part of the header stamp, shown bold after &quot;Data updated on &quot;.&#13;&#10;STR(DAY({ MAX([date (dim_date.csv)]) })) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, { MAX([date (dim_date.csv)]) }), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR({ MAX([date (dim_date.csv)]) }))&#13;&#10;+ &quot;, 23:59&quot;' />
      </column>
      <column caption='History Label' datatype='string' name='[Calculation_2111610048197173466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// History Label&#13;&#10;// Second line of the header stamp: &quot;90 days of history from 22 Jul 2026&quot;.&#13;&#10;STR({ COUNTD([date (dim_date.csv)]) }) + &quot; days of history from &quot;&#13;&#10;+ STR(DAY({ MIN([date (dim_date.csv)]) })) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, { MIN([date (dim_date.csv)]) }), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR({ MIN([date (dim_date.csv)]) }))' />
      </column>
      <column caption='Is Info Button Row' datatype='boolean' name='[Calculation_6860269217128732528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Info Button Row&#13;&#10;// One scaffold row for the single-mark info button. Put on Filters (True).&#13;&#10;[day_index] = 0' />
      </column>
      <column caption='Info Button Glyph' datatype='string' name='[Calculation_1055782736416529768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Info Button Glyph&#13;&#10;// The header icon: &quot;ⓘ&quot; opens the info panel, &quot;✕&quot; closes it.&#13;&#10;IF [Parameters].[Parameter 7] THEN &quot;✕&quot; ELSE &quot;ⓘ&quot; END' />
      </column>
      <column caption='Info Toggle Value' datatype='boolean' name='[Calculation_1949193342976572784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Info Toggle Value&#13;&#10;// The value the info button writes into p_show_info: the opposite of the current state.&#13;&#10;NOT [Parameters].[Parameter 7]' />
      </column>
      <column caption='Is Platform Match Day' datatype='boolean' name='[Calculation_1100032193373739257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Day&#13;&#10;// Day-level platform filter for Node Daily. Migrated models count against Redshift before&#13;&#10;// their move and Snowflake after, so daily KPIs and cost split correctly by platform.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
      </column>
      <column caption='Run Success - Focus' datatype='real' name='[Calculation_1734332201503898389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Focus&#13;&#10;// Successful model runs / all model runs in the window. The mart&apos;s runs column already excludes skipped runs.&#13;&#10;// 30d check: 99.85%.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [runs] - [runs_failed] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [runs] END)' />
      </column>
      <column caption='In Prior Period' datatype='boolean' name='[Calculation_1036360725637968047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// In Prior Period&#13;&#10;// TRUE for the same-length window just before the selected one.&#13;&#10;// Matches no rows at 90 days (the data starts 22 Jul), so every &quot;- Prior&quot; measure returns NULL there.&#13;&#10;[days_before_as_of] &gt;= [Parameters].[Parameter 1]&#13;&#10;AND [days_before_as_of] &lt; 2 * [Parameters].[Parameter 1]' />
      </column>
      <column caption='Run Success - Prior' datatype='real' name='[Calculation_2698166877041094131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Prior&#13;&#10;// Same rate for the window before. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [runs] - [runs_failed] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [runs] END)' />
      </column>
      <column caption='Run Success - Change' datatype='real' name='[Calculation_3389207884386059757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Change&#13;&#10;// Rate metric, so the change is in percentage points. 30d check: +0.10 pp.&#13;&#10;([Calculation_1734332201503898389] - [Calculation_2698166877041094131]) * 100' />
      </column>
      <column caption='Run Success - Change Good' datatype='real' name='[Calculation_2508963726874360695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Change Good&#13;&#10;// Green part of the change line. Higher is better, so a rise (or no change) lands here.&#13;&#10;// Format: ▲ 0.00 pp;▼ 0.00 pp;● 0 pp&#13;&#10;IF [Calculation_3389207884386059757] &gt;= 0 THEN [Calculation_3389207884386059757] END' />
      </column>
      <column caption='Run Success - Change Good Text' datatype='string' name='[Calculation_9292920473058013561]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Run Success - Change Good Text&#13;&#10;// Green part of the change line as text: &quot;▲ 0.10 pp&quot;, or &quot;● 0 pp&quot; when nothing changed.&#13;&#10;// Blank when the change is bad or there is no earlier period. Two decimals, as on the BAN.&#13;&#10;IF ISNULL([Calculation_2508963726874360695]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_2508963726874360695] = 0 THEN &quot;● 0 pp&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_2508963726874360695] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_2508963726874360695] * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Run Success - Change Bad' datatype='real' name='[Calculation_6587374685601982419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Change Bad&#13;&#10;// Red part of the change line: a fall in run success. Same number format as Change Good.&#13;&#10;IF [Calculation_3389207884386059757] &lt; 0 THEN [Calculation_3389207884386059757] END' />
      </column>
      <column caption='Run Success - Change Bad Text' datatype='string' name='[Calculation_1409042108075507256]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Run Success - Change Bad Text&#13;&#10;// Red part of the change line as text: &quot;▼ 0.03 pp&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_6587374685601982419]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_6587374685601982419]) * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND(ABS([Calculation_6587374685601982419]) * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Compare Label' datatype='string' name='[Calculation_1953312242491521622]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Compare Label&#13;&#10;// Grey tail of every KPI change line: &quot;vs prior 30d&quot;, or &quot;-  no earlier period&quot; at 90 days.&#13;&#10;IF [Calculation_1497969784006078758]&#13;&#10;    THEN &quot;vs prior &quot; + STR([Parameters].[Parameter 1]) + &quot;d&quot;&#13;&#10;ELSE &quot;-  no earlier period&quot;&#13;&#10;END' />
      </column>
      <column caption='Run Success - Trend' datatype='real' name='[Calculation_7172698235724822835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Trend&#13;&#10;// Bars under the card: failed model runs per day (the prototype never plots a rate on a cut baseline).&#13;&#10;SUM([runs_failed])' />
      </column>
      <column caption='Run Success - Trend In Period' datatype='real' name='[Calculation_1059166526216479784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_7172698235724822835] END' />
      </column>
      <column caption='Run Success - Trend Out Period' datatype='real' name='[Calculation_2561166764669332405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_7172698235724822835] END' />
      </column>
      <column caption='Test Pass - Focus' datatype='real' name='[Calculation_1484671631694661168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Focus&#13;&#10;// Passing tests / all tests run in the window. Warnings count as not passing. 30d check: 99.41%.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [tests_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [tests_pass] + [tests_warn] + [tests_fail] END)' />
      </column>
      <column caption='Test Pass - Prior' datatype='real' name='[Calculation_2137113554368486090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Prior&#13;&#10;// Same rate for the window before. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [tests_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [tests_pass] + [tests_warn] + [tests_fail] END)' />
      </column>
      <column caption='Test Pass - Change' datatype='real' name='[Calculation_2084733784715193085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Change&#13;&#10;// Rate metric, percentage points.&#13;&#10;([Calculation_1484671631694661168] - [Calculation_2137113554368486090]) * 100' />
      </column>
      <column caption='Test Pass - Change Good' datatype='real' name='[Calculation_5917572901775054444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Change Good&#13;&#10;// Higher is better. Format: ▲ 0.00 pp;▼ 0.00 pp;● 0 pp&#13;&#10;IF [Calculation_2084733784715193085] &gt;= 0 THEN [Calculation_2084733784715193085] END' />
      </column>
      <column caption='Test Pass - Change Good Text' datatype='string' name='[Calculation_1950607229902710421]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Test Pass - Change Good Text&#13;&#10;// Green part of the change line as text: &quot;▲ 0.10 pp&quot;, or &quot;● 0 pp&quot; when nothing changed.&#13;&#10;// Blank when the change is bad or there is no earlier period. Two decimals, as on the BAN.&#13;&#10;IF ISNULL([Calculation_5917572901775054444]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_5917572901775054444] = 0 THEN &quot;● 0 pp&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_5917572901775054444] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_5917572901775054444] * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Test Pass - Change Bad' datatype='real' name='[Calculation_3363780124593530695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Change Bad&#13;&#10;// A fall in the pass rate. Same number format.&#13;&#10;IF [Calculation_2084733784715193085] &lt; 0 THEN [Calculation_2084733784715193085] END' />
      </column>
      <column caption='Test Pass - Change Bad Text' datatype='string' name='[Calculation_1148189262971748201]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Test Pass - Change Bad Text&#13;&#10;// Red part of the change line as text: &quot;▼ 0.03 pp&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_3363780124593530695]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_3363780124593530695]) * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND(ABS([Calculation_3363780124593530695]) * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Test Pass - Trend' datatype='real' name='[Calculation_2879388710444902546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Trend&#13;&#10;// Bars: failing or warning test executions per day. The Monday spikes are story 2.&#13;&#10;SUM([tests_warn] + [tests_fail])' />
      </column>
      <column caption='Test Pass - Trend In Period' datatype='real' name='[Calculation_5039955109046369523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_2879388710444902546] END' />
      </column>
      <column caption='Test Pass - Trend Out Period' datatype='real' name='[Calculation_4452841432140642752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_2879388710444902546] END' />
      </column>
      <column caption='Freshness SLA - Focus' datatype='real' name='[Calculation_1872933243208732540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Focus&#13;&#10;// Hourly source freshness checks that passed / all checks in the window. 30d check: 99.87%.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [fresh_checks_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [fresh_checks_pass] + [fresh_checks_warn] + [fresh_checks_error] END)' />
      </column>
      <column caption='Freshness SLA - Prior' datatype='real' name='[Calculation_3014479629346497840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Prior&#13;&#10;// Same rate for the window before. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [fresh_checks_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [fresh_checks_pass] + [fresh_checks_warn] + [fresh_checks_error] END)' />
      </column>
      <column caption='Freshness SLA - Change' datatype='real' name='[Calculation_1466251191431629742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Change&#13;&#10;// Rate metric, percentage points.&#13;&#10;([Calculation_1872933243208732540] - [Calculation_3014479629346497840]) * 100' />
      </column>
      <column caption='Freshness SLA - Change Good' datatype='real' name='[Calculation_1299950345497314843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Change Good&#13;&#10;// Higher is better. Format: ▲ 0.00 pp;▼ 0.00 pp;● 0 pp&#13;&#10;IF [Calculation_1466251191431629742] &gt;= 0 THEN [Calculation_1466251191431629742] END' />
      </column>
      <column caption='Freshness SLA - Change Good Text' datatype='string' name='[Calculation_3150169085595565380]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Freshness SLA - Change Good Text&#13;&#10;// Green part of the change line as text: &quot;▲ 0.10 pp&quot;, or &quot;● 0 pp&quot; when nothing changed.&#13;&#10;// Blank when the change is bad or there is no earlier period. Two decimals, as on the BAN.&#13;&#10;IF ISNULL([Calculation_1299950345497314843]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_1299950345497314843] = 0 THEN &quot;● 0 pp&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_1299950345497314843] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_1299950345497314843] * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Freshness SLA - Change Bad' datatype='real' name='[Calculation_9932674774647368440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Change Bad&#13;&#10;// A fall in freshness compliance. Same number format.&#13;&#10;IF [Calculation_1466251191431629742] &lt; 0 THEN [Calculation_1466251191431629742] END' />
      </column>
      <column caption='Freshness SLA - Change Bad Text' datatype='string' name='[Calculation_1352644649828212213]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Freshness SLA - Change Bad Text&#13;&#10;// Red part of the change line as text: &quot;▼ 0.03 pp&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_9932674774647368440]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_9932674774647368440]) * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND(ABS([Calculation_9932674774647368440]) * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Freshness SLA - Trend' datatype='real' name='[Calculation_2466217536611413858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Trend&#13;&#10;// Bars: late source checks (warn or error) per day. The 1 Oct spike is the Stripe outage (story 5).&#13;&#10;SUM([fresh_checks_warn] + [fresh_checks_error])' />
      </column>
      <column caption='Freshness SLA - Trend In Period' datatype='real' name='[Calculation_1084932894337796393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_2466217536611413858] END' />
      </column>
      <column caption='Freshness SLA - Trend Out Period' datatype='real' name='[Calculation_2103565215221969907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_2466217536611413858] END' />
      </column>
      <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
      </column>
      <column caption='Is At Risk Now' datatype='boolean' name='[Calculation_2875175252813195699]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is At Risk Now&#13;&#10;// Warning or Critical in the current snapshot. Shared by Health, Blast radius and Governance.&#13;&#10;[current_status_code] &gt;= 2' />
      </column>
      <column caption='Exposures At Risk Now' datatype='integer' name='[Calculation_2866140559093986658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk Now&#13;&#10;// Exposures whose upstream chain is Warning or Critical in the current snapshot. Check: 12.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [Calculation_2875175252813195699] THEN 1 END))' />
      </column>
      <column caption='Exposures In Scope' datatype='integer' name='[Calculation_3186893425654714520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures In Scope&#13;&#10;// All exposures for the selected platform, including unregistered ones. Check: 27.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; THEN 1 END))' />
      </column>
      <column caption='Exposures At Risk Of Label' datatype='string' name='[Calculation_2683875477335081578]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Exposures At Risk Of Label&#13;&#10;// Small grey suffix after the BAN: &quot;of 27 now&quot;.&#13;&#10;&quot;of &quot; + STR([Calculation_3186893425654714520]) + &quot; now&quot;' />
      </column>
      <column caption='Exposures Critical Now' datatype='integer' name='[Calculation_1964810160360354757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures Critical Now&#13;&#10;// Change-line lead, in red: &quot;4 critical&quot;. Format: 0 &quot;critical&quot;&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [current_status_code] = 3 THEN 1 END))' />
      </column>
      <column caption='Exposures Warning Now' datatype='integer' name='[Calculation_8920847743012969069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures Warning Now&#13;&#10;// Change-line tail, in grey: &quot;· 8 warning&quot;. Format: &quot;· &quot;0&quot; warning&quot;&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [current_status_code] = 2 THEN 1 END))' />
      </column>
      <column caption='Exposures At Risk - Trend' datatype='integer' name='[Calculation_3996116585410579374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk - Trend&#13;&#10;// Exposures Warning or Critical at the end of each day. One row per exposure per day, so this counts exposures.&#13;&#10;SUM(IF [status_eod_code] &gt;= 2 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Exposures At Risk - Trend In Period' datatype='real' name='[Calculation_2107588681978104977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_3996116585410579374] END' />
      </column>
      <column caption='Exposures At Risk - Trend Out Period' datatype='real' name='[Calculation_3360750808181857461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_3996116585410579374] END' />
      </column>
      <column caption='Is Platform Match Day (Episodes)' datatype='boolean' name='[Calculation_3348788321593585024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Day (Episodes)&#13;&#10;// Same rule for Recovery Episodes: the platform the node was on when the failure started.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day (mart_recovery_episodes.csv)] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='MTTR - Focus' datatype='real' name='[Calculation_1490761445074029792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Focus&#13;&#10;// Mean hours from a node&apos;s first failure to its next success, for episodes that started in the window and have recovered.&#13;&#10;// Covers model runs, source freshness and BI refreshes. 30d check: 4.87 h.&#13;&#10;AVG(IF [Calculation_1409194560049525583] AND NOT [is_open] THEN [hours_to_recover] END)' />
      </column>
      <column caption='MTTR - Focus Label' datatype='string' name='[Calculation_6570730252120364370]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// MTTR - Focus Label&#13;&#10;// BAN text, matching the prototype: minutes under an hour, otherwise hours to 1 decimal. &quot;-&quot; when nothing recovered.&#13;&#10;IF ISNULL([Calculation_1490761445074029792]) THEN &quot;-&quot;&#13;&#10;ELSEIF [Calculation_1490761445074029792] &lt; 1&#13;&#10;    THEN STR(ROUND([Calculation_1490761445074029792] * 60)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([Calculation_1490761445074029792], 1)) + &quot; h&quot;&#13;&#10;END' />
      </column>
      <column caption='MTTR - Prior' datatype='real' name='[Calculation_8777189573491179478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Prior&#13;&#10;// Same average for episodes that started in the window before. NULL at 90 days.&#13;&#10;AVG(IF [Calculation_1036360725637968047] AND NOT [is_open] THEN [hours_to_recover] END)' />
      </column>
      <column caption='MTTR - Change' datatype='real' name='[Calculation_9964583792416952326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Change&#13;&#10;// Percentage change. Inverse metric: a rise is bad.&#13;&#10;IF [Calculation_8777189573491179478] = 0 OR ISNULL([Calculation_8777189573491179478]) THEN NULL&#13;&#10;ELSE [Calculation_1490761445074029792] / [Calculation_8777189573491179478] - 1&#13;&#10;END' />
      </column>
      <column caption='MTTR - Change Good' datatype='real' name='[Calculation_2649301209160798169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Change Good&#13;&#10;// Inverse metric, so a fall (or no change) is good and shows in green. Format: ▲ 0.0%;▼ 0.0%;● 0%&#13;&#10;IF [Calculation_9964583792416952326] &lt;= 0 THEN [Calculation_9964583792416952326] END' />
      </column>
      <column caption='MTTR - Change Good Text' datatype='string' name='[Calculation_8864060235112699764]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// MTTR - Change Good Text&#13;&#10;// Inverse metric: a fall is good. Green text &quot;▼ 10.8%&quot;, or &quot;● 0%&quot; when nothing changed.&#13;&#10;IF ISNULL([Calculation_2649301209160798169]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_2649301209160798169] = 0 THEN &quot;● 0%&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_2649301209160798169]) * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_2649301209160798169]) * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='MTTR - Change Bad' datatype='real' name='[Calculation_1820979831573442882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Change Bad&#13;&#10;// A rise in recovery time, in red. Same number format.&#13;&#10;IF [Calculation_9964583792416952326] &gt; 0 THEN [Calculation_9964583792416952326] END' />
      </column>
      <column caption='MTTR - Change Bad Text' datatype='string' name='[Calculation_2992056182811374933]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// MTTR - Change Bad Text&#13;&#10;// Inverse metric: a rise is bad. Red text &quot;▲ 4.2%&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_1820979831573442882]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_1820979831573442882] * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([Calculation_1820979831573442882] * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='MTTR - Trend' datatype='real' name='[Calculation_7021360273238040373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Trend&#13;&#10;// Bars: mean recovery time of episodes that started each day. Days with no episodes stay empty.&#13;&#10;AVG(IF NOT [is_open] THEN [hours_to_recover] END)' />
      </column>
      <column caption='MTTR - Trend In Period' datatype='real' name='[Calculation_2182700666057493534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_7021360273238040373] END' />
      </column>
      <column caption='MTTR - Trend Out Period' datatype='real' name='[Calculation_2828040696381880192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_7021360273238040373] END' />
      </column>
      <column caption='Warehouse Cost - Focus' datatype='real' name='[Calculation_2007928041536179389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Focus&#13;&#10;// dbt build cost plus direct consumer query cost, USD, in the window. 30d check: $4,189.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [build_cost_usd] + [consumer_query_cost_usd] END)' />
      </column>
      <column caption='Warehouse Cost - Prior' datatype='real' name='[Calculation_4337567063949269036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Prior&#13;&#10;// Same total for the window before. 30d check: $4,935. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [build_cost_usd] + [consumer_query_cost_usd] END)' />
      </column>
      <column caption='Warehouse Cost - Change' datatype='real' name='[Calculation_2589026499509165578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Change&#13;&#10;// Percentage change. Inverse metric: a rise is bad. 30d check: -15.1%.&#13;&#10;IF [Calculation_4337567063949269036] = 0 OR ISNULL([Calculation_4337567063949269036]) THEN NULL&#13;&#10;ELSE [Calculation_2007928041536179389] / [Calculation_4337567063949269036] - 1&#13;&#10;END' />
      </column>
      <column caption='Warehouse Cost - Change Good' datatype='real' name='[Calculation_1563871595510825643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Good&#13;&#10;// A fall in cost, in green. Format: ▲ 0.0%;▼ 0.0%;● 0%&#13;&#10;IF [Calculation_2589026499509165578] &lt;= 0 THEN [Calculation_2589026499509165578] END' />
      </column>
      <column caption='Warehouse Cost - Change Good Text' datatype='string' name='[Calculation_6597731815754042260]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Good Text&#13;&#10;// Inverse metric: a fall is good. Green text &quot;▼ 10.8%&quot;, or &quot;● 0%&quot; when nothing changed.&#13;&#10;IF ISNULL([Calculation_1563871595510825643]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_1563871595510825643] = 0 THEN &quot;● 0%&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_1563871595510825643]) * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_1563871595510825643]) * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Warehouse Cost - Change Bad' datatype='real' name='[Calculation_3322367611289919336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Bad&#13;&#10;// A rise in cost, in red. Same number format.&#13;&#10;IF [Calculation_2589026499509165578] &gt; 0 THEN [Calculation_2589026499509165578] END' />
      </column>
      <column caption='Warehouse Cost - Change Bad Text' datatype='string' name='[Calculation_3322579375304469107]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Bad Text&#13;&#10;// Inverse metric: a rise is bad. Red text &quot;▲ 4.2%&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_3322367611289919336]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_3322367611289919336] * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([Calculation_3322367611289919336] * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Warehouse Cost - Trend' datatype='real' name='[Calculation_2340317715032000993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Trend&#13;&#10;// Bars: daily cost. The early-October drop is fct_sessions going incremental (story 1).&#13;&#10;SUM([build_cost_usd] + [consumer_query_cost_usd])' />
      </column>
      <column caption='Warehouse Cost - Trend In Period' datatype='real' name='[Calculation_3253353875959333377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_2340317715032000993] END' />
      </column>
      <column caption='Warehouse Cost - Trend Out Period' datatype='real' name='[Calculation_4504844918117665692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_2340317715032000993] END' />
      </column>
      <column caption='Is Tile Layout Match' datatype='boolean' name='[Calculation_6095821144001551766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile Layout Match&#13;&#10;// Keeps the layout that matches the All / Needs attention buttons. Put on Filters (True).&#13;&#10;[layout] = [Parameters].[Parameter 8]' />
      </column>
      <column caption='Tile Fill Key' datatype='string' name='[Calculation_2950369687746909721]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Fill Key&#13;&#10;// Fill for the rounded tile: status tint, or faded when the tile is outside the Platform filter.&#13;&#10;IF [feature_type] &lt;&gt; &quot;tile&quot;&#13;&#10;    THEN &quot;None&quot;&#13;&#10;ELSEIF NOT [Calculation_2214252331607255986]&#13;&#10;    THEN &quot;Faded&quot;&#13;&#10;ELSEIF [current_status_code] = 3&#13;&#10;    THEN &quot;Critical&quot;&#13;&#10;ELSEIF [current_status_code] = 2&#13;&#10;    THEN &quot;Warning&quot;&#13;&#10;ELSE &quot;Healthy&quot;&#13;&#10;END' />
      </column>
      <column caption='Clear Node Value' datatype='string' name='[Calculation_1962397006096080865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Clear Node Value&#13;&#10;// Empty string a parameter action can write into p_selected_node, to clear it (prototype: opening an exposure clears the node).&#13;&#10;&quot;&quot;' />
      </column>
      <column caption='Clear Node Key Value' datatype='integer' name='[Calculation_7177065549275409274]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Clear Node Key Value&#13;&#10;// Companion to Clear Node Value for p_selected_node_key. -1 matches no node.&#13;&#10;-1' />
      </column>
      <column caption='Tile Header Text' datatype='string' name='[Calculation_3219610012864781816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Text&#13;&#10;// Group label in caps with its count, e.g. &quot;BI DASHBOARDS  17&quot;. Blank on tile rows.&#13;&#10;// v04 (one map layer): the label is centred on its anchor dot at the left edge of the grid, so it is padded on the&#13;&#10;// right with no-break spaces (about 2.4 per capital) to push the visible text to start at the dot.&#13;&#10;IF [feature_type] = &quot;header&quot;&#13;&#10;    THEN UPPER([group_label]) + &quot;  &quot; + STR([group_count])&#13;&#10;        + REPLACE(SPACE(INT((LEN([group_label]) + 4) * 2.4)), &quot; &quot;, &quot; &quot;)&#13;&#10;END' />
      </column>
      <column caption='Tile Name Short' datatype='string' name='[Calculation_8990803335852813669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Name Short&#13;&#10;// Tile title cut to fit a 163px tile: 22 characters, then &quot;…&quot;. The tooltip has the full name.&#13;&#10;IF LEN([display_name]) &gt; 23 THEN LEFT([display_name], 22) + &quot;…&quot; ELSE [display_name] END' />
      </column>
      <column caption='Consumer Type Label' datatype='string' name='[Calculation_2336170961516567926]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Consumer Type Label&#13;&#10;// Tile meta line: the BI tool for dashboards, otherwise the consumer type.&#13;&#10;IF NOT ISNULL([bi_tool]) THEN&#13;&#10;    CASE [bi_tool]&#13;&#10;    WHEN &quot;tableau&quot;  THEN &quot;Tableau&quot;&#13;&#10;    WHEN &quot;sigma&quot;    THEN &quot;Sigma&quot;&#13;&#10;    WHEN &quot;power_bi&quot; THEN &quot;Power BI&quot;&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    CASE [exposure_type]&#13;&#10;    WHEN &quot;dashboard&quot; THEN &quot;Dashboard&quot;&#13;&#10;    WHEN &quot;notebook&quot;  THEN &quot;Notebook&quot;&#13;&#10;    WHEN &quot;ml&quot;        THEN &quot;ML model&quot;&#13;&#10;    WHEN &quot;data_app&quot;  THEN &quot;Data app&quot;&#13;&#10;    WHEN &quot;agent&quot;     THEN &quot;AI agent&quot;&#13;&#10;    WHEN &quot;data_hub&quot;  THEN &quot;Data hub&quot;&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Tile Owner Text' datatype='string' name='[Calculation_3035768374696072600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Owner Text&#13;&#10;// Owner on the tile meta line, grey. Empty when there is no owner (the red version takes over).&#13;&#10;IF [owner_name] &lt;&gt; &quot;No owner&quot; THEN [owner_name] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Owner Missing Text' datatype='string' name='[Calculation_2565169924538089914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Owner Missing Text&#13;&#10;// &quot;No owner&quot; in red bold on the meta line (story 8 and the unregistered consumers).&#13;&#10;IF [owner_name] = &quot;No owner&quot; THEN &quot;No owner&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Trust Critical' datatype='string' name='[Calculation_2803746157308900676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Trust Critical&#13;&#10;// Trust badge with its icon, shown in red. Only one of the three trust fields is filled for a tile.&#13;&#10;IF [current_status_code] = 3 THEN &quot;✕ &quot; + [trust_badge] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Trust Warning' datatype='string' name='[Calculation_1833995497923574551]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Trust Warning&#13;&#10;// Trust badge with its icon, shown in the warning text colour #93600F.&#13;&#10;IF [current_status_code] = 2 THEN &quot;▲ &quot; + [trust_badge] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Trust Healthy' datatype='string' name='[Calculation_1522121282636949905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Trust Healthy&#13;&#10;// Trust badge with its icon, shown in the healthy text colour #1E7450.&#13;&#10;IF [current_status_code] = 1 THEN &quot;✓ &quot; + [trust_badge] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile AI Tag' datatype='string' name='[Calculation_4692392410293798022]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile AI Tag&#13;&#10;// &quot;AI-built&quot; chip text for ai_assisted exposures (story 10 and the agents).&#13;&#10;IF [build_method] = &quot;ai_assisted&quot; THEN &quot;AI-built&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Score Text' datatype='string' name='[Calculation_1659843968626155727]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Score Text&#13;&#10;// 7-day health score on the tile, one decimal: &quot;99.7&quot;.&#13;&#10;IF ISNULL([health_score_now]) THEN &quot;&quot;&#13;&#10;ELSE STR(INT(ROUND([health_score_now] * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([health_score_now] * 10)) % 10)&#13;&#10;END' />
      </column>
      <column caption='Tile Tooltip Why' datatype='string' name='[Calculation_1883889205833775337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Tooltip Why&#13;&#10;// Tooltip &quot;Why&quot; block: the upstream nodes behind the status, or a reassurance line.&#13;&#10;IF [culprit_count] &gt; 0 THEN [culprit_nodes]&#13;&#10;ELSE &quot;Every upstream step is healthy&quot;&#13;&#10;END' />
      </column>
      <column caption='Tile View Option' datatype='string' name='[Calculation_2894482038928477351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Option&#13;&#10;// Scaffold for the All / Needs attention buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;Needs attention&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Tile View Button Row' datatype='boolean' name='[Calculation_2058479208791343830]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile View Button Row&#13;&#10;// Keeps the 2 scaffold rows that carry the All / Needs attention buttons. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_2894482038928477351])' />
      </column>
      <column caption='Is Active Tile View' datatype='boolean' name='[Calculation_1284089094536110577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Tile View&#13;&#10;// Colours the selected tile-view button.&#13;&#10;[Calculation_2894482038928477351] = [Parameters].[Parameter 8]' />
      </column>
      <column caption='Tile View Label Active' datatype='string' name='[Calculation_1838581371832391049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Label Active&#13;&#10;// Button text when this tile view is selected (Semibold Navy run).&#13;&#10;IF [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile View Label Inactive' datatype='string' name='[Calculation_3133453958818750804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Label Inactive&#13;&#10;// Button text when this tile view is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
      </column>
      <column caption='Attention Sort' datatype='integer' name='[Calculation_1867437212419901178]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Attention Sort&#13;&#10;// Worst first, then the node that feeds the most exposures. Sort Rows by this, descending.&#13;&#10;[current_status_code] * 1000 + [exposures_fed]' />
      </column>
      <column caption='Attention Order' datatype='integer' name='[Calculation_2821357717055420234]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Attention Order&#13;&#10;// Attention Sort turned around, so the natural ascending order of the rows is worst first.&#13;&#10;-[Calculation_1867437212419901178]' />
      </column>
      <column caption='Is Attention Node' datatype='boolean' name='[Calculation_3175454921771165665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Attention Node&#13;&#10;// Upstream nodes (not exposures) that are Warning or Critical right now. Today: 3 nodes.&#13;&#10;[resource_type] &lt;&gt; &quot;exposure&quot;&#13;&#10;AND [Calculation_2875175252813195699]' />
      </column>
      <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
      </column>
      <column caption='Status Tint Key' datatype='string' name='[Calculation_1400495547723235965]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Status Tint Key&#13;&#10;// Same values as Status Label, kept as a separate field so it can carry the light tint palette&#13;&#10;// for tile and alert backgrounds: Healthy #FFFFFF, Warning #FDF3E1, Critical #FBEAE9, No data #F1F2F4.&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Attention Icon Critical' datatype='string' name='[Calculation_3020345249174904341]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Icon Critical&#13;&#10;// &quot;✕&quot; in red before a Critical node. Split by status so each icon gets its own colour.&#13;&#10;IF [current_status_code] = 3 THEN &quot;✕&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Attention Icon Warning' datatype='string' name='[Calculation_1079190453669342032]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Icon Warning&#13;&#10;// &quot;▲&quot; in the warning text colour before a Warning node.&#13;&#10;IF [current_status_code] = 2 THEN &quot;▲&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Attention Incident Tag' datatype='string' name='[Calculation_5034449253068379788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Incident Tag&#13;&#10;// Incident chip next to the node name, for example &quot;INC-008&quot;. Empty when there is no open incident.&#13;&#10;IFNULL([open_incident_id], &quot;&quot;)' />
      </column>
      <column caption='Last Event Label' datatype='string' name='[Calculation_2229498162963349132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Last Event Label&#13;&#10;// The prototype&apos;s timestamp format: &quot;19 Oct, 21:25&quot;. &quot;-&quot; when the node has never run or been checked.&#13;&#10;IF ISNULL([last_event_at]) THEN &quot;-&quot;&#13;&#10;ELSE STR(DAY([last_event_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [last_event_at]), 3) + &quot;, &quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [last_event_at])), 2) + &quot;:&quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [last_event_at])), 2)&#13;&#10;END' />
      </column>
      <column caption='Attention Reason' datatype='string' name='[Calculation_2745413474489980072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Reason&#13;&#10;// Second line of the alert: what is wrong. Failed models get the time of the failure, as in the prototype.&#13;&#10;[status_reason]&#13;&#10;+ IF [last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at])&#13;&#10;    THEN &quot; at &quot; + [Calculation_2229498162963349132]&#13;&#10;  ELSE &quot;&quot;&#13;&#10;  END' />
      </column>
      <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
      </column>
      <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Attention Meta' datatype='string' name='[Calculation_6126214509312991080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Meta&#13;&#10;// Third line: where it sits and what it affects, for example &quot;Staging · Snowflake · affects 4 exposures&quot;.&#13;&#10;[Calculation_7823664326256286450] + &quot; · &quot; + [Calculation_1641578937180273009] + &quot; · affects &quot;&#13;&#10;+ STR([exposures_fed])&#13;&#10;+ IF [exposures_fed] = 1 THEN &quot; exposure&quot; ELSE &quot; exposures&quot; END' />
      </column>
      <column caption='Attention Open Since' datatype='string' name='[Calculation_1700778924915878744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Open Since&#13;&#10;// Tail of the meta line: &quot; · open since 19 Oct&quot;. Uses open_incident_started_at, added to dim_nodes for this.&#13;&#10;IF ISNULL([open_incident_started_at]) THEN &quot;&quot;&#13;&#10;ELSE &quot; · open since &quot; + STR(DAY([open_incident_started_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [open_incident_started_at]), 3)&#13;&#10;END' />
      </column>
      <column caption='Node Count' datatype='integer' name='[Calculation_2446133016301952044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Node Count&#13;&#10;// Number of nodes in the view. dim_nodes has one row per node.&#13;&#10;COUNTD([node_id (dim_nodes.csv)])' />
      </column>
      <column caption='Layer Share' datatype='real' name='[Calculation_9282765132542256788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Share&#13;&#10;// Each status&apos;s share of the layer, so every bar spans the full width.&#13;&#10;// Table calc: compute using Status Label (along the bar).&#13;&#10;[Calculation_2446133016301952044] / TOTAL([Calculation_2446133016301952044])'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2946817898410042583]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Layer Label Position' datatype='real' name='[Calculation_2008892738692294245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Label Position&#13;&#10;// Where the &quot;1 / 27&quot; count sits on the layer bar: just past the end of the full bar (axis fixed 0 to 1.15).&#13;&#10;MIN(1.06)' />
      </column>
      <column caption='Status Stack Order' datatype='integer' name='[Calculation_2946817898410042583]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Status Stack Order&#13;&#10;// Healthy first, for stacked bars, as in the prototype&apos;s layer health strip: Healthy, Warning, Critical, No data.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 1 THEN 1&#13;&#10;WHEN 2 THEN 2&#13;&#10;WHEN 3 THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='Layer Total' datatype='integer' name='[Calculation_3311281824631653486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Total&#13;&#10;// Nodes in the layer for the selected platform. FIXED with the platform rule inside, so no context filter is needed.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] THEN 1 END) }' />
      </column>
      <column caption='Layer Total Text' datatype='string' name='[Calculation_1760329556827391948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Total Text&#13;&#10;// The layer total, in grey after the issue count: &quot;1 / 30&quot; or just &quot;21&quot;.&#13;&#10;STR([Calculation_3311281824631653486])' />
      </column>
      <column caption='Layer Has Critical' datatype='boolean' name='[Calculation_4191687787979507265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Has Critical&#13;&#10;// TRUE when any node in the layer is Critical, so the issue count shows in red rather than amber.&#13;&#10;{ FIXED [layer] : MAX(IF [Calculation_2214252331607255986] AND [current_status_code] = 3 THEN 1 ELSE 0 END) } = 1' />
      </column>
      <column caption='Layer Issues' datatype='integer' name='[Calculation_1394288337659403442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Issues&#13;&#10;// Nodes in the layer that are Warning or Critical right now, for the selected platform.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] AND [Calculation_2875175252813195699] THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Layer Issues Critical Text' datatype='string' name='[Calculation_2393800399496740184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Critical Text&#13;&#10;// &quot;1 / &quot; in red, shown when the layer has a Critical node.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Layer Issues Warning Text' datatype='string' name='[Calculation_3164047678432910206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Warning Text&#13;&#10;// &quot;1 / &quot; in amber ink #93600F, when the layer has issues but none Critical.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND NOT [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Show Info Panel' datatype='boolean' name='[Calculation_3095764547146903988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Info Panel&#13;&#10;// DZV for GL Info Panel: shown while p_show_info is True.&#13;&#10;[Parameters].[Parameter 7]' />
      </column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style>
        <style-rule element='mark'>
          <encoding attr='color' field='[none:Calculation_1290101426377148290:nk]' type='palette'>
