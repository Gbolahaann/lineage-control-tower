        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_2007928041536179389:qk]' />
              <text column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_6597731815754042260:nk]' />
              <text column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_3322579375304469107:nk]' />
              <text column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[attr:Calculation_1953312242491521622:nk]' />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='7' bold='true'>WAREHOUSE COST</run>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='7'>Æ&#10;</run>
                <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Estimated compute cost of dbt builds plus queries from data products, in USD.</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8' bold='true'>WAREHOUSE COST  ⓘ</run>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ&#10;</run>
                <run fontcolor='#002c55' fontname='Arial' fontsize='18' bold='true'>&lt;[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_2007928041536179389:qk]&gt;</run>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ&#10;</run>
