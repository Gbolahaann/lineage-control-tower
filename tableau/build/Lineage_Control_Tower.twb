              <calculation class='tableau' formula='// Info Toggle Value&#13;&#10;// The value the info button writes into p_show_info: the opposite of the current state.&#13;&#10;NOT [Parameters].[Parameter 7]' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
