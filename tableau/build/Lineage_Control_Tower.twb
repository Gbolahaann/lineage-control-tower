          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Lineage Scope' datatype='boolean' name='[Calculation_2164541789448021386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Lineage Scope&#13;&#10;// Keeps the per-exposure layout of the selected exposure. Put on Filters (True).&#13;&#10;[layout_scope] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Lineage Divider Bucket' datatype='integer' name='[Calculation_9310144658734288108]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Lineage Divider Bucket&#13;&#10;// Divider number 1 to 5 (before columns 1 to 5), taken from the edge rows&apos; point_order.&#13;&#10;IF [row_type] = &quot;edge&quot; AND INT([point_order]) &lt;= 5 THEN INT([point_order]) END' />
            </column>
            <column caption='Lineage Divider Point' datatype='spatial' name='[Calculation_1445586200258206806]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Divider Point&#13;&#10;// A thin vertical line between layer columns: top at sources rows, bottom at every other row&#13;&#10;// (drawn as a line with path layer_column, so it always spans the full height).&#13;&#10;IF NOT ISNULL([Calculation_9310144658734288108]) THEN MAKEPOINT(&#13;&#10;    IF [layer_column] = 0 THEN 3.7000 ELSE -3.7400 END,&#13;&#10;    ((8 + [Calculation_9310144658734288108] * 151.833 - 6) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Lineage Heading Bucket' datatype='integer' name='[Calculation_2413323732837840958]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Lineage Heading Bucket&#13;&#10;// Heading number 1 to 6, taken from the edge rows&apos; point_order.&#13;&#10;IF [row_type] = &quot;edge&quot; AND INT([point_order]) &lt;= 6 THEN INT([point_order]) END' />
            </column>
            <column caption='Lineage Heading' datatype='string' name='[Calculation_2224389289499474903]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Heading&#13;&#10;// Layer column heading above the graph.&#13;&#10;CASE [Calculation_2413323732837840958]&#13;&#10;WHEN 1 THEN &quot;SOURCES&quot;&#13;&#10;WHEN 2 THEN &quot;STAGING&quot;&#13;&#10;WHEN 3 THEN &quot;INTERMEDIATE&quot;&#13;&#10;WHEN 4 THEN &quot;MARTS&quot;&#13;&#10;WHEN 5 THEN &quot;BI SEMANTIC LAYER&quot;&#13;&#10;WHEN 6 THEN &quot;EXPOSURE&quot;&#13;&#10;END' />
            </column>
            <column caption='Lineage Heading Point' datatype='spatial' name='[Calculation_1551465130989007384]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Heading Point&#13;&#10;// Middle of a layer column heading, which starts 2 px in from the column edge.&#13;&#10;IF NOT ISNULL([Calculation_2413323732837840958]) THEN MAKEPOINT((374 - (10)) / 100, ((CASE [Calculation_2413323732837840958] WHEN 1 THEN 33.2 WHEN 2 THEN 182.8 WHEN 3 THEN 348.5 WHEN 4 THEN 482.2 WHEN 5 THEN 664.6 WHEN 6 THEN 795.2 END) - 463.5) / 100) END' />
            </column>
            <column caption='Selected Reach Keys' datatype='string' name='[Calculation_2711556710182190933]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Selected Reach Keys&#13;&#10;// |key|key| list of every node on the selected node&apos;s path (itself, everything upstream and downstream)&#13;&#10;// in this exposure&apos;s layout. NULL when the selected node is not in this graph.&#13;&#10;{ FIXED [layout_scope] :&#13;&#10;    MAX(IF [row_type] = &quot;node&quot;&#13;&#10;        AND [node_key (mart_lineage_layout.csv)] = [Parameters].[Parameter 5]&#13;&#10;        THEN [reach_keys] END) }' />
            </column>
            <column caption='Has Path Selection' datatype='boolean' name='[Calculation_1532913090214597387]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Has Path Selection&#13;&#10;// TRUE when the clicked node is part of this exposure&apos;s graph. Otherwise nothing is faded.&#13;&#10;NOT ISNULL([Calculation_2711556710182190933])' />
            </column>
            <column caption='Is On Path Edge' datatype='boolean' name='[Calculation_1902643259081548742]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is On Path Edge&#13;&#10;// TRUE when both ends of an edge are on the selected path. Like the prototype, an edge that jumps from an&#13;&#10;// upstream node straight to a downstream node also lights up; that case is rare in this graph.&#13;&#10;IF NOT [Calculation_1532913090214597387] THEN TRUE&#13;&#10;ELSE CONTAINS([Calculation_2711556710182190933], &quot;|&quot; + STR([node_key (mart_lineage_layout.csv)]) + &quot;|&quot;)&#13;&#10;    AND CONTAINS([Calculation_2711556710182190933], &quot;|&quot; + STR([child_key]) + &quot;|&quot;)&#13;&#10;END' />
            </column>
            <column caption='Edge Colour Key' datatype='string' name='[Calculation_1687481836717768070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Edge Colour Key&#13;&#10;// Edge rows carry the parent&apos;s node_id, so dim_nodes gives the parent&apos;s status: a failing parent turns its edges red or amber.&#13;&#10;// Palette: Faded #EEF0F2, Critical #D2453F, Warning #E8A33D, On path #005FAE, Default #CBD0D5.&#13;&#10;IF NOT [Calculation_1902643259081548742] THEN &quot;Faded&quot;&#13;&#10;ELSEIF [current_status_code] = 3 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [current_status_code] = 2 THEN &quot;Warning&quot;&#13;&#10;ELSEIF [Calculation_1532913090214597387] THEN &quot;On path&quot;&#13;&#10;ELSE &quot;Default&quot;&#13;&#10;END' />
            </column>
            <column caption='Lineage Y Max' datatype='real' name='[Calculation_2862554141724672958]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Lineage Y Max&#13;&#10;// Bottom row of the selected graph.&#13;&#10;{ FIXED [layout_scope] : MAX(IF [row_type] = &quot;node&quot; THEN [y] END) }' />
            </column>
            <column caption='Lineage Y Min' datatype='real' name='[Calculation_8729747500185938838]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Lineage Y Min&#13;&#10;// Top row of the selected graph (y of its node rows).&#13;&#10;{ FIXED [layout_scope] : MIN(IF [row_type] = &quot;node&quot; THEN [y] END) }' />
            </column>
            <column caption='Lineage Box Height' datatype='real' name='[Calculation_9398625473923371421]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Lineage Box Height&#13;&#10;// Box height in px, 13 to 22 from the number of rows (prototype drawLineage).&#13;&#10;MIN(22, MAX(13, (748 - 50) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838] + 1.4) - 2))' />
            </column>
            <column caption='Lineage Edge Point' datatype='spatial' name='[Calculation_2028226497456021498]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Edge Point&#13;&#10;// A point of an edge curve (the mart&apos;s x in layer columns, y in rows).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([y]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END))) / 100,&#13;&#10;    (((8 + ([x]) * 151.833)) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Is On Path Node' datatype='boolean' name='[Calculation_2720870856721498789]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is On Path Node&#13;&#10;// TRUE for boxes on the selected path, or for every box when nothing is selected.&#13;&#10;IF NOT [Calculation_1532913090214597387] THEN TRUE&#13;&#10;ELSE CONTAINS([Calculation_2711556710182190933], &quot;|&quot; + STR([node_key (mart_lineage_layout.csv)]) + &quot;|&quot;)&#13;&#10;END' />
            </column>
            <column caption='Is Selected Node Box' datatype='boolean' name='[Calculation_2543776221048440310]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Selected Node Box&#13;&#10;// The clicked box, so its name can be bolded.&#13;&#10;[node_key (mart_lineage_layout.csv)] = [Parameters].[Parameter 5]' />
            </column>
            <column caption='Lineage Box Border Key' datatype='string' name='[Calculation_2702365918922892839]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Box Border Key&#13;&#10;// Box border: navy for the selected box, the status colour for warning and critical, pale off the path.&#13;&#10;IF [Calculation_2543776221048440310] THEN &quot;Selected&quot;&#13;&#10;ELSEIF NOT [Calculation_2720870856721498789] THEN &quot;Faded&quot;&#13;&#10;ELSEIF [current_status_code] = 3 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [current_status_code] = 2 THEN &quot;Warning&quot;&#13;&#10;ELSE &quot;Default&quot;&#13;&#10;END' />
            </column>
            <column caption='Lineage Node X' datatype='real' name='[Calculation_3349816069477544607]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Lineage Node X&#13;&#10;// Layer column of a node, on every row that carries its node_key (its node row and its outgoing edges).&#13;&#10;{ FIXED [layout_scope], [node_key (mart_lineage_layout.csv)] : MIN(IF [row_type] = &quot;node&quot; THEN [x] END) }' />
            </column>
            <column caption='Lineage Node Y' datatype='real' name='[Calculation_1468698324675902386]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Lineage Node Y&#13;&#10;// Row of a node, on every row that carries its node_key.&#13;&#10;{ FIXED [layout_scope], [node_key (mart_lineage_layout.csv)] : MIN(IF [row_type] = &quot;node&quot; THEN [y] END) }' />
            </column>
            <column caption='Lineage Box Border Point' datatype='spatial' name='[Calculation_6377687894188231371]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Box Border Point&#13;&#10;// Box outline of a node, drawn from its outgoing edge rows (path point_order).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_1468698324675902386]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421]) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2))) + (MIN(6, [Calculation_9398625473923371421] / 2)) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + ([Calculation_3349816069477544607]) * 151.833) + 60.733)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((121.46666666666668) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2))) + (MIN(6, [Calculation_9398625473923371421] / 2)) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Panel Tags Value' datatype='string' name='[Calculation_9860372241269830816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Tags Value&#13;&#10;// What a click writes into p_panel_tags: &quot;|moved|ai|unregistered|&quot; for the tags this node carries.&#13;&#10;&quot;|&quot; + IF NOT ISNULL([migrated_from_platform]) THEN &quot;moved|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF [build_method] = &quot;ai_assisted&quot; THEN &quot;ai|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF NOT [is_declared] THEN &quot;unregistered|&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
            </column>
            <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='Node Platform Tooltip' datatype='string' name='[Calculation_2505057497825235880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Node Platform Tooltip&#13;&#10;// &quot;Snowflake (moved from Redshift on 3 Sep)&quot; for migrated nodes.&#13;&#10;[Calculation_1641578937180273009]&#13;&#10;+ IF ISNULL([migrated_from_platform]) THEN &quot;&quot;&#13;&#10;  ELSE &quot; (moved from &quot; + PROPER([migrated_from_platform]) + &quot; on &quot;&#13;&#10;      + STR(DAY([migration_date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [migration_date]), 3) + &quot;)&quot;&#13;&#10;  END' />
            </column>
            <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
            </column>
            <column caption='Last Runtime Label' datatype='string' name='[Calculation_1403910267805111020]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Last Runtime Label&#13;&#10;// Last model runtime in the prototype&apos;s duration format: &quot;45s&quot;, &quot;27.9 min&quot; or &quot;1.2 h&quot;.&#13;&#10;IF ISNULL([last_runtime_sec]) THEN &quot;&quot;&#13;&#10;ELSEIF [last_runtime_sec] &lt; 60 THEN STR(ROUND([last_runtime_sec])) + &quot;s&quot;&#13;&#10;ELSEIF [last_runtime_sec] &lt; 3600 THEN STR(ROUND([last_runtime_sec] / 60, 1)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([last_runtime_sec] / 3600, 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='Lag Now Label' datatype='string' name='[Calculation_2339296116464127259]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lag Now Label&#13;&#10;// Current source lag: &quot;45 min&quot; under an hour, otherwise &quot;6.0 h&quot;.&#13;&#10;IF ISNULL([freshness_lag_min]) THEN &quot;&quot;&#13;&#10;ELSEIF [freshness_lag_min] &lt; 60 THEN STR(ROUND([freshness_lag_min])) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([freshness_lag_min] / 60, 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='Lineage Box Fill Key' datatype='string' name='[Calculation_1996634092689200478]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Box Fill Key&#13;&#10;// Box fill: the status tint, white when healthy, near white off the path.&#13;&#10;IF NOT [Calculation_2720870856721498789] THEN &quot;Faded&quot;&#13;&#10;ELSEIF [current_status_code] = 3 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [current_status_code] = 2 THEN &quot;Warning&quot;&#13;&#10;ELSE &quot;Default&quot;&#13;&#10;END' />
            </column>
            <column caption='Lineage Box Fill Point' datatype='spatial' name='[Calculation_6434936126226937117]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Box Fill Point&#13;&#10;// Box fill, 1 px inside the border (2 px for the selected box).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_1468698324675902386]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421] - 2 * (IF [Calculation_2543776221048440310] THEN 2 ELSE 1 END)) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Calculation_2543776221048440310] THEN 2 ELSE 1 END))) + (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Calculation_2543776221048440310] THEN 2 ELSE 1 END)) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + ([Calculation_3349816069477544607]) * 151.833) + 60.733)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((121.467 - 2 * (IF [Calculation_2543776221048440310] THEN 2 ELSE 1 END)) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Calculation_2543776221048440310] THEN 2 ELSE 1 END))) + (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Calculation_2543776221048440310] THEN 2 ELSE 1 END)) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Lineage Exposure Status' datatype='integer' name='[Calculation_1476318630322912776]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Lineage Exposure Status&#13;&#10;// Status code of the selected exposure, on every row.&#13;&#10;{ MAX(IF [node_id (dim_nodes.csv)] = [Parameters].[Parameter 3] THEN [current_status_code] END) }' />
            </column>
            <column caption='Lineage Exposure Border Key' datatype='string' name='[Calculation_9794080485824952673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Border Key&#13;&#10;// The exposure box border.&#13;&#10;IF [Parameters].[Parameter 4] = [layout_scope] THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Calculation_1476318630322912776] = 3 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [Calculation_1476318630322912776] = 2 THEN &quot;Warning&quot;&#13;&#10;ELSE &quot;Default&quot;&#13;&#10;END' />
            </column>
            <column caption='Lineage Exposure Y' datatype='real' name='[Calculation_3026584209685377350]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Lineage Exposure Y&#13;&#10;// Row of the graph&apos;s exposure (its node_id is the layout scope).&#13;&#10;{ FIXED [layout_scope] : MIN(IF [row_type] = &quot;node&quot; AND [node_id (mart_lineage_layout.csv)] = [layout_scope] THEN [y] END) }' />
            </column>
            <column caption='Lineage Exposure Border Point' datatype='spatial' name='[Calculation_3290102549076772709]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Border Point&#13;&#10;// The exposure&apos;s box, drawn from its incoming edge rows.&#13;&#10;IF [row_type] = &quot;edge&quot; AND [child_node_id] = [layout_scope] THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_3026584209685377350]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421]) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2))) + (MIN(6, [Calculation_9398625473923371421] / 2)) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + (5) * 151.833) + 60.733)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((121.46666666666668) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2))) + (MIN(6, [Calculation_9398625473923371421] / 2)) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Lineage Exposure Fill Key' datatype='string' name='[Calculation_1486862183174907159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Fill Key&#13;&#10;// The exposure box fill.&#13;&#10;IF [Calculation_1476318630322912776] = 3 THEN &quot;Critical&quot;&#13;&#10;ELSEIF [Calculation_1476318630322912776] = 2 THEN &quot;Warning&quot;&#13;&#10;ELSE &quot;Default&quot;&#13;&#10;END' />
            </column>
            <column caption='Lineage Exposure Fill Point' datatype='spatial' name='[Calculation_2290898334426755834]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Fill Point&#13;&#10;// The exposure&apos;s box fill.&#13;&#10;IF [row_type] = &quot;edge&quot; AND [child_node_id] = [layout_scope] THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_3026584209685377350]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421] - 2 * (IF [Parameters].[Parameter 4] = [layout_scope] THEN 2 ELSE 1 END)) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Parameters].[Parameter 4] = [layout_scope] THEN 2 ELSE 1 END))) + (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Parameters].[Parameter 4] = [layout_scope] THEN 2 ELSE 1 END)) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + (5) * 151.833) + 60.733)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((121.467 - 2 * (IF [Parameters].[Parameter 4] = [layout_scope] THEN 2 ELSE 1 END)) / 2 - (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Parameters].[Parameter 4] = [layout_scope] THEN 2 ELSE 1 END))) + (MIN(6, [Calculation_9398625473923371421] / 2) - (IF [Parameters].[Parameter 4] = [layout_scope] THEN 2 ELSE 1 END)) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Lineage Dot Key' datatype='string' name='[Calculation_2618043692623518270]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Dot Key&#13;&#10;// Status dot colour, pale off the path.&#13;&#10;IF NOT [Calculation_2720870856721498789] THEN &quot;Faded&quot; ELSE [Calculation_3105941082857465865] END' />
            </column>
            <column caption='Lineage Dot Point' datatype='spatial' name='[Calculation_2087957033439278726]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Dot Point&#13;&#10;// Status dot, 3.2 px radius, 8 px in from the box edge.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_1468698324675902386]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * ((6.4) / 2 - (3.2)) + (3.2) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + ([Calculation_3349816069477544607]) * 151.833) + 8)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((6.4) / 2 - (3.2)) + (3.2) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Lineage Stripe Key' datatype='string' name='[Calculation_9835761828687221722]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Stripe Key&#13;&#10;// Platform stripe colour, pale off the path.&#13;&#10;IF NOT [Calculation_2720870856721498789] THEN &quot;Faded&quot; ELSE [Calculation_1641578937180273009] END' />
            </column>
            <column caption='Lineage Stripe Point' datatype='spatial' name='[Calculation_1153384882188955846]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Stripe Point&#13;&#10;// Platform stripe, 3 px wide, at the right end of the box.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_1468698324675902386]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421] - 6) / 2 - (1.5)) + (1.5) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + ([Calculation_3349816069477544607]) * 151.833) + 115.967)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((3) / 2 - (1.5)) + (1.5) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Lineage Exposure Dot Key' datatype='string' name='[Calculation_2452760912051295846]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Dot Key&#13;&#10;// The exposure box status dot.&#13;&#10;CASE [Calculation_1476318630322912776] WHEN 3 THEN &quot;Critical&quot; WHEN 2 THEN &quot;Warning&quot; WHEN 1 THEN &quot;Healthy&quot; ELSE &quot;No data&quot; END' />
            </column>
            <column caption='Lineage Exposure Dot Point' datatype='spatial' name='[Calculation_2959312180648738363]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Dot Point&#13;&#10;// The exposure&apos;s status dot.&#13;&#10;IF [row_type] = &quot;edge&quot; AND [child_node_id] = [layout_scope] THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_3026584209685377350]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * ((6.4) / 2 - (3.2)) + (3.2) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + (5) * 151.833) + 8)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((6.4) / 2 - (3.2)) + (3.2) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Lineage Exposure Platform' datatype='string' name='[Calculation_2132277863714181032]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Platform&#13;&#10;// Platform of the selected exposure, on every row.&#13;&#10;{ MAX(IF [node_id (dim_nodes.csv)] = [Parameters].[Parameter 3] THEN [Calculation_1641578937180273009] END) }' />
            </column>
            <column caption='Lineage Exposure Stripe Key' datatype='string' name='[Calculation_1214037053747658779]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Stripe Key&#13;&#10;// The exposure box platform stripe.&#13;&#10;[Calculation_2132277863714181032]' />
            </column>
            <column caption='Lineage Exposure Stripe Point' datatype='spatial' name='[Calculation_1235778005112457999]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Lineage Exposure Stripe Point&#13;&#10;// The exposure&apos;s platform stripe.&#13;&#10;IF [row_type] = &quot;edge&quot; AND [child_node_id] = [layout_scope] THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_3026584209685377350]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421] - 6) / 2 - (1.5)) + (1.5) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + (5) * 151.833) + 115.967)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((3) / 2 - (1.5)) + (1.5) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
            </column>
