              <text column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2111610048197173466:nk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Data updated on </run>
                <run fontcolor='#16212e' fontname='Arial' fontsize='8' bold='true'>&lt;[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2445757024107576062:nk]&gt;</run>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ&#10;</run>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>&lt;[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2111610048197173466:nk]&gt;</run>
