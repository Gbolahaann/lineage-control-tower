            <column caption='BR Email Anchor' datatype='real' name='[Calculation_1272315071399739603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// BR Email Anchor&#13;&#10;// Where the envelope sits on the button&apos;s 0 to 1 axis, so icon and text are centred together.&#13;&#10;MIN(0.148)' />
            </column>
            <column caption='Is First Date Row' datatype='boolean' name='[Calculation_7201951502715406386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is First Date Row&#13;&#10;// One-row scaffold (the first day) for the Gantt day buttons and label. Put on Filters (True).&#13;&#10;[day_index] = 0' />
            </column>
            <column caption='BR Email Glyph' datatype='string' name='[Calculation_2241409737872708397]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// BR Email Glyph&#13;&#10;// The button&apos;s text, beside the envelope icon (as the prototype&apos;s &quot;Copy incident message&quot;).&#13;&#10;MIN(&quot;Email incident message&quot;)' />
            </column>
