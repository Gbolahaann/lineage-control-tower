      </column>
      <column caption='PF Rows Text' datatype='string' name='[Calculation_1036172898290230613]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Rows Text&#13;&#10;// Largest build in rows, as the prototype writes it: &quot;60.9M&quot;.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_inventory_daily&quot; THEN &quot;7.7M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_order_items&quot; THEN &quot;13.8M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_orders&quot; THEN &quot;5.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_partner_payouts&quot; THEN &quot;77.7K&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_payments&quot; THEN &quot;3.7M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_revenue_daily&quot; THEN &quot;63.1K&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_shipments&quot; THEN &quot;4.7M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_store_sales&quot; THEN &quot;2.6M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_customers__deduped&quot; THEN &quot;2.2M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_inventory__snapshots&quot; THEN &quot;3.2M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_orders__enriched&quot; THEN &quot;5.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_payments__reconciled&quot; THEN &quot;3.8M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.dim_companies&quot; THEN &quot;37.6K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.dim_contacts&quot; THEN &quot;775.7K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_ad_spend_daily&quot; THEN &quot;116.6K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_attribution&quot; THEN &quot;2.5M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_campaign_performance&quot; THEN &quot;497.7K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_marketing_roi&quot; THEN &quot;14.6K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_pipeline&quot; THEN &quot;102.8K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__attribution&quot; THEN &quot;2.5M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__unified&quot; THEN &quot;4.0M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_campaigns__spend_daily&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_contacts__lifecycle&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_deals__pipeline&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__ad_stats&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__campaigns&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deal_stages&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deals&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_meta_ads__ad_insights&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.dim_customer_behavior&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_app_engagement&quot; THEN &quot;30.4K&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_churn_features&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_demand_signals&quot; THEN &quot;4.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_experiment_results&quot; THEN &quot;5.5K&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_funnel_daily&quot; THEN &quot;10.9K&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_sessions&quot; THEN &quot;60.9M&quot;&#13;&#10;WHEN &quot;model.acme_product.int_app__engagement&quot; THEN &quot;25.5M&quot;&#13;&#10;WHEN &quot;model.acme_product.int_customer_behavior&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.int_funnel__steps&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.int_sessions__stitched&quot; THEN &quot;58.2M&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_events&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_installs&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__page_views&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__search_events&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__web_sessions&quot; THEN &quot;-&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='PF Rows Point' datatype='spatial' name='[Calculation_1382265748193917292]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Rows Point&#13;&#10;// Largest build, right-aligned at its column.&#13;&#10;MAKEPOINT(0, (CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_inventory_daily&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_order_items&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_core.fct_orders&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_partner_payouts&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_core.fct_payments&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_revenue_daily&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_core.fct_shipments&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_store_sales&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_customers__deduped&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_inventory__snapshots&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_orders__enriched&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_payments__reconciled&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.dim_companies&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_marketing.dim_contacts&quot; THEN 503.2&#13;&#10;WHEN &quot;model.acme_marketing.fct_ad_spend_daily&quot; THEN 503.6&#13;&#10;WHEN &quot;model.acme_marketing.fct_attribution&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.fct_campaign_performance&quot; THEN 503.2&#13;&#10;WHEN &quot;model.acme_marketing.fct_marketing_roi&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_marketing.fct_pipeline&quot; THEN 503.2&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__attribution&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__unified&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.int_campaigns__spend_daily&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.int_contacts__lifecycle&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.int_deals__pipeline&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__ad_stats&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__campaigns&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deals&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_meta_ads__ad_insights&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.dim_customer_behavior&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.fct_app_engagement&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_product.fct_churn_features&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.fct_demand_signals&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.fct_experiment_results&quot; THEN 509.1&#13;&#10;WHEN &quot;model.acme_product.fct_funnel_daily&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_product.fct_sessions&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_product.int_app__engagement&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_product.int_customer_behavior&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.int_funnel__steps&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.int_sessions__stitched&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_events&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_installs&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__page_views&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__search_events&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__web_sessions&quot; THEN 518.2&#13;&#10;ELSE 0&#13;&#10;END - 365) / 100)' />
      </column>
      <column caption='PF Cost Point' datatype='spatial' name='[Calculation_1392208467928993943]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Cost Point&#13;&#10;// Cost: the label ends here.&#13;&#10;MAKEPOINT(0, (584.0 - 365) / 100)' />
      </column>
      <column caption='PF Pill Good Text' datatype='string' name='[Calculation_2202777234592407529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Pill Good Text&#13;&#10;// Pill text in green.&#13;&#10;IF [Calculation_2255261106894237473] = &quot;Switched&quot; THEN [Calculation_2337790847276450150] END' />
      </column>
      <column caption='PF Pill Warn Text' datatype='string' name='[Calculation_1606204181775312819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Pill Warn Text&#13;&#10;// Pill text in amber ink.&#13;&#10;IF [Calculation_2255261106894237473] = &quot;Open&quot; THEN [Calculation_2337790847276450150] END' />
      </column>
      <column caption='PF Pill Text Point' datatype='spatial' name='[Calculation_3486248168281878592]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Pill Text Point&#13;&#10;// Middle of the pill.&#13;&#10;MAKEPOINT(0, (620 + (CASE [Calculation_2337790847276450150] WHEN &quot;✓  Switched 4 Oct&quot; THEN 47.5 ELSE 0 END) - 365) / 100)' />
      </column>
      <column caption='Product Cost Label Tag' datatype='string' name='[Calculation_3193649455591386272]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Product Cost Label Tag&#13;&#10;// &quot;unregistered&quot; tag after an exposure name in the cost bars.&#13;&#10;IF [is_declared] THEN &quot;&quot; ELSE &quot;unregistered&quot; END' />
      </column>
      <column caption='Product Cost (Period)' datatype='real' name='[Calculation_3016817971858344399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Product Cost (Period)&#13;&#10;// Allocated cost in the window: upstream build cost split across the exposures each model feeds, plus own queries.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [allocated_cost_usd] END)' />
      </column>
      <column caption='Product Cost Track' datatype='real' name='[Calculation_2011931852930701367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Product Cost Track&#13;&#10;// Where each cost label starts, just past the longest bar (as the Why runs failed counts).&#13;&#10;// Table calc along display_name and the unregistered tag.&#13;&#10;WINDOW_MAX([Calculation_3016817971858344399]) * 1.14'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Is Top Product Cost' datatype='boolean' name='[Calculation_5716871441044921580]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Is Top Product Cost&#13;&#10;// The 12 data products that cost most in the window. Table calc filter (True).&#13;&#10;RANK_UNIQUE([Calculation_3016817971858344399]) &lt;= 12'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Product Uses (Period)' datatype='real' name='[Calculation_1159284100207867770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Product Uses (Period)&#13;&#10;// An exposure&apos;s consumption events in the window (views, queries, sessions or calls).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [events] END)' />
      </column>
      <column caption='Uses Unit Label' datatype='string' name='[Calculation_2657459577906221023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Uses Unit Label&#13;&#10;// Unit after a usage number: views, queries, app sessions or agent calls (Exposure Daily).&#13;&#10;CASE [consumption_type (mart_exposure_daily.csv)]&#13;&#10;WHEN &quot;view&quot;        THEN &quot;views&quot;&#13;&#10;WHEN &quot;query&quot;       THEN &quot;queries&quot;&#13;&#10;WHEN &quot;app_session&quot; THEN &quot;app sessions&quot;&#13;&#10;WHEN &quot;agent_call&quot;  THEN &quot;agent calls&quot;&#13;&#10;END' />
      </column>
      <column caption='Cost Per Use' datatype='real' name='[Calculation_2256908730979128074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Cost Per Use&#13;&#10;// Product Cost / Product Uses. NULL (shown &quot;-&quot;) when there was no use.&#13;&#10;IF [Calculation_1159284100207867770] = 0 OR ISNULL([Calculation_1159284100207867770]) THEN NULL&#13;&#10;ELSE [Calculation_3016817971858344399] / [Calculation_1159284100207867770]&#13;&#10;END' />
      </column>
      <column caption='Retire Uses Threshold' datatype='real' name='[Calculation_7109802039074897984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Retire Uses Threshold&#13;&#10;// Y position of the retire band&apos;s top edge: 10 uses per 30 days, scaled to the window.&#13;&#10;10 * [Parameters].[Parameter 1] / 30' />
      </column>
      <column caption='US Retire Zone' datatype='real' name='[Calculation_1644253842737692818]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// US Retire Zone&#13;&#10;// Uses axis of the retire-zone corners: 1 (the axis floor), the threshold (10 uses per 30 days,&#13;&#10;// scaled to the window) at the bend and the right edge, 1 again at the bottom right.&#13;&#10;CASE MIN([day_index]) WHEN 86 THEN 1 WHEN 87 THEN [Calculation_7109802039074897984]&#13;&#10;WHEN 88 THEN [Calculation_7109802039074897984] WHEN 89 THEN 1 END' />
      </column>
      <column caption='US Scatter Uses' datatype='real' name='[Calculation_3395208717117628007]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// US Scatter Uses&#13;&#10;// Uses axis of a product dot (NULL with no use or cost).&#13;&#10;IF [Calculation_1159284100207867770] &gt; 0 AND [Calculation_3016817971858344399] &gt; 0 THEN [Calculation_1159284100207867770] END' />
      </column>
      <column caption='US Scatter X' datatype='real' name='[Calculation_8348940959693549021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// US Scatter X&#13;&#10;// Cost axis of the scatter. A product: its cost in the period (NULL with no use or cost: a log axis&#13;&#10;// cannot show 0). A retire-zone corner: $5 at the bottom left, $5 x the threshold at the bend, and the&#13;&#10;// axis&apos;s right edge (a round power of ten above the dearest product, per period and platform).&#13;&#10;IF MIN([day_index]) = MAX([day_index]) THEN&#13;&#10;    CASE MIN([day_index]) WHEN 86 THEN 5 WHEN 87 THEN 5 * [Calculation_7109802039074897984]&#13;&#10;    ELSE CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN 1000&#13;&#10;WHEN &quot;7|snowflake&quot; THEN 1000&#13;&#10;WHEN &quot;7|databricks&quot; THEN 100&#13;&#10;WHEN &quot;7|redshift&quot; THEN 1000&#13;&#10;WHEN &quot;30|All&quot; THEN 1000&#13;&#10;WHEN &quot;30|snowflake&quot; THEN 1000&#13;&#10;WHEN &quot;30|databricks&quot; THEN 1000&#13;&#10;WHEN &quot;30|redshift&quot; THEN 1000&#13;&#10;WHEN &quot;90|All&quot; THEN 10000&#13;&#10;WHEN &quot;90|snowflake&quot; THEN 10000&#13;&#10;WHEN &quot;90|databricks&quot; THEN 10000&#13;&#10;WHEN &quot;90|redshift&quot; THEN 1000&#13;&#10;ELSE 1000&#13;&#10;END END&#13;&#10;ELSEIF [Calculation_1159284100207867770] &gt; 0 AND [Calculation_3016817971858344399] &gt; 0 THEN [Calculation_3016817971858344399]&#13;&#10;END' />
      </column>
      <column caption='Uses Per 30 Days' datatype='real' name='[Calculation_1750303070460088850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Uses Per 30 Days&#13;&#10;// Uses scaled to 30 days, so the retire threshold reads the same at 7, 30 and 90 days.&#13;&#10;[Calculation_1159284100207867770] / [Parameters].[Parameter 1] * 30' />
      </column>
      <column caption='Is Retire Candidate' datatype='boolean' name='[Calculation_1477962250728433097]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Is Retire Candidate&#13;&#10;// Under 10 uses per 30 days AND over $5 per use (or no use at all), declared products only&#13;&#10;// (thresholds from generator/config.yaml). Check: only Web Funnel Analysis.&#13;&#10;[Calculation_1750303070460088850] &lt; 10&#13;&#10;AND (ISNULL([Calculation_2256908730979128074]) OR [Calculation_2256908730979128074] &gt; 5)&#13;&#10;AND ATTR([is_declared])' />
      </column>
      <column caption='Scatter Colour Key' datatype='string' name='[Calculation_1682376588086171483]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Scatter Colour Key&#13;&#10;// Retire candidate #D2453F, Unregistered #E8A33D, AI-built #5B5FC7, Built by hand #005FAE.&#13;&#10;IF [Calculation_1477962250728433097] THEN &quot;Retire candidate&quot;&#13;&#10;ELSEIF NOT ATTR([is_declared]) THEN &quot;Unregistered&quot;&#13;&#10;ELSEIF ATTR([build_method]) = &quot;ai_assisted&quot; THEN &quot;AI-built&quot;&#13;&#10;ELSE &quot;Built by hand&quot;&#13;&#10;END' />
      </column>
      <column caption='Scatter Label' datatype='string' name='[Calculation_8863144114571249906]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Scatter Label&#13;&#10;// Labels only the retire candidates, unregistered readers and the most used product, as in the prototype.&#13;&#10;// Table calc: compute using exposure_id.&#13;&#10;IF [Calculation_1477962250728433097]&#13;&#10;    OR NOT ATTR([is_declared])&#13;&#10;    OR [Calculation_1159284100207867770] = WINDOW_MAX([Calculation_1159284100207867770])&#13;&#10;    THEN REPLACE(ATTR([display_name]), &quot;Unregistered: &quot;, &quot;&quot;)&#13;&#10;END'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[node_id (dim_nodes.csv)]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Is Declared Consumer Type View' datatype='boolean' name='[Calculation_5318034218639341289]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Declared Consumer Type View&#13;&#10;// Small multiple filter: declared products counted in views.&#13;&#10;[consumption_type (mart_exposure_daily.csv)] = &quot;view&quot;&#13;&#10;AND [is_declared]' />
      </column>
      <column caption='Uses In Period (Type)' datatype='real' name='[Calculation_1813047203116692796]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Uses In Period (Type)&#13;&#10;// Total shown at the top right of each small multiple (put on Detail and reference it in the title).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [events] END)' />
      </column>
      <column caption='US Type Total Text' datatype='string' name='[Calculation_1169681039857698251]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// US Type Total Text&#13;&#10;// Total at the top right of a small multiple, as the prototype writes it: &quot;12.3K&quot;, &quot;418&quot;.&#13;&#10;IF [Calculation_1813047203116692796] &gt;= 1000 THEN STR(ROUND([Calculation_1813047203116692796] / 1000, 1)) + &quot;K&quot;&#13;&#10;ELSE STR(INT([Calculation_1813047203116692796])) END' />
      </column>
      <column caption='Is Declared Consumer Type Query' datatype='boolean' name='[Calculation_5057544808602958082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Declared Consumer Type Query&#13;&#10;// Small multiple filter: declared products counted in queries.&#13;&#10;[consumption_type (mart_exposure_daily.csv)] = &quot;query&quot;&#13;&#10;AND [is_declared]' />
      </column>
      <column caption='Is Declared Consumer Type App Session' datatype='boolean' name='[Calculation_2089370070531572526]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Declared Consumer Type App Session&#13;&#10;// Small multiple filter: declared products counted in sessions.&#13;&#10;[consumption_type (mart_exposure_daily.csv)] = &quot;app_session&quot;&#13;&#10;AND [is_declared]' />
      </column>
      <column caption='Is Declared Consumer Type Agent Call' datatype='boolean' name='[Calculation_1959924681003229914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Declared Consumer Type Agent Call&#13;&#10;// Small multiple filter: declared products counted in calls.&#13;&#10;[consumption_type (mart_exposure_daily.csv)] = &quot;agent_call&quot;&#13;&#10;AND [is_declared]' />
      </column>
      <column caption='Is US Ranked Heading Row' datatype='boolean' name='[Calculation_2749339455271264329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is US Ranked Heading Row&#13;&#10;// One date row per column title. Put on Filters (True).&#13;&#10;[day_index] &lt; 7' />
      </column>
      <column caption='US Ranked Heading' datatype='string' name='[Calculation_3266799929369922666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// US Ranked Heading&#13;&#10;// Column titles, one date row each.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;DATA PRODUCT&quot;&#13;&#10;WHEN 1 THEN &quot;TYPE&quot;&#13;&#10;WHEN 2 THEN &quot;BUILT&quot;&#13;&#10;WHEN 3 THEN &quot;USES&quot;&#13;&#10;WHEN 4 THEN &quot;CHANGE&quot;&#13;&#10;WHEN 5 THEN &quot;CONSUMERS&quot;&#13;&#10;WHEN 6 THEN &quot;COST/USE&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='US Ranked Heading Point' datatype='spatial' name='[Calculation_2072025500493383909]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// US Ranked Heading Point&#13;&#10;// Middle of a column title (measured by the build).&#13;&#10;MAKEPOINT(0, (CASE [day_index]&#13;&#10;WHEN 0 THEN 44.6&#13;&#10;WHEN 1 THEN 164.4&#13;&#10;WHEN 2 THEN 220.9&#13;&#10;WHEN 3 THEN 326.1&#13;&#10;WHEN 4 THEN 368.2&#13;&#10;WHEN 5 THEN 428.0&#13;&#10;WHEN 6 THEN 491.4&#13;&#10;ELSE 0&#13;&#10;END - 299.5) / 100)' />
      </column>
