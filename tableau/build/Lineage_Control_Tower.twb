            <column caption='Runtime Trend Now' datatype='real' name='[Calculation_3083874683594051399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Runtime Trend Now&#13;&#10;// 7-day vs prior 28-day runtime change on the last day (19 Oct), as a fraction. Format ▲ 0%;▼ 0%.&#13;&#10;// Needs runtime_trend_pct typed as Number (decimal) in the data source.&#13;&#10;MAX(IF [days_before_as_of] = 0 THEN [runtime_trend_pct] END)' />
            </column>
            <column caption='Runtime Change Up Text' datatype='string' name='[Calculation_2072871993879220877]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Runtime Change Up Text&#13;&#10;// &quot;▲ 30%&quot; in red: runtime up more than 25% (7 days against the 28 before).&#13;&#10;IF [Calculation_3083874683594051399] &gt; 0.25 THEN &quot;▲ &quot; + STR(ROUND([Calculation_3083874683594051399] * 100)) + &quot;%&quot; END' />
            </column>
            <column caption='Runtime Change Down Text' datatype='string' name='[Calculation_9094679087243904666]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Runtime Change Down Text&#13;&#10;// &quot;▼ 30%&quot; in green: runtime down more than 25%.&#13;&#10;IF [Calculation_3083874683594051399] &lt; -0.25 THEN &quot;▼ &quot; + STR(ROUND(-[Calculation_3083874683594051399] * 100)) + &quot;%&quot; END' />
            </column>
            <column caption='Runtime Change Flat Text' datatype='string' name='[Calculation_2647206799758291440]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Runtime Change Flat Text&#13;&#10;// &quot;▲ 3%&quot; in ink: within 25% either way.&#13;&#10;IF ABS([Calculation_3083874683594051399]) &lt;= 0.25&#13;&#10;    THEN IF [Calculation_3083874683594051399] &gt;= 0 THEN &quot;▲ &quot; ELSE &quot;▼ &quot; END + STR(ROUND(ABS([Calculation_3083874683594051399]) * 100)) + &quot;%&quot; END' />
            </column>
            <column caption='PF Trend Point' datatype='spatial' name='[Calculation_1636667861724742913]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Trend Point&#13;&#10;// 7d vs 28d: the label ends here.&#13;&#10;MAKEPOINT(0, (432.0 - 365) / 100)' />
            </column>
            <column caption='PF Rows Text' datatype='string' name='[Calculation_1036172898290230613]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Rows Text&#13;&#10;// Largest build in rows, as the prototype writes it: &quot;60.9M&quot;.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_inventory_daily&quot; THEN &quot;7.7M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_order_items&quot; THEN &quot;13.8M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_orders&quot; THEN &quot;5.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_partner_payouts&quot; THEN &quot;77.7K&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_payments&quot; THEN &quot;3.7M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_revenue_daily&quot; THEN &quot;63.1K&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_shipments&quot; THEN &quot;4.7M&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_store_sales&quot; THEN &quot;2.6M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_customers__deduped&quot; THEN &quot;2.2M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_inventory__snapshots&quot; THEN &quot;3.2M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_orders__enriched&quot; THEN &quot;5.1M&quot;&#13;&#10;WHEN &quot;model.acme_core.int_payments__reconciled&quot; THEN &quot;3.8M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.dim_companies&quot; THEN &quot;37.6K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.dim_contacts&quot; THEN &quot;775.7K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_ad_spend_daily&quot; THEN &quot;116.6K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_attribution&quot; THEN &quot;2.5M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_campaign_performance&quot; THEN &quot;497.7K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_marketing_roi&quot; THEN &quot;14.6K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_pipeline&quot; THEN &quot;102.8K&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__attribution&quot; THEN &quot;2.5M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__unified&quot; THEN &quot;4.0M&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_campaigns__spend_daily&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_contacts__lifecycle&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_deals__pipeline&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__ad_stats&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__campaigns&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deal_stages&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deals&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_meta_ads__ad_insights&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.dim_customer_behavior&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_app_engagement&quot; THEN &quot;30.4K&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_churn_features&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_demand_signals&quot; THEN &quot;4.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_experiment_results&quot; THEN &quot;5.5K&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_funnel_daily&quot; THEN &quot;10.9K&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_sessions&quot; THEN &quot;60.9M&quot;&#13;&#10;WHEN &quot;model.acme_product.int_app__engagement&quot; THEN &quot;25.5M&quot;&#13;&#10;WHEN &quot;model.acme_product.int_customer_behavior&quot; THEN &quot;2.1M&quot;&#13;&#10;WHEN &quot;model.acme_product.int_funnel__steps&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.int_sessions__stitched&quot; THEN &quot;58.2M&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_events&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_installs&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__page_views&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__search_events&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__web_sessions&quot; THEN &quot;-&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='PF Rows Point' datatype='spatial' name='[Calculation_1382265748193917292]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Rows Point&#13;&#10;// Largest build, right-aligned at its column.&#13;&#10;MAKEPOINT(0, (CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_inventory_daily&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_order_items&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_core.fct_orders&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_partner_payouts&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_core.fct_payments&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_revenue_daily&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_core.fct_shipments&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.fct_store_sales&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_customers__deduped&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_inventory__snapshots&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_orders__enriched&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_core.int_payments__reconciled&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.dim_companies&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_marketing.dim_contacts&quot; THEN 503.2&#13;&#10;WHEN &quot;model.acme_marketing.fct_ad_spend_daily&quot; THEN 503.6&#13;&#10;WHEN &quot;model.acme_marketing.fct_attribution&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.fct_campaign_performance&quot; THEN 503.2&#13;&#10;WHEN &quot;model.acme_marketing.fct_marketing_roi&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_marketing.fct_pipeline&quot; THEN 503.2&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__attribution&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__unified&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_marketing.int_campaigns__spend_daily&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.int_contacts__lifecycle&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.int_deals__pipeline&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__ad_stats&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__campaigns&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deals&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_marketing.stg_meta_ads__ad_insights&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.dim_customer_behavior&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.fct_app_engagement&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_product.fct_churn_features&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.fct_demand_signals&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.fct_experiment_results&quot; THEN 509.1&#13;&#10;WHEN &quot;model.acme_product.fct_funnel_daily&quot; THEN 506.1&#13;&#10;WHEN &quot;model.acme_product.fct_sessions&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_product.int_app__engagement&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_product.int_customer_behavior&quot; THEN 508.2&#13;&#10;WHEN &quot;model.acme_product.int_funnel__steps&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.int_sessions__stitched&quot; THEN 505.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_events&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_installs&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__page_views&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__search_events&quot; THEN 518.2&#13;&#10;WHEN &quot;model.acme_product.stg_events__web_sessions&quot; THEN 518.2&#13;&#10;ELSE 0&#13;&#10;END - 365) / 100)' />
            </column>
            <column caption='PF Cost Point' datatype='spatial' name='[Calculation_1392208467928993943]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Cost Point&#13;&#10;// Cost: the label ends here.&#13;&#10;MAKEPOINT(0, (584.0 - 365) / 100)' />
