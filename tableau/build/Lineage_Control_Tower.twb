      <column caption='Lineage Label Point' datatype='spatial' name='[Calculation_2283752602737777214]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Lineage Label Point&#13;&#10;// Middle of a box name: 16 px in from the box edge plus half the name&apos;s width.&#13;&#10;IF [row_type] = &quot;node&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([y]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END))) / 100,&#13;&#10;    (((8 + ([x]) * 151.833) + 16 + [Calculation_8207042615384186710] / 2) - 463.5) / 100&#13;&#10;) END' />
      </column>
      <column caption='Lineage View Option' datatype='string' name='[Calculation_3302216381930638508]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Lineage View Option&#13;&#10;// Scaffold for the Graph / Table buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;Graph&quot;&#13;&#10;WHEN 1 THEN &quot;Table&quot;&#13;&#10;END' />
      </column>
