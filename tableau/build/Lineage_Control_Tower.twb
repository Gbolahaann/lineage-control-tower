            <column caption='Failed Model Runs' datatype='integer' name='[Calculation_1556808545805540049]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Failed Model Runs&#13;&#10;// Count of failed model runs. 30d check: 50 (18 compilation, 17 database, 9 permission, 6 timeout).&#13;&#10;COUNT([job_run_id])' />
            </column>
            <column caption='Top Model Track' datatype='real' name='[Calculation_1053829186246530949]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Top Model Track&#13;&#10;// Same for the top-models bars. Table calc along display_name.&#13;&#10;WINDOW_MAX([Calculation_1556808545805540049]) * 1.14'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Is Platform Match Error' datatype='boolean' name='[Calculation_1475933581110583641]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Error&#13;&#10;// Platform filter for Run Errors: the platform the model ran on when it failed.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform (mart_run_errors.csv)] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Is Top Failing Model' datatype='boolean' name='[Calculation_2758321348733286171]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Is Top Failing Model&#13;&#10;// The 7 models that failed most. Table calc filter (True), along display_name.&#13;&#10;RANK_UNIQUE([Calculation_1556808545805540049]) &lt;= 7'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
              </calculation>
