      <column caption='GOV Domain Fair Text' datatype='string' name='[Calculation_2072023923269927093]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Fair Text&#13;&#10;// Fair texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;87%&quot;&#13;&#10;WHEN &quot;All|4&quot; THEN &quot;75%&quot;&#13;&#10;WHEN &quot;All|7&quot; THEN &quot;78%&quot;&#13;&#10;WHEN &quot;All|17&quot; THEN &quot;74%&quot;&#13;&#10;WHEN &quot;All|18&quot; THEN &quot;74%&quot;&#13;&#10;WHEN &quot;All|22&quot; THEN &quot;82%&quot;&#13;&#10;WHEN &quot;All|23&quot; THEN &quot;73%&quot;&#13;&#10;WHEN &quot;All|24&quot; THEN &quot;83%&quot;&#13;&#10;WHEN &quot;All|27&quot; THEN &quot;79%&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;87%&quot;&#13;&#10;WHEN &quot;snowflake|4&quot; THEN &quot;75%&quot;&#13;&#10;WHEN &quot;snowflake|17&quot; THEN &quot;74%&quot;&#13;&#10;WHEN &quot;snowflake|18&quot; THEN &quot;74%&quot;&#13;&#10;WHEN &quot;snowflake|22&quot; THEN &quot;80%&quot;&#13;&#10;WHEN &quot;snowflake|23&quot; THEN &quot;70%&quot;&#13;&#10;WHEN &quot;snowflake|24&quot; THEN &quot;80%&quot;&#13;&#10;WHEN &quot;databricks|2&quot; THEN &quot;75%&quot;&#13;&#10;WHEN &quot;databricks|12&quot; THEN &quot;79%&quot;&#13;&#10;WHEN &quot;redshift|2&quot; THEN &quot;74%&quot;&#13;&#10;WHEN &quot;redshift|3&quot; THEN &quot;74%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
