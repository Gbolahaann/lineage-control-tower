)&#13;&#10;WHEN &quot;90|redshift|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 2.4631)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Unreg Likely Point' datatype='spatial' name='[Calculation_3024394703894142065]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Unreg Likely Point&#13;&#10;// Where the likely cell sits.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [principal]&#13;&#10;WHEN &quot;7|All|svc_shared_analytics&quot; THEN MAKEPOINT(0.0000, 3.4037)&#13;&#10;WHEN &quot;7|All|r.alvarez@acme-retail.example&quot; THEN MAKEPOINT(0.0000, 3.5898)&#13;&#10;WHEN &quot;7|All|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;7|snowflake|svc_shared_analytics&quot; THEN MAKEPOINT(0.0000, 3.4037)&#13;&#10;WHEN &quot;7|snowflake|r.alvarez@acme-retail.example&quot; THEN MAKEPOINT(0.0000, 3.5898)&#13;&#10;WHEN &quot;7|snowflake|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;7|redshift|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;30|All|svc_shared_analytics&quot; THEN MAKEPOINT(0.0000, 3.4037)&#13;&#10;WHEN &quot;30|All|r.alvarez@acme-retail.example&quot; THEN MAKEPOINT(0.0000, 3.5898)&#13;&#10;WHEN &quot;30|All|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;30|snowflake|svc_shared_analytics&quot; THEN MAKEPOINT(0.0000, 3.4037)&#13;&#10;WHEN &quot;30|snowflake|r.alvarez@acme-retail.example&quot; THEN MAKEPOINT(0.0000, 3.5898)&#13;&#10;WHEN &quot;30|snowflake|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;30|redshift|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;90|All|svc_shared_analytics&quot; THEN MAKEPOINT(0.0000, 3.4037)&#13;&#10;WHEN &quot;90|All|r.alvarez@acme-retail.example&quot; THEN MAKEPOINT(0.0000, 3.5898)&#13;&#10;WHEN &quot;90|All|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;90|snowflake|svc_shared_analytics&quot; THEN MAKEPOINT(0.0000, 3.4037)&#13;&#10;WHEN &quot;90|snowflake|r.alvarez@acme-retail.example&quot; THEN MAKEPOINT(0.0000, 3.5898)&#13;&#10;WHEN &quot;90|snowflake|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;WHEN &quot;90|redshift|svc_jobs_runner&quot; THEN MAKEPOINT(0.0000, 3.5750)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Subtitle' datatype='string' name='[Calculation_2193766285080535837]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Subtitle&#13;&#10;// Card subtitle (written by the build per platform).&#13;&#10;CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;All&quot; THEN &quot;5 AI-assisted dashboards, 5 of them on pds_finance_revenue&quot;&#13;&#10;WHEN &quot;snowflake&quot; THEN &quot;5 AI-assisted dashboards, 5 of them on pds_finance_revenue&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;0 AI-assisted dashboards&quot;&#13;&#10;WHEN &quot;redshift&quot; THEN &quot;0 AI-assisted dashboards&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Order' datatype='integer' name='[Calculation_3307777296963834059]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// GOV Sprawl Order&#13;&#10;// In catalogue order (the prototype&apos;s).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN 0&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN 1&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN 2&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN 3&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN 4&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Is GOV Sprawl Row' datatype='boolean' name='[Calculation_1804279518985990444]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is GOV Sprawl Row&#13;&#10;// AI-assisted dashboards under the platform filter. Put on Filters (True).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;All|exposure.acme_core.revenue_overview_ai&quot; THEN TRUE&#13;&#10;WHEN &quot;All|exposure.acme_core.revenue_by_channel_v2&quot; THEN TRUE&#13;&#10;WHEN &quot;All|exposure.acme_core.daily_sales_snapshot&quot; THEN TRUE&#13;&#10;WHEN &quot;All|exposure.acme_core.revenue_dashboard_copy&quot; THEN TRUE&#13;&#10;WHEN &quot;All|exposure.acme_core.q3_sales_summary_ai&quot; THEN TRUE&#13;&#10;WHEN &quot;snowflake|exposure.acme_core.revenue_overview_ai&quot; THEN TRUE&#13;&#10;WHEN &quot;snowflake|exposure.acme_core.revenue_by_channel_v2&quot; THEN TRUE&#13;&#10;WHEN &quot;snowflake|exposure.acme_core.daily_sales_snapshot&quot; THEN TRUE&#13;&#10;WHEN &quot;snowflake|exposure.acme_core.revenue_dashboard_copy&quot; THEN TRUE&#13;&#10;WHEN &quot;snowflake|exposure.acme_core.q3_sales_summary_ai&quot; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Row Point' datatype='spatial' name='[Calculation_2802805299369934297]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Row Point&#13;&#10;// The row (takes the click).&#13;&#10;MAKEPOINT(&#13;&#10;    (0.5 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 22 + 0 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((0) + (390) / 2) + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((390) / 2 - 0) + 0 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22))) - 195) / 100&#13;&#10;)' />
      </column>
      <column caption='GOV Sprawl Name Text' datatype='string' name='[Calculation_2830010191814113027]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Name Text&#13;&#10;// Dashboard name, bold.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN &quot;Revenue Overview (AI)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;Revenue by Channel v2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;Daily Sales Snapshot&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;Revenue Dashboard (copy)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;Q3 Sales Summary (AI)&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Divider Point' datatype='spatial' name='[Calculation_2800316542371111446]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Divider Point&#13;&#10;// Line under each row.&#13;&#10;MAKEPOINT(&#13;&#10;    (-22 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0.5 + 0 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((0) + (390) / 2) + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((390) / 2 - 0) + 0 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22))) - 195) / 100&#13;&#10;)' />
      </column>
      <column caption='GOV Sprawl Name Point' datatype='spatial' name='[Calculation_1830332947383741616]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Name Point&#13;&#10;// Name, first line, left.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN MAKEPOINT(0.0850, -1.2943)&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN MAKEPOINT(0.0850, -1.2737)&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN MAKEPOINT(0.0850, -1.3327)&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN MAKEPOINT(0.0850, -1.1822)&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN MAKEPOINT(0.0850, -1.2854)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Meta Text' datatype='string' name='[Calculation_3110578940140778655]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Meta Text&#13;&#10;// Owner, created date and maturity, grey.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN &quot;Liam Chen · created 7 Sep · maturity low&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;Amara Okafor · created 14 Sep · maturity low&quot;&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;Daniel Kim · created 22 Sep · maturity low&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;Kwame Mensah · created 1 Oct · maturity low&quot;&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;Tomas Ortega · created 8 Oct · maturity low&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Meta Point' datatype='spatial' name='[Calculation_1491768506341199243]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Meta Point&#13;&#10;// Meta, second line, left.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN MAKEPOINT(-0.0850, -1.0180)&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN MAKEPOINT(-0.0850, -0.9269)&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN MAKEPOINT(-0.0850, -0.9920)&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN MAKEPOINT(-0.0850, -0.9191)&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN MAKEPOINT(-0.0850, -0.9608)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Views Text' datatype='string' name='[Calculation_2974949616835524813]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Views Text&#13;&#10;// Views in the period.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_overview_ai&quot; THEN &quot;3 views&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;3 views&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;17 views&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;42 views&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;89 views&quot;&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_overview_ai&quot; THEN &quot;74 views&quot;&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;184 views&quot;&#13;&#10;WHEN &quot;30|exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;320 views&quot;&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;411 views&quot;&#13;&#10;WHEN &quot;30|exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;183 views&quot;&#13;&#10;WHEN &quot;90|exposure.acme_core.revenue_overview_ai&quot; THEN &quot;347 views&quot;&#13;&#10;WHEN &quot;90|exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;330 views&quot;&#13;&#10;WHEN &quot;90|exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;320 views&quot;&#13;&#10;WHEN &quot;90|exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;411 views&quot;&#13;&#10;WHEN &quot;90|exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;183 views&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Up Text' datatype='string' name='[Calculation_1927346583381575149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Up Text&#13;&#10;// Rise against the period before, green.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;  ▲ 26%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Down Text' datatype='string' name='[Calculation_1927102532023578932]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Down Text&#13;&#10;// Fall, red.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_overview_ai&quot; THEN &quot;  ▼ 67%&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;  ▼ 73%&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;  ▼ 64%&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;  ▼ 58%&quot;&#13;&#10;WHEN &quot;7|exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;  ▼ 5%&quot;&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_overview_ai&quot; THEN &quot;  ▼ 73%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Sprawl Views Point' datatype='spatial' name='[Calculation_9511753646447410911]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Sprawl Views Point&#13;&#10;// Views and change, right, first line.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_overview_ai&quot; THEN MAKEPOINT(0.0850, 1.5297)&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_by_channel_v2&quot; THEN MAKEPOINT(0.0850, 1.5297)&#13;&#10;WHEN &quot;7|exposure.acme_core.daily_sales_snapshot&quot; THEN MAKEPOINT(0.0850, 1.5002)&#13;&#10;WHEN &quot;7|exposure.acme_core.revenue_dashboard_copy&quot; THEN MAKEPOINT(0.0850, 1.5002)&#13;&#10;WHEN &quot;7|exposure.acme_core.q3_sales_summary_ai&quot; THEN MAKEPOINT(0.0850, 1.5297)&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_overview_ai&quot; THEN MAKEPOINT(0.0850, 1.5002)&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_by_channel_v2&quot; THEN MAKEPOINT(0.0850, 1.4706)&#13;&#10;WHEN &quot;30|exposure.acme_core.daily_sales_snapshot&quot; THEN MAKEPOINT(0.0850, 1.6738)&#13;&#10;WHEN &quot;30|exposure.acme_core.revenue_dashboard_copy&quot; THEN MAKEPOINT(0.0850, 1.6777)&#13;&#10;WHEN &quot;30|exposure.acme_core.q3_sales_summary_ai&quot; THEN MAKEPOINT(0.0850, 1.6738)&#13;&#10;WHEN &quot;90|exposure.acme_core.revenue_overview_ai&quot; THEN MAKEPOINT(0.0850, 1.6738)&#13;&#10;WHEN &quot;90|exposure.acme_core.revenue_by_channel_v2&quot; THEN MAKEPOINT(0.0850, 1.6738)&#13;&#10;WHEN &quot;90|exposure.acme_core.daily_sales_snapshot&quot; THEN MAKEPOINT(0.0850, 1.6738)&#13;&#10;WHEN &quot;90|exposure.acme_core.revenue_dashboard_copy&quot; THEN MAKEPOINT(0.0850, 1.6777)&#13;&#10;WHEN &quot;90|exposure.acme_core.q3_sales_summary_ai&quot; THEN MAKEPOINT(0.0850, 1.6738)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Domain Heading' datatype='string' name='[Calculation_3170188258222030970]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Heading&#13;&#10;// Column titles, one date row each.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;DOMAIN&quot;&#13;&#10;WHEN 1 THEN &quot;MODELS&quot;&#13;&#10;WHEN 2 THEN &quot;DOCS&quot;&#13;&#10;WHEN 3 THEN &quot;TESTS&quot;&#13;&#10;WHEN 4 THEN &quot;OWNED&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Domain Heading Point' datatype='spatial' name='[Calculation_2612976522888255764]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Heading Point&#13;&#10;// Middle of a column title (measured by the build).&#13;&#10;MAKEPOINT(0, (CASE [day_index]&#13;&#10;WHEN 0 THEN 27.0&#13;&#10;WHEN 1 THEN 129.9&#13;&#10;WHEN 2 THEN 227.0&#13;&#10;WHEN 3 THEN 297.0&#13;&#10;WHEN 4 THEN 367.0&#13;&#10;ELSE 0&#13;&#10;END - 195) / 100)' />
      </column>
      <column caption='GOV Domain Line Rect Point' datatype='spatial' name='[Calculation_2947504494406258327]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Line Rect Point&#13;&#10;// Rectangles of the scene, 4 date rows each (written by the build).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.6100, -1.9500)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.6100, 1.9500)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.6000, 1.9500)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(0.6000, -1.9500)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(0.3100, -1.9500)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(0.3100, 1.9500)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(0.3000, 1.9500)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(0.3000, -1.9500)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(0.0100, -1.9500)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(0.0100, 1.9500)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(0.0000, 1.9500)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(0.0000, -1.9500)&#13;&#10;WHEN &quot;All|12&quot; THEN MAKEPOINT(-0.2900, -1.9500)&#13;&#10;WHEN &quot;All|13&quot; THEN MAKEPOINT(-0.2900, 1.9500)&#13;&#10;WHEN &quot;All|14&quot; THEN MAKEPOINT(-0.3000, 1.9500)&#13;&#10;WHEN &quot;All|15&quot; THEN MAKEPOINT(-0.3000, -1.9500)&#13;&#10;WHEN &quot;All|16&quot; THEN MAKEPOINT(-0.5900, -1.9500)&#13;&#10;WHEN &quot;All|17&quot; THEN MAKEPOINT(-0.5900, 1.9500)&#13;&#10;WHEN &quot;All|18&quot; THEN MAKEPOINT(-0.6000, 1.9500)&#13;&#10;WHEN &quot;All|19&quot; THEN MAKEPOINT(-0.6000, -1.9500)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.6100, -1.9500)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.6100, 1.9500)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.6000, 1.9500)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(0.6000, -1.9500)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(0.3100, -1.9500)&#13;&#10;WHEN &quot;snowflake|5&quot; THEN MAKEPOINT(0.3100, 1.9500)&#13;&#10;WHEN &quot;snowflake|6&quot; THEN MAKEPOINT(0.3000, 1.9500)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(0.3000, -1.9500)&#13;&#10;WHEN &quot;snowflake|8&quot; THEN MAKEPOINT(0.0100, -1.9500)&#13;&#10;WHEN &quot;snowflake|9&quot; THEN MAKEPOINT(0.0100, 1.9500)&#13;&#10;WHEN &quot;snowflake|10&quot; THEN MAKEPOINT(0.0000, 1.9500)&#13;&#10;WHEN &quot;snowflake|11&quot; THEN MAKEPOINT(0.0000, -1.9500)&#13;&#10;WHEN &quot;snowflake|12&quot; THEN MAKEPOINT(-0.2900, -1.9500)&#13;&#10;WHEN &quot;snowflake|13&quot; THEN MAKEPOINT(-0.2900, 1.9500)&#13;&#10;WHEN &quot;snowflake|14&quot; THEN MAKEPOINT(-0.3000, 1.9500)&#13;&#10;WHEN &quot;snowflake|15&quot; THEN MAKEPOINT(-0.3000, -1.9500)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.6100, -1.9500)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.6100, 1.9500)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(0.6000, 1.9500)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(0.6000, -1.9500)&#13;&#10;WHEN &quot;databricks|4&quot; THEN MAKEPOINT(0.3100, -1.9500)&#13;&#10;WHEN &quot;databricks|5&quot; THEN MAKEPOINT(0.3100, 1.9500)&#13;&#10;WHEN &quot;databricks|6&quot; THEN MAKEPOINT(0.3000, 1.9500)&#13;&#10;WHEN &quot;databricks|7&quot; THEN MAKEPOINT(0.3000, -1.9500)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Domain Line Rect Id' datatype='integer' name='[Calculation_1701095157185660351]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// GOV Domain Line Rect Id&#13;&#10;// Which rectangle a date row draws.&#13;&#10;INT([day_index] / 4)' />
      </column>
      <column caption='GOV Domain Rect Key' datatype='string' name='[Calculation_2302549258654506414]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Rect Key&#13;&#10;// Rectangle colour.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR(INT([day_index] / 4))&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|3&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|4&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;All|5&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;All|6&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;All|7&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;All|8&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;All|9&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|10&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|11&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;All|12&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|13&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|14&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|15&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;All|16&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;All|17&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;snowflake|3&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|4&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|5&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|6&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|7&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|8&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;snowflake|9&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;snowflake|10&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;snowflake|11&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;snowflake|12&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;snowflake|13&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;snowflake|14&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;databricks|2&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;databricks|3&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;databricks|4&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;databricks|5&quot; THEN &quot;Good&quot;&#13;&#10;WHEN &quot;databricks|6&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;databricks|7&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;databricks|8&quot; THEN &quot;Poor&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;Fair&quot;&#13;&#10;WHEN &quot;redshift|1&quot; THEN &quot;Fair&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
