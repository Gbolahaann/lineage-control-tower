          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Incident Tick' datatype='real' name='[Calculation_1447918477104689102]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Incident Tick&#13;&#10;// Grey tick under an incident label, on days an incident started.&#13;&#10;IF COUNT([incident_id]) &gt; 0 THEN 22 END' />
            </column>
            <column caption='Incident Label Anchor' datatype='real' name='[Calculation_3308085721278344582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Incident Label Anchor&#13;&#10;// Point the &quot;INC 4&quot; label sits above (label vertical alignment top).&#13;&#10;IF COUNT([incident_id]) &gt; 0 THEN 24 END' />
            </column>
            <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
            </column>
            <column caption='Incident Marker Label' datatype='string' name='[Calculation_1454750851671812728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Incident Marker Label&#13;&#10;// &quot;INC 4&quot; above the day an incident started, as in the prototype.&#13;&#10;REPLACE([incident_id], &quot;INC-00&quot;, &quot;INC &quot;)' />
