        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_4452841432140642752:qk]' field-type='quantitative' fold='true' scope='rows' synchronized='true' type='space' />
            <format attr='display' class='0' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:date (dim_date.csv):qk]' scope='cols' value='false' />
            <format attr='display' class='0' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_5039955109046369523:qk]' scope='rows' value='false' />
            <format attr='display' class='0' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_4452841432140642752:qk]' scope='rows' value='false' />
            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='cell'>
