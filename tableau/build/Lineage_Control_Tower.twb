          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Axis Date Label' datatype='string' name='[Calculation_2516393983253929826]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Axis Date Label&#13;&#10;// &quot;22 Jul&quot;, &quot;1 Aug&quot; ... under the 90-day charts: the first day and every 1st of the month.&#13;&#10;IF [day_index] = 0 OR DAY([date (dim_date.csv)]) = 1&#13;&#10;THEN STR(DAY([date (dim_date.csv)])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [date (dim_date.csv)]), 3)&#13;&#10;END' />
            </column>
            <column caption='Compliance Axis Anchor' datatype='real' name='[Calculation_3974338510023223291]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Compliance Axis Anchor&#13;&#10;// Date labels under the compliance chart (its 90 % to 100 % scale).&#13;&#10;IF NOT ISNULL(MIN([Calculation_2516393983253929826])) THEN 0.9950 END' />
            </column>
            <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
            </column>
            <column caption='Date (Dates)' datatype='date' name='[date (dim_date.csv)]' role='dimension' type='ordinal' />
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
