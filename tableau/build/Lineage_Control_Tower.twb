    <worksheet name='GOV Maturity Bar'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='GOV Maturity Rect Key' datatype='string' name='[Calculation_5448684144314486562]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity Rect Key&#13;&#10;// Rectangle colour.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR(INT([day_index] / 4))&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;High&quot;&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;Medium&quot;&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;Low&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;High&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;Medium&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;Low&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Medium&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;Low&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Maturity Rect Point' datatype='spatial' name='[Calculation_3021839753373122621]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity Rect Point&#13;&#10;// Rectangles of the scene, 4 date rows each (written by the build).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.1000, -1.9400)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.1000, -0.9489)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(-0.1000, -0.9489)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(-0.1000, -1.9400)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(0.1000, -0.9289)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(0.1000, 0.6400)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(-0.1000, 0.6400)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(-0.1000, -0.9289)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(0.1000, 0.6600)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(0.1000, 1.9400)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(-0.1000, 1.9400)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(-0.1000, 0.6600)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.1000, -1.9400)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.1000, -0.6600)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(-0.1000, -0.6600)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(-0.1000, -1.9400)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(0.1000, -0.6400)&#13;&#10;WHEN &quot;snowflake|5&quot; THEN MAKEPOINT(0.1000, 0.4543)&#13;&#10;WHEN &quot;snowflake|6&quot; THEN MAKEPOINT(-0.1000, 0.4543)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(-0.1000, -0.6400)&#13;&#10;WHEN &quot;snowflake|8&quot; THEN MAKEPOINT(0.1000, 0.4743)&#13;&#10;WHEN &quot;snowflake|9&quot; THEN MAKEPOINT(0.1000, 1.9400)&#13;&#10;WHEN &quot;snowflake|10&quot; THEN MAKEPOINT(-0.1000, 1.9400)&#13;&#10;WHEN &quot;snowflake|11&quot; THEN MAKEPOINT(-0.1000, 0.4743)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.1000, -1.9400)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.1000, 1.2900)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(-0.1000, 1.2900)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(-0.1000, -1.9400)&#13;&#10;WHEN &quot;databricks|4&quot; THEN MAKEPOINT(0.1000, 1.3100)&#13;&#10;WHEN &quot;databricks|5&quot; THEN MAKEPOINT(0.1000, 1.9400)&#13;&#10;WHEN &quot;databricks|6&quot; THEN MAKEPOINT(-0.1000, 1.9400)&#13;&#10;WHEN &quot;databricks|7&quot; THEN MAKEPOINT(-0.1000, 1.3100)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Maturity Rect Id' datatype='integer' name='[Calculation_1178769372579170359]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// GOV Maturity Rect Id&#13;&#10;// Which rectangle a date row draws.&#13;&#10;INT([day_index] / 4)' />
            </column>
            <column caption='GOV Maturity High Text' datatype='string' name='[Calculation_1379564157944384660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity High Text&#13;&#10;// High texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;High 7&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;High 7&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Maturity High Point' datatype='spatial' name='[Calculation_1688701287673531912]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity High Point&#13;&#10;// Where each high text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.0000, -1.4444)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.0000, -1.3000)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Maturity Medium Text' datatype='string' name='[Calculation_2565230626922315159]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity Medium Text&#13;&#10;// Medium texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;Medium 11&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;Medium 6&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Medium 5&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Maturity Medium Point' datatype='spatial' name='[Calculation_1035872354527681986]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity Medium Point&#13;&#10;// Where each medium text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.0000, -0.1444)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.0000, -0.0929)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.0000, -0.3250)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Maturity Low Text' datatype='string' name='[Calculation_1953433276022917392]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity Low Text&#13;&#10;// Low texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;Low 9&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;Low 8&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;Low 1&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Maturity Low Point' datatype='spatial' name='[Calculation_2316636795269700898]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Maturity Low Point&#13;&#10;// Where each low text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.0000, 1.3000)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.0000, 1.2071)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.0000, 1.6250)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5448684144314486562]' derivation='None' name='[none:Calculation_5448684144314486562:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_3021839753373122621]' derivation='Collect' name='[clct:Calculation_3021839753373122621:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1178769372579170359]' derivation='None' name='[none:Calculation_1178769372579170359:ok]' pivot='key' type='ordinal' />
            <column-instance column='[day_index]' derivation='None' name='[none:day_index:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1379564157944384660]' derivation='Attribute' name='[attr:Calculation_1379564157944384660:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1688701287673531912]' derivation='Collect' name='[clct:Calculation_1688701287673531912:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2565230626922315159]' derivation='Attribute' name='[attr:Calculation_2565230626922315159:nk]' pivot='key' type='nominal' />
