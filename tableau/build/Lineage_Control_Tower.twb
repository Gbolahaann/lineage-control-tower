      <column caption='GOV Domain Fair Point' datatype='spatial' name='[Calculation_2359397860978431030]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Fair Point&#13;&#10;// Where each fair text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.7600, 0.3200)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(0.7600, 1.7200)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(0.4600, 0.3200)&#13;&#10;WHEN &quot;All|17&quot; THEN MAKEPOINT(-0.1400, 0.3200)&#13;&#10;WHEN &quot;All|18&quot; THEN MAKEPOINT(-0.1400, 1.0200)&#13;&#10;WHEN &quot;All|22&quot; THEN MAKEPOINT(-0.4400, 0.3200)&#13;&#10;WHEN &quot;All|23&quot; THEN MAKEPOINT(-0.4400, 1.0200)&#13;&#10;WHEN &quot;All|24&quot; THEN MAKEPOINT(-0.4400, 1.7200)&#13;&#10;WHEN &quot;All|27&quot; THEN MAKEPOINT(-0.7400, 0.3200)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.7600, 0.3200)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(0.7600, 1.7200)&#13;&#10;WHEN &quot;snowflake|17&quot; THEN MAKEPOINT(-0.1400, 0.3200)&#13;&#10;WHEN &quot;snowflake|18&quot; THEN MAKEPOINT(-0.1400, 1.0200)&#13;&#10;WHEN &quot;snowflake|22&quot; THEN MAKEPOINT(-0.4400, 0.3200)&#13;&#10;WHEN &quot;snowflake|23&quot; THEN MAKEPOINT(-0.4400, 1.0200)&#13;&#10;WHEN &quot;snowflake|24&quot; THEN MAKEPOINT(-0.4400, 1.7200)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(0.7600, 0.3200)&#13;&#10;WHEN &quot;databricks|12&quot; THEN MAKEPOINT(0.1600, 0.3200)&#13;&#10;WHEN &quot;redshift|2&quot; THEN MAKEPOINT(0.7600, 0.3200)&#13;&#10;WHEN &quot;redshift|3&quot; THEN MAKEPOINT(0.7600, 1.0200)&#13;&#10;ELSE NULL&#13;&#10;END' />
