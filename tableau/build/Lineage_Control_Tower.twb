      <column caption='US Sem Avg Text' datatype='string' name='[Calculation_2149314611670896401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// US Sem Avg Text&#13;&#10;// Average refresh time: &quot;4.2 min&quot;, &quot;19s&quot;.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|semantic.tableau.pds_finance_revenue&quot; THEN &quot;1.2 min&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_commerce_sales&quot; THEN &quot;3.8 min&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_board_kpis&quot; THEN &quot;20s&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_finance_close&quot; THEN &quot;42s&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_web_funnel&quot; THEN &quot;8.3 min&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_sales_pipeline&quot; THEN &quot;20s&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_ops_monitor&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;7|semantic.sigma.sigma_customer_360&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;7|semantic.sigma.sigma_product_engagement&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_marketing&quot; THEN &quot;20s&quot;&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_inventory&quot; THEN &quot;1.1 min&quot;&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_support&quot; THEN &quot;20s&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_finance_revenue&quot; THEN &quot;1.2 min&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_commerce_sales&quot; THEN &quot;4.2 min&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_board_kpis&quot; THEN &quot;19s&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_finance_close&quot; THEN &quot;38s&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_web_funnel&quot; THEN &quot;7.8 min&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_sales_pipeline&quot; THEN &quot;20s&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_ops_monitor&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;30|semantic.sigma.sigma_customer_360&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;30|semantic.sigma.sigma_product_engagement&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_marketing&quot; THEN &quot;20s&quot;&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_inventory&quot; THEN &quot;1.0 min&quot;&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_support&quot; THEN &quot;19s&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_finance_revenue&quot; THEN &quot;1.1 min&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_commerce_sales&quot; THEN &quot;4.2 min&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_board_kpis&quot; THEN &quot;20s&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_finance_close&quot; THEN &quot;37s&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_web_funnel&quot; THEN &quot;8.0 min&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_sales_pipeline&quot; THEN &quot;19s&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_ops_monitor&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;90|semantic.sigma.sigma_customer_360&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;90|semantic.sigma.sigma_product_engagement&quot; THEN &quot;-&quot;&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_marketing&quot; THEN &quot;19s&quot;&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_inventory&quot; THEN &quot;59s&quot;&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_support&quot; THEN &quot;19s&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='US Sem Avg Point' datatype='spatial' name='[Calculation_1879220247853194202]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// US Sem Avg Point&#13;&#10;// Average refresh, right-aligned.&#13;&#10;MAKEPOINT(0, (CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|semantic.tableau.pds_finance_revenue&quot; THEN 390.9&#13;&#10;WHEN &quot;7|semantic.tableau.pds_commerce_sales&quot; THEN 390.9&#13;&#10;WHEN &quot;7|semantic.tableau.pds_board_kpis&quot; THEN 399.8&#13;&#10;WHEN &quot;7|semantic.tableau.pds_finance_close&quot; THEN 399.8&#13;&#10;WHEN &quot;7|semantic.tableau.pds_web_funnel&quot; THEN 390.9&#13;&#10;WHEN &quot;7|semantic.tableau.pds_sales_pipeline&quot; THEN 399.8&#13;&#10;WHEN &quot;7|semantic.tableau.pds_ops_monitor&quot; THEN 406.6&#13;&#10;WHEN &quot;7|semantic.sigma.sigma_customer_360&quot; THEN 406.6&#13;&#10;WHEN &quot;7|semantic.sigma.sigma_product_engagement&quot; THEN 406.6&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_marketing&quot; THEN 399.8&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_inventory&quot; THEN 390.9&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_support&quot; THEN 399.8&#13;&#10;WHEN &quot;30|semantic.tableau.pds_finance_revenue&quot; THEN 390.9&#13;&#10;WHEN &quot;30|semantic.tableau.pds_commerce_sales&quot; THEN 390.9&#13;&#10;WHEN &quot;30|semantic.tableau.pds_board_kpis&quot; THEN 399.8&#13;&#10;WHEN &quot;30|semantic.tableau.pds_finance_close&quot; THEN 399.8&#13;&#10;WHEN &quot;30|semantic.tableau.pds_web_funnel&quot; THEN 390.9&#13;&#10;WHEN &quot;30|semantic.tableau.pds_sales_pipeline&quot; THEN 399.8&#13;&#10;WHEN &quot;30|semantic.tableau.pds_ops_monitor&quot; THEN 406.6&#13;&#10;WHEN &quot;30|semantic.sigma.sigma_customer_360&quot; THEN 406.6&#13;&#10;WHEN &quot;30|semantic.sigma.sigma_product_engagement&quot; THEN 406.6&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_marketing&quot; THEN 399.8&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_inventory&quot; THEN 390.9&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_support&quot; THEN 399.8&#13;&#10;WHEN &quot;90|semantic.tableau.pds_finance_revenue&quot; THEN 390.9&#13;&#10;WHEN &quot;90|semantic.tableau.pds_commerce_sales&quot; THEN 390.9&#13;&#10;WHEN &quot;90|semantic.tableau.pds_board_kpis&quot; THEN 399.8&#13;&#10;WHEN &quot;90|semantic.tableau.pds_finance_close&quot; THEN 399.8&#13;&#10;WHEN &quot;90|semantic.tableau.pds_web_funnel&quot; THEN 390.9&#13;&#10;WHEN &quot;90|semantic.tableau.pds_sales_pipeline&quot; THEN 399.8&#13;&#10;WHEN &quot;90|semantic.tableau.pds_ops_monitor&quot; THEN 406.6&#13;&#10;WHEN &quot;90|semantic.sigma.sigma_customer_360&quot; THEN 406.6&#13;&#10;WHEN &quot;90|semantic.sigma.sigma_product_engagement&quot; THEN 406.6&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_marketing&quot; THEN 399.8&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_inventory&quot; THEN 399.8&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_support&quot; THEN 399.8&#13;&#10;ELSE 0&#13;&#10;END - 302.5) / 100)' />
      </column>
      <column caption='US Sem Live Text' datatype='string' name='[Calculation_1408919461814538994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// US Sem Live Text&#13;&#10;// Where the sparkline would be, for a live object.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;semantic.tableau.pds_ops_monitor&quot; THEN &quot;Live, no extract&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_customer_360&quot; THEN &quot;Live, no extract&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_product_engagement&quot; THEN &quot;Live, no extract&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='US Sem Live Point' datatype='spatial' name='[Calculation_4312945817914878797]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// US Sem Live Point&#13;&#10;// &quot;Live, no extract&quot;, left-aligned in the sparkline column.&#13;&#10;MAKEPOINT(0, (457.4 - 302.5) / 100)' />
      </column>
      <column caption='Is Failing On Last Day' datatype='boolean' name='[Calculation_6351627516110461744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Failing On Last Day&#13;&#10;// A test with a failure on 19 Oct (Test Daily only holds non-pass days). Check: 2 tests, as in the prototype.&#13;&#10;[days_before_as_of] = 0&#13;&#10;AND [fails] &gt; 0' />
      </column>
      <column caption='Tests Failing Now' datatype='integer' name='[Calculation_2823121125048494252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tests Failing Now&#13;&#10;// Mini KPI &quot;Failing right now&quot;.&#13;&#10;COUNTD(IF [Calculation_6351627516110461744] THEN [test_id] END)' />
      </column>
      <column caption='QA Failing Now Name' datatype='string' name='[Calculation_1571669004968560095]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA Failing Now Name&#13;&#10;// Red sub-line: one test failing on the last day. MAX picks the same one as the prototype&#13;&#10;// (&quot;unique_dim_customers_customer_id&quot;).&#13;&#10;MAX(IF [Calculation_6351627516110461744] THEN [test_name] END)' />
      </column>
      <column caption='QA All Passing Text' datatype='string' name='[Calculation_2697130262614228201]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA All Passing Text&#13;&#10;// Grey sub-line when nothing fails on the last day.&#13;&#10;IF [Calculation_2823121125048494252] = 0 THEN &quot;All tests passing&quot; END' />
      </column>
      <column caption='Tests Run In Period' datatype='real' name='[Calculation_2475179044337828019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tests Run In Period&#13;&#10;// Mini KPI &quot;Tests run in period&quot;. Format: #,##0.0,&quot;K&quot;&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [tests_pass] + [tests_warn] + [tests_fail] END)' />
      </column>
      <column caption='QA Tests Run Text' datatype='string' name='[Calculation_2397801738437354116]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA Tests Run Text&#13;&#10;// &quot;69.8K&quot;, as the prototype writes it.&#13;&#10;IF [Calculation_2475179044337828019] &gt;= 1000 THEN STR(ROUND([Calculation_2475179044337828019] / 1000, 1)) + &quot;K&quot;&#13;&#10;ELSE STR(INT([Calculation_2475179044337828019])) END' />
      </column>
      <column caption='Tests Defined' datatype='real' name='[Calculation_2345939181121162117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tests Defined&#13;&#10;// Sub-line &quot;N distinct tests&quot;: every dbt test defined on a model.&#13;&#10;SUM(IF [resource_type] = &quot;model&quot; THEN [test_count] END)' />
      </column>
      <column caption='QA Tests Defined Text' datatype='string' name='[Calculation_2311020166329822756]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA Tests Defined Text&#13;&#10;// &quot;166 distinct tests&quot;.&#13;&#10;STR(INT([Calculation_2345939181121162117])) + &quot; distinct tests&quot;' />
      </column>
      <column caption='Model Test Coverage' datatype='real' name='[Calculation_2755792014614728756]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Model Test Coverage&#13;&#10;// Models with at least one test / all models. Check: 68 of 82 = 83%. Also used on Governance.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND [test_count] &gt; 0 THEN 1 END))&#13;&#10;/&#13;&#10;SUM(IF [resource_type] = &quot;model&quot; THEN 1 END)' />
      </column>
      <column caption='Models In Scope' datatype='real' name='[Calculation_1109898678677432824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Models In Scope&#13;&#10;// Model count for the selected platform, for &quot;of 82&quot; sub-lines.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; THEN 1 END))' />
      </column>
      <column caption='Models Without Tests' datatype='real' name='[Calculation_1132856952812547619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Models Without Tests&#13;&#10;// Sub-line &quot;14 of 82 models have no tests&quot;.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND [test_count] = 0 THEN 1 END))' />
      </column>
      <column caption='QA No Tests Text' datatype='string' name='[Calculation_1860166786122385259]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA No Tests Text&#13;&#10;// &quot;14 of 82 models have no tests&quot;.&#13;&#10;STR(INT([Calculation_1132856952812547619])) + &quot; of &quot; + STR(INT([Calculation_1109898678677432824])) + &quot; models have no tests&quot;' />
      </column>
      <column caption='Fail Days In Period' datatype='integer' name='[Calculation_3002741023514892638]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Fail Days In Period&#13;&#10;// Days in the window where the model&apos;s worst test failed. FIXED so it can filter and sort rows.&#13;&#10;{ FIXED [node_id] : SUM(IF [Calculation_1409194560049525583] AND [worst_test_code] = 3 THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Warn Days In Period' datatype='integer' name='[Calculation_3013549279375927188]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Warn Days In Period&#13;&#10;// Days in the window where the model&apos;s worst test only warned.&#13;&#10;{ FIXED [node_id] : SUM(IF [Calculation_1409194560049525583] AND [worst_test_code] = 2 THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Heatmap Sort' datatype='integer' name='[Calculation_2566231260755502163]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Heatmap Sort&#13;&#10;// Most failure days first, then most warning days.&#13;&#10;[Calculation_3002741023514892638] * 100 + [Calculation_3013549279375927188]' />
      </column>
      <column caption='Heat Order' datatype='integer' name='[Calculation_1233721044792988211]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Heat Order&#13;&#10;// Heatmap rows, most failure days first, then warning days (Heatmap Sort turned around).&#13;&#10;-[Calculation_2566231260755502163]' />
      </column>
      <column caption='Heat Fail Text' datatype='string' name='[Calculation_2654983973042598342]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Heat Fail Text&#13;&#10;// &quot;6F&quot; in red beside the model name.&#13;&#10;IF [Calculation_3002741023514892638] &gt; 0 THEN STR([Calculation_3002741023514892638]) + &quot;F&quot; END' />
      </column>
      <column caption='Heat Warn Text' datatype='string' name='[Calculation_1701187385151390232]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Heat Warn Text&#13;&#10;// &quot;8W&quot; in amber ink.&#13;&#10;IF [Calculation_3013549279375927188] &gt; 0 THEN STR([Calculation_3013549279375927188]) + &quot;W&quot; END' />
      </column>
      <column caption='Is In Heatmap Span' datatype='boolean' name='[Calculation_2700404503449311998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is In Heatmap Span&#13;&#10;// The heatmap always shows at least 30 days, and the full window at 90.&#13;&#10;[days_before_as_of] &lt; IIF([Parameters].[Parameter 1] &gt; 30, [Parameters].[Parameter 1], 30)' />
      </column>
      <column caption='Has Test Issue In Period' datatype='boolean' name='[Calculation_2796207200988626187]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Has Test Issue In Period&#13;&#10;// Rows shown: models with any warning or failure in the window.&#13;&#10;[Calculation_3002741023514892638] + [Calculation_3013549279375927188] &gt; 0' />
      </column>
      <column caption='Worst Test Label' datatype='string' name='[Calculation_4959349905375632629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Worst Test Label&#13;&#10;// Worst test result of a model on a day (Node Daily). Palette: No run #EFEFEB, All passed #E3F2E9,&#13;&#10;// Warning #E8A33D, Failed #D2453F. The Lineage panel strip uses the strong green #2F9E6B for All passed instead.&#13;&#10;CASE [worst_test_code]&#13;&#10;WHEN 3 THEN &quot;Failed&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;All passed&quot;&#13;&#10;ELSE &quot;No run&quot;&#13;&#10;END' />
      </column>
      <column caption='Heat Cell Key' datatype='string' name='[Calculation_1581496167133538179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Heat Cell Key&#13;&#10;// Heatmap square colour (its own palette: pale green for passed).&#13;&#10;[Calculation_4959349905375632629]' />
      </column>
      <column caption='QA Strip Header' datatype='string' name='[Calculation_4561048554171669019]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// QA Strip Header&#13;&#10;// An empty row header as wide as the heatmap&apos;s, so the date strip lines up with its columns.&#13;&#10;&quot; &quot;' />
      </column>
      <column caption='QA Monday Label' datatype='string' name='[Calculation_1256969906793957266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// QA Monday Label&#13;&#10;// Date labels over the heatmap: Mondays, &quot;Mon 21 Sep&quot; on the 30-day strip.&#13;&#10;IF DATEPART(&apos;weekday&apos;, [date (dim_date.csv)], &apos;monday&apos;) = 1&#13;&#10;THEN STR(DAY([date (dim_date.csv)])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [date (dim_date.csv)]), 3) END' />
      </column>
      <column caption='QA Monday Label 30' datatype='string' name='[Calculation_2942310133745287070]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// QA Monday Label 30&#13;&#10;// With the weekday, as the prototype at 30 days.&#13;&#10;IF NOT ISNULL([Calculation_1256969906793957266]) THEN &quot;Mon &quot; + [Calculation_1256969906793957266] END' />
      </column>
      <column caption='QA KF Slot' datatype='integer' name='[Calculation_9061342006016474767]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// QA KF Slot&#13;&#10;// Row of the list a carrier model&apos;s Node Daily rows draw (a scaffold: the content is the test&apos;s,&#13;&#10;// written by the build per period and platform).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN 0&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN 1&#13;&#10;WHEN &quot;model.acme_core.dim_products&quot; THEN 2&#13;&#10;WHEN &quot;model.acme_core.dim_stores&quot; THEN 3&#13;&#10;WHEN &quot;model.acme_core.fct_board_kpis&quot; THEN 4&#13;&#10;WHEN &quot;model.acme_core.fct_finance_close&quot; THEN 5&#13;&#10;WHEN &quot;model.acme_core.fct_gl_journal&quot; THEN 6&#13;&#10;WHEN &quot;model.acme_core.fct_inventory_daily&quot; THEN 7&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Is QA KF Row' datatype='boolean' name='[Calculation_2537301615494657624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is QA KF Row&#13;&#10;// Rows that have a test in this period and platform. Put on Filters (True).&#13;&#10;[Calculation_9061342006016474767] &lt; CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN 8&#13;&#10;WHEN &quot;7|snowflake&quot; THEN 8&#13;&#10;WHEN &quot;7|databricks&quot; THEN 7&#13;&#10;WHEN &quot;7|redshift&quot; THEN 4&#13;&#10;WHEN &quot;30|All&quot; THEN 8&#13;&#10;WHEN &quot;30|snowflake&quot; THEN 8&#13;&#10;WHEN &quot;30|databricks&quot; THEN 8&#13;&#10;WHEN &quot;30|redshift&quot; THEN 8&#13;&#10;WHEN &quot;90|All&quot; THEN 8&#13;&#10;WHEN &quot;90|snowflake&quot; THEN 8&#13;&#10;WHEN &quot;90|databricks&quot; THEN 8&#13;&#10;WHEN &quot;90|redshift&quot; THEN 8&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='QA KF Bar Id' datatype='integer' name='[Calculation_3812163153577257373]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// QA KF Bar Id&#13;&#10;// Which weekday bar a Node Daily row draws (12 rows each, up to 84).&#13;&#10;IF [Calculation_2690238693341099106] &lt; 84 THEN INT([Calculation_2690238693341099106] / 12) END' />
      </column>
      <column caption='QA KF Bar Key' datatype='string' name='[Calculation_3739048857491135836]' role='dimension' type='nominal'>
