          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='QA Issues Track Point' datatype='spatial' name='[Calculation_5739010618764932664]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// QA Issues Track Point&#13;&#10;// The light grey track under each bar (written by the build).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;7|All|0&quot; THEN MAKEPOINT(0.4650, -1.9100)&#13;&#10;WHEN &quot;7|All|1&quot; THEN MAKEPOINT(0.4650, 1.9100)&#13;&#10;WHEN &quot;7|All|2&quot; THEN MAKEPOINT(0.4250, 1.9100)&#13;&#10;WHEN &quot;7|All|3&quot; THEN MAKEPOINT(0.4250, -1.9100)&#13;&#10;WHEN &quot;7|All|4&quot; THEN MAKEPOINT(0.2150, -1.9100)&#13;&#10;WHEN &quot;7|All|5&quot; THEN MAKEPOINT(0.2150, 1.9100)&#13;&#10;WHEN &quot;7|All|6&quot; THEN MAKEPOINT(0.1750, 1.9100)&#13;&#10;WHEN &quot;7|All|7&quot; THEN MAKEPOINT(0.1750, -1.9100)&#13;&#10;WHEN &quot;7|All|8&quot; THEN MAKEPOINT(-0.0350, -1.9100)&#13;&#10;WHEN &quot;7|All|9&quot; THEN MAKEPOINT(-0.0350, 1.9100)&#13;&#10;WHEN &quot;7|All|10&quot; THEN MAKEPOINT(-0.0750, 1.9100)&#13;&#10;WHEN &quot;7|All|11&quot; THEN MAKEPOINT(-0.0750, -1.9100)&#13;&#10;WHEN &quot;7|All|12&quot; THEN MAKEPOINT(-0.2850, -1.9100)&#13;&#10;WHEN &quot;7|All|13&quot; THEN MAKEPOINT(-0.2850, 1.9100)&#13;&#10;WHEN &quot;7|All|14&quot; THEN MAKEPOINT(-0.3250, 1.9100)&#13;&#10;WHEN &quot;7|All|15&quot; THEN MAKEPOINT(-0.3250, -1.9100)&#13;&#10;WHEN &quot;7|All|16&quot; THEN MAKEPOINT(-0.5350, -1.9100)&#13;&#10;WHEN &quot;7|All|17&quot; THEN MAKEPOINT(-0.5350, 1.9100)&#13;&#10;WHEN &quot;7|All|18&quot; THEN MAKEPOINT(-0.5750, 1.9100)&#13;&#10;WHEN &quot;7|All|19&quot; THEN MAKEPOINT(-0.5750, -1.9100)&#13;&#10;WHEN &quot;7|snowflake|0&quot; THEN MAKEPOINT(0.4650, -1.9100)&#13;&#10;WHEN &quot;7|snowflake|1&quot; THEN MAKEPOINT(0.4650, 1.9100)&#13;&#10;WHEN &quot;7|snowflake|2&quot; THEN MAKEPOINT(0.4250, 1.9100)&#13;&#10;WHEN &quot;7|snowflake|3&quot; THEN MAKEPOINT(0.4250, -1.9100)&#13;&#10;WHEN &quot;7|snowflake|4&quot; THEN MAKEPOINT(0.2150, -1.9100)&#13;&#10;WHEN &quot;7|snowflake|5&q