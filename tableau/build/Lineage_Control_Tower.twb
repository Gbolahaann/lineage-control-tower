                <member alias='BI semantic layer · pbi_inventory' value='&quot;semantic.power_bi.pbi_inventory&quot;' />
                <member alias='BI semantic layer · pbi_marketing' value='&quot;semantic.power_bi.pbi_marketing&quot;' />
                <member alias='BI semantic layer · pbi_support' value='&quot;semantic.power_bi.pbi_support&quot;' />
                <member alias='BI semantic layer · pds_board_kpis' value='&quot;semantic.tableau.pds_board_kpis&quot;' />
                <member alias='BI semantic layer · pds_commerce_sales' value='&quot;semantic.tableau.pds_commerce_sales&quot;' />
                <member alias='BI semantic layer · pds_finance_close' value='&quot;semantic.tableau.pds_finance_close&quot;' />
                <member alias='BI semantic layer · pds_finance_revenue' value='&quot;semantic.tableau.pds_finance_revenue&quot;' />
                <member alias='BI semantic layer · pds_ops_monitor' value='&quot;semantic.tableau.pds_ops_monitor&quot;' />
