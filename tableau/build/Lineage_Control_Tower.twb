              <calculation class='tableau' formula='// Panel Tests Latest Text&#13;&#10;// &quot;Latest: 2 passing, 1 warning&quot; under the strip.&#13;&#10;&quot;Latest: &quot; + STR(ZN([tests_passing])) + &quot; passing&quot;&#13;&#10;+ IF [tests_warning] &gt; 0 THEN &quot;, &quot; + STR([tests_warning]) + &quot; warning&quot; ELSE &quot;&quot; END' />
            </column>
