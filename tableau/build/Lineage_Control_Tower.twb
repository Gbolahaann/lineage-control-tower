                </zone-style>
              </zone>
              <zone friendly-name='AB Content' h='87800' id='1506' param='horz' type-v2='layout-flow' w='85500' x='14500' y='12200'>
                <zone fixed-size='456' friendly-name='AB What Card' h='84400' id='1496' is-fixed='true' param='vert' type-v2='layout-flow' w='28938' x='16250' y='14200'>
                  <zone fixed-size='40' h='4000' id='1482' is-fixed='true' type-v2='text' w='26375' x='17312' y='15700'>
                    <formatted-text>
                      <run fontcolor='#7a838e' fontname='Arial' fontsize='7' bold='true'>DEVELOPER</run>
                      <run fontcolor='#7a838e' fontname='Arial' fontsize='7'>Æ&#10;</run>
                      <run fontcolor='#002c55' fontname='Arial' fontsize='10' bold='true'>Gbolahan Adebayo</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='1' h='100' id='1483' is-fixed='true' type-v2='empty' w='26375' x='17312' y='19700'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                      <format attr='background-color' value='#efefeb' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='10' h='1000' id='1484' is-fixed='true' type-v2='empty' w='26375' x='17312' y='19800'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='30' h='3000' id='1485' is-fixed='true' type-v2='text' w='26375' x='17312' y='20800'>
                    <formatted-text>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='10' bold='true'>What this is</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='196' h='19600' id='1486' is-fixed='true' type-v2='text' w='26375' x='17312' y='23800'>
                    <formatted-text>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='9'>Lineage Control Tower monitors every data product at Acme Retail Co. and traces each one back through dbt to the raw tables that feed it. It answers one question per page: what broke, who is affected, what is slow, what is expensive, and what nobody uses.</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='9'>A data product here is anything that reads the warehouse: BI dashboards in Tableau, Sigma and Power BI, notebooks, ML models, Databricks apps, AI agents and data hubs built in Claude. Each one is registered as a dbt exposure, so it sits at the end of the lineage chain.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='4' h='400' id='1487' is-fixed='true' type-v2='empty' w='26375' x='17312' y='43400'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='85' h='8500' id='1488' is-fixed='true' name='AB Layer Chain' show-title='false' w='26375' x='17312' y='43800'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='12' h='1200' id='1489' is-fixed='true' type-v2='empty' w='26375' x='17312' y='52300'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='84' h='8400' id='1490' is-fixed='true' type-v2='text' w='26375' x='17312' y='53500'>
                    <formatted-text>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>How to use it. </run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='9'>Start on Health overview. Click any exposure tile to see its lineage, click any node to see its history, then use Trace downstream impact to see who to tell. Period and Platform at the top apply to every page.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='128' h='13200' id='1491' is-fixed='true' type-v2='text' w='26375' x='17312' y='61900'>
                    <formatted-text>
                      <run fontcolor='#002c55' fontname='Arial' fontsize='9' bold='true'>The data is synthetic. </run>
                      <run fontcolor='#002c55' fontname='Arial' fontsize='9'>Acme Retail Co. is fictional. 90 days of dbt runs, tests, freshness checks, BI refreshes, warehouse cost and usage were generated in Python with eleven planted stories, such as a Monday test failure, a Stripe outage on month-end close and an AI agent reading data nobody registered.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#cfe0f1' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='1' />
                      <format attr='margin' value='0' />
                      <format attr='background-color' value='#eef4fb' />
                      <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='8' />
                      <format attr='padding-left' value='12' />
                      <format attr='padding-right' value='12' />
                      <format attr='padding-top' value='8' />
                      <format attr='margin-top' value='4' />
                    </zone-style>
                  </zone>
                  <zone h='19200' id='1492' type-v2='empty' w='26375' x='17312' y='75100'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='28' friendly-name='AB Docs Link Row' h='2800' id='1495' is-fixed='true' param='horz' type-v2='layout-flow' w='26375' x='17312' y='94300'>
                    <zone fixed-size='192' h='2800' id='1493' is-fixed='true' type-v2='dashboard-object' w='12000' x='17312' y='94300'>
                      <button action='tabdoc:goto-sheet window-id=&quot;{09D966FC-06F6-0185-ED2E-7389B9755D6E}&quot;' button-type='text'>
                        <button-visual-state>
                          <caption>Documentation for developers ›</caption>
                          <button-caption-font-style fontcolor='#005fae' fontname='Arial' fontsize='8' />
                          <format attr='background-color' value='#ffffff' />
                        </button-visual-state>
                      </button>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='0' />
                        <format attr='padding' value='0' />
                      </zone-style>
                    </zone>
                    <zone h='2800' id='1494' type-v2='empty' w='14375' x='29312' y='94300'>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='0' />
                      </zone-style>
                    </zone>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone-style>
                    <format attr='border-color' value='#e6e7e2' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='0' />
                    <format attr='background-color' value='#ffffff' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
                    <format attr='padding-top' value='14' />
                    <format attr='padding-right' value='16' />
                    <format attr='padding-bottom' value='14' />
                    <format attr='padding-left' value='16' />
                    <format attr='margin-right' value='7' />
                  </zone-style>
                </zone>
                <zone fixed-size='414' friendly-name='AB Sources Card' h='84400' id='1503' is-fixed='true' param='vert' type-v2='layout-flow' w='26750' x='45188' y='14200'>
                  <zone fixed-size='44' h='4400' id='1497' is-fixed='true' type-v2='text' w='23750' x='46688' y='15700'>
                    <formatted-text>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='10' bold='true'>Where the numbers come from</run>
                      <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>In production, every table maps to something you already have</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                      <format attr='padding-bottom' value='10' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='279' h='27900' id='1498' is-fixed='true' name='AB Sources Table' show-title='false' w='23750' x='46688' y='20100'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='30' h='3000' id='1499' is-fixed='true' type-v2='text' w='23750' x='46688' y='48000'>
                    <formatted-text>
                      <run fontcolor='#7a838e' fontname='Arial' fontsize='7' bold='true'>BUILT FOR ANY TOOL</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                      <format attr='padding-top' value='14' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='1' h='100' id='1500' is-fixed='true' type-v2='empty' w='23750' x='46688' y='51000'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                      <format attr='background-color' value='#efefeb' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='70' h='7000' id='1501' is-fixed='true' type-v2='text' w='23750' x='46688' y='51100'>
                    <formatted-text>
                      <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>The data model is the product. This view is built in Tableau, and the same tables can drive Sigma, Power BI, Looker, a Claude-built data hub, or an agent that answers questions about data health.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                      <format attr='padding-top' value='6' />
                    </zone-style>
                  </zone>
                  <zone h='39000' id='1502' type-v2='empty' w='23750' x='46688' y='58100'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                    </zone-style>
                  </zone>
                  <zone-style>
                    <format attr='border-color' value='#e6e7e2' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='0' />
                    <format attr='background-color' value='#ffffff' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
                    <format attr='padding-top' value='14' />
                    <format attr='padding-right' value='16' />
                    <format attr='padding-bottom' value='14' />
                    <format attr='padding-left' value='16' />
                    <format attr='margin-left' value='7' />
                    <format attr='margin-right' value='7' />
                  </zone-style>
                </zone>
                <zone friendly-name='AB Definitions Card' h='84400' id='1505' param='vert' type-v2='layout-flow' w='26312' x='71938' y='14200'>
                  <zone h='81400' id='1504' type-v2='text' w='23750' x='73438' y='15700'>
                    <formatted-text>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='10' bold='true'>Metric definitions</run>
                      <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Run success</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Successful model runs ÷ all model runs, skipped excluded</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Test pass rate</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Passing tests ÷ all tests run. Warnings count as not passing</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Freshness SLA</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Passing hourly freshness checks ÷ all checks</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Exposure status</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Critical if anything upstream has failed, is past its freshness error threshold or failed to refresh. Warning for failing tests, late sources or skipped refreshes</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Health score</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>40% upstream run success + 30% test pass + 30% freshness, over 7 days</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Mean time to recover</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>First failure to next success, per node</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Risk score</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Daily downstream consumers × failure rate</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Cost per exposure</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Upstream build cost split evenly across exposures fed, plus own queries</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Retire candidate</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Under 10 uses in 30 days and over $5 per use</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='6'>Æ&#10;</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9' bold='true'>Incremental candidate</run>
                      <run fontcolor='#16212e' fontname='Arial' fontsize='9'>Æ&#10;</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Table over 10M rows whose 7-day runtime is 25%+ above its 28-day average</run>
                      <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
