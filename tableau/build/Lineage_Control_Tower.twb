      <column caption='Period Option' datatype='integer' name='[Calculation_1395152531449864650]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Period Option&#13;&#10;// Scaffold: turns the first 3 days of dim_date into the 3 period buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN 7&#13;&#10;WHEN 1 THEN 30&#13;&#10;WHEN 2 THEN 90&#13;&#10;END' />
      </column>
      <column caption='Is Active Period Option' datatype='boolean' name='[Calculation_1290101426377148290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Period Option&#13;&#10;// Colours the selected period button (Navy fill, white text) against the rest.&#13;&#10;[Calculation_1395152531449864650] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Period Option Label' datatype='string' name='[Calculation_3141427238531064247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;&quot;Last &quot; + STR([Calculation_1395152531449864650]) + &quot; days&quot;' />
      </column>
      <column caption='Period Label Active' datatype='string' name='[Calculation_2018629980644388562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Label Active&#13;&#10;// Button text when this button is the selected period (Semibold Navy run).&#13;&#10;IF [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
      </column>
      <column caption='Period Label Inactive' datatype='string' name='[Calculation_3943248154185459554]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Label Inactive&#13;&#10;// Button text when this button is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
      </column>
      <column caption='Is Period Button Row' datatype='boolean' name='[Calculation_1896708728705539988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Period Button Row&#13;&#10;// Keeps the 3 scaffold rows that carry a period button. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1395152531449864650])' />
      </column>
      <column caption='Platform Option Order' datatype='integer' name='[Calculation_1997623788981524034]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Platform Option Order&#13;&#10;// Keeps the platform buttons in prototype order (All, Snowflake, Databricks, Redshift) instead of A to Z.&#13;&#10;[day_index]' />
      </column>
      <column caption='Platform Option' datatype='string' name='[Calculation_1708304674625620149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Option&#13;&#10;// Scaffold: turns the first 4 days of dim_date into the 4 platform buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;snowflake&quot;&#13;&#10;WHEN 2 THEN &quot;databricks&quot;&#13;&#10;WHEN 3 THEN &quot;redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Platform Dot Snowflake' datatype='string' name='[Calculation_1113706873550636432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Snowflake&#13;&#10;// Coloured square before &quot;Snowflake&quot; on its button. Each platform has its own field so each gets its own run colour.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;snowflake&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Dot Databricks' datatype='string' name='[Calculation_2812498324364876413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Databricks&#13;&#10;// Coloured square before &quot;Databricks&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;databricks&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Dot Redshift' datatype='string' name='[Calculation_2114073437937435113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Redshift&#13;&#10;// Coloured square before &quot;Redshift&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;redshift&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Is Active Platform Option' datatype='boolean' name='[Calculation_1733161848805935888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Platform Option&#13;&#10;// Colours the selected platform button.&#13;&#10;[Calculation_1708304674625620149] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Platform Option Label' datatype='string' name='[Calculation_1669066058101174507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;CASE [Calculation_1708304674625620149]&#13;&#10;WHEN &quot;All&quot;        THEN &quot;All&quot;&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Platform Label Active' datatype='string' name='[Calculation_1615833699327644939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Label Active&#13;&#10;// Button text when this button is the selected platform (Semibold Navy run).&#13;&#10;IF [Calculation_1733161848805935888] THEN [Calculation_1669066058101174507] ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Label Inactive' datatype='string' name='[Calculation_3045694386135075059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Label Inactive&#13;&#10;// Button text when this button is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1733161848805935888] THEN [Calculation_1669066058101174507] ELSE &quot;&quot; END' />
      </column>
      <column caption='Is Platform Button Row' datatype='boolean' name='[Calculation_1766699502863314635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Button Row&#13;&#10;// Keeps the 4 scaffold rows that carry a platform button. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1708304674625620149])' />
      </column>
      <column caption='Has Prior Period' datatype='boolean' name='[Calculation_1497969784006078758]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Has Prior Period&#13;&#10;// FALSE at 90 days, when there is no earlier window in the data.&#13;&#10;// Drives the &quot;no earlier period&quot; wording. Measures don&apos;t need it: their Prior is NULL anyway.&#13;&#10;2 * [Parameters].[Parameter 1] &lt;= { MAX([day_index]) } + 1' />
      </column>
      <column caption='Period Hint Label' datatype='string' name='[Calculation_2651474984799504069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Hint Label&#13;&#10;// Hint text at the right of the filter band, as in the prototype.&#13;&#10;IF [Calculation_1497969784006078758]&#13;&#10;    THEN &quot;Changes compare with the &quot; + STR([Parameters].[Parameter 1]) + &quot; days before&quot;&#13;&#10;ELSE &quot;No earlier period in the data to compare with&quot;&#13;&#10;END' />
      </column>
      <column caption='Data Updated Date Text' datatype='string' name='[Calculation_2445757024107576062]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Data Updated Date Text&#13;&#10;// The date part of the header stamp, shown bold after &quot;Data updated on &quot;.&#13;&#10;STR(DAY({ MAX([date (dim_date.csv)]) })) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, { MAX([date (dim_date.csv)]) }), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR({ MAX([date (dim_date.csv)]) }))&#13;&#10;+ &quot;, 23:59&quot;' />
      </column>
      <column caption='History Label' datatype='string' name='[Calculation_2111610048197173466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// History Label&#13;&#10;// Second line of the header stamp: &quot;90 days of history from 22 Jul 2026&quot;.&#13;&#10;STR({ COUNTD([date (dim_date.csv)]) }) + &quot; days of history from &quot;&#13;&#10;+ STR(DAY({ MIN([date (dim_date.csv)]) })) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, { MIN([date (dim_date.csv)]) }), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR({ MIN([date (dim_date.csv)]) }))' />
      </column>
      <column caption='Info Button Glyph' datatype='string' name='[Calculation_1055782736416529768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Info Button Glyph&#13;&#10;// The header icon: &quot;ⓘ&quot; opens the info panel, &quot;✕&quot; closes it.&#13;&#10;IF [Parameters].[Parameter 7] THEN &quot;✕&quot; ELSE &quot;ⓘ&quot; END' />
      </column>
      <column caption='Info Toggle Value' datatype='boolean' name='[Calculation_1949193342976572784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Info Toggle Value&#13;&#10;// The value the info button writes into p_show_info: the opposite of the current state.&#13;&#10;NOT [Parameters].[Parameter 7]' />
      </column>
      <column caption='Is Info Button Row' datatype='boolean' name='[Calculation_6860269217128732528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Info Button Row&#13;&#10;// One scaffold row for the single-mark info button. Put on Filters (True).&#13;&#10;[day_index] = 0' />
      </column>
      <column caption='Show Info Panel' datatype='boolean' name='[Calculation_3095764547146903988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Info Panel&#13;&#10;// DZV for GL Info Panel: shown while p_show_info is True.&#13;&#10;[Parameters].[Parameter 7]' />
      </column>
