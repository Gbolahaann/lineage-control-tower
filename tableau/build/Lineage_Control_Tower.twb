    <worksheet name='US Cost vs Usage Scatter'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Retire Uses Threshold' datatype='real' name='[Calculation_7109802039074897984]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Retire Uses Threshold&#13;&#10;// Y position of the retire band&apos;s top edge: 10 uses per 30 days, scaled to the window.&#13;&#10;10 * [Parameters].[Parameter 1] / 30' />
            </column>
            <column caption='US Retire Zone' datatype='real' name='[Calculation_1644253842737692818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// US Retire Zone&#13;&#10;// Uses axis of the retire-zone corners: 1 (the axis floor), the threshold (10 uses per 30 days,&#13;&#10;// scaled to the window) at the bend and the right edge, 1 again at the bottom right.&#13;&#10;CASE MIN([day_index]) WHEN 86 THEN 1 WHEN 87 THEN [Calculation_7109802039074897984]&#13;&#10;WHEN 88 THEN [Calculation_7109802039074897984] WHEN 89 THEN 1 END' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Product Cost (Period)' datatype='real' name='[Calculation_3016817971858344399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Product Cost (Period)&#13;&#10;// Allocated cost in the window: upstream build cost split across the exposures each model feeds, plus own queries.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [allocated_cost_usd] END)' />
            </column>
            <column caption='Product Uses (Period)' datatype='real' name='[Calculation_1159284100207867770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Product Uses (Period)&#13;&#10;// An exposure&apos;s consumption events in the window (views, queries, sessions or calls).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [events] END)' />
            </column>
            <column caption='US Scatter Uses' datatype='real' name='[Calculation_3395208717117628007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// US Scatter Uses&#13;&#10;// Uses axis of a product dot (NULL with no use or cost).&#13;&#10;IF [Calculation_1159284100207867770] &gt; 0 AND [Calculation_3016817971858344399] &gt; 0 THEN [Calculation_1159284100207867770] END' />
            </column>
            <column caption='US Scatter X' datatype='real' name='[Calculation_8348940959693549021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// US Scatter X&#13;&#10;// Cost axis of the scatter. A product: its cost in the period (NULL with no use or cost: a log axis&#13;&#10;// cannot show 0). A retire-zone corner: $5 at the bottom left, $5 x the threshold at the bend, and the&#13;&#10;// axis&apos;s right edge (a round power of ten above the dearest product, per period and platform).&#13;&#10;IF MIN([day_index]) = MAX([day_index]) THEN&#13;&#10;    CASE MIN([day_index]) WHEN 86 THEN 5 WHEN 87 THEN 5 * [Calculation_7109802039074897984]&#13;&#10;    ELSE CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN 1000&#13;&#10;WHEN &quot;7|snowflake&quot; THEN 1000&#13;&#10;WHEN &quot;7|databricks&quot; THEN 100&#13;&#10;WHEN &quot;7|redshift&quot; THEN 1000&#13;&#10;WHEN &quot;30|All&quot; THEN 1000&#13;&#10;WHEN &quot;30|snowflake&quot; THEN 1000&#13;&#10;WHEN &quot;30|databricks&quot; THEN 1000&#13;&#10;WHEN &quot;30|redshift&quot; THEN 1000&#13;&#10;WHEN &quot;90|All&quot; THEN 10000&#13;&#10;WHEN &quot;90|snowflake&quot; THEN 10000&#13;&#10;WHEN &quot;90|databricks&quot; THEN 10000&#13;&#10;WHEN &quot;90|redshift&quot; THEN 1000&#13;&#10;ELSE 1000&#13;&#10;END END&#13;&#10;ELSEIF [Calculation_1159284100207867770] &gt; 0 AND [Calculation_3016817971858344399] &gt; 0 THEN [Calculation_3016817971858344399]&#13;&#10;END' />
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Cost Per Use' datatype='real' name='[Calculation_2256908730979128074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Cost Per Use&#13;&#10;// Product Cost / Product Uses. NULL (shown &quot;-&quot;) when there was no use.&#13;&#10;IF [Calculation_1159284100207867770] = 0 OR ISNULL([Calculation_1159284100207867770]) THEN NULL&#13;&#10;ELSE [Calculation_3016817971858344399] / [Calculation_1159284100207867770]&#13;&#10;END' />
            </column>
            <column caption='Uses Per 30 Days' datatype='real' name='[Calculation_1750303070460088850]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Uses Per 30 Days&#13;&#10;// Uses scaled to 30 days, so the retire threshold reads the same at 7, 30 and 90 days.&#13;&#10;[Calculation_1159284100207867770] / [Parameters].[Parameter 1] * 30' />
            </column>
            <column caption='Is Retire Candidate' datatype='boolean' name='[Calculation_1477962250728433097]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Is Retire Candidate&#13;&#10;// Under 10 uses per 30 days AND over $5 per use (or no use at all), declared products only&#13;&#10;// (thresholds from generator/config.yaml). Check: only Web Funnel Analysis.&#13;&#10;[Calculation_1750303070460088850] &lt; 10&#13;&#10;AND (ISNULL([Calculation_2256908730979128074]) OR [Calculation_2256908730979128074] &gt; 5)&#13;&#10;AND ATTR([is_declared])' />
            </column>
            <column caption='Scatter Colour Key' datatype='string' name='[Calculation_1682376588086171483]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Scatter Colour Key&#13;&#10;// Retire candidate #D2453F, Unregistered #E8A33D, AI-built #5B5FC7, Built by hand #005FAE.&#13;&#10;IF [Calculation_1477962250728433097] THEN &quot;Retire candidate&quot;&#13;&#10;ELSEIF NOT ATTR([is_declared]) THEN &quot;Unregistered&quot;&#13;&#10;ELSEIF ATTR([build_method]) = &quot;ai_assisted&quot; THEN &quot;AI-built&quot;&#13;&#10;ELSE &quot;Built by hand&quot;&#13;&#10;END' />
            </column>
            <column caption='Scatter Label' datatype='string' name='[Calculation_8863144114571249906]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Scatter Label&#13;&#10;// Labels only the retire candidates, unregistered readers and the most used product, as in the prototype.&#13;&#10;// Table calc: compute using exposure_id.&#13;&#10;IF [Calculation_1477962250728433097]&#13;&#10;    OR NOT ATTR([is_declared])&#13;&#10;    OR [Calculation_1159284100207867770] = WINDOW_MAX([Calculation_1159284100207867770])&#13;&#10;    THEN REPLACE(ATTR([display_name]), &quot;Unregistered: &quot;, &quot;&quot;)&#13;&#10;END'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[node_id (dim_nodes.csv)]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Clear Node Value' datatype='string' name='[Calculation_1962397006096080865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Clear Node Value&#13;&#10;// Empty string a parameter action can write into p_selected_node, to clear it (prototype: opening an exposure clears the node).&#13;&#10;&quot;&quot;' />
            </column>
            <column caption='Clear Node Key Value' datatype='integer' name='[Calculation_7177065549275409274]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Clear Node Key Value&#13;&#10;// Companion to Clear Node Value for p_selected_node_key. -1 matches no node.&#13;&#10;-1' />
            </column>
            <column caption='Panel Tags Value' datatype='string' name='[Calculation_9860372241269830816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Tags Value&#13;&#10;// What a click writes into p_panel_tags: &quot;|moved|ai|unregistered|&quot; for the tags this node carries.&#13;&#10;&quot;|&quot; + IF NOT ISNULL([migrated_from_platform]) THEN &quot;moved|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF [build_method] = &quot;ai_assisted&quot; THEN &quot;ai|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF NOT [is_declared] THEN &quot;unregistered|&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Uses Unit Label' datatype='string' name='[Calculation_2657459577906221023]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Uses Unit Label&#13;&#10;// Unit after a usage number: views, queries, app sessions or agent calls (Exposure Daily).&#13;&#10;CASE [consumption_type (mart_exposure_daily.csv)]&#13;&#10;WHEN &quot;view&quot;        THEN &quot;views&quot;&#13;&#10;WHEN &quot;query&quot;       THEN &quot;queries&quot;&#13;&#10;WHEN &quot;app_session&quot; THEN &quot;app sessions&quot;&#13;&#10;WHEN &quot;agent_call&quot;  THEN &quot;agent calls&quot;&#13;&#10;END' />
            </column>
            <column caption='Allocated Cost Usd' datatype='real' name='[allocated_cost_usd]' role='measure' type='quantitative' />
            <column caption='Build Method' datatype='string' name='[build_method]' role='dimension' type='nominal' />
            <column caption='Consumption Type (Exposure Daily)' datatype='string' name='[consumption_type (mart_exposure_daily.csv)]' role='dimension' type='nominal' />
            <column caption='Current Status Code' datatype='integer' name='[current_status_code]' role='dimension' type='ordinal' />
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Events' datatype='integer' name='[events]' role='measure' type='quantitative' />
            <column caption='Is Declared' datatype='boolean' name='[is_declared]' role='dimension' type='nominal' />
            <column caption='Migrated From Platform' datatype='string' name='[migrated_from_platform]' role='dimension' type='nominal' />
            <column caption='Node Id (Nodes)' datatype='string' name='[node_id (dim_nodes.csv)]' role='dimension' type='nominal' />
            <column caption='Platform Filter Values' datatype='string' name='[platform_filter_values]' role='dimension' type='nominal' />
            <column caption='Platform Now' datatype='string' name='[platform_now]' role='dimension' type='nominal' />
            <column caption='Resource Type' datatype='string' name='[resource_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1644253842737692818]' derivation='User' name='[usr:Calculation_1644253842737692818:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_3395208717117628007]' derivation='User' name='[usr:Calculation_3395208717117628007:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_8348940959693549021]' derivation='User' name='[usr:Calculation_8348940959693549021:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2214252331607255986]' derivation='None' name='[none:Calculation_2214252331607255986:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1329749043964588995]' derivation='None' name='[none:Calculation_1329749043964588995:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1841670643858094106]' derivation='None' name='[none:Calculation_1841670643858094106:nk]' pivot='key' type='nominal' />
            <column-instance column='[day_index]' derivation='None' name='[none:day_index:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1682376588086171483]' derivation='User' name='[usr:Calculation_1682376588086171483:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_8863144114571249906]' derivation='User' name='[usr:Calculation_8863144114571249906:nk]' pivot='key' type='nominal'>
              <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[node_id (dim_nodes.csv)]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[node_id (dim_nodes.csv)]' derivation='None' name='[none:node_id (dim_nodes.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1962397006096080865]' derivation='None' name='[none:Calculation_1962397006096080865:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_7177065549275409274]' derivation='None' name='[none:Calculation_7177065549275409274:ok]' pivot='key' type='ordinal' />
            <column-instance column='[current_status_code]' derivation='None' name='[none:current_status_code:ok]' pivot='key' type='ordinal' />
