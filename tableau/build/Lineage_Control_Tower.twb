            <column caption='QA Issues Value Point' datatype='spatial' name='[Calculation_3003441550564036928]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// QA Issues Value Point&#13;&#10;// Where the value sits (right-aligned, measured).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;7|All|0&quot; THEN MAKEPOINT(0.5550, 1.8509)&#13;&#10;WHEN &quot;7|All|1&quot; THEN MAKEPOINT(0.3050, 1.8509)&#13;&#10;WHEN &quot;7|All|2&quot; THEN MAKEPOINT(0.0550, 1.8805)&#13;&#10;WHEN &quot;7|All|3&quot; THEN MAKEPOINT(-0.1950, 1.8805)&#13;&#10;WHEN &quot;7|All|4&quot; THEN MAKEPOINT(-0.4450, 1.8805)&#13;&#10;WHEN &quot;7|snowflake|0&quot; THEN MAKEPOINT(0.5550, 1.8509)&#13;&#10;WHEN &quot;7|snowflake|1&quot; THEN MAKEPOINT(0.3050, 1.8509)&#13;&#10;WHEN &quot;7|snowflake|2&quot; THEN MAKEPOINT(0.0550, 1.8805)&#13;&#10;WHEN &quot;7|snowflake|3&quot; THEN MAKEPOINT(-0.1950, 1.8805)&#13;&#10;WHEN &quot;7|snowflake|4&quot; THEN MAKEPOINT(-0.4450, 1.8805)&#13;&#10;WHEN &quot;7|databricks|0&quot; THEN MAKEPOINT(0.5550, 1.8805)&#13;&#10;WHEN &quot;7|databricks|1&quot; THEN MAKEPOINT(0.3050, 1.8805)&#13;&#10;WHEN &quot;7|databricks|2&quot; THEN MAKEPOINT(0.0550, 1.8805)&#13;&#10;WHEN &quot;7|redshift|0&quot; THEN MAKEPOINT(0.5550, 1.8805)&#13;&#10;WHEN &quot;7|redshift|1&quot; THEN MAKEPOINT(0.3050, 1.8805)&#13;&#10;WHEN &quot;7|redshift|2&quot; THEN MAKEPOINT(0.0550, 1.8805)&#13;&#10;WHEN &quot;30|All|0&quot; THEN MAKEPOINT(0.5550, 1.8214)&#13;&#10;WHEN &quot;30|All|1&quot; THEN MAKEPOINT(0.3050, 1.8214)&#13;&#10;WHEN &quot;30|All|2&quot; THEN MAKEPOINT(0.0550, 1.8509)&#13;&#10;WHEN &quot;30|All|3&quot; THEN MAKEPOINT(-0.1950, 1.8509)&#13;&#10;WHEN &quot;30|All|4&quot; THEN MAKEPOINT(-0.4450, 1.8805)&#13;&#10;WHEN &quot;30|snowflake|0&quot; THEN MAKEPOINT(0.5550, 1.8214)&#13;&#10;WHEN &quot;30|snowflake|1&quot; THEN MAKEPOINT(0.3050, 1.8272)&#13;&#10;WHEN &quot;30|snowflake|2&quot; THEN MAKEPOINT(0.0550, 1.8509)&#13;&#10;WHEN &quot;30|snowflake|3&quot; THEN MAKEPOINT(-0.1950, 1.8509)&#13;&#