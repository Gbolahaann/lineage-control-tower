                          <run fontcolor='#7a838e' fontname='Arial' fontsize='7'>Æ&#10;</run>
                          <run fontcolor='#7a838e' fontname='Arial' fontsize='5'>Æ&#10;</run>
                          <run fontcolor='#16212e' fontname='Arial' fontsize='8' bold='true'>p_period</run>
                          <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Æ&#10;</run>
