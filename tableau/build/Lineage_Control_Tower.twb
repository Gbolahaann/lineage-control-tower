      <column caption='GOV Domain Poor Text' datatype='string' name='[Calculation_2383708823060288766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Poor Text&#13;&#10;// Poor texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|19&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;All|28&quot; THEN &quot;64%&quot;&#13;&#10;WHEN &quot;All|29&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;snowflake|19&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;databricks|13&quot; THEN &quot;64%&quot;&#13;&#10;WHEN &quot;databricks|14&quot; THEN &quot;67%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
