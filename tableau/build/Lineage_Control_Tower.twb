        <style>
          <style-rule element='axis'>
            <encoding attr='space' class='0' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_4504844918117665692:qk]' field-type='quantitative' fold='true' scope='rows' synchronized='true' type='space' />
