    <worksheet name='PF Average Per Day KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Platform Match Day' datatype='boolean' name='[Calculation_1100032193373739257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Day&#13;&#10;// Day-level platform filter for Node Daily. Migrated models count against Redshift before&#13;&#10;// their move and Snowflake after, so daily KPIs and cost split correctly by platform.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Warehouse Cost - Focus' datatype='real' name='[Calculation_2007928041536179389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Warehouse Cost - Focus&#13;&#10;// dbt build cost plus direct consumer query cost, USD, in the window. 30d check: $4,189.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [build_cost_usd] + [consumer_query_cost_usd] END)' />
            </column>
            <column caption='Average Cost Per Day' datatype='real' name='[Calculation_2162546195325930241]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Average Cost Per Day&#13;&#10;// Mini KPI: window cost divided by the number of days in the window.&#13;&#10;[Calculation_2007928041536179389] / [Parameters].[Parameter 1]' />
            </column>
            <column caption='PF Snowflake Name' datatype='string' name='[Calculation_1203335104702411347]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Snowflake Name&#13;&#10;// &quot;Snowflake&quot; in its colour on the average-per-day line, when the filter shows it.&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;) THEN &quot;Snowflake&quot; END' />
            </column>
            <column caption='Cost Per Day Snowflake' datatype='real' name='[Calculation_1964666010242481635]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Cost Per Day Snowflake&#13;&#10;// Sub-line part, in the Snowflake colour. NULL when another platform is selected.&#13;&#10;SUM(IF [Calculation_1409194560049525583] AND [platform_on_day] = &quot;snowflake&quot;&#13;&#10;    THEN [build_cost_usd] + [consumer_query_cost_usd] END) / [Parameters].[Parameter 1]' />
            </column>
            <column caption='PF Snowflake Per Day Text' datatype='string' name='[Calculation_4702041613127393790]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Snowflake Per Day Text&#13;&#10;// &quot; $80&quot; after the name: Snowflake&apos;s cost per day in the window ($0 when it had none).&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;) THEN &quot; $&quot; + STR(INT(ROUND(ZN([Calculation_1964666010242481635])))) END' />
            </column>
            <column caption='PF Platform Separator' datatype='string' name='[Calculation_2748686657077975214]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Platform Separator&#13;&#10;// &quot; · &quot; between the platforms when all three are shown.&#13;&#10;IF [Parameters].[Parameter 2] = &quot;All&quot; THEN &quot;  ·  &quot; END' />
            </column>
            <column caption='PF Databricks Name' datatype='string' name='[Calculation_2005008339625904292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Databricks Name&#13;&#10;// &quot;Databricks&quot; in its colour on the average-per-day line, when the filter shows it.&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;databricks&quot;) THEN &quot;Databricks&quot; END' />
            </column>
            <column caption='Cost Per Day Databricks' datatype='real' name='[Calculation_2622736667316066365]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Cost Per Day Databricks&#13;&#10;// Sub-line part, in the Databricks colour.&#13;&#10;SUM(IF [Calculation_1409194560049525583] AND [platform_on_day] = &quot;databricks&quot;&#13;&#10;    THEN [build_cost_usd] + [consumer_query_cost_usd] END) / [Parameters].[Parameter 1]' />
            </column>
            <column caption='PF Databricks Per Day Text' datatype='string' name='[Calculation_1980839361186170002]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Databricks Per Day Text&#13;&#10;// &quot; $80&quot; after the name: Databricks&apos;s cost per day in the window ($0 when it had none).&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;databricks&quot;) THEN &quot; $&quot; + STR(INT(ROUND(ZN([Calculation_2622736667316066365])))) END' />
            </column>
            <column caption='PF Redshift Name' datatype='string' name='[Calculation_2886232109293083039]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Redshift Name&#13;&#10;// &quot;Redshift&quot; in its colour on the average-per-day line, when the filter shows it.&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;redshift&quot;) THEN &quot;Redshift&quot; END' />
            </column>
            <column caption='Cost Per Day Redshift' datatype='real' name='[Calculation_1816382868067773308]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Cost Per Day Redshift&#13;&#10;// Sub-line part, in the Redshift colour. NULL in the last 30 days (Redshift was retired on 15 Sep).&#13;&#10;SUM(IF [Calculation_1409194560049525583] AND [platform_on_day] = &quot;redshift&quot;&#13;&#10;    THEN [build_cost_usd] + [consumer_query_cost_usd] END) / [Parameters].[Parameter 1]' />
            </column>
            <column caption='PF Redshift Per Day Text' datatype='string' name='[Calculation_1279538948842296469]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Redshift Per Day Text&#13;&#10;// &quot; $80&quot; after the name: Redshift&apos;s cost per day in the window ($0 when it had none).&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;redshift&quot;) THEN &quot; $&quot; + STR(INT(ROUND(ZN([Calculation_1816382868067773308])))) END' />
            </column>
            <column caption='Build Cost Usd' datatype='real' name='[build_cost_usd]' role='measure' type='quantitative' />
            <column caption='Consumer Query Cost Usd' datatype='real' name='[consumer_query_cost_usd]' role='measure' type='quantitative' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Platform On Day' datatype='string' name='[platform_on_day]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1100032193373739257]' derivation='None' name='[none:Calculation_1100032193373739257:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2162546195325930241]' derivation='User' name='[usr:Calculation_2162546195325930241:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1203335104702411347]' derivation='Attribute' name='[attr:Calculation_1203335104702411347:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4702041613127393790]' derivation='User' name='[usr:Calculation_4702041613127393790:nk]' pivot='key' type='nominal' />
