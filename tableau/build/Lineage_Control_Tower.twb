              <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2496845894520933783]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_2008892738692294245]' derivation='User' name='[usr:Calculation_2008892738692294245:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2214252331607255986]' derivation='None' name='[none:Calculation_2214252331607255986:nk]' pivot='key' type='nominal' />
