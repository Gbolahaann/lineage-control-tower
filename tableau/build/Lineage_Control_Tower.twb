            <column caption='QA Issues Value Text' datatype='string' name='[Calculation_2761500021068615093]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// QA Issues Value Text&#13;&#10;// Row value, right, bold.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;7|All|0&quot; THEN &quot;46&quot;&#13;&#10;WHEN &quot;7|All|1&quot; THEN &quot;34&quot;&#13;&#10;WHEN &quot;7|All|2&quot; THEN &quot;5&quot;&#13;&#10;WHEN &quot;7|All|3&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;7|All|4&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;7|snowflake|0&quot; THEN &quot;42&quot;&#13;&#10;WHEN &quot;7|snowflake|1&quot; THEN &quot;32&quot;&#13;&#10;WHEN &quot;7|snowflake|2&quot; THEN &quot;5&quot;&#13;&#10;WHEN &quot;7|snowflake|3&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;7|snowflake|4&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;7|databricks|0&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;7|databricks|1&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;7|databricks|2&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|redshift|0&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;7|redshift|1&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;7|redshift|2&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;30|All|0&quot; THEN &quot;245&quot;&#13;&#10;WHEN &quot;30|All|1&quot; THEN &quot;121&quot;&#13;&#10;WHEN &quot;30|All|2&quot; THEN &quot;22&quot;&#13;&#10;WHEN &quot;30|All|3&quot; THEN &quot;19&quot;&#13;&#10;WHEN &quot;30|All|4&quot; THEN &quot;8&quot;&#13;&#10;WHEN &quot;30|snowflake|0&quot; THEN &quot;229&quot;&#13;&#10;WHEN &quot;30|snowflake|1&quot; THEN &quot;111&quot;&#13;&#10;WHEN &quot;30|snowflake|2&quot; THEN &quot;19&quot;&#13;&#10;WHEN &quot;30|snowflake|3&quot; THEN &quot;14&quot;&#13;&#10;WHEN &quot;30|snowflake|4&quot; THEN &quot;6&quot;&#13;&#10;WHEN &quot;30|databricks|0&quot; THEN &quot;16&quot;&#13;&#10;WHEN &quot;30|databricks|1&quot; THEN &quot;10&quot;&#13;&#10;WHEN &quot;30|databricks|2&quot; THEN &quot;5&quot;&#13;&#10;WHEN &quot;30|databricks|3&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;30|databricks|4&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;30|redshift|0&quot; THEN &quot;11&quot;&#13;&#10;WHEN &quot;30|redshift|1&quot; THEN &quot;9&quot;&#13;&#10;WHEN &quot;30|redshift|2&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;30|redshift|3&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;90|All|0&quot; THEN &quot;685&quot;&#13;&#10;WHEN &quot;90|All|1&quot; THEN &quot;454&quot;&#13;&#10;WHEN &quot;90|All|2&quot; THEN &quot;67&quot;&#13;&#10;WHEN &quot;90|All|3&quot; THEN &quot;55&quot;&#13;&#10;WHEN &quot;90|All|4&quot; THEN &quot;35&quot;&#13;&#10;WHEN &quot;90|snowflake|0&quot; THEN &quot;620&quot;&#13;&#10;WHEN &quot;90|snowflake|1&quot; THEN &quot;406&quot;&#13;&#10;WHEN &quot;90|snowflake|2&quot; THEN &quot;56&quot;&#13;&#10;WHEN &quot;90|snowflake|3&quot; THEN &quot;44&quot;&#13;&#10;WHEN &quot;90|snowflake|4&quot; THEN &quot;28&quot;&#13;&#10;WHEN &quot;90|databricks|0&quot; THEN &quot;65&quot;&#13;&#10;WHEN &quot;90|databricks|1&quot; THEN &quot;48&quot;&#13;&#10;WHEN &quot;90|databricks|2&quot; THEN &quot;11&quot;&#13;&#10;WHEN &quot;90|databricks|3&quot; THEN &quot;11&quot;&#13;&#10;WHEN &quot;90|databricks|4&quot; THEN &quot;7&quot;&#13;&#10;WHEN &quot;90|redshift|0&quot; THEN &quot;36&quot;&#13;&#10;WHEN &quot;90|redshift|1&quot; THEN &quot;34&quot;&#13;&#10;WHEN &quot;90|redshift|2&quot; THEN &quot;5&quot;&#13;&#10;WHEN &quot;90|redshift|3&quot; THEN &quot;4&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
