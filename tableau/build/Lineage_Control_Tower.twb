    <worksheet name='US Semantic Refresh Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='US Semantic Rank' datatype='integer' name='[Calculation_1591276624012025443]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// US Semantic Rank&#13;&#10;// Row of a semantic object: most failed refreshes in the period first, then lowest success,&#13;&#10;// live objects (nothing to refresh) with the fully successful ones (the prototype&apos;s order).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_finance_revenue&quot; THEN 2&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_board_kpis&quot; THEN 3&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_finance_close&quot; THEN 4&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_web_funnel&quot; THEN 5&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_sales_pipeline&quot; THEN 6&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_ops_monitor&quot; THEN 7&#13;&#10;WHEN &quot;7|All|semantic.sigma.sigma_customer_360&quot; THEN 8&#13;&#10;WHEN &quot;7|All|semantic.sigma.sigma_product_engagement&quot; THEN 9&#13;&#10;WHEN &quot;7|All|semantic.power_bi.pbi_marketing&quot; THEN 10&#13;&#10;WHEN &quot;7|All|semantic.power_bi.pbi_inventory&quot; THEN 11&#13;&#10;WHEN &quot;7|All|semantic.power_bi.pbi_support&quot; THEN 12&#13;&#10;WHEN &quot;7|snowflake|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;7|snowflake|semantic.tableau.pds_finance_revenue&quot; THEN 2&#13;&#10;WHEN &quot;7|snowflake|semantic.tableau.pds_board_kpis&quot; THEN 3&#13;&#10;WHEN &quot;7|snowflake|semantic.tableau.pds_finance_close&quot; THEN 4&#13;&#10;WHEN &quot;7|snowflake|semantic.tableau.pds_sales_pipeline&quot; THEN 5&#13;&#10;WHEN &quot;7|snowflake|semantic.tableau.pds_ops_monitor&quot; THEN 6&#13;&#10;WHEN &quot;7|snowflake|semantic.sigma.sigma_customer_360&quot; THEN 7&#13;&#10;WHEN &quot;7|snowflake|semantic.power_bi.pbi_marketing&quot; THEN 8&#13;&#10;WHEN &quot;7|snowflake|semantic.power_bi.pbi_inventory&quot; THEN 9&#13;&#10;WHEN &quot;7|databricks|semantic.tableau.pds_web_funnel&quot; THEN 1&#13;&#10;WHEN &quot;7|databricks|semantic.sigma.sigma_product_engagement&quot; THEN 2&#13;&#10;WHEN &quot;7|databricks|semantic.power_bi.pbi_support&quot; THEN 3&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_board_kpis&quot; THEN 2&#13;&#10;WHEN &quot;30|All|semantic.power_bi.pbi_support&quot; THEN 3&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_sales_pipeline&quot; THEN 4&#13;&#10;WHEN &quot;30|All|semantic.power_bi.pbi_inventory&quot; THEN 5&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_finance_revenue&quot; THEN 6&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_finance_close&quot; THEN 7&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_web_funnel&quot; THEN 8&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_ops_monitor&quot; THEN 9&#13;&#10;WHEN &quot;30|All|semantic.sigma.sigma_customer_360&quot; THEN 10&#13;&#10;WHEN &quot;30|All|semantic.sigma.sigma_product_engagement&quot; THEN 11&#13;&#10;WHEN &quot;30|All|semantic.power_bi.pbi_marketing&quot; THEN 12&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_board_kpis&quot; THEN 2&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_sales_pipeline&quot; THEN 3&#13;&#10;WHEN &quot;30|snowflake|semantic.power_bi.pbi_inventory&quot; THEN 4&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_finance_revenue&quot; THEN 5&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_finance_close&quot; THEN 6&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_ops_monitor&quot; THEN 7&#13;&#10;WHEN &quot;30|snowflake|semantic.sigma.sigma_customer_360&quot; THEN 8&#13;&#10;WHEN &quot;30|snowflake|semantic.power_bi.pbi_marketing&quot; THEN 9&#13;&#10;WHEN &quot;30|databricks|semantic.power_bi.pbi_support&quot; THEN 1&#13;&#10;WHEN &quot;30|databricks|semantic.tableau.pds_web_funnel&quot; THEN 2&#13;&#10;WHEN &quot;30|databricks|semantic.sigma.sigma_product_engagement&quot; THEN 3&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;90|All|semantic.power_bi.pbi_support&quot; THEN 2&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_finance_revenue&quot; THEN 3&#13;&#10;WHEN &quot;90|All|semantic.power_bi.pbi_inventory&quot; THEN 4&#13;&#10;WHEN &quot;90|All|semantic.power_bi.pbi_marketing&quot; THEN 5&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_sales_pipeline&quot; THEN 6&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_board_kpis&quot; THEN 7&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_finance_close&quot; THEN 8&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_web_funnel&quot; THEN 9&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_ops_monitor&quot; THEN 10&#13;&#10;WHEN &quot;90|All|semantic.sigma.sigma_customer_360&quot; THEN 11&#13;&#10;WHEN &quot;90|All|semantic.sigma.sigma_product_engagement&quot; THEN 12&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_finance_revenue&quot; THEN 2&#13;&#10;WHEN &quot;90|snowflake|semantic.power_bi.pbi_inventory&quot; THEN 3&#13;&#10;WHEN &quot;90|snowflake|semantic.power_bi.pbi_marketing&quot; THEN 4&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_sales_pipeline&quot; THEN 5&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_board_kpis&quot; THEN 6&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_finance_close&quot; THEN 7&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_ops_monitor&quot; THEN 8&#13;&#10;WHEN &quot;90|snowflake|semantic.sigma.sigma_customer_360&quot; THEN 9&#13;&#10;WHEN &quot;90|databricks|semantic.power_bi.pbi_support&quot; THEN 1&#13;&#10;WHEN &quot;90|databricks|semantic.tableau.pds_web_funnel&quot; THEN 2&#13;&#10;WHEN &quot;90|databricks|semantic.sigma.sigma_product_engagement&quot; THEN 3&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Is US Semantic Row' datatype='boolean' name='[Calculation_1717301173565009206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is US Semantic Row&#13;&#10;// Rows of the refresh table. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1591276624012025443])' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='US Spark Index' datatype='integer' name='[Calculation_2060391578778294933]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// US Spark Index&#13;&#10;// Day 0 to 89 along a sparkline (path).&#13;&#10;DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date])' />
            </column>
            <column caption='US Spark Point' datatype='spatial' name='[Calculation_1559731673072550002]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// US Spark Point&#13;&#10;// Failed refreshes that day, scaled to the object&apos;s busiest day (grey, all 90 days).&#13;&#10;MAKEPOINT(&#13;&#10;    (-7 + IIF({ FIXED [node_id] : MAX([refresh_failed]) } &gt; 0,&#13;&#10;        ZN([refresh_failed]) / { FIXED [node_id] : MAX([refresh_failed]) }, 0) * 14) / 100,&#13;&#10;    (421.3 + ([Calculation_2060391578778294933] + 0.5) * 1.9741 - 302.5) / 100&#13;&#10;)' />
            </column>
            <column caption='US Spark Window Point' datatype='spatial' name='[Calculation_7202346770402695873]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// US Spark Window Point&#13;&#10;// The same inside the selected window (red).&#13;&#10;IF DATEDIFF(&apos;day&apos;, [date], { MAX([date]) }) &lt; [Parameters].[Parameter 1] THEN MAKEPOINT(&#13;&#10;    (-7 + IIF({ FIXED [node_id] : MAX([refresh_failed]) } &gt; 0,&#13;&#10;        ZN([refresh_failed]) / { FIXED [node_id] : MAX([refresh_failed]) }, 0) * 14) / 100,&#13;&#10;    (421.3 + ([Calculation_2060391578778294933] + 0.5) * 1.9741 - 302.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='US Sem Name Text' datatype='string' name='[Calculation_8140781876698398080]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// US Sem Name Text&#13;&#10;// Semantic object name.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_revenue&quot; THEN &quot;pds_finance_revenue&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_commerce_sales&quot; THEN &quot;pds_commerce_sales&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_board_kpis&quot; THEN &quot;pds_board_kpis&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_close&quot; THEN &quot;pds_finance_close&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_web_funnel&quot; THEN &quot;pds_web_funnel&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_sales_pipeline&quot; THEN &quot;pds_sales_pipeline&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_ops_monitor&quot; THEN &quot;pds_ops_monitor&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_customer_360&quot; THEN &quot;sigma_customer_360&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_product_engagement&quot; THEN &quot;sigma_product_engagement&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_marketing&quot; THEN &quot;pbi_marketing&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_inventory&quot; THEN &quot;pbi_inventory&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_support&quot; THEN &quot;pbi_support&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='US Sem Name Point' datatype='spatial' name='[Calculation_1915867465279800040]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// US Sem Name Point&#13;&#10;// Name, left-aligned.&#13;&#10;MAKEPOINT(0, (CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_revenue&quot; THEN 58.8&#13;&#10;WHEN &quot;semantic.tableau.pds_commerce_sales&quot; THEN 59.7&#13;&#10;WHEN &quot;semantic.tableau.pds_board_kpis&quot; THEN 45.5&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_close&quot; THEN 52.0&#13;&#10;WHEN &quot;semantic.tableau.pds_web_funnel&quot; THEN 46.7&#13;&#10;WHEN &quot;semantic.tableau.pds_sales_pipeline&quot; THEN 53.2&#13;&#10;WHEN &quot;semantic.tableau.pds_ops_monitor&quot; THEN 48.8&#13;&#10;WHEN &quot;semantic.sigma.sigma_customer_360&quot; THEN 58.8&#13;&#10;WHEN &quot;semantic.sigma.sigma_product_engagement&quot; THEN 75.3&#13;&#10;WHEN &quot;semantic.power_bi.pbi_marketing&quot; THEN 41.4&#13;&#10;WHEN &quot;semantic.power_bi.pbi_inventory&quot; THEN 39.6&#13;&#10;WHEN &quot;semantic.power_bi.pbi_support&quot; THEN 35.8&#13;&#10;ELSE 0&#13;&#10;END - 302.5) / 100)' />
            </column>
            <column caption='Panel Tags Value' datatype='string' name='[Calculation_9860372241269830816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Tags Value&#13;&#10;// What a click writes into p_panel_tags: &quot;|moved|ai|unregistered|&quot; for the tags this node carries.&#13;&#10;&quot;|&quot; + IF NOT ISNULL([migrated_from_platform]) THEN &quot;moved|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF [build_method] = &quot;ai_assisted&quot; THEN &quot;ai|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF NOT [is_declared] THEN &quot;unregistered|&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='US Sem Failed Text' datatype='string' name='[Calculation_7012493816865350482]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// US Sem Failed Text&#13;&#10;// Failed refreshes in the period.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|semantic.tableau.pds_finance_revenue&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_commerce_sales&quot; THEN &quot;6&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_board_kpis&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_finance_close&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_web_funnel&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_sales_pipeline&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.tableau.pds_ops_monitor&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.sigma.sigma_customer_360&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.sigma.sigma_product_engagement&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_marketing&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_inventory&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;7|semantic.power_bi.pbi_support&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_finance_revenue&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_commerce_sales&quot; THEN &quot;11&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_board_kpis&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_finance_close&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_web_funnel&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_sales_pipeline&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_ops_monitor&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.sigma.sigma_customer_360&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.sigma.sigma_product_engagement&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_marketing&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_inventory&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;30|semantic.power_bi.pbi_support&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_finance_revenue&quot; THEN &quot;5&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_commerce_sales&quot; THEN &quot;14&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_board_kpis&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_finance_close&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_web_funnel&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_sales_pipeline&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_ops_monitor&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;90|semantic.sigma.sigma_customer_360&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;90|semantic.sigma.sigma_product_engagement&quot; THEN &quot;0&quot;&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_marketing&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_inventory&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_support&quot; THEN &quot;8&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='US Sem Tool Text' datatype='string' name='[Calculation_9659455732730307168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// US Sem Tool Text&#13;&#10;// BI tool.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_revenue&quot; THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_commerce_sales&quot; THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_board_kpis&quot; THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_close&quot; THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_web_funnel&quot; THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_sales_pipeline&quot; THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_ops_monitor&quot; THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_customer_360&quot; THEN &quot;Sigma&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_product_engagement&quot; THEN &quot;Sigma&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_marketing&quot; THEN &quot;Power BI&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_inventory&quot; THEN &quot;Power BI&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_support&quot; THEN &quot;Power BI&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='US Sem Tool Point' datatype='spatial' name='[Calculation_6094797652282486536]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// US Sem Tool Point&#13;&#10;// Tool, left-aligned.&#13;&#10;MAKEPOINT(0, (CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_revenue&quot; THEN 170.3&#13;&#10;WHEN &quot;semantic.tableau.pds_commerce_sales&quot; THEN 170.3&#13;&#10;WHEN &quot;semantic.tableau.pds_board_kpis&quot; THEN 170.3&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_close&quot; THEN 170.3&#13;&#10;WHEN &quot;semantic.tableau.pds_web_funnel&quot; THEN 170.3&#13;&#10;WHEN &quot;semantic.tableau.pds_sales_pipeline&quot; THEN 170.3&#13;&#10;WHEN &quot;semantic.tableau.pds_ops_monitor&quot; THEN 170.3&#13;&#10;WHEN &quot;semantic.sigma.sigma_customer_360&quot; THEN 166.7&#13;&#10;WHEN &quot;semantic.sigma.sigma_product_engagement&quot; THEN 166.7&#13;&#10;WHEN &quot;semantic.power_bi.pbi_marketing&quot; THEN 173.2&#13;&#10;WHEN &quot;semantic.power_bi.pbi_inventory&quot; THEN 173.2&#13;&#10;WHEN &quot;semantic.power_bi.pbi_support&quot; THEN 173.2&#13;&#10;ELSE 0&#13;&#10;END - 302.5) / 100)' />
            </column>
            <column caption='US Sem Mode Text' datatype='string' name='[Calculation_2622989630208407235]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// US Sem Mode Text&#13;&#10;// Connection: extract or live.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_revenue&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_commerce_sales&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_board_kpis&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_close&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_web_funnel&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_sales_pipeline&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_ops_monitor&quot; THEN &quot;live&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_customer_360&quot; THEN &quot;live&quot;&#13;&#10;WHEN &quot;semantic.sigma.sigma_product_engagement&quot; THEN &quot;live&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_marketing&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_inventory&quot; THEN &quot;extract&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_support&quot; THEN &quot;extract&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='US Sem Mode Point' datatype='spatial' name='[Calculation_2403185076481228497]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// US Sem Mode Point&#13;&#10;// Mode, left-aligned.&#13;&#10;MAKEPOINT(0, (CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_revenue&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.tableau.pds_commerce_sales&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.tableau.pds_board_kpis&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_close&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.tableau.pds_web_funnel&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.tableau.pds_sales_pipeline&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.tableau.pds_ops_monitor&quot; THEN 211.7&#13;&#10;WHEN &quot;semantic.sigma.sigma_customer_360&quot; THEN 211.7&#13;&#10;WHEN &quot;semantic.sigma.sigma_product_engagement&quot; THEN 211.7&#13;&#10;WHEN &quot;semantic.power_bi.pbi_marketing&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.power_bi.pbi_inventory&quot; THEN 219.7&#13;&#10;WHEN &quot;semantic.power_bi.pbi_support&quot; THEN 219.7&#13;&#10;ELSE 0&#13;&#10;END - 302.5) / 100)' />
