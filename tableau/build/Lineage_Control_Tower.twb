            <column caption='PF Pill Good Text' datatype='string' name='[Calculation_2202777234592407529]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Pill Good Text&#13;&#10;// Pill text in green.&#13;&#10;IF [Calculation_2255261106894237473] = &quot;Switched&quot; THEN [Calculation_2337790847276450150] END' />
