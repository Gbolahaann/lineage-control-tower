              <calculation class='tableau' formula='// Uses In Period (Type)&#13;&#10;// Total shown at the top right of each small multiple (put on Detail and reference it in the title).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [events] END)' />
            </column>
            <column caption='US Type Total Text' datatype='string' name='[Calculation_1169681039857698251]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// US Type Total Text&#13;&#10;// Total at the top right of a small multiple, as the prototype writes it: &quot;12.3K&quot;, &quot;418&quot;.&#13;&#10;IF [Calculation_1813047203116692796] &gt;= 1000 THEN STR(ROUND([Calculation_1813047203116692796] / 1000, 1)) + &quot;K&quot;&#13;&#10;ELSE STR(INT([Calculation_1813047203116692796])) END' />
            </column>
