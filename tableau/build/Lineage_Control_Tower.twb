        <calculation class='tableau' formula='// GOV Domain Good Point&#13;&#10;// Where each good text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(0.7600, 1.0200)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(0.4600, 1.0200)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(0.4600, 1.7200)&#13;&#10;WHEN &quot;All|12&quot; THEN MAKEPOINT(0.1600, 0.3200)&#13;&#10;WHEN &quot;All|13&quot; THEN MAKEPOINT(0.1600, 1.0200)&#13;&#10;WHEN &quot;All|14&quot; THEN MAKEPOINT(0.1600, 1.7200)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(0.7600, 1.0200)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(0.4600, 0.3200)&#13;&#10;WHEN &quot;snowflake|8&quot; THEN MAKEPOINT(0.4600, 1.0200)&#13;&#10;WHEN &quot;snowflake|9&quot; THEN MAKEPOINT(0.4600, 1.7200)&#13;&#10;WHEN &quot;snowflake|12&quot; THEN MAKEPOINT(0.1600, 0.3200)&#13;&#10;WHEN &quot;snowflake|13&quot; THEN MAKEPOINT(0.1600, 1.0200)&#13;&#10;WHEN &quot;snowflake|14&quot; THEN MAKEPOINT(0.1600, 1.7200)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(0.7600, 1.0200)&#13;&#10;WHEN &quot;databricks|4&quot; THEN MAKEPOINT(0.7600, 1.7200)&#13;&#10;WHEN &quot;databricks|7&quot; THEN MAKEPOINT(0.4600, 0.3200)&#13;&#10;WHEN &quot;databricks|8&quot; THEN MAKEPOINT(0.4600, 1.0200)&#13;&#10;WHEN &quot;databricks|9&quot; THEN MAKEPOINT(0.4600, 1.7200)&#13;&#10;ELSE NULL&#13;&#10;END' />
