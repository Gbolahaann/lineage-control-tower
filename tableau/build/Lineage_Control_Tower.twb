      <column caption='BR Risk Fed Text' datatype='string' name='[Calculation_1864176269908317609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// BR Risk Fed Text&#13;&#10;// Exposures fed. Written by the build.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.fct_board_kpis&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;model.acme_core.int_gl__mapped&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_core.int_payments__reconciled&quot; THEN &quot;10&quot;&#13;&#10;WHEN &quot;model.acme_core.stg_netsuite__accounts&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_core.stg_netsuite__gl_entries&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_core.stg_netsuite__journal_lines&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_core.stg_shopify__order_items&quot; THEN &quot;16&quot;&#13;&#10;WHEN &quot;model.acme_core.stg_wms__warehouses&quot; THEN &quot;8&quot;&#13;&#10;WHEN &quot;model.acme_marketing.dim_companies&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_ad_spend_daily&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;model.acme_marketing.fct_pipeline&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__attribution&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_ads__unified&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_campaigns__spend_daily&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;model.acme_marketing.int_deals__pipeline&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_google_ads__ad_stats&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__companies&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__contacts&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deal_stages&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_marketing.stg_hubspot__deals&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;model.acme_product.dim_customer_behavior&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_demand_signals&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_sessions&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;model.acme_product.fct_support_sla_daily&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;model.acme_product.int_customer_behavior&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;model.acme_product.int_funnel__steps&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;model.acme_product.int_sessions__stitched&quot; THEN &quot;6&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_events&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__app_installs&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;model.acme_product.stg_events__page_views&quot; THEN &quot;6&quot;&#13;&#10;WHEN &quot;semantic.power_bi.pbi_support&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_board_kpis&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_commerce_sales&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;semantic.tableau.pds_finance_revenue&quot; THEN &quot;6&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;10&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;6&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;6&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
