        <calculation class='tableau' formula='// Table Platform Fill Point&#13;&#10;// Platform pill fill.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (5) + 3 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((308) + (307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END - 1)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END - 1) - (308)) / 2 - 3) + 3 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
