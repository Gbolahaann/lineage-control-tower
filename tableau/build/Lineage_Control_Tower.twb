                      <formatted-text>
                        <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>Lineage Control Tower monitors every data product at Acme Retail Co. (fictional) and traces it back through dbt to the raw tables that feed it, one question per page.</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='0' />
                      </zone-style>
                    </zone>
                    <zone fixed-size='22' h='2200' id='1583' is-fixed='true' type-v2='text' w='25062' x='17312' y='28900'>
                      <formatted-text>
                        <run fontcolor='#7a838e' fontname='Arial' fontsize='7' bold='true'>DATA SOURCES</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='0' />
                        <format attr='padding-top' value='6' />
                      </zone-style>
                    </zone>
                    <zone h='11600' id='1584' type-v2='text' w='25062' x='17312' y='31100'>
                      <formatted-text>
                        <run fontcolor='#4a5563' fontname='Arial' fontsize='8'>One data source, &quot;Lineage Control Tower&quot;: 14 CSV tables from data/marts, related on node_id (dim_nodes) and date (dim_date), plus the exposure tile shapes (GeoJSON). Every number is synthetic, generated in Python.</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='0' />
                      </zone-style>
                    </zone>
                    <zone-style>
                      <format attr='border-color' value='#e6e7e2' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='1' />
                      <format attr='margin' value='0' />
                      <format attr='background-color' value='#ffffff' />
                      <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='10' />
                      <format attr='padding-top' value='14' />
                      <format attr='padding-right' value='16' />
                      <format attr='padding-bottom' value='14' />
                      <format attr='padding-left' value='16' />
                      <format attr='margin-right' value='7' />
                    </zone-style>
                  </zone>
                  <zone friendly-name='DOC Parameters Card' h='30000' id='1593' param='vert' type-v2='layout-flow' w='54375' x='43875' y='14200'>
                    <zone fixed-size='44' h='4400' id='1586' is-fixed='true' type-v2='text' w='51812' x='45375' y='15700'>
                      <formatted-text>
                        <run fontcolor='#16212e' fontname='Arial' fontsize='10' bold='true'>Parameters</run>
                        <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ&#10;</run>
                        <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Global, so a choice on one page carries to the next</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='0' />
