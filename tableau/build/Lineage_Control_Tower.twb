    <worksheet name='QA Heatmap Dates 30'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='QA Strip Header' datatype='string' name='[Calculation_4561048554171669019]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// QA Strip Header&#13;&#10;// An empty row header as wide as the heatmap&apos;s, so the date strip lines up with its columns.&#13;&#10;&quot; &quot;' />
            </column>
            <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
            </column>
            <column caption='Is In Heatmap Span' datatype='boolean' name='[Calculation_2700404503449311998]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is In Heatmap Span&#13;&#10;// The heatmap always shows at least 30 days, and the full window at 90.&#13;&#10;[days_before_as_of] &lt; IIF([Parameters].[Parameter 1] &gt; 30, [Parameters].[Parameter 1], 30)' />
            </column>
            <column caption='QA Monday Label' datatype='string' name='[Calculation_1256969906793957266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// QA Monday Label&#13;&#10;// Date labels over the heatmap: Mondays, &quot;Mon 21 Sep&quot; on the 30-day strip.&#13;&#10;IF DATEPART(&apos;weekday&apos;, [date (dim_date.csv)], &apos;monday&apos;) = 1&#13;&#10;THEN STR(DAY([date (dim_date.csv)])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [date (dim_date.csv)]), 3) END' />
            </column>
            <column caption='QA Monday Label 30' datatype='string' name='[Calculation_2942310133745287070]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// QA Monday Label 30&#13;&#10;// With the weekday, as the prototype at 30 days.&#13;&#10;IF NOT ISNULL([Calculation_1256969906793957266]) THEN &quot;Mon &quot; + [Calculation_1256969906793957266] END' />
            </column>
            <column caption='Date (Dates)' datatype='date' name='[date (dim_date.csv)]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
