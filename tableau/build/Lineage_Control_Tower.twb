            <column caption='Full Bar' datatype='real' name='[Calculation_2313436587575898004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Full Bar&#13;&#10;// Bar length for a full-width background (axis fixed 0 to 1 and hidden): buttons, alert rows.&#13;&#10;MIN(1.0)' />
            </column>
            <column caption='Panel Node Id' datatype='string' name='[Calculation_1386184292960313328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Node Id&#13;&#10;// Node shown in the side panel: the clicked node, or the exposure itself until a node is clicked.&#13;&#10;IF [Parameters].[Parameter 4] = &quot;&quot; THEN [Parameters].[Parameter 3]&#13;&#10;ELSE [Parameters].[Parameter 4]&#13;&#10;END' />
            </column>
            <column caption='Is Panel Node Daily' datatype='boolean' name='[Calculation_2646987086833843320]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Panel Node Daily&#13;&#10;// Filter for the Node Daily panel sheets (row-level compare on the fact&apos;s own key).&#13;&#10;[node_id] = [Calculation_1386184292960313328]' />
            </column>
            <column caption='Is Last 30 Days' datatype='boolean' name='[Calculation_3373060496381436566]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Last 30 Days&#13;&#10;// The test strip shows the last 30 days. Put on Filters (True).&#13;&#10;[days_before_as_of] &lt; 30' />
            </column>
            <column caption='Worst Test Label' datatype='string' name='[Calculation_4959349905375632629]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Worst Test Label&#13;&#10;// Worst test result of a model on a day (Node Daily). Palette: No run #EFEFEB, All passed #E3F2E9,&#13;&#10;// Warning #E8A33D, Failed #D2453F. The Lineage panel strip uses the strong green #2F9E6B for All passed instead.&#13;&#10;CASE [worst_test_code]&#13;&#10;WHEN 3 THEN &quot;Failed&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;All passed&quot;&#13;&#10;ELSE &quot;No run&quot;&#13;&#10;END' />
            </column>
            <column caption='Panel Test Key' datatype='string' name='[Calculation_1870315392599836731]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Test Key&#13;&#10;// Test strip colour (its own palette: strong green for All passed).&#13;&#10;[Calculation_4959349905375632629]' />
            </column>
