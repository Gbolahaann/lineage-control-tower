          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='AB Chain Chip' datatype='integer' name='[Calculation_1675367000128934840]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// AB Chain Chip&#13;&#10;// Which chip a scaffold model&apos;s Node Daily rows draw (0 to 5, raw sources first).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN 0&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN 1&#13;&#10;WHEN &quot;model.acme_core.dim_products&quot; THEN 2&#13;&#10;WHEN &quot;model.acme_core.dim_stores&quot; THEN 3&#13;&#10;WHEN &quot;model.acme_core.fct_board_kpis&quot; THEN 4&#13;&#10;WHEN &quot;model.acme_core.fct_finance_close&quot; THEN 5&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Is AB Chain Carrier' datatype='boolean' name='[Calculation_1209214612049002755]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is AB Chain Carrier&#13;&#10;// The six scaffold models. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1675367000128934840])' />
            </column>
            <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
            </column>
            <column caption='AB Chain Edge Point' datatype='spatial' name='[Calculation_3158814346728745150]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// AB Chain Edge Point&#13;&#10;// Chip outline: a rounded box in the line colour, rows 0 to 87.&#13;&#10;CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 6 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((0) + (79) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((79) / 2 - 6) + 6 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 1 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 6 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((101.625) + (54) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((54) / 2 - 6) + 6 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 2 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 6 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((178.25) + (77) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((77) / 2 - 6) + 6 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 3 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 6 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((277.875) + (45) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((45) / 2 - 6) + 6 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 4 THEN MAKEPOINT(&#13;&#10;    (-22.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 6 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((0) + (99) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((99) / 2 - 6) + 6 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 5 THEN MAKEPOINT(&#13;&#10;    (-22.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 6 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((121.625) + (68) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((68) / 2 - 6) + 6 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='AB Chain Fill Point' datatype='spatial' name='[Calculation_2626891144144372717]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// AB Chain Fill Point&#13;&#10;// Chip fill, 1 px inside the outline.&#13;&#10;CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 5 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((1) + (77) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((77) / 2 - 5) + 5 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 1 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 5 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((102.625) + (52) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((52) / 2 - 5) + 5 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 2 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 5 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((179.25) + (75) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((75) / 2 - 5) + 5 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 3 THEN MAKEPOINT(&#13;&#10;    (23.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 5 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((278.875) + (43) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((43) / 2 - 5) + 5 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 4 THEN MAKEPOINT(&#13;&#10;    (-22.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 5 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((1) + (97) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((97) / 2 - 5) + 5 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;WHEN 5 THEN MAKEPOINT(&#13;&#10;    (-22.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 5 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((122.625) + (66) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((66) / 2 - 5) + 5 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 209) / 100&#13;&#10;)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='AB Chain Label Text' datatype='string' name='[Calculation_2579459739728198310]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// AB Chain Label Text&#13;&#10;// Layer name (row 0 of its chip).&#13;&#10;IF [Calculation_2690238693341099106] = 0 THEN CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN &quot;Raw sources&quot;&#13;&#10;WHEN 1 THEN &quot;Staging&quot;&#13;&#10;WHEN 2 THEN &quot;Intermediate&quot;&#13;&#10;WHEN 3 THEN &quot;Marts&quot;&#13;&#10;WHEN 4 THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN 5 THEN &quot;Exposures&quot;&#13;&#10;ELSE NULL&#13;&#10;END END' />
            </column>
            <column caption='AB Chain Label Point' datatype='spatial' name='[Calculation_4484299174926464258]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// AB Chain Label Point&#13;&#10;// Left in the chip, top line (centred at half its measured width).&#13;&#10;IF [Calculation_2690238693341099106] = 0 THEN CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN MAKEPOINT(0.3050, -1.6930)&#13;&#10;WHEN 1 THEN MAKEPOINT(0.3050, -0.8036)&#13;&#10;WHEN 2 THEN MAKEPOINT(0.3050, 0.0778)&#13;&#10;WHEN 3 THEN MAKEPOINT(0.3050, 0.9116)&#13;&#10;WHEN 4 THEN MAKEPOINT(-0.1550, -1.5926)&#13;&#10;WHEN 5 THEN MAKEPOINT(-0.1550, -0.5328)&#13;&#10;ELSE NULL&#13;&#10;END END' />
            </column>
            <column caption='AB Chain Count Text' datatype='string' name='[Calculation_5325841394090348431]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// AB Chain Count Text&#13;&#10;// Nodes in the layer, counted live from dim_nodes (row 1 of its chip).&#13;&#10;IF [Calculation_2690238693341099106] = 1 THEN STR(CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN { FIXED : COUNTD(IF [layer] = &quot;source&quot; THEN [node_id (dim_nodes.csv)] END) }&#13;&#10;WHEN 1 THEN { FIXED : COUNTD(IF [layer] = &quot;staging&quot; THEN [node_id (dim_nodes.csv)] END) }&#13;&#10;WHEN 2 THEN { FIXED : COUNTD(IF [layer] = &quot;intermediate&quot; THEN [node_id (dim_nodes.csv)] END) }&#13;&#10;WHEN 3 THEN { FIXED : COUNTD(IF [layer] = &quot;mart&quot; THEN [node_id (dim_nodes.csv)] END) }&#13;&#10;WHEN 4 THEN { FIXED : COUNTD(IF [layer] = &quot;semantic&quot; THEN [node_id (dim_nodes.csv)] END) }&#13;&#10;WHEN 5 THEN { FIXED : COUNTD(IF [layer] = &quot;exposure&quot; THEN [node_id (dim_nodes.csv)] END) }&#13;&#10;ELSE NULL&#13;&#10;END) END' />
            </column>
            <column caption='AB Chain Count Point' datatype='spatial' name='[Calculation_1620475801785499367]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// AB Chain Count Point&#13;&#10;// Left in the chip, under the name (measured from today&apos;s count).&#13;&#10;IF [Calculation_2690238693341099106] = 1 THEN CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN MAKEPOINT(0.1550, -1.9256)&#13;&#10;WHEN 1 THEN MAKEPOINT(0.1550, -0.9094)&#13;&#10;WHEN 2 THEN MAKEPOINT(0.1550, -0.1431)&#13;&#10;WHEN 3 THEN MAKEPOINT(0.1550, 0.8531)&#13;&#10;WHEN 4 THEN MAKEPOINT(-0.3050, -1.9256)&#13;&#10;WHEN 5 THEN MAKEPOINT(-0.3050, -0.7094)&#13;&#10;ELSE NULL&#13;&#10;END END' />
            </column>
            <column caption='AB Chain Arrow Text' datatype='string' name='[Calculation_2847209239552114628]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// AB Chain Arrow Text&#13;&#10;// The arrow after a chip (row 2), not after the last.&#13;&#10;IF [Calculation_2690238693341099106] = 2 THEN CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN &quot;→&quot;&#13;&#10;WHEN 1 THEN &quot;→&quot;&#13;&#10;WHEN 2 THEN &quot;→&quot;&#13;&#10;WHEN 3 THEN &quot;→&quot;&#13;&#10;WHEN 4 THEN &quot;→&quot;&#13;&#10;ELSE NULL&#13;&#10;END END' />
