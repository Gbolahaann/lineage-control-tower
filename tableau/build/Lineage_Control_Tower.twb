        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Text' />
            <encodings>
              <text column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_6570730252120364370:nk]' />
              <text column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_8864060235112699764:nk]' />
