              <calculation class='tableau' formula='// AB Chain Arrow Point&#13;&#10;// Between two chips.&#13;&#10;IF [Calculation_2690238693341099106] = 2 THEN CASE [Calculation_1675367000128934840]&#13;&#10;WHEN 0 THEN MAKEPOINT(0.2350, -1.1869)&#13;&#10;WHEN 1 THEN MAKEPOINT(0.2350, -0.4206)&#13;&#10;WHEN 2 THEN MAKEPOINT(0.2350, 0.5756)&#13;&#10;WHEN 3 THEN MAKEPOINT(0.2350, 1.2519)&#13;&#10;WHEN 4 THEN MAKEPOINT(-0.2250, -0.9869)&#13;&#10;ELSE NULL&#13;&#10;END END' />
