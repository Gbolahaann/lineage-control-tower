            <column caption='Exposure Type Name' datatype='string' name='[Calculation_2968435387414133410]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Exposure Type Name&#13;&#10;// Display name for the consumer type.&#13;&#10;CASE [exposure_type]&#13;&#10;WHEN &quot;dashboard&quot; THEN &quot;Dashboard&quot;&#13;&#10;WHEN &quot;notebook&quot;  THEN &quot;Notebook&quot;&#13;&#10;WHEN &quot;ml&quot;        THEN &quot;ML model&quot;&#13;&#10;WHEN &quot;data_app&quot;  THEN &quot;Data app&quot;&#13;&#10;WHEN &quot;agent&quot;     THEN &quot;AI agent&quot;&#13;&#10;WHEN &quot;data_hub&quot;  THEN &quot;Data hub&quot;&#13;&#10;END' />
            </column>
            <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
            </column>
            <column caption='Panel Kind Line' datatype='string' name='[Calculation_2080349039431948818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Kind Line&#13;&#10;// Small line above the panel title: &quot;Staging · view&quot;, &quot;BI semantic layer · published_data_source&quot;, &quot;Exposures · Dashboard&quot;.&#13;&#10;[Calculation_7823664326256286450] + &quot; · &quot;&#13;&#10;+ IF [resource_type] = &quot;exposure&quot; THEN [Calculation_2968435387414133410]&#13;&#10;  ELSE IFNULL([materialization], IFNULL([semantic_object_type], [resource_type]))&#13;&#10;  END' />
            </column>
            <column caption='Panel Name' datatype='string' name='[Calculation_1877222636442730434]' role='dimension' type='nominal'>
