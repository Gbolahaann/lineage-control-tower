    <worksheet name='FR Source Lag Bullets'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Lag Sort' datatype='real' name='[Calculation_5834561475858190025]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Lag Sort&#13;&#10;// Latest relative to its SLA first, as in the prototype.&#13;&#10;[freshness_lag_min] / [error_after_minutes]' />
            </column>
            <column caption='Bullet Order' datatype='real' name='[Calculation_1617098935289657198]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Bullet Order&#13;&#10;// Latest relative to its SLA first (Lag Sort turned around, so the natural order is the right one).&#13;&#10;-[Calculation_5834561475858190025]' />
            </column>
            <column caption='Is Source' datatype='boolean' name='[Calculation_7370041543117874643]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Source&#13;&#10;// Keeps raw sources.&#13;&#10;[resource_type] = &quot;source&quot;' />
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Bullet Scale' datatype='real' name='[Calculation_3134732436745690889]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Bullet Scale&#13;&#10;// Each source on its own scale, as the prototype: to 1.25 x its error threshold, or past its lag.&#13;&#10;MAX([error_after_minutes] * 1.25, ZN([freshness_lag_min]) * 1.05)' />
            </column>
            <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
            </column>
            <column caption='Bullet Good Zone Point' datatype='spatial' name='[Calculation_3036502089728444550]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Good Zone Point&#13;&#10;// On-time zone, 0 to the warn threshold (green tint).&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0700 WHEN 1 THEN 0.0700 WHEN 2 THEN -0.0700 ELSE -0.0700 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * (0))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 ELSE (((210 + (327) * (0))) - 305.5) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Bullet Warn Zone Point' datatype='spatial' name='[Calculation_2518547156491336561]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Warn Zone Point&#13;&#10;// Warn zone, warn to error threshold (amber tint).&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0700 WHEN 1 THEN 0.0700 WHEN 2 THEN -0.0700 ELSE -0.0700 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 ELSE (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Bullet Error Zone Point' datatype='spatial' name='[Calculation_3171746235470183154]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Error Zone Point&#13;&#10;// Past the error threshold (red tint), to the end of the scale.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0700 WHEN 1 THEN 0.0700 WHEN 2 THEN -0.0700 ELSE -0.0700 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * (1))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * (1))) - 305.5) / 100 ELSE (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
            </column>
            <column caption='Bullet Lag Bar Point' datatype='spatial' name='[Calculation_3137052557468375359]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Lag Bar Point&#13;&#10;// The lag now, a 4 px bar in the status colour (at least 0.5 % long, as the prototype).&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0250 WHEN 1 THEN 0.0250 WHEN 2 THEN -0.0250 ELSE -0.0250 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * (0))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * (MAX(0.005, ZN([freshness_lag_min]) / [Calculation_3134732436745690889])))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * (MAX(0.005, ZN([freshness_lag_min]) / [Calculation_3134732436745690889])))) - 305.5) / 100 ELSE (((210 + (327) * (0))) - 305.5) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Bullet Value Text' datatype='string' name='[Calculation_1613376037383014604]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Value Text&#13;&#10;// Lag now as the prototype writes it: &quot;44 min&quot;, &quot;6.0 h&quot; (written by the build from dim_nodes).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;2 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;7 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;26 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;5.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;28 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;3 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;3.1 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;2.3 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;23.2 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;6.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;4 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;22.9 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;42 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;44 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;13 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;9 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;4 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;9 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;14 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;11 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;59 min&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;2.7 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;2.7 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;5.6 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;0 min&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;21 min&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;5.4 h&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Bullet Lag Tip' datatype='string' name='[Calculation_1499941139764820272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Lag Tip&#13;&#10;// LAG NOW in the tooltip.&#13;&#10;[Calculation_1613376037383014604]' />
            </column>
            <column caption='Bullet Warn Tip' datatype='string' name='[Calculation_8960573281369348412]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Warn Tip&#13;&#10;// WARN AFTER in the tooltip.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;10.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;10.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;48.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;48.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;2.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;24.0 h&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Bullet Error Tip' datatype='string' name='[Calculation_2611258565758139959]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Error Tip&#13;&#10;// ERROR AFTER in the tooltip.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;6.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;18.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;18.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;72.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;72.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;36.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;36.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;36.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;36.0 h&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Last Event Label' datatype='string' name='[Calculation_2229498162963349132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Last Event Label&#13;&#10;// The prototype&apos;s timestamp format: &quot;19 Oct, 21:25&quot;. &quot;-&quot; when the node has never run or been checked.&#13;&#10;IF ISNULL([last_event_at]) THEN &quot;-&quot;&#13;&#10;ELSE STR(DAY([last_event_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [last_event_at]), 3) + &quot;, &quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [last_event_at])), 2) + &quot;:&quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [last_event_at])), 2)&#13;&#10;END' />
            </column>
            <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='Bullet Name Text' datatype='string' name='[Calculation_3270933911152836450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Name Text&#13;&#10;// Source name, cut by the build to its 200 px column.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;raw_shopify.orders&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;raw_shopify.order_items&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;raw_shopify.customers&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;raw_shopify.products&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;raw_stripe.payments&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;raw_stripe.refunds&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;raw_netsuite.gl_entries&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;raw_netsuite.journal_lines&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;raw_netsuite.accounts&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;raw_wms.inventory&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;raw_wms.shipments&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;raw_wms.warehouses&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;raw_pos.store_sales&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;raw_dbt_artifacts.run_results&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;raw_events.web_sessions&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;raw_events.page_views&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;raw_events.search_events&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;raw_events.app_events&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;raw_zendesk.tickets&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;raw_zendesk.ticket_comments&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;raw_experiments.assignments&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;raw_google_ads.campaigns&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;raw_google_ads.ad_stats&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;raw_meta_ads.ad_insights&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;raw_hubspot.deals&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;raw_hubspot.contacts&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;raw_hubspot.companies&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Bullet Name Point' datatype='spatial' name='[Calculation_2438262903930881793]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Name Point&#13;&#10;// Name, left-aligned: centred half its measured width in from the left edge.&#13;&#10;MAKEPOINT(0, (CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN 44.5&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN 57.5&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN 53.9&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN 49.8&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN 49.0&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN 43.7&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN 54.6&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN 61.4&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN 52.9&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN 45.5&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN 48.1&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN 52.6&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN 48.7&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN 68.2&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN 62.0&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN 56.7&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN 63.2&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN 56.1&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN 47.8&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN 72.6&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN 71.7&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN 66.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN 60.5&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN 63.2&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN 44.6&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN 51.7&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN 57.6&#13;&#10;ELSE 0&#13;&#10;END - 305.5) / 100)' />
            </column>
            <column caption='Bullet Value Critical' datatype='string' name='[Calculation_2860129992511355501]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Value Critical&#13;&#10;// Lag value, red bold.&#13;&#10;IF [current_status_code] = 3 THEN [Calculation_1613376037383014604] END' />
            </column>
            <column caption='Bullet Value Warning' datatype='string' name='[Calculation_2076494762075167363]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Value Warning&#13;&#10;// Lag value, amber bold.&#13;&#10;IF [current_status_code] = 2 THEN [Calculation_1613376037383014604] END' />
            </column>
            <column caption='Bullet Value Normal' datatype='string' name='[Calculation_8313506078945889371]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Bullet Value Normal&#13;&#10;// Lag value, grey, on time.&#13;&#10;IF [current_status_code] &lt; 2 THEN [Calculation_1613376037383014604] END' />
            </column>
            <column caption='Bullet Value Point' datatype='spatial' name='[Calculation_7742891051247665925]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Bullet Value Point&#13;&#10;// Value, right-aligned: centred half its measured width in from the right edge.&#13;&#10;MAKEPOINT(0, (305.5 - CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN 15.1&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN 15.1&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN 16.5&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN 12.1&#13;&#10;ELSE 0&#13;&#10;END) / 100)' />
            </column>
