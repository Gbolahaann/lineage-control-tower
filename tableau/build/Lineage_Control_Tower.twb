          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Panel Node Id' datatype='string' name='[Calculation_1386184292960313328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Node Id&#13;&#10;// Node shown in the side panel: the clicked node, or the exposure itself until a node is clicked.&#13;&#10;IF [Parameters].[Parameter 4] = &quot;&quot; THEN [Parameters].[Parameter 3]&#13;&#10;ELSE [Parameters].[Parameter 4]&#13;&#10;END' />
            </column>
            <column caption='Is Panel Node' datatype='boolean' name='[Calculation_2972930213303912559]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Panel Node&#13;&#10;// Filter for every Nodes-based panel sheet.&#13;&#10;[node_id (dim_nodes.csv)] = [Calculation_1386184292960313328]' />
            </column>
            <column caption='Last Runtime Label' datatype='string' name='[Calculation_1403910267805111020]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Last Runtime Label&#13;&#10;// Last model runtime in the prototype&apos;s duration format: &quot;45s&quot;, &quot;27.9 min&quot; or &quot;1.2 h&quot;.&#13;&#10;IF ISNULL([last_runtime_sec]) THEN &quot;&quot;&#13;&#10;ELSEIF [last_runtime_sec] &lt; 60 THEN STR(ROUND([last_runtime_sec])) + &quot;s&quot;&#13;&#10;ELSEIF [last_runtime_sec] &lt; 3600 THEN STR(ROUND([last_runtime_sec] / 60, 1)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([last_runtime_sec] / 3600, 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='Panel Last Run Text' datatype='string' name='[Calculation_2436608709301960229]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Last Run Text&#13;&#10;// Bold part of &quot;Last run 1s at 19 Oct, 21:25&quot;.&#13;&#10;IF [Calculation_1403910267805111020] = &quot;&quot; THEN &quot;-&quot; ELSE [Calculation_1403910267805111020] END' />
            </column>
            <column caption='Last Event Label' datatype='string' name='[Calculation_2229498162963349132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Last Event Label&#13;&#10;// The prototype&apos;s timestamp format: &quot;19 Oct, 21:25&quot;. &quot;-&quot; when the node has never run or been checked.&#13;&#10;IF ISNULL([last_event_at]) THEN &quot;-&quot;&#13;&#10;ELSE STR(DAY([last_event_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [last_event_at]), 3) + &quot;, &quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [last_event_at])), 2) + &quot;:&quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [last_event_at])), 2)&#13;&#10;END' />
            </column>
            <column caption='Last Event At' datatype='datetime' name='[last_event_at]' role='dimension' type='ordinal' />
            <column caption='Last Runtime Sec' datatype='real' name='[last_runtime_sec]' role='measure' type='quantitative' />
