    <worksheet name='HO Tiles AI Agents Data Hubs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
            <column alias='All' caption='p_tile_view' datatype='string' datatype-customized='true' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Needs attention&quot;' value='Needs attention' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Needs attention' value='&quot;Needs attention&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Tile Row' datatype='integer' name='[Calculation_1091687039505899741]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Tile Row&#13;&#10;// Row inside each group. Same compute-using and sort as Tile Column. Make it discrete.&#13;&#10;INT((INDEX() - 1) / 5) + 1'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_4441281616373123992]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Tile Column' datatype='integer' name='[Calculation_7154026945591774946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Tile Column&#13;&#10;// Column 1 to 5 in the tile grid (the prototype shows 5 tiles per row).&#13;&#10;// Table calc: Specific dimensions = exposure_group, node_id (dim_nodes.csv); restart every exposure_group;&#13;&#10;// sort by Tile Sort Key, MIN, ascending. Make it discrete.&#13;&#10;(INDEX() - 1) % 5 + 1'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_4441281616373123992]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Is Exposure' datatype='boolean' name='[Calculation_8377152860883702219]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Exposure&#13;&#10;// Keeps exposure rows only. Put on Filters (True).&#13;&#10;[resource_type] = &quot;exposure&quot;' />
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Is At Risk Now' datatype='boolean' name='[Calculation_2875175252813195699]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is At Risk Now&#13;&#10;// Warning or Critical in the current snapshot. Shared by Health, Blast radius and Governance.&#13;&#10;[current_status_code] &gt;= 2' />
            </column>
            <column caption='Show Exposure Tile' datatype='boolean' name='[Calculation_1065115793061580082]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Show Exposure Tile&#13;&#10;// The All / Needs attention switch above the grid.&#13;&#10;[Parameters].[Parameter 8] = &quot;All&quot;&#13;&#10;OR [Calculation_2875175252813195699]' />
            </column>
            <column caption='Exposure Group Sort' datatype='integer' name='[Calculation_1368642606501877949]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Exposure Group Sort&#13;&#10;// Prototype group order: BI dashboards, Apps ML and notebooks, AI agents and data hubs, Unregistered.&#13;&#10;CASE [exposure_group]&#13;&#10;WHEN &quot;BI dashboards&quot;                        THEN 1&#13;&#10;WHEN &quot;Apps, ML and notebooks&quot;               THEN 2&#13;&#10;WHEN &quot;AI agents and data hubs&quot;              THEN 3&#13;&#10;WHEN &quot;Unregistered, found in query history&quot; THEN 4&#13;&#10;END' />
            </column>
            <column caption='Is Tile Group 3' datatype='boolean' name='[Calculation_1578473119693928549]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Tile Group 3&#13;&#10;// Keeps the tiles of one exposure group on its own sheet. Put on Filters (True).&#13;&#10;[Calculation_1368642606501877949] = 3' />
            </column>
            <column caption='Tile Sort Key' datatype='string' name='[Calculation_4441281616373123992]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Sort Key&#13;&#10;// Worst first, then name, inside each group: &quot;6...&quot; Critical, &quot;7...&quot; Warning, &quot;8...&quot; Healthy.&#13;&#10;// Used as the custom sort (MIN, ascending) of the tile INDEX.&#13;&#10;STR(9 - [current_status_code]) + [display_name]' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
            </column>
            <column caption='Tile Border Key' datatype='string' name='[Calculation_2146754034371610369]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Border Key&#13;&#10;// Tile border colour by status (#E6E7E2, warning #F1DDB8, critical #EDC3C0).&#13;&#10;[Calculation_3105941082857465865]' />
            </column>
            <column caption='Exposure Path Index' datatype='integer' name='[Calculation_2209184240857417826]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Exposure Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Exposure Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date (mart_exposure_daily.csv)]) }, [date (mart_exposure_daily.csv)]), 87)' />
            </column>
            <column caption='Tile Border Point' datatype='spatial' name='[Calculation_3333512912099760788]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Border Point&#13;&#10;// Tile outline, 162 x 62 px, radius 8.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 23 + 8 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((84.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 72 + 8 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
            </column>
            <column caption='Clear Node Value' datatype='string' name='[Calculation_1962397006096080865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Clear Node Value&#13;&#10;// Empty string a parameter action can write into p_selected_node, to clear it (prototype: opening an exposure clears the node).&#13;&#10;&quot;&quot;' />
            </column>
            <column caption='Clear Node Key Value' datatype='integer' name='[Calculation_7177065549275409274]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Clear Node Key Value&#13;&#10;// Companion to Clear Node Value for p_selected_node_key. -1 matches no node.&#13;&#10;-1' />
            </column>
            <column caption='Panel Tags Value' datatype='string' name='[Calculation_9860372241269830816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Tags Value&#13;&#10;// What a click writes into p_panel_tags: &quot;|moved|ai|unregistered|&quot; for the tags this node carries.&#13;&#10;&quot;|&quot; + IF NOT ISNULL([migrated_from_platform]) THEN &quot;moved|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF [build_method] = &quot;ai_assisted&quot; THEN &quot;ai|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF NOT [is_declared] THEN &quot;unregistered|&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile Score Text' datatype='string' name='[Calculation_1659843968626155727]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Score Text&#13;&#10;// 7-day health score on the tile, one decimal: &quot;99.7&quot;.&#13;&#10;IF ISNULL([health_score_now]) THEN &quot;&quot;&#13;&#10;ELSE STR(INT(ROUND([health_score_now] * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([health_score_now] * 10)) % 10)&#13;&#10;END' />
            </column>
            <column caption='Tile Tooltip Why' datatype='string' name='[Calculation_1883889205833775337]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Tooltip Why&#13;&#10;// Tooltip &quot;Why&quot; block: the upstream nodes behind the status, or a reassurance line.&#13;&#10;IF [culprit_count] &gt; 0 THEN [culprit_nodes]&#13;&#10;ELSE &quot;Every upstream step is healthy&quot;&#13;&#10;END' />
            </column>
            <column caption='Tile Fill Key' datatype='string' name='[Calculation_2950369687746909721]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Fill Key&#13;&#10;// Tile fill by status: white, critical #FBEAE9.&#13;&#10;[Calculation_3105941082857465865]' />
            </column>
            <column caption='Tile Fill Point' datatype='spatial' name='[Calculation_1871695570403440015]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Fill Point&#13;&#10;// Tile fill, 1px inside the border.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 23 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((84.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 72 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
            </column>
            <column caption='Tile Edge Key' datatype='string' name='[Calculation_2561198721248056038]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Edge Key&#13;&#10;// The 3px top edge of a tile: critical #D2453F, warning #FDF3E1, otherwise the fill.&#13;&#10;[Calculation_3105941082857465865]' />
            </column>
            <column caption='Tile Edge Point' datatype='spatial' name='[Calculation_1113835329291751442]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Edge Point&#13;&#10;// The coloured top edge: the fill cut to its top 3px.&#13;&#10;MAKEPOINT(&#13;&#10;    MAX((0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 23 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100, 0.2700),&#13;&#10;    ((84.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 72 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
            </column>
            <column caption='Tile Dot Point' datatype='spatial' name='[Calculation_1781533279255170688]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Dot Point&#13;&#10;// Status dot, 8px, top right.&#13;&#10;MAKEPOINT(&#13;&#10;    (15 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 4 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((149.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 0 + 4 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
            </column>
            <column caption='Tile AI Border Point' datatype='spatial' name='[Calculation_2037306926675212976]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile AI Border Point&#13;&#10;// AI-built pill outline after the trust badge; shrinks away when the tile is not AI-built.&#13;&#10;MAKEPOINT(&#13;&#10;    (-17 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 4 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((4 + CASE [current_status_code] WHEN 3 THEN 87.3 WHEN 2 THEN 113.0 ELSE 72.9 END) - 84 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 19.5 + 4 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
            </column>
            <column caption='Tile AI Fill Point' datatype='spatial' name='[Calculation_1853842245305432435]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile AI Fill Point&#13;&#10;// AI-built pill fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (-17 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 3 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((4 + CASE [current_status_code] WHEN 3 THEN 87.3 WHEN 2 THEN 113.0 ELSE 72.9 END) - 84 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 19.5 + 3 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
            </column>
            <column caption='Tile Name Short' datatype='string' name='[Calculation_8990803335852813669]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Name Short&#13;&#10;// Tile title cut to fit the card beside the status dot: 17 characters, then &quot;…&quot;.&#13;&#10;IF LEN([display_name]) &gt; 18 THEN LEFT([display_name], 17) + &quot;…&quot; ELSE [display_name] END' />
            </column>
            <column caption='Tile Name Point' datatype='spatial' name='[Calculation_2021794883042844412]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Name Point&#13;&#10;// Start of the tile name.&#13;&#10;MAKEPOINT(&#13;&#10;    0.1500,&#13;&#10;    -0.7400&#13;&#10;)' />
            </column>
            <column caption='Consumer Type Label' datatype='string' name='[Calculation_2336170961516567926]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Consumer Type Label&#13;&#10;// Tile meta line: the BI tool for dashboards, otherwise the consumer type.&#13;&#10;IF NOT ISNULL([bi_tool]) THEN&#13;&#10;    CASE [bi_tool]&#13;&#10;    WHEN &quot;tableau&quot;  THEN &quot;Tableau&quot;&#13;&#10;    WHEN &quot;sigma&quot;    THEN &quot;Sigma&quot;&#13;&#10;    WHEN &quot;power_bi&quot; THEN &quot;Power BI&quot;&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    CASE [exposure_type]&#13;&#10;    WHEN &quot;dashboard&quot; THEN &quot;Dashboard&quot;&#13;&#10;    WHEN &quot;notebook&quot;  THEN &quot;Notebook&quot;&#13;&#10;    WHEN &quot;ml&quot;        THEN &quot;ML model&quot;&#13;&#10;    WHEN &quot;data_app&quot;  THEN &quot;Data app&quot;&#13;&#10;    WHEN &quot;agent&quot;     THEN &quot;AI agent&quot;&#13;&#10;    WHEN &quot;data_hub&quot;  THEN &quot;Data hub&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Tile Owner Text' datatype='string' name='[Calculation_3035768374696072600]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Owner Text&#13;&#10;// Owner on the tile meta line, grey. Empty when there is no owner (the red version takes over).&#13;&#10;IF [owner_name] &lt;&gt; &quot;No owner&quot; THEN [owner_name] ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile Meta Text' datatype='string' name='[Calculation_9469610853407196222]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Meta Text&#13;&#10;// Second tile line, grey: &quot;Tableau · Priya Raman&quot; (the red &quot;No owner&quot; follows when there is none).&#13;&#10;[Calculation_2336170961516567926] + &quot; · &quot; + [Calculation_3035768374696072600]' />
            </column>
            <column caption='Tile Owner Missing Text' datatype='string' name='[Calculation_2565169924538089914]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Owner Missing Text&#13;&#10;// &quot;No owner&quot; in red bold on the meta line (story 8 and the unregistered consumers).&#13;&#10;IF [owner_name] = &quot;No owner&quot; THEN &quot;No owner&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile Meta Point' datatype='spatial' name='[Calculation_2094161589767259837]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Meta Point&#13;&#10;// Start of the tool and owner line.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.0100,&#13;&#10;    -0.7400&#13;&#10;)' />
            </column>
            <column caption='Tile Trust Critical' datatype='string' name='[Calculation_2803746157308900676]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Trust Critical&#13;&#10;// Trust badge in red. Only one of the three trust fields is filled for a tile.&#13;&#10;IF [current_status_code] = 3 THEN [trust_badge] ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile Trust Warning' datatype='string' name='[Calculation_1833995497923574551]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Trust Warning&#13;&#10;// Trust badge in the warning text colour #93600F.&#13;&#10;IF [current_status_code] = 2 THEN [trust_badge] ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile Trust Healthy' datatype='string' name='[Calculation_1522121282636949905]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile Trust Healthy&#13;&#10;// Trust badge in green.&#13;&#10;IF [current_status_code] &lt; 2 THEN [trust_badge] ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile Trust Point' datatype='spatial' name='[Calculation_1637570669490700936]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Trust Point&#13;&#10;// Start of the trust badge.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.1700,&#13;&#10;    -0.7400&#13;&#10;)' />
            </column>
            <column caption='Tile AI Tag' datatype='string' name='[Calculation_4692392410293798022]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile AI Tag&#13;&#10;// &quot;AI-built&quot; chip text for ai_assisted exposures (story 10 and the agents).&#13;&#10;IF [build_method] = &quot;ai_assisted&quot; THEN &quot;AI-built&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile AI Text Point' datatype='spatial' name='[Calculation_2807702554943169410]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile AI Text Point&#13;&#10;// Middle of the AI-built pill.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.1700,&#13;&#10;    ((4 + CASE [current_status_code] WHEN 3 THEN 87.3 WHEN 2 THEN 113.0 ELSE 72.9 END) - 84) / 100&#13;&#10;)' />
            </column>
            <column caption='Tile Score Point' datatype='spatial' name='[Calculation_3365331846570732051]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tile Score Point&#13;&#10;// Right end of the score: 15px in from the card edge, as GB set it on v13.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.1700,&#13;&#10;    0.6500&#13;&#10;)' />
            </column>
