      <column caption='Table Row Key' datatype='string' name='[Calculation_3315487402959781063]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Row Key&#13;&#10;// Highlights the selected node&apos;s row (light accent), as in the prototype.&#13;&#10;IF [Calculation_2543776221048440310] THEN &quot;Selected&quot; ELSE &quot;Default&quot; END' />
