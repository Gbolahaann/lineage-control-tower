            </column>
            <column caption='BR Who Trust Healthy' datatype='string' name='[Calculation_1093410587256416372]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// BR Who Trust Healthy&#13;&#10;// Status pill text, healthy colour.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.lineage_control_tower&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_product.product_engagement&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_product.web_funnel_analysis&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_product.pricing_experiment_analysis&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_marketing.marketing_campaign_performance&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.observed.undeclared_promo_notebook&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_marketing.sales_pipeline&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.observed.undeclared_regional_hub&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_core.partner_revenue_share&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;WHEN &quot;exposure.acme_product.support_sla_tracker&quot; THEN &quot;✓  Trusted&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='BR Who Pill Text Point' datatype='spatial' name='[Calculation_1002657263860301661]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// BR Who Pill Text Point&#13;&#10;// Middle of the pill.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.lineage_control_tower&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.customer_360&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_product.product_engagement&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_product.churn_prediction_model&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_product.web_funnel_analysis&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_product.pricing_experiment_analysis&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_product.demand_forecast_app&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_marketing.marketing_campaign_performance&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.observed.undeclared_promo_notebook&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.executive_revenue_dashboard&quot; THEN MAKEPOINT(0, (518.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack&quot; THEN MAKEPOINT(0, (518.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_marketing.sales_pipeline&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.finance_close_tracker&quot; THEN MAKEPOINT(0, (518.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.finance_qa_agent&quot; THEN MAKEPOINT(0, (518.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.supply_chain_ops&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.store_ops_hub&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.observed.undeclared_regional_hub&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.partner_revenue_share&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.merchandising_copilot&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.observed.undeclared_pricing_agent&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_core.inventory_health&quot; THEN MAKEPOINT(0, (532.9 - 296.5) / 100)&#13;&#10;WHEN &quot;exposure.acme_product.support_sla_tracker&quot; THEN MAKEPOINT(0, (511.4 - 296.5) / 100)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
