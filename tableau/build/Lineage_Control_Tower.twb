        <calculation class='tableau' formula='// BR Risk Heading Point&#13;&#10;// Middle of a column title (measured by the build).&#13;&#10;MAKEPOINT(0, (CASE [day_index]&#13;&#10;WHEN 0 THEN 10.6&#13;&#10;WHEN 1 THEN 60.5&#13;&#10;WHEN 2 THEN 261.5&#13;&#10;WHEN 3 THEN 387.7&#13;&#10;WHEN 4 THEN 557.1&#13;&#10;WHEN 5 THEN 657.7&#13;&#10;WHEN 6 THEN 772.2&#13;&#10;WHEN 7 THEN 852.2&#13;&#10;WHEN 8 THEN 1185.5&#13;&#10;ELSE 0&#13;&#10;END - 628) / 100)' />
