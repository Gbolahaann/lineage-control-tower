          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Late Pill Border Point' datatype='spatial' name='[Calculation_1501965132719312571]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Pill Border Point&#13;&#10;// Status pill outline (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6350, -1.3650), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6350, -0.7486), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6050, -0.7186), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.5050, -0.7186), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.4750, -0.7486), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.4750, -1.3650), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.5050, -1.3950), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6050, -1.3950), NULL)&#13;&#10;END' />
            </column>
            <column caption='Late Shape Id' datatype='integer' name='[Calculation_5402477272524234802]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Late Shape Id&#13;&#10;// Which pill or chip a scaffold row draws (8 rows each).&#13;&#10;INT([day_index] / 8)' />
            </column>
            <column caption='Late Shape Point Order' datatype='integer' name='[Calculation_1514529175384296372]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Late Shape Point Order&#13;&#10;// Point 0 to 7 round the shape (path).&#13;&#10;[day_index] % 8' />
            </column>
            <column caption='Late Pill Key' datatype='string' name='[Calculation_2885006952513766161]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Pill Key&#13;&#10;// Pill colours by status.&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 0 THEN &quot;Warning&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Pill Fill Point' datatype='spatial' name='[Calculation_2907567794637741529]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Pill Fill Point&#13;&#10;// Status pill fill, 1 px inside.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6250, -1.3650), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6250, -0.7486), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6050, -0.7286), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.5050, -0.7286), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.4850, -0.7486), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.4850, -1.3650), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.5050, -1.3850), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.6050, -1.3850), NULL)&#13;&#10;END' />
            </column>
            <column caption='Late Chip Border Point' datatype='spatial' name='[Calculation_3225091204895001805]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Chip Border Point&#13;&#10;// Data product chip outline.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 8 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2550, -1.3650), NULL)&#13;&#10;WHEN 9 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2550, -0.0124), NULL)&#13;&#10;WHEN 10 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2250, 0.0176), NULL)&#13;&#10;WHEN 11 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.1250, 0.0176), NULL)&#13;&#10;WHEN 12 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.0950, -0.0124), NULL)&#13;&#10;WHEN 13 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.0950, -1.3650), NULL)&#13;&#10;WHEN 14 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.1250, -1.3950), NULL)&#13;&#10;WHEN 15 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2250, -1.3950), NULL)&#13;&#10;WHEN 16 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2550, 0.0876), NULL)&#13;&#10;WHEN 17 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2550, 0.8095), NULL)&#13;&#10;WHEN 18 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2250, 0.8395), NULL)&#13;&#10;WHEN 19 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parame