        <calculation class='tableau' formula='// Lineage Label Faded&#13;&#10;// Box name in pale grey, for boxes off the selected path.&#13;&#10;IF [row_type] = &quot;node&quot; AND NOT [Calculation_2720870856721498789] THEN [Calculation_3399849254129370742] END' />
      </column>
      <column caption='Lineage Label Exposure' datatype='string' name='[Calculation_8918052964969563599]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Lineage Label Exposure&#13;&#10;// The exposure&apos;s own box name, in bold.&#13;&#10;IF [row_type] = &quot;node&quot; AND [node_id (mart_lineage_layout.csv)] = [layout_scope] THEN [Calculation_3399849254129370742] END' />
