              <calculation class='tableau' formula='// BR Pill Status Point&#13;&#10;// Status pill (status tint), rows 0 to 87 of the first carrier.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 5 + 4 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((0) + (CASE [Parameters].[Parameter 4]&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN 58&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN 58&#13;&#10;WH