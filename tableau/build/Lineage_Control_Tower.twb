      <column caption='Table Layer Point' datatype='spatial' name='[Calculation_3094586231087995518]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Layer Point&#13;&#10;// Middle of the layer name.&#13;&#10;IF [row_type] = &quot;node&quot; THEN MAKEPOINT(0, ((199 + [Calculation_2382819482069011588] / 2) - 454.5) / 100) END' />
      </column>
      <column caption='Table Platform Snowflake' datatype='string' name='[Calculation_1692058321836367076]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Platform Snowflake&#13;&#10;// Coloured square in the platform pill.&#13;&#10;IF [platform_now] = &quot;snowflake&quot; THEN &quot;■ &quot; END' />
      </column>
      <column caption='Table Platform Databricks' datatype='string' name='[Calculation_1229764877727306520]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Platform Databricks&#13;&#10;// Coloured square in the platform pill.&#13;&#10;IF [platform_now] = &quot;databricks&quot; THEN &quot;■ &quot; END' />
      </column>
      <column caption='Table Platform Redshift' datatype='string' name='[Calculation_1342305447691403312]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Platform Redshift&#13;&#10;// Coloured square in the platform pill.&#13;&#10;IF [platform_now] = &quot;redshift&quot; THEN &quot;■ &quot; END' />
      </column>
      <column caption='Table Platform Text Point' datatype='spatial' name='[Calculation_1454757948850613321]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Platform Text Point&#13;&#10;// Middle of the platform pill.&#13;&#10;IF [row_type] = &quot;node&quot; THEN MAKEPOINT(0, ((307 + (CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END) / 2) - 454.5) / 100) END' />
      </column>
      <column caption='Table Status Critical' datatype='string' name='[Calculation_2307749869215472046]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Status Critical&#13;&#10;// Status pill text, red. One of the four status fields is filled per row.&#13;&#10;IF [current_status_code] = 3 THEN &quot;✕ Critical&quot; END' />
      </column>
      <column caption='Table Status Warning' datatype='string' name='[Calculation_3199408619509195321]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Status Warning&#13;&#10;// Status pill text, amber ink.&#13;&#10;IF [current_status_code] = 2 THEN &quot;▲ Warning&quot; END' />
      </column>
      <column caption='Table Status Healthy' datatype='string' name='[Calculation_1365196371762527086]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Status Healthy&#13;&#10;// Status pill text, green.&#13;&#10;IF [current_status_code] = 1 THEN &quot;✓ Healthy&quot; END' />
      </column>
      <column caption='Table Status No Data' datatype='string' name='[Calculation_3850409175751531363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Status No Data&#13;&#10;// Status pill text, grey.&#13;&#10;IF [current_status_code] = 0 THEN &quot;– No data&quot; END' />
      </column>
      <column caption='Table Status Text Point' datatype='spatial' name='[Calculation_1516897192244032907]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Status Text Point&#13;&#10;// Middle of the status pill.&#13;&#10;IF [row_type] = &quot;node&quot; THEN MAKEPOINT(0, ((401 + (CASE [Calculation_3105941082857465865] WHEN &quot;Critical&quot; THEN 57 WHEN &quot;Warning&quot; THEN 65 WHEN &quot;Healthy&quot; THEN 59 WHEN &quot;No data&quot; THEN 58 ELSE 0 END) / 2) - 454.5) / 100) END' />
      </column>
      <column caption='Table Hops Text' datatype='string' name='[Calculation_4660940884838871421]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Hops Text&#13;&#10;// Hops from the node to the graph&apos;s exposure, written by the build from Blast Radius and keyed on&#13;&#10;// Lineage Layout&apos;s own fields: a map point may read only one table besides Nodes (v17: &quot;Column can have&#13;&#10;// only one upstream base table&quot; when hops came from Blast Radius).&#13;&#10;CASE [layout_scope] + &quot;|&quot; + [node_id (mart_lineage_layout.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.dim_customers&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.dim_products&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_board_kpis&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_finance_close&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_inventory_daily&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_order_items&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_orders&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_revenue_daily&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_shipments&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.fct_store_sales&quot; THEN &quot;2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.int_customers__deduped&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.int_gl__mapped&quot; THEN &quot;4&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.int_inventory__snapshots&quot; THEN &quot;3&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack|model.acme_core.int_orders