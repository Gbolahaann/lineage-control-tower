sions&quot; THEN 150.1&#13;&#10;WHEN &quot;raw_experiments.assignments&quot; THEN 174.7&#13;&#10;WHEN &quot;raw_google_ads.ad_stats&quot; THEN 146.1&#13;&#10;WHEN &quot;raw_google_ads.campaigns&quot; THEN 160.1&#13;&#10;WHEN &quot;raw_hubspot.companies&quot; THEN 140.7&#13;&#10;WHEN &quot;raw_hubspot.contacts&quot; THEN 127.4&#13;&#10;WHEN &quot;raw_hubspot.deals&quot; THEN 108.7&#13;&#10;WHEN &quot;raw_meta_ads.ad_insights&quot; THEN 152.7&#13;&#10;WHEN &quot;raw_netsuite.accounts&quot; THEN 129.4&#13;&#10;WHEN &quot;raw_netsuite.gl_entries&quot; THEN 133.4&#13;&#10;WHEN &quot;raw_netsuite.journal_lines&quot; THEN 150.7&#13;&#10;WHEN &quot;raw_pos.store_sales&quot; THEN 118.1&#13;&#10;WHEN &quot;raw_shopify.customers&quot; THEN 133.2&#13;&#10;WHEN &quot;raw_shopify.order_items&quot; THEN 141.2&#13;&#10;WHEN &quot;raw_shopify.orders&quot; THEN 109.8&#13;&#10;WHEN &quot;raw_shopify.products&quot; THEN 123.8&#13;&#10;WHEN &quot;raw_stripe.payments&quot; THEN 119.4&#13;&#10;WHEN &quot;raw_stripe.refunds&quot; THEN 107.4&#13;&#10;WHEN &quot;raw_wms.inventory&quot; THEN 111.4&#13;&#10;WHEN &quot;raw_wms.shipments&quot; THEN 117.4&#13;&#10;WHEN &quot;raw_wms.warehouses&quot; THEN 126.7&#13;&#10;WHEN &quot;raw_zendesk.ticket_comments&quot; THEN 176.1&#13;&#10;WHEN &quot;raw_zendesk.tickets&quot; THEN 116.1&#13;&#10;WHEN &quot;sigma_customer_360&quot; THEN 122.1&#13;&#10;WHEN &quot;sigma_product_engagement&quot; THEN 163.4&#13;&#10;WHEN &quot;stg_dbt__run_results&quot; THEN 122.0&#13;&#10;WHEN &quot;stg_events__app_events&quot; THEN 142.1&#13;&#10;WHEN &quot;stg_events__app_installs&quot; THEN 145.4&#13;&#10;WHEN &quot;stg_events__page_views&quot; THEN 143.4&#13;&#10;WHEN &quot;stg_events__search_events&quot; THEN 159.4&#13;&#10;WHEN &quot;stg_events__web_sessions&quot; THEN 157.4&#13;&#10;WHEN &quot;stg_experiments__assignments&quot; THEN 182.1&#13;&#10;WHEN &quot;stg_google_ads__ad_stats&quot; THEN 153.4&#13;&#10;WHEN &quot;stg_google_ads__campaigns&quot; THEN 167.4&#13;&#10;WHEN &quot;stg_hubspot__companies&quot; THEN 148.0&#13;&#10;WHEN &quot;stg_hubspot__contacts&quot; THEN 134.7&#13;&#10;WHEN &quot;stg_hubspot__deal_stages&quot; THEN 154.0&#13;&#10;WHEN &quot;stg_hubspot__deals&quot; THEN 116.0&#13;&#10;WHEN &quot;stg_meta_ads__ad_insights&quot; THEN 160.1&#13;&#10;WHEN &quot;stg_netsuite__accounts&quot; THEN 136.7&#13;&#10;WHEN &quot;stg_netsuite__gl_entries&quot; THEN 140.7&#13;&#10;WHEN &quot;stg_netsuite__journal_lines&quot; THEN 158.1&#13;&#10;WHEN &quot;stg_pos__store_sales&quot; THEN 125.4&#13;&#10;WHEN &quot;stg_shopify__customers&quot; THEN 141.4&#13;&#10;WHEN &quot;stg_shopify__order_discounts&quot; THEN 174.7&#13;&#10;WHEN &quot;stg_shopify__order_items&quot; THEN 149.4&#13;&#10;WHEN &quot;stg_shopify__orders&quot; THEN 118.0&#13;&#10;WHEN &quot;stg_shopify__products&quot; THEN 132.0&#13;&#10;WHEN &quot;stg_stripe__payments&quot; THEN 126.7&#13;&#10;WHEN &quot;stg_stripe__refunds&quot; THEN 114.7&#13;&#10;WHEN &quot;stg_wms__inventory&quot; THEN 118.7&#13;&#10;WHEN &quot;stg_wms__shipments&quot; THEN 124.7&#13;&#10;WHEN &quot;stg_wms__warehouses&quot; THEN 134.1&#13;&#10;WHEN &quot;stg_zendesk__ticket_comments&quot; THEN 183.4&#13;&#10;WHEN &quot;stg_zendesk__tickets&quot; THEN 123.4&#13;&#10;ELSE LEN([display_name]) * 7&#13;&#10;END' />
      </column>
      <column caption='Alert Tag Point' datatype='spatial' name='[Calculation_8482078463587217548]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Point&#13;&#10;// Middle of the incident tag box, just after the node name.&#13;&#10;MAKEPOINT(0.2298, (37 + [Calculation_1052386569481538431] + 8 + 26 + -186) / 100)' />
      </column>
      <column caption='Attention Tag Key' datatype='string' name='[Calculation_3399448354263373002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Tag Key&#13;&#10;// Shows the incident tag box only when the node has an open incident.&#13;&#10;IF [open_incident_id] &lt;&gt; &quot;&quot; THEN &quot;tag&quot; ELSE &quot;none&quot; END' />
      </column>
      <column caption='Attention Incident Tag' datatype='string' name='[Calculation_5034449253068379788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Incident Tag&#13;&#10;// Incident chip next to the node name, for example &quot;INC-008&quot;. Empty when there is no open incident.&#13;&#10;IFNULL([open_incident_id], &quot;&quot;)' />
      </column>
      <column caption='Alert Tag Text Point' datatype='spatial' name='[Calculation_2553845990692593975]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Text Point&#13;&#10;// Same spot as Alert Tag Point, for the tag text layer.&#13;&#10;MAKEPOINT(0.2298, (37 + [Calculation_1052386569481538431] + 8 + 26 + -186) / 100)' />
      </column>
      <column caption='Node Count' datatype='integer' name='[Calculation_2446133016301952044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Node Count&#13;&#10;// Number of nodes in the view. dim_nodes has one row per node.&#13;&#10;COUNTD([node_id (dim_nodes.csv)])' />
      </column>
      <column caption='Layer Share' datatype='real' name='[Calculation_9282765132542256788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Share&#13;&#10;// Each status&apos;s share of the layer, so every bar spans the full width.&#13;&#10;// Table calc: compute using Status Label (along the bar).&#13;&#10;[Calculation_2446133016301952044] / TOTAL([Calculation_2446133016301952044])'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2496845894520933783]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Layer Label Position' datatype='real' name='[Calculation_2008892738692294245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Label Position&#13;&#10;// Where the &quot;1 / 27&quot; count sits on the layer bar: just past the end of the full bar (axis fixed 0 to 1.15).&#13;&#10;MIN(1.08)' />
      </column>
      <column caption='Status Stack Order' datatype='integer' name='[Calculation_2946817898410042583]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Status Stack Order&#13;&#10;// Healthy first, for stacked bars, as in the prototype&apos;s layer health strip: Healthy, Warning, Critical, No data.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 1 THEN 1&#13;&#10;WHEN 2 THEN 2&#13;&#10;WHEN 3 THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='Layer Stack Key' datatype='integer' name='[Calculation_2496845894520933783]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Layer Stack Key&#13;&#10;// Stack order for the layer bar, left to right: Healthy, Warning, Critical, No data.&#13;&#10;// Tableau stacks the highest value first, so Healthy gets the highest key.&#13;&#10;5 - [Calculation_2946817898410042583]' />
      </column>
      <column caption='Layer Total' datatype='integer' name='[Calculation_3311281824631653486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Total&#13;&#10;// Nodes in the layer for the selected platform. FIXED with the platform rule inside, so no context filter is needed.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] THEN 1 END) }' />
      </column>
      <column caption='Layer Total Text' datatype='string' name='[Calculation_1760329556827391948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Total Text&#13;&#10;// The layer total, in grey after the issue count: &quot;1 / 30&quot; or just &quot;21&quot;.&#13;&#10;STR([Calculation_3311281824631653486])' />
      </column>
      <column caption='Layer Has Critical' datatype='boolean' name='[Calculation_4191687787979507265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Has Critical&#13;&#10;// TRUE when any node in the layer is Critical, so the issue count shows in red rather than amber.&#13;&#10;{ FIXED [layer] : MAX(IF [Calculation_2214252331607255986] AND [current_status_code] = 3 THEN 1 ELSE 0 END) } = 1' />
      </column>
      <column caption='Layer Issues' datatype='integer' name='[Calculation_1394288337659403442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Issues&#13;&#10;// Nodes in the layer that are Warning or Critical right now, for the selected platform.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] AND [Calculation_2875175252813195699] THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Layer Issues Critical Text' datatype='string' name='[Calculation_2393800399496740184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Critical Text&#13;&#10;// &quot;1 / &quot; in red, shown when the layer has a Critical node.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Layer Issues Warning Text' datatype='string' name='[Calculation_3164047678432910206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Warning Text&#13;&#10;// &quot;1 / &quot; in amber ink #93600F, when the layer has issues but none Critical.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND NOT [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Show Info Panel' datatype='boolean' name='[Calculation_3095764547146903988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Info Panel&#13;&#10;// DZV for GL Info Panel: shown while p_show_info is True.&#13;&#10;[Parameters].[Parameter 7]' />
      </column>
      <column-instance column='[Calculation_1290101426377148290]' derivation='None' name='[none:Calculation_1290101426377148290:nk]' pivot='key' type='nominal' />
      <column-instance column='[Calculation_1733161848805935888]' derivation='None' name='[none:Calculation_1733161848805935888:nk]' pivot='key' type='nominal' />
      <column-instance column='[Calculation_1284089094536110577]' derivation='None' name='[none:Calculation_1284089094536110577:nk]' pivot='key' type='nominal' />
