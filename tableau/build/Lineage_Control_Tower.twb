    <worksheet name='US Ranked Products Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Uses' caption='p_us_sort' datatype='string' datatype-customized='true' name='[Parameter 14]' param-domain-type='list' role='measure' type='nominal' value='&quot;Uses&quot;'>
              <calculation class='tableau' formula='&quot;Uses&quot;' />
              <aliases>
                <alias key='&quot;Uses&quot;' value='Uses' />
                <alias key='&quot;Change&quot;' value='Change' />
                <alias key='&quot;Cost per use&quot;' value='Cost per use' />
