            <column caption='GOV Hygiene Rect Id' datatype='integer' name='[Calculation_2753292097713496065]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// GOV Hygiene Rect Id&#13;&#10;// Which rectangle a date row draws.&#13;&#10;INT([day_index] / 4)' />
