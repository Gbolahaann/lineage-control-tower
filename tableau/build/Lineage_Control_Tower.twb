      <column caption='Late Chip Fill Point' datatype='spatial' name='[Calculation_3367338565339848723]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Chip Fill Point&#13;&#10;// Data product chip fill, 1 px inside (takes the click).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 8 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2450, -1.3650), NULL)&#13;&#10;WHEN 9 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2450, -0.0124), NULL)&#13;&#10;WHEN 10 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2250, 0.0076), NULL)&#13;&#10;WHEN 11 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.1250, 0.0076), NULL)&#13;&#10;WHEN 12 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.1050, -0.0124), NULL)&#13;&#10;WHEN 13 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.1050, -1.3650), NULL)&#13;&#10;WHEN 14 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.1250, -1.3850), NULL)&#13;&#10;WHEN 15 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2250, -1.3850), NULL)&#13;&#10;WHEN 16 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2450, 0.0876), NULL)&#13;&#10;WHEN 17 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2450, 0.8095), NULL)&#13;&#10;WHEN 18 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(1.2250, 0.8295), NULL)&#13;&#10;WHEN 19 THEN IIF(([Parameters].[Parameter 2] = &quot;