    <worksheet name='FR Late Checks Calendar'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Calendar Day Short' datatype='string' name='[Calculation_2166958855069030471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Calendar Day Short&#13;&#10;// &quot;Mon&quot; ... &quot;Sun&quot; down the calendar.&#13;&#10;LEFT([day_name], 3)' />
            </column>
            <column caption='Calendar Today' datatype='real' name='[Calculation_1023255157077629383]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calendar Today&#13;&#10;// The navy square behind today&apos;s (a little larger): its outline, as in the prototype.&#13;&#10;IF MIN([days_before_as_of]) = 0 THEN 0.0 END' />
            </column>
            <column caption='Calendar Cell' datatype='real' name='[Calculation_2542639095485652484]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Calendar Cell&#13;&#10;// Every day&apos;s square sits at 0 on a hidden axis.&#13;&#10;MIN(0.0)' />
            </column>
            <column caption='Is Platform Match Day' datatype='boolean' name='[Calculation_1100032193373739257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Day&#13;&#10;// Day-level platform filter for Node Daily. Migrated models count against Redshift before&#13;&#10;// their move and Snowflake after, so daily KPIs and cost split correctly by platform.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Late Day Key' datatype='string' name='[Calculation_2553669690829697165]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Day Key&#13;&#10;// Calendar colour: Error #D2453F, Warn #E8A33D, On time (in window) #E3F2E9, Earlier #EEF0EE.&#13;&#10;IF SUM([fresh_checks_error]) &gt; 0 THEN &quot;Error&quot;&#13;&#10;ELSEIF SUM([fresh_checks_warn]) &gt; 0 THEN &quot;Warn&quot;&#13;&#10;ELSEIF MAX([days_before_as_of]) &lt; [Parameters].[Parameter 1] THEN &quot;On time&quot;&#13;&#10;ELSE &quot;Earlier&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Checks (Daily)' datatype='integer' name='[Calculation_5120633682563126247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Late Checks (Daily)&#13;&#10;// Checks that came back warn or error that day. Shown as the number in each calendar cell.&#13;&#10;SUM([fresh_checks_warn] + [fresh_checks_error])' />
            </column>
            <column caption='Late Checks Text' datatype='string' name='[Calculation_1736940290597779592]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Checks Text&#13;&#10;// The number in a calendar square, blank on days with none.&#13;&#10;IF [Calculation_5120633682563126247] &gt; 0 THEN STR([Calculation_5120633682563126247]) END' />
            </column>
            <column caption='Date (Dates)' datatype='date' name='[date (dim_date.csv)]' role='dimension' type='ordinal' />
            <column caption='Day Name' datatype='string' name='[day_name]' role='dimension' type='nominal' />
            <column caption='Day Of Week' datatype='integer' name='[day_of_week]' role='dimension' type='quantitative' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Fresh Checks Error' datatype='real' name='[fresh_checks_error]' role='measure' type='quantitative' />
            <column caption='Fresh Checks Warn' datatype='real' name='[fresh_checks_warn]' role='measure' type='quantitative' />
            <column caption='Platform On Day' datatype='string' name='[platform_on_day]' role='dimension' type='nominal' />
            <column caption='Week Start' datatype='date' name='[week_start]' role='dimension' type='ordinal' />
            <column-instance column='[day_of_week]' derivation='None' name='[none:day_of_week:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2166958855069030471]' derivation='None' name='[none:Calculation_2166958855069030471:nk]' pivot='key' type='nominal' />
            <column-instance column='[week_start]' derivation='None' name='[none:week_start:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1023255157077629383]' derivation='User' name='[usr:Calculation_1023255157077629383:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2542639095485652484]' derivation='User' name='[usr:Calculation_2542639095485652484:qk]' pivot='key' type='quantitative' />
