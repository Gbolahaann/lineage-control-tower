ms.inventory&quot; THEN 60.8&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN 60.8&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN 64.4&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN 64.4&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN 60.8&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN 64.4&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN 64.4&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN 57.9&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN 57.9&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Table Owner Point' datatype='spatial' name='[Calculation_2560271451971407633]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Owner Point&#13;&#10;// Middle of the owner name.&#13;&#10;IF [row_type] = &quot;node&quot; THEN MAKEPOINT(0, ((826 + [Calculation_1497838641404470019] / 2) - 454.5) / 100) END' />
      </column>
      <column caption='Is Selected Exposure' datatype='boolean' name='[Calculation_1839336276141763942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Selected Exposure&#13;&#10;// TRUE for the exposure chosen on any tab (tile, usage row, blast row). Drives highlight and scope.&#13;&#10;[node_id (dim_nodes.csv)] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='Access Path Label' datatype='string' name='[Calculation_2331319450614080517]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Access Path Label&#13;&#10;// How a consumer reaches the data, in the prototype&apos;s wording.&#13;&#10;CASE [access_path]&#13;&#10;WHEN &quot;bi_semantic_layer&quot;  THEN &quot;via BI semantic layer&quot;&#13;&#10;WHEN &quot;direct_warehouse&quot;   THEN &quot;direct to warehouse&quot;&#13;&#10;WHEN &quot;dbt_semantic_layer&quot; THEN &quot;via dbt semantic layer&quot;&#13;&#10;WHEN &quot;mcp_server&quot;         THEN &quot;via MCP server&quot;&#13;&#10;WHEN &quot;extract&quot;            THEN &quot;via extract&quot;&#13;&#10;END' />
      </column>
      <column caption='BI Tool Name' datatype='string' name='[Calculation_3050416534534877802]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// BI Tool Name&#13;&#10;// Display name for the BI tool.&#13;&#10;CASE [bi_tool]&#13;&#10;WHEN &quot;tableau&quot;  THEN &quot;Tableau&quot;&#13;&#10;WHEN &quot;sigma&quot;    THEN &quot;Sigma&quot;&#13;&#10;WHEN &quot;power_bi&quot; THEN &quot;Power BI&quot;&#13;&#10;END' />
      </column>
      <column caption='Exposure Type Name' datatype='string' name='[Calculation_2968435387414133410]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Exposure Type Name&#13;&#10;// Display name for the consumer type.&#13;&#10;CASE [exposure_type]&#13;&#10;WHEN &quot;dashboard&quot; THEN &quot;Dashboard&quot;&#13;&#10;WHEN &quot;notebook&quot;  THEN &quot;Notebook&quot;&#13;&#10;WHEN &quot;ml&quot;        THEN &quot;ML model&quot;&#13;&#10;WHEN &quot;data_app&quot;  THEN &quot;Data app&quot;&#13;&#10;WHEN &quot;agent&quot;     THEN &quot;AI agent&quot;&#13;&#10;WHEN &quot;data_hub&quot;  THEN &quot;Data hub&quot;&#13;&#10;END' />
      </column>
      <column caption='Exposure Access Line' datatype='string' name='[Calculation_2402761884333603727]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Exposure Access Line&#13;&#10;// Subtitle beside the picker: &quot;Dashboard in Tableau, via BI semantic layer · 61 upstream nodes&quot;.&#13;&#10;[Calculation_2968435387414133410]&#13;&#10;+ IF ISNULL([bi_tool]) THEN &quot;&quot; ELSE &quot; in &quot; + [Calculation_3050416534534877802] END&#13;&#10;+ &quot;, &quot; + [Calculation_2331319450614080517]&#13;&#10;+ &quot; · &quot; + STR([upstream_node_count]) + &quot; upstream nodes&quot;' />
      </column>
      <column caption='Panel Node Id' datatype='string' name='[Calculation_1386184292960313328]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Node Id&#13;&#10;// Node shown in the side panel: the clicked node, or the exposure itself until a node is clicked.&#13;&#10;IF [Parameters].[Parameter 4] = &quot;&quot; THEN [Parameters].[Parameter 3]&#13;&#10;ELSE [Parameters].[Parameter 4]&#13;&#10;END' />
      </column>
      <column caption='Is Panel Node' datatype='boolean' name='[Calculation_2972930213303912559]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Panel Node&#13;&#10;// Filter for every Nodes-based panel sheet.&#13;&#10;[node_id (dim_nodes.csv)] = [Calculation_1386184292960313328]' />
      </column>
      <column caption='Panel Kind Line' datatype='string' name='[Calculation_2080349039431948818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Kind Line&#13;&#10;// Small line above the panel title: &quot;Staging · view&quot;, &quot;BI semantic layer · published_data_source&quot;, &quot;Exposures · Dashboard&quot;.&#13;&#10;[Calculation_7823664326256286450] + &quot; · &quot;&#13;&#10;+ IF [resource_type] = &quot;exposure&quot; THEN [Calculation_2968435387414133410]&#13;&#10;  ELSE IFNULL([materialization], IFNULL([semantic_object_type], [resource_type]))&#13;&#10;  END' />
      </column>
      <column caption='Panel Name' datatype='string' name='[Calculation_1877222636442730434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Name&#13;&#10;// Title of the panel: the node&apos;s full name.&#13;&#10;[display_name]' />
      </column>
      <column caption='Panel Moved Tag' datatype='string' name='[Calculation_1333639474157867932]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Moved Tag&#13;&#10;// &quot;moved from Redshift on 3 Sep&quot; pill text for migrated nodes.&#13;&#10;IF ISNULL([migrated_from_platform]) THEN &quot;&quot;&#13;&#10;ELSE &quot;moved from &quot; + PROPER([migrated_from_platform]) + &quot; on &quot;&#13;&#10;    + STR(DAY([migration_date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [migration_date]), 3)&#13;&#10;END' />
      </column>
      <column caption='Panel Callout Reason' datatype='string' name='[Calculation_2696229332938111457]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Callout Reason&#13;&#10;// What is wrong with the panel node, wrapped to the callout width by the build (from dim_nodes).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack&quot; THEN &quot;stg_netsuite__journal_lines (Critical); dim_customers&quot; + CHAR(10) + &quot;(Warning); raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.customer_360&quot; THEN &quot;dim_customers (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.executive_revenue_dashboard&quot; THEN &quot;stg_netsuite__journal_lines (Critical); dim_customers&quot; + CHAR(10) + &quot;(Warning); raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.finance_close_tracker&quot; THEN &quot;stg_netsuite__journal_lines (Critical)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.finance_qa_agent&quot; THEN &quot;stg_netsuite__journal_lines (Critical)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.inventory_health&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.merchandising_copilot&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.store_ops_hub&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.supply_chain_ops&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_product.churn_prediction_model&quot; THEN &quot;dim_customers (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_product.demand_forecast_app&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.observed.undeclared_pricing_agent&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN &quot;1 test failing: unique_dim_customers_customer_id&quot;&#13;&#10;WHEN &quot;model.acme_core.stg_netsuite__journal_lines&quot; THEN &quot;Compilation Error in model stg_netsuite__journal_lines at&quot; + CHAR(10) + &quot;19 Oct, 21:25&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;Loading late, 6.0 h behind (warn after 3.0 h)&quot;&#13;&#10;END' />
      </column>
      <column caption='Panel Callout Error' datatype='string' name='[Calculation_2552850758722083609]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Callout Error&#13;&#10;// The raw error message under the reason, wrapped by the build (from dim_nodes).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.stg_netsuite__journal_lines&quot; THEN &quot;Compilation Error in model stg_netsuite__journal_lines: &apos;dict&quot; + CHAR(10) + &quot;object&apos; has no attribute &apos;currency_code&apos;. This can happen when a&quot; + CHAR(10) + &quot;macro argument is renamed.&quot;&#13;&#10;END' />
      </column>
      <column caption='Panel Tests Label' datatype='string' name='[Calculation_2139792900117064923]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Tests Label&#13;&#10;// Label of the last details row, models only.&#13;&#10;IF [resource_type] = &quot;model&quot; THEN &quot;Tests defined&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Panel Owner Text' datatype='string' name='[Calculation_1127649889546741305]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Owner Text&#13;&#10;// Owner row; empty when there is no owner (the red version takes over).&#13;&#10;IF ISNULL([owner_name]) OR [owner_name] = &quot;No owner&quot; THEN &quot;&quot; ELSE [owner_name] END' />
      </column>
      <column caption='Panel Owner Missing' datatype='string' name='[Calculation_1005813198723708199]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Owner Missing&#13;&#10;// &quot;No owner&quot; in red.&#13;&#10;IF ISNULL([owner_name]) OR [owner_name] = &quot;No owner&quot; THEN &quot;No owner&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Panel Team Text' datatype='string' name='[Calculation_2786630389780039406]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Team Text&#13;&#10;// Team row (&quot;-&quot; when there is none).&#13;&#10;IFNULL([owner_team], &quot;-&quot;)' />
      </column>
      <column caption='Panel Slack Text' datatype='string' name='[Calculation_1860481505930290137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Slack Text&#13;&#10;// Slack row, from Owners.&#13;&#10;IFNULL([slack_channel], &quot;-&quot;)' />
      </column>
      <column caption='Panel Project Text' datatype='string' name='[Calculation_1829859781985471552]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Project Text&#13;&#10;// dbt project row.&#13;&#10;IFNULL([dbt_project], &quot;-&quot;)' />
      </column>
      <column caption='Panel Schema Text' datatype='string' name='[Calculation_2157706400399715687]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Schema Text&#13;&#10;// Schema row.&#13;&#10;IFNULL([schema_name], &quot;-&quot;)' />
      </column>
      <column caption='Panel Documented Good' datatype='string' name='[Calculation_1335187067778267090]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Documented Good&#13;&#10;// &quot;Yes&quot; in ink.&#13;&#10;IF [has_description] THEN &quot;Yes&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Panel Documented Bad' datatype='string' name='[Calculation_5244465548340057021]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Documented Bad&#13;&#10;// &quot;No description&quot; in amber ink.&#13;&#10;IF NOT [has_description] THEN &quot;No description&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Panel Tests Good' datatype='string' name='[Calculation_2074904657642114202]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Tests Good&#13;&#10;// Number of tests defined, models only.&#13;&#10;IF [resource_type] = &quot;model&quot; AND [test_count] &gt; 0 THEN STR([test_count]) ELSE &quot;&quot; END' />
      </column>
      <column caption='Panel Tests None' datatype='string' name='[Calculation_6834756490450264188]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Tests None&#13;&#10;// &quot;None&quot; in amber ink for models without tests.&#13;&#10;IF [resource_type] = &quot;model&quot; AND [test_count] = 0 THEN &quot;None&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Panel Last Run Text' datatype='string' name='[Calculation_2436608709301960229]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Last Run Text&#13;&#10;// Bold part of &quot;Last run 1s at 19 Oct, 21:25&quot;.&#13;&#10;IF [Calculation_1403910267805111020] = &quot;&quot; THEN &quot;-&quot; ELSE [Calculation_1403910267805111020] END' />
      </column>
      <column caption='Is Panel Node Daily' datatype='boolean' name='[Calculation_2646987086833843320]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Panel Node Daily&#13;&#10;// Filter for the Node Daily panel sheets (row-level compare on the fact&apos;s own key).&#13;&#10;[node_id] = [Calculation_1386184292960313328]' />
      </column>
      <column caption='Runtime Trend Now' datatype='real' name='[Calculation_3083874683594051399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Runtime Trend Now&#13;&#10;// 7-day vs prior 28-day runtime change on the last day (19 Oct), as a fraction. Format ▲ 0%;▼ 0%.&#13;&#10;// Needs runtime_trend_pct typed as Number (decimal) in the data source.&#13;&#10;MAX(IF [days_before_as_of] = 0 THEN [runtime_trend_pct] END)' />
      </column>
      <column caption='Runtime Change Up Text' datatype='string' name='[Calculation_2072871993879220877]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Runtime Change Up Text&#13;&#10;// &quot;▲ 30%&quot; in red: runtime up more than 25% (7 days against the 28 before).&#13;&#10;IF [Calculation_3083874683594051399] &gt; 0.25 THEN &quot;▲ &quot; + STR(ROUND([Calculation_3083874683594051399] * 100)) + &quot;%&quot; END' />
      </column>
      <column caption='Runtime Change Down Text' datatype='string' name='[Calculation_9094679087243904666]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Runtime Change Down Text&#13;&#10;// &quot;▼ 30%&quot; in green: runtime down more than 25%.&#13;&#10;IF [Calculation_3083874683594051399] &lt; -0.25 THEN &quot;▼ &quot; + STR(ROUND(-[Calculation_3083874683594051399] * 100)) + &quot;%&quot; END' />
      </column>
      <column caption='Runtime Change Flat Text' datatype='string' name='[Calculation_2647206799758291440]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Runtime Change Flat Text&#13;&#10;// &quot;▲ 3%&quot; in ink: within 25% either way.&#13;&#10;IF ABS([Calculation_3083874683594051399]) &lt;= 0.25&#13;&#10;    THEN IF [Calculation_3083874683594051399] &gt;= 0 THEN &quot;▲ &quot; ELSE &quot;▼ &quot; END + STR(ROUND(ABS([Calculation_3083874683594051399]) * 100)) + &quot;%&quot; END' />
      </column>
      <column caption='Runtime Change Text' datatype='string' name='[Calculation_2431941125293497517]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Runtime Change Text&#13;&#10;// &quot;7d vs 28d&quot; after the runtime change, grey.&#13;&#10;IF ISNULL([Calculation_3083874683594051399]) THEN &quot;&quot; ELSE &quot;  7d vs 28d&quot; END' />
      </column>
      <column caption='Runtime Minutes (Daily)' datatype='real' name='[Calculation_5251881012306753110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Runtime Minutes (Daily)&#13;&#10;// Panel runtime line, in minutes. Needs avg_runtime_sec typed as Number.&#13;&#10;AVG([avg_runtime_sec]) / 60' />
      </column>
      <column caption='Runtime Minutes In Period' datatype='real' name='[Calculation_9600251826755173368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Runtime Minutes In Period&#13;&#10;// Runtime Minutes inside the selected window.&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_5251881012306753110] END' />
      </column>
      <column caption='Runtime Minutes Out Period' datatype='real' name='[Calculation_2901935896968598429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Runtime Minutes Out Period&#13;&#10;// Runtime Minutes outside the selected window (grey).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_5251881012306753110] END' />
      </column>
      <column caption='Runs In Period' datatype='real' name='[Calculation_5270684263439303529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Runs In Period&#13;&#10;// Model runs in the window (skipped excluded, as in the mart).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [runs] END)' />
      </column>
      <column caption='Failed Runs In Period' datatype='real' name='[Calculation_4943033888619381620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Failed Runs In Period&#13;&#10;// Failed model runs in the window. Shown red when above 0, green at 0.&#13;&#10;ZN(SUM(IF [Calculation_1409194560049525583] THEN [runs_failed] END))' />
      </column>
      <column caption='Failed Runs Bad Text' datatype='string' name='[Calculation_6093269038080048633]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Failed Runs Bad Text&#13;&#10;// &quot;1 failed&quot; in red when any run failed in the period.&#13;&#10;IF [Calculation_4943033888619381620] &gt; 0 THEN STR([Calculation_4943033888619381620]) + &quot; failed&quot; END' />
      </column>
      <column caption='Failed Runs Good Text' datatype='string' name='[Calculation_1661068913062762579]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Failed Runs Good Text&#13;&#10;// &quot;0 failed&quot; in green.&#13;&#10;IF [Calculation_4943033888619381620] = 0 THEN &quot;0 failed&quot; END' />
      </column>
      <column caption='Is Last 30 Days' datatype='boolean' name='[Calculation_3373060496381436566]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Last 30 Days&#13;&#10;// The test strip shows the last 30 days. Put on Filters (True).&#13;&#10;[days_before_as_of] &lt; 30' />
      </column>
      <column caption='Worst Test Label' datatype='string' name='[Calculation_4959349905375632629]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Worst Test Label&#13;&#10;// Worst test result of a model on a day (Node Daily). Palette: No run #EFEFEB, All passed #E3F2E9,&#13;&#10;// Warning #E8A33D, Failed #D2453F. The Lineage panel strip uses the strong green #2F9E6B for All passed instead.&#13;&#10;CASE [worst_test_code]&#13;&#10;WHEN 3 THEN &quot;Failed&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;All passed&quot;&#13;&#10;ELSE &quot;No run&quot;&#13;&#10;END' />
      </column>
      <column caption='Panel Test Key' datatype='string' name='[Calculation_1870315392599836731]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Test Key&#13;&#10;// Test strip colour (its own palette: strong green for All passed).&#13;&#10;[Calculation_4959349905375632629]' />
      </column>
      <column caption='Panel Tests Latest Text' datatype='string' name='[Calculation_1405441125861015833]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Tests Latest Text&#13;&#10;// &quot;Latest: 2 passing, 1 warning&quot; under the strip.&#13;&#10;&quot;Latest: &quot; + STR(ZN([tests_passing])) + &quot; passing&quot;&#13;&#10;+ IF [tests_warning] &gt; 0 THEN &quot;, &quot; + STR([tests_warning]) + &quot; warning&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Panel Tests Failing Text' datatype='string' name='[Calculation_2185241538257827997]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Tests Failing Text&#13;&#10;// &quot;, 1 failing&quot; in red.&#13;&#10;IF [tests_failing] &gt; 0 THEN &quot;, &quot; + STR([tests_failing]) + &quot; failing&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Error Hours Text' datatype='string' name='[Calculation_2509854475239831940]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Hours Text&#13;&#10;// Hours with one decimal, always (&quot;12.0&quot;, &quot;2.5&quot;): tenths as a whole number, then the point.&#13;&#10;STR(INT(ROUND([error_after_minutes] / 6) / 10)) + &quot;.&quot; + STR(INT(INT(ROUND([error_after_minutes] / 6)) % 10))' />
      </column>
      <column caption='Warn Hours Text' datatype='string' name='[Calculation_3184828284847424735]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Warn Hours Text&#13;&#10;// Hours with one decimal, always (&quot;12.0&quot;, &quot;2.5&quot;): tenths as a whole number, then the point.&#13;&#10;STR(INT(ROUND([warn_after_minutes] / 6) / 10)) + &quot;.&quot; + STR(INT(INT(ROUND([warn_after_minutes] / 6)) % 10))' />
      </column>
      <column caption='Panel Warn After Label' datatype='string' name='[Calculation_1281532667660790701]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Warn After Label&#13;&#10;// &quot;warn 12.0 h · error 24.0 h&quot; under the freshness bullet, as in the mock (always one decimal).&#13;&#10;&quot;warn &quot; + [Calculation_3184828284847424735] + &quot; h · error &quot; + [Calculation_2509854475239831940] + &quot; h&quot;' />
      </column>
      <column caption='Worst Lag Hours (Daily)' datatype='real' name='[Calculation_1501859043302415176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Worst Lag Hours (Daily)&#13;&#10;// Source panel line: worst lag of the day, in hours.&#13;&#10;MAX([max_lag_min]) / 60' />
      </column>
      <column caption='Worst Lag Hours In Period' datatype='real' name='[Calculation_3075692162237765445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Worst Lag Hours In Period&#13;&#10;// Worst Lag Hours inside the selected window.&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_1501859043302415176] END' />
      </column>
      <column caption='Worst Lag Hours Out Period' datatype='real' name='[Calculation_1531461362163268325]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Worst Lag Hours Out Period&#13;&#10;// Worst Lag Hours outside the selected window (grey).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_1501859043302415176] END' />
      </column>
      <column caption='Refreshes OK In Period' datatype='real' name='[Calculation_2455482225658210647]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Refreshes OK In Period&#13;&#10;// Successful extract refreshes in the window.&#13;&#10;ZN(SUM(IF [Calculation_1409194560049525583] THEN [refresh_ok] END))' />
      </column>
      <column caption='Panel Refresh Ok Text' datatype='string' name='[Calculation_3320940046558431394]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Panel Refresh Ok Text&#13;&#10;// Refresh summary line, start.&#13;&#10;STR([Calculation_2455482225658210647]) + &quot; succeeded · &quot;' />
      </column>
      <column caption='Refreshes Failed In Period' datatype='real' name='[Calculation_2309702576367122148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Refreshes Failed In Period&#13;&#10;// Failed extract refreshes in the window.&#13;&#10;ZN(SUM(IF [Calculation_1409194560049525583] THEN [refresh_failed] END))' />
      </column>
      <column caption='Panel Refresh Failed Text' datatype='string' name='[Calculation_5757700998680533950]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Panel Refresh Failed Text&#13;&#10;// Failed refreshes, red when above 0.&#13;&#10;STR([Calculation_2309702576367122148]) + &quot; failed&quot;' />
      </column>
      <column caption='Refreshes Skipped In Period' datatype='real' name='[Calculation_1430961952602913129]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Refreshes Skipped In Period&#13;&#10;// Refreshes skipped because an upstream mart failed.&#13;&#10;ZN(SUM(IF [Calculation_1409194560049525583] THEN [refresh_skipped] END))' />
      </column>
      <column caption='Panel Refresh Rest Text' datatype='string' name='[Calculation_1766832021931801037]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Panel Refresh Rest Text&#13;&#10;// &quot; · 2 skipped · extract connection&quot;.&#13;&#10;&quot; · &quot; + STR([Calculation_1430961952602913129]) + &quot; skipped · &quot; + IFNULL(ATTR([connection_type]), &quot;live&quot;) + &quot; connection&quot;' />
      </column>
      <column caption='Failed Refreshes In Period' datatype='real' name='[Calculation_2932651121659067293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Failed Refreshes In Period&#13;&#10;// Failed Refreshes inside the selected window.&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN SUM([refresh_failed]) END' />
      </column>
      <column caption='Failed Refreshes Out Period' datatype='real' name='[Calculation_7110299999956591991]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Failed Refreshes Out Period&#13;&#10;// Failed Refreshes outside the selected window (grey).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN SUM([refresh_failed]) END' />
      </column>
      <column caption='Panel Score Now' datatype='string' name='[Calculation_3342392161425583144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Score Now&#13;&#10;// &quot;99.7&quot; in &quot;Now 99.7 / 100&quot;.&#13;&#10;IF ISNULL([health_score_now]) THEN &quot;-&quot; ELSE STR(ROUND([health_score_now], 1)) END' />
      </column>
      <column caption='Health Score In Period' datatype='real' name='[Calculation_5563210246430517781]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Health Score In Period&#13;&#10;// Health Score inside the selected window.&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN AVG([health_score]) END' />
      </column>
      <column caption='Health Score Out Period' datatype='real' name='[Calculation_1470151867168146673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Health Score Out Period&#13;&#10;// Health Score outside the selected window (grey).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN AVG([health_score]) END' />
      </column>
      <column caption='Is Panel Exposure Daily' datatype='boolean' name='[Calculation_3043010716982636625]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Panel Exposure Daily&#13;&#10;// Filter for the Exposure Daily panel sheets.&#13;&#10;[exposure_id] = [Calculation_1386184292960313328]' />
      </column>
      <column caption='Product Uses (Period)' datatype='real' name='[Calculation_1159284100207867770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Product Uses (Period)&#13;&#10;// An exposure&apos;s consumption events in the window (views, queries, sessions or calls).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [events] END)' />
      </column>
      <column caption='Panel Uses Text' datatype='string' name='[Calculation_3368208530110789885]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Panel Uses Text&#13;&#10;// Usage row: &quot;1,234&quot; before the unit.&#13;&#10;IF ISNULL([Calculation_1159284100207867770]) THEN &quot;0&quot; ELSE STR([Calculation_1159284100207867770]) END' />
      </column>
      <column caption='Uses Unit Label' datatype='string' name='[Calculation_2657459577906221023]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Uses Unit Label&#13;&#10;// Unit after a usage number: views, queries, app sessions or agent calls (Exposure Daily).&#13;&#10;CASE [consumption_type (mart_exposure_daily.csv)]&#13;&#10;WHEN &quot;view&quot;        THEN &quot;views&quot;&#13;&#10;WHEN &quot;query&quot;       THEN &quot;queries&quot;&#13;&#10;WHEN &quot;app_session&quot; THEN &quot;app sessions&quot;&#13;&#10;WHEN &quot;agent_call&quot;  THEN &quot;agent calls&quot;&#13;&#10;END' />
      </column>
      <column caption='Daily Consumers In Period' datatype='real' name='[Calculation_3176503466807260993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Consumers In Period&#13;&#10;// Mean daily unique consumers over the window (one Exposure Daily row per day).&#13;&#10;AVG(IF [Calculation_1409194560049525583] THEN [unique_consumers] END)' />
      </column>
      <column caption='Product Cost (Period)' datatype='real' name='[Calculation_3016817971858344399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Product Cost (Period)&#13;&#10;// Allocated cost in the window: upstream build cost split across the exposures each model feeds, plus own queries.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [allocated_cost_usd] END)' />
      </column>
      <column caption='Cost Per Use' datatype='real' name='[Calculation_2256908730979128074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Cost Per Use&#13;&#10;// Product Cost / Product Uses. NULL (shown &quot;-&quot;) when there was no use.&#13;&#10;IF [Calculation_1159284100207867770] = 0 OR ISNULL([Calculation_1159284100207867770]) THEN NULL&#13;&#10;ELSE [Calculation_3016817971858344399] / [Calculation_1159284100207867770]&#13;&#10;END' />
      </column>
      <column caption='Bullet Good Point' datatype='spatial' name='[Calculation_2917886856601150780]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Good Point&#13;&#10;// Freshness bullet: on-time zone, 0 to warn.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN ((0) - 151) / 100 WHEN 1 THEN (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 2 THEN (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 ELSE ((0) - 151) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Bullet Warn Point' datatype='spatial' name='[Calculation_1544498994739950646]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Warn Point&#13;&#10;// Freshness bullet: warn zone.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 1 THEN (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 2 THEN (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 ELSE (([warn_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Bullet Error Point' datatype='spatial' name='[Calculation_2583197384628426240]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Error Point&#13;&#10;// Freshness bullet: error zone, up to 1.25 x the error threshold.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 WHEN 1 THEN ((302) - 151) / 100 WHEN 2 THEN ((302) - 151) / 100 ELSE (([error_after_minutes] * (302 / (1.25 * [error_after_minutes]))) - 151) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Bullet Lag Point' datatype='spatial' name='[Calculation_4634444041752179346]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Lag Point&#13;&#10;// Freshness bullet: the lag now, as a bar in the status colour.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0400 WHEN 1 THEN 0.0400 WHEN 2 THEN 0.0000 ELSE 0.0000 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN ((0) - 151) / 100 WHEN 1 THEN ((MIN(302, ZN([freshness_lag_min]) * (302 / (1.25 * [error_after_minutes])))) - 151) / 100 WHEN 2 THEN ((MIN(302, ZN([freshness_lag_min]) * (302 / (1.25 * [error_after_minutes])))) - 151) / 100 ELSE ((0) - 151) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Show Info Panel' datatype='boolean' name='[Calculation_3095764547146903988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Info Panel&#13;&#10;// DZV for GL Info Panel: shown while p_show_info is True.&#13;&#10;[Parameters].[Parameter 7]' />
      </column>
      <column caption='Show Lineage Graph' datatype='boolean' name='[Calculation_1147842048297464616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Lineage Graph&#13;&#10;// DZV for the graph container.&#13;&#10;[Parameters].[Parameter 9] = &quot;Graph&quot;' />
      </column>
      <column caption='Show Lineage Table' datatype='boolean' name='[Calculation_3354050259910385261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Lineage Table&#13;&#10;// DZV for the table container.&#13;&#10;[Parameters].[Parameter 9] = &quot;Table&quot;' />
      </column>
      <column caption='Show Panel AI Built' datatype='boolean' name='[Calculation_3287618743400089148]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel AI Built&#13;&#10;// DZV: AI-built tag. Reads parameters only (written by the click), so it updates at once.&#13;&#10;CONTAINS([Parameters].[Parameter 13], &quot;|ai|&quot;)' />
      </column>
      <column caption='Show Panel Callout Critical' datatype='boolean' name='[Calculation_2542490028760190858]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Callout Critical&#13;&#10;// DZV: red callout with what is wrong. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 10] = 3' />
      </column>
      <column caption='Show Panel Callout Warning' datatype='boolean' name='[Calculation_2860787359736809962]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Callout Warning&#13;&#10;// DZV: amber callout. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 10] = 2' />
      </column>
      <column caption='Show Panel Exposure' datatype='boolean' name='[Calculation_2942085833074458690]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Exposure&#13;&#10;// DZV: health score and usage, plus the &quot;See usage and cost&quot; button.&#13;&#10;[Parameters].[Parameter 11] = &quot;exposure&quot;' />
      </column>
      <column caption='Show Panel Model' datatype='boolean' name='[Calculation_6174480559955514104]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Model&#13;&#10;// DZV: runtime, runs and test strip sections. Reads a parameter written by the click.&#13;&#10;[Parameters].[Parameter 11] = &quot;model&quot;' />
      </column>
      <column caption='Show Panel Moved' datatype='boolean' name='[Calculation_2032540838145557222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Moved&#13;&#10;// DZV: &quot;moved from ...&quot; tag for migrated nodes. Reads parameters only (written by the click), so it updates at once.&#13;&#10;CONTAINS([Parameters].[Parameter 13], &quot;|moved|&quot;)' />
      </column>
      <column caption='Show Panel Not Registered' datatype='boolean' name='[Calculation_2506417177455402660]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Not Registered&#13;&#10;// DZV: Not registered tag. Reads parameters only (written by the click), so it updates at once.&#13;&#10;CONTAINS([Parameters].[Parameter 13], &quot;|unregistered|&quot;)' />
      </column>
      <column caption='Show Panel Pill Critical' datatype='boolean' name='[Calculation_2878007123420300596]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Pill Critical&#13;&#10;// DZV: red status pill (not exposures). Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 10] = 3 AND [Parameters].[Parameter 11] &lt;&gt; &quot;exposure&quot;' />
      </column>
      <column caption='Show Panel Pill Healthy' datatype='boolean' name='[Calculation_1540502094643111087]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Pill Healthy&#13;&#10;// DZV: green status pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 10] = 1 AND [Parameters].[Parameter 11] &lt;&gt; &quot;exposure&quot;' />
      </column>
      <column caption='Show Panel Pill No Data' datatype='boolean' name='[Calculation_2081634782732797587]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Pill No Data&#13;&#10;// DZV: grey status pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 10] = 0 AND [Parameters].[Parameter 11] &lt;&gt; &quot;exposure&quot;' />
      </column>
      <column caption='Show Panel Pill Warning' datatype='boolean' name='[Calculation_2319640016079913468]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Pill Warning&#13;&#10;// DZV: amber status pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 10] = 2 AND [Parameters].[Parameter 11] &lt;&gt; &quot;exposure&quot;' />
      </column>
      <column caption='Show Panel Platform Databricks' datatype='boolean' name='[Calculation_2144758063277694889]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Platform Databricks&#13;&#10;// DZV: platform pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 12] = &quot;databricks&quot;' />
      </column>
      <column caption='Show Panel Platform Redshift' datatype='boolean' name='[Calculation_1276664768730343810]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Platform Redshift&#13;&#10;// DZV: platform pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 12] = &quot;redshift&quot;' />
      </column>
      <column caption='Show Panel Platform Snowflake' datatype='boolean' name='[Calculation_1136715844561904546]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Platform Snowflake&#13;&#10;// DZV: platform pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 12] = &quot;snowflake&quot;' />
      </column>
      <column caption='Show Panel Semantic' datatype='boolean' name='[Calculation_1531473644085307863]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Semantic&#13;&#10;// DZV: refresh summary.&#13;&#10;[Parameters].[Parameter 11] = &quot;semantic&quot;' />
      </column>
      <column caption='Show Panel Source' datatype='boolean' name='[Calculation_9419725483394934608]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Source&#13;&#10;// DZV: freshness bullet and lag trend.&#13;&#10;[Parameters].[Parameter 11] = &quot;source&quot;' />
      </column>
      <column caption='Show Panel Trace Button' datatype='boolean' name='[Calculation_2405699987706411223]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Trace Button&#13;&#10;// DZV: &quot;Trace downstream impact&quot; for every node except exposures. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 11] &lt;&gt; &quot;exposure&quot;' />
      </column>
      <column caption='Show Panel Trust Do Not Use' datatype='boolean' name='[Calculation_1231198085658665630]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Trust Do Not Use&#13;&#10;// DZV: exposures show their trust badge instead of a status. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 11] = &quot;exposure&quot; AND [Parameters].[Parameter 10] = 3' />
      </column>
      <column caption='Show Panel Trust Trusted' datatype='boolean' name='[Calculation_3294533728641670204]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Trust Trusted&#13;&#10;// DZV: green trust pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 11] = &quot;exposure&quot; AND [Parameters].[Parameter 10] &lt; 2' />
      </column>
      <column caption='Show Panel Trust Use With Caution' datatype='boolean' name='[Calculation_2510505638809444996]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Panel Trust Use With Caution&#13;&#10;// DZV: amber trust pill. Reads parameters only (written by the click), so it updates at once.&#13;&#10;[Parameters].[Parameter 11] = &quot;exposure&quot; AND [Parameters].[Parameter 10] = 2' />
      </column>
      <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
      </column>
      <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
