      <column caption='Bullet Name Text' datatype='string' name='[Calculation_3270933911152836450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Bullet Name Text&#13;&#10;// Source name, cut by the build to its 200 px column.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;raw_shopify.orders&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;raw_shopify.order_items&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;raw_shopify.customers&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;raw_shopify.products&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;raw_stripe.payments&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;raw_stripe.refunds&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;raw_netsuite.gl_entries&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;raw_netsuite.journal_lines&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;raw_netsuite.accounts&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;raw_wms.inventory&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;raw_wms.shipments&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;raw_wms.warehouses&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;raw_pos.store_sales&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;raw_dbt_artifacts.run_results&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;raw_events.web_sessions&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;raw_events.page_views&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;raw_events.search_events&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;raw_events.app_events&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;raw_zendesk.tickets&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;raw_zendesk.ticket_comments&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;raw_experiments.assignments&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;raw_google_ads.campaigns&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;raw_google_ads.ad_stats&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;raw_meta_ads.ad_insights&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;raw_hubspot.deals&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;raw_hubspot.contacts&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;raw_hubspot.companies&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Bullet Name Point' datatype='spatial' name='[Calculation_2438262903930881793]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Name Point&#13;&#10;// Name, left-aligned: centred half its measured width in from the left edge.&#13;&#10;MAKEPOINT(0, (CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN 44.5&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN 57.5&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN 53.9&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN 49.8&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN 49.0&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN 43.7&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN 54.6&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN 61.4&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN 52.9&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN 45.5&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN 48.1&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN 52.6&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN 48.7&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN 68.2&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN 62.0&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN 56.7&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN 63.2&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN 56.1&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN 47.8&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN 72.6&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN 71.7&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN 66.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN 60.5&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN 63.2&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN 44.6&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN 51.7&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN 57.6&#13;&#10;ELSE 0&#13;&#10;END - 305.5) / 100)' />
      </column>
      <column caption='Bullet Value Critical' datatype='string' name='[Calculation_2860129992511355501]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Bullet Value Critical&#13;&#10;// Lag value, red bold.&#13;&#10;IF [current_status_code] = 3 THEN [Calculation_1613376037383014604] END' />
      </column>
      <column caption='Bullet Value Warning' datatype='string' name='[Calculation_2076494762075167363]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Bullet Value Warning&#13;&#10;// Lag value, amber bold.&#13;&#10;IF [current_status_code] = 2 THEN [Calculation_1613376037383014604] END' />
      </column>
      <column caption='Bullet Value Normal' datatype='string' name='[Calculation_8313506078945889371]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Bullet Value Normal&#13;&#10;// Lag value, grey, on time.&#13;&#10;IF [current_status_code] &lt; 2 THEN [Calculation_1613376037383014604] END' />
      </column>
      <column caption='Bullet Value Point' datatype='spatial' name='[Calculation_7742891051247665925]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Value Point&#13;&#10;// Value, right-aligned: centred half its measured width in from the right edge.&#13;&#10;MAKEPOINT(0, (305.5 - CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN 15.1&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN 15.1&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN 16.5&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN 12.1&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN 13.9&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN 16.8&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN 12.1&#13;&#10;ELSE 0&#13;&#10;END) / 100)' />
      </column>
      <column caption='Latest Check Label' datatype='string' name='[Calculation_1480353776021512574]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Latest Check Label&#13;&#10;// Subtitle tail: &quot;Latest check 19 Oct, 23:00&quot;. Built from MAX of the timestamp, not of the text,&#13;&#10;// because &quot;9 Oct&quot; sorts after &quot;19 Oct&quot; as text.&#13;&#10;&quot;Latest check &quot;&#13;&#10;+ STR(DAY(MAX([last_event_at]))) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, MAX([last_event_at])), 3) + &quot;, &quot;&#13;&#10;+ RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, MAX([last_event_at]))), 2) + &quot;:&quot;&#13;&#10;+ RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, MAX([last_event_at]))), 2)' />
      </column>
      <column caption='Freshness Incident Tick' datatype='real' name='[Calculation_1900265801119430050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness Incident Tick&#13;&#10;// Tick under a freshness incident&apos;s label (INC 6, INC 8): a Gantt bar from the axis bottom.&#13;&#10;IF COUNT(IF [category] = &quot;freshness&quot; THEN [incident_id] END) &gt; 0 THEN 0.99 END' />
      </column>
      <column caption='Freshness Incident Anchor' datatype='real' name='[Calculation_8827293827650527009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness Incident Anchor&#13;&#10;// Point the label sits above.&#13;&#10;IF COUNT(IF [category] = &quot;freshness&quot; THEN [incident_id] END) &gt; 0 THEN 0.99460 END' />
      </column>
      <column caption='Freshness Incident Tick Length' datatype='real' name='[Calculation_9979621809358414906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness Incident Tick Length&#13;&#10;// How far the tick reaches up the strip.&#13;&#10;MIN(0.00420)' />
      </column>
      <column caption='Freshness Incident Label' datatype='string' name='[Calculation_1226887036694265486]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Freshness Incident Label&#13;&#10;// &quot;INC 6&quot; over freshness incidents only (the prototype filters to them).&#13;&#10;IF [category] = &quot;freshness&quot; THEN [Calculation_1454750851671812728] END' />
      </column>
      <column caption='Compliance Band' datatype='real' name='[Calculation_1016955751409068314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Compliance Band&#13;&#10;// The window band: a Gantt bar from the bottom of the axis (99%) on days in the window. A bar from&#13;&#10;// zero made Tableau show 0 % to 100 % (v30).&#13;&#10;IF MAX(IIF([Calculation_1409194560049525583], 1, 0)) = 1 THEN 0.99 END' />
      </column>
      <column caption='Freshness Pass Rate 7 Day' datatype='real' name='[Calculation_1919093782589270881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness Pass Rate 7 Day&#13;&#10;// Share of hourly checks on time over the 7 days up to each day, per platform (GB, v30: a&#13;&#10;// trend rather than daily spikes). Table calc along Days Back Mid: the 6 days before are +1 to +6.&#13;&#10;WINDOW_SUM(SUM([fresh_checks_pass]), 0, 6)&#13;&#10;/&#13;&#10;WINDOW_SUM(SUM([fresh_checks_pass] + [fresh_checks_warn] + [fresh_checks_error]), 0, 6)'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2904210747288447847]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Compliance Band Length' datatype='real' name='[Calculation_3511737934060676815]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Compliance Band Length&#13;&#10;// The band&apos;s length: the whole axis.&#13;&#10;MIN(0.0100)' />
      </column>
      <column caption='Platform On Day Name' datatype='string' name='[Calculation_2924358152833088820]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform On Day Name&#13;&#10;// Display name of the platform a node was on that day (Node Daily). Colours: Snowflake #005FAE, Databricks #4BAEE3, Redshift #5B5FC7.&#13;&#10;CASE [platform_on_day]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Compliance Axis Anchor' datatype='real' name='[Calculation_3974338510023223291]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Compliance Axis Anchor&#13;&#10;// Date labels under the compliance chart (its 90 % to 100 % scale).&#13;&#10;IF NOT ISNULL(MIN([Calculation_2516393983253929826])) THEN 0.9950 END' />
      </column>
      <column caption='Calendar Day Short' datatype='string' name='[Calculation_2166958855069030471]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Calendar Day Short&#13;&#10;// &quot;Mon&quot; ... &quot;Sun&quot; down the calendar.&#13;&#10;LEFT([day_name], 3)' />
      </column>
      <column caption='Calendar Today' datatype='real' name='[Calculation_1023255157077629383]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Calendar Today&#13;&#10;// The navy square behind today&apos;s (a little larger): its outline, as in the prototype.&#13;&#10;IF MIN([days_before_as_of]) = 0 THEN 0.0 END' />
      </column>
      <column caption='Calendar Cell' datatype='real' name='[Calculation_2542639095485652484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Calendar Cell&#13;&#10;// Every day&apos;s square sits at 0 on a hidden axis.&#13;&#10;MIN(0.0)' />
      </column>
      <column caption='Late Day Key' datatype='string' name='[Calculation_2553669690829697165]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Day Key&#13;&#10;// Calendar colour: Error #D2453F, Warn #E8A33D, On time (in window) #E3F2E9, Earlier #EEF0EE.&#13;&#10;IF SUM([fresh_checks_error]) &gt; 0 THEN &quot;Error&quot;&#13;&#10;ELSEIF SUM([fresh_checks_warn]) &gt; 0 THEN &quot;Warn&quot;&#13;&#10;ELSEIF MAX([days_before_as_of]) &lt; [Parameters].[Parameter 1] THEN &quot;On time&quot;&#13;&#10;ELSE &quot;Earlier&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Checks (Daily)' datatype='integer' name='[Calculation_5120633682563126247]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Late Checks (Daily)&#13;&#10;// Checks that came back warn or error that day. Shown as the number in each calendar cell.&#13;&#10;SUM([fresh_checks_warn] + [fresh_checks_error])' />
      </column>
      <column caption='Late Checks Text' datatype='string' name='[Calculation_1736940290597779592]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Checks Text&#13;&#10;// The number in a calendar square, blank on days with none.&#13;&#10;IF [Calculation_5120633682563126247] &gt; 0 THEN STR([Calculation_5120633682563126247]) END' />
      </column>
      <column caption='Late Pill Border Point' datatype='spatial' name='[Calculation_1501965132719312571]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Pill Border Point&#13;&#10;// Status pill outline (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5600, -1.5250), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5600, -0.9086), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -0.8786), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -0.8786), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4000, -0.9086), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4000, -1.5250), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -1.5550), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -1.5550), NULL)&#13;&#10;END' />
      </column>
      <column caption='Late Shape Id' datatype='integer' name='[Calculation_5402477272524234802]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Late Shape Id&#13;&#10;// Which pill or chip a scaffold row draws (8 rows each).&#13;&#10;INT([day_index] / 8)' />
      </column>
      <column caption='Late Shape Point Order' datatype='integer' name='[Calculation_1514529175384296372]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Late Shape Point Order&#13;&#10;// Point 0 to 7 round the shape (path).&#13;&#10;[day_index] % 8' />
      </column>
      <column caption='Late Pill Key' datatype='string' name='[Calculation_2885006952513766161]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Pill Key&#13;&#10;// Pill colours by status.&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 0 THEN &quot;Warning&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Pill Fill Point' datatype='spatial' name='[Calculation_2907567794637741529]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Pill Fill Point&#13;&#10;// Status pill fill, 1 px inside.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5500, -1.5250), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5500, -0.9086), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -0.8886), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -0.8886), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4100, -0.9086), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4100, -1.5250), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -1.5450), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -1.5450), NULL)&#13;&#10;END' />
      </column>
