    <worksheet name='GOV Gaps List'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='GOV Gaps Rect Key' datatype='string' name='[Calculation_4401964893841527788]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Gaps Rect Key&#13;&#10;// Rectangle colour.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR(INT([day_index] / 4))&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;databricks|2&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;redshift|1&quot; THEN &quot;Line&quot;&#13;&#10;WHEN &quot;redshift|2&quot; THEN &quot;Line&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Gaps Rect Point' datatype='spatial' name='[Calculation_1427328897243357856]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Gaps Rect Point&#13;&#10;// Rectangles of the scene, 4 date rows each (written by the build).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(2.6650, -1.8600)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(2.6650, 1.8600)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(2.6550, 1.8600)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(2.6550, -1.8600)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(1.8250, -1.8600)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(1.8250, 1.8600)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(1.8150, 1.8600)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(1.8150, -1.8600)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(-0.5150, -1.8600)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(-0.5150, 1.8600)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(-0.5250, 1.8600)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(-0.5250, -1.8600)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(2.6650, -1.8600)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(2.6650, 1.8600)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(2.6550, 1.8600)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(2.6550, -1.8600)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(1.9750, -1.8600)&#13;&#10;WHEN &quot;snowflake|5&quot; THEN MAKEPOINT(1.9750, 1.8600)&#13;&#10;WHEN &quot;snowflake|6&quot; THEN MAKEPOINT(1.9650, 1.8600)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(1.9650, -1.8600)&#13;&#10;WHEN &quot;snowflake|8&quot; THEN MAKEPOINT(0.3850, -1.8600)&#13;&#10;WHEN &quot;snowflake|9&quot; THEN MAKEPOINT(0.3850, 1.8600)&#13;&#10;WHEN &quot;snowflake|10&quot; THEN MAKEPOINT(0.3750, 1.8600)&#13;&#10;WHEN &quot;snowflake|11&quot; THEN MAKEPOINT(0.3750, -1.8600)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(2.6650, -1.8600)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(2.6650, 1.8600)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(2.6550, 1.8600)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(2.6550, -1.8600)&#13;&#10;WHEN &quot;databricks|4&quot; THEN MAKEPOINT(2.2750, -1.8600)&#13;&#10;WHEN &quot;databricks|5&quot; THEN MAKEPOINT(2.2750, 1.8600)&#13;&#10;WHEN &quot;databricks|6&quot; THEN MAKEPOINT(2.2650, 1.8600)&#13;&#10;WHEN &quot;databricks|7&quot; THEN MAKEPOINT(2.2650, -1.8600)&#13;&#10;WHEN &quot;databricks|8&quot; THEN MAKEPOINT(1.2850, -1.8600)&#13;&#10;WHEN &quot;databricks|9&quot; THEN MAKEPOINT(1.2850, 1.8600)&#13;&#10;WHEN &quot;databricks|10&quot; THEN MAKEPOINT(1.2750, 1.8600)&#13;&#10;WHEN &quot;databricks|11&quot; THEN MAKEPOINT(1.2750, -1.8600)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(2.6650, -1.8600)&#13;&#10;WHEN &quot;redshift|1&quot; THEN MAKEPOINT(2.6650, 1.8600)&#13;&#10;WHEN &quot;redshift|2&quot; THEN MAKEPOINT(2.6550, 1.8600)&#13;&#10;WHEN &quot;redshift|3&quot; THEN MAKEPOINT(2.6550, -1.8600)&#13;&#10;WHEN &quot;redshift|4&quot; THEN MAKEPOINT(2.2750, -1.8600)&#13;&#10;WHEN &quot;redshift|5&quot; THEN MAKEPOINT(2.2750, 1.8600)&#13;&#10;WHEN &quot;redshift|6&quot; THEN MAKEPOINT(2.2650, 1.8600)&#13;&#10;WHEN &quot;redshift|7&quot; THEN MAKEPOINT(2.2650, -1.8600)&#13;&#10;WHEN &quot;redshift|8&quot; THEN MAKEPOINT(1.2850, -1.8600)&#13;&#10;WHEN &quot;redshift|9&quot; THEN MAKEPOINT(1.2850, 1.8600)&#13;&#10;WHEN &quot;redshift|10&quot; THEN MAKEPOINT(1.2750, 1.8600)&#13;&#10;WHEN &quot;redshift|11&quot; THEN MAKEPOINT(1.2750, -1.8600)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Gaps Rect Id' datatype='integer' name='[Calculation_3169845255194462451]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// GOV Gaps Rect Id&#13;&#10;// Which rectangle a date row draws.&#13;&#10;INT([day_index] / 4)' />
            </column>
            <column caption='GOV Gaps Head Text' datatype='string' name='[Calculation_2036852667139373010]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Gaps Head Text&#13;&#10;// Head texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;NO OWNER&quot;&#13;&#10;WHEN &quot;All|9&quot; THEN &quot;NO TESTS&quot;&#13;&#10;WHEN &quot;All|38&quot; THEN &quot;NO DESCRIPTION&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;NO OWNER&quot;&#13;&#10;WHEN &quot;snowflake|7&quot; THEN &quot;NO TESTS&quot;&#13;&#10;WHEN &quot;snowflake|26&quot; THEN &quot;NO DESCRIPTION&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;NO OWNER&quot;&#13;&#10;WHEN &quot;databricks|3&quot; THEN &quot;NO TESTS&quot;&#13;&#10;WHEN &quot;databricks|14&quot; THEN &quot;NO DESCRIPTION&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;NO OWNER&quot;&#13;&#10;WHEN &quot;redshift|2&quot; THEN &quot;NO TESTS&quot;&#13;&#10;WHEN &quot;redshift|13&quot; THEN &quot;NO DESCRIPTION&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Gaps Head Point' datatype='spatial' name='[Calculation_2483089165135901465]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Gaps Head Point&#13;&#10;// Where each head text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(2.7450, -1.5970)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(1.9050, -1.6256)&#13;&#10;WHEN &quot;All|38&quot; THEN MAKEPOINT(-0.4350, -1.4563)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(2.7450, -1.5970)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(2.0550, -1.6256)&#13;&#10;WHEN &quot;snowflake|26&quot; THEN MAKEPOINT(0.4650, -1.4563)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(2.7450, -1.5970)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(2.3550, -1.6256)&#13;&#10;WHEN &quot;databricks|14&quot; THEN MAKEPOINT(1.3650, -1.4563)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(2.7450, -1.5970)&#13;&#10;WHEN &quot;redshift|2&quot; THEN MAKEPOINT(2.3550, -1.6256)&#13;&#10;WHEN &quot;redshift|13&quot; THEN MAKEPOINT(1.3650, -1.4563)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Gaps Item Text' datatype='string' name='[Calculation_1833932802591840827]' role='dimension' type='nominal'>
