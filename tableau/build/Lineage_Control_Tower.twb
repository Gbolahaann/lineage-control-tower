    <worksheet name='HO Exposures At Risk KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Is At Risk Now' datatype='boolean' name='[Calculation_2875175252813195699]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is At Risk Now&#13;&#10;// Warning or Critical in the current snapshot. Shared by Health, Blast radius and Governance.&#13;&#10;[current_status_code] &gt;= 2' />
            </column>
            <column caption='Exposures At Risk Now' datatype='integer' name='[Calculation_2866140559093986658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures At Risk Now&#13;&#10;// Exposures whose upstream chain is Warning or Critical in the current snapshot. Check: 12.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [Calculation_2875175252813195699] THEN 1 END))' />
            </column>
            <column caption='Exposures In Scope' datatype='integer' name='[Calculation_3186893425654714520]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures In Scope&#13;&#10;// All exposures for the selected platform, including unregistered ones. Check: 27.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; THEN 1 END))' />
            </column>
            <column caption='Exposures At Risk Of Label' datatype='string' name='[Calculation_2683875477335081578]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Exposures At Risk Of Label&#13;&#10;// Small grey suffix after the BAN: &quot;of 27 now&quot;.&#13;&#10;&quot;of &quot; + STR([Calculation_3186893425654714520]) + &quot; now&quot;' />
            </column>
            <column caption='Exposures Critical Now' datatype='integer' name='[Calculation_1964810160360354757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures Critical Now&#13;&#10;// Change-line lead, in red: &quot;4 critical&quot;. Format: 0 &quot;critical&quot;&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [current_status_code] = 3 THEN 1 END))' />
            </column>
            <column caption='Exposures Warning Now' datatype='integer' name='[Calculation_8920847743012969069]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures Warning Now&#13;&#10;// Change-line tail, in grey: &quot;· 8 warning&quot;. Format: &quot;· &quot;0&quot; warning&quot;&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [current_status_code] = 2 THEN 1 END))' />
            </column>
            <column caption='Current Status Code' datatype='integer' name='[current_status_code]' role='dimension' type='ordinal' />
            <column caption='Platform Filter Values' datatype='string' name='[platform_filter_values]' role='dimension' type='nominal' />
