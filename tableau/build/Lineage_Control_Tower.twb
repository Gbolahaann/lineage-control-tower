      <column caption='Late Chip Exposure' datatype='string' name='[Calculation_3300680714804879543]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Chip Exposure&#13;&#10;// The data product a chip opens (p_selected_exposure).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;exposure.acme_core.executive_revenue_dashboard&quot;&#13;&#10;WHEN 2 THEN &quot;exposure.acme_core.board_kpi_pack&quot;&#13;&#10;WHEN 3 THEN &quot;exposure.acme_core.supply_chain_ops&quot;&#13;&#10;WHEN 4 THEN &quot;exposure.acme_core.inventory_health&quot;&#13;&#10;WHEN 5 THEN &quot;exposure.acme_product.demand_forecast_app&quot;&#13;&#10;WHEN 6 THEN &quot;exposure.acme_core.merchandising_copilot&quot;&#13;&#10;WHEN 7 THEN &quot;exposure.acme_core.store_ops_hub&quot;&#13;&#10;WHEN 8 THEN &quot;exposure.observed.undeclared_pricing_agent&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Chip Status' datatype='integer' name='[Calculation_1407047436052111403]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Late Chip Status&#13;&#10;// Its status code, for the Lineage panel (p_panel_status).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN 3&#13;&#10;WHEN 2 THEN 3&#13;&#10;WHEN 3 THEN 2&#13;&#10;WHEN 4 THEN 2&#13;&#10;WHEN 5 THEN 2&#13;&#10;WHEN 6 THEN 2&#13;&#10;WHEN 7 THEN 2&#13;&#10;WHEN 8 THEN 2&#13;&#10;END' />
      </column>
      <column caption='Late Chip Type' datatype='string' name='[Calculation_1504662037100545342]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Chip Type&#13;&#10;// Its type, for the Lineage panel (p_panel_type).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;exposure&quot;&#13;&#10;WHEN 2 THEN &quot;exposure&quot;&#13;&#10;WHEN 3 THEN &quot;exposure&quot;&#13;&#10;WHEN 4 THEN &quot;exposure&quot;&#13;&#10;WHEN 5 THEN &quot;exposure&quot;&#13;&#10;WHEN 6 THEN &quot;exposure&quot;&#13;&#10;WHEN 7 THEN &quot;exposure&quot;&#13;&#10;WHEN 8 THEN &quot;exposure&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Chip Platform' datatype='string' name='[Calculation_1833500224696775779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Chip Platform&#13;&#10;// Its platform, for the Lineage panel (p_panel_platform).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;snowflake&quot;&#13;&#10;WHEN 2 THEN &quot;snowflake&quot;&#13;&#10;WHEN 3 THEN &quot;snowflake&quot;&#13;&#10;WHEN 4 THEN &quot;snowflake&quot;&#13;&#10;WHEN 5 THEN &quot;databricks&quot;&#13;&#10;WHEN 6 THEN &quot;snowflake&quot;&#13;&#10;WHEN 7 THEN &quot;snowflake&quot;&#13;&#10;WHEN 8 THEN &quot;snowflake&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Chip Tags' datatype='string' name='[Calculation_1812376704710986453]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Chip Tags&#13;&#10;// Its tags, for the Lineage panel (p_panel_tags).&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 1 THEN &quot;|&quot;&#13;&#10;WHEN 2 THEN &quot;|&quot;&#13;&#10;WHEN 3 THEN &quot;|&quot;&#13;&#10;WHEN 4 THEN &quot;|&quot;&#13;&#10;WHEN 5 THEN &quot;|&quot;&#13;&#10;WHEN 6 THEN &quot;|ai|&quot;&#13;&#10;WHEN 7 THEN &quot;|ai|&quot;&#13;&#10;WHEN 8 THEN &quot;|ai|unregistered|&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Chip Text' datatype='string' name='[Calculation_3245556163370616280]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Chip Text&#13;&#10;// The chip texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 3 THEN &quot;Executive Revenue Dashboard&quot;&#13;&#10;WHEN 4 THEN &quot;Board KPI Pack&quot;&#13;&#10;WHEN 5 THEN &quot;Supply Chain Ops&quot;&#13;&#10;WHEN 6 THEN &quot;Inventory Health&quot;&#13;&#10;WHEN 7 THEN &quot;Demand Forecast App&quot;&#13;&#10;WHEN 8 THEN &quot;Merchandising Copilot&quot;&#13;&#10;WHEN 9 THEN &quot;Store Ops Hub&quot;&#13;&#10;WHEN 10 THEN &quot;Unregistered: pricing agent&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Pill Text' datatype='string' name='[Calculation_1764489920114139474]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Pill Text&#13;&#10;// The pill texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;▲  Warning&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Text Point' datatype='spatial' name='[Calculation_2282167173564098285]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Text Point&#13;&#10;// Every text on the card, one scaffold row each (centred at half its measured width).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4800, -1.2168), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4800, -0.3056), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.2900, -0.5244), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1000, -0.8487), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1000, 0.2885), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.1000, -1.1171), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.1000, -0.2379), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.1000, 0.7299), NULL)&#13;&#10;WHEN 8 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.3000, -1.0312), NULL)&#13;&#10;WHEN 9 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.3000, -0.0973), NULL)&#13;&#10;WHEN 10 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(-0.5000, -0.9321), NULL)&#13;&#10;END' />
      </column>
      <column caption='Late Name Text' datatype='string' name='[Calculation_1531619695946605715]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Name Text&#13;&#10;// The name texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 1 THEN &quot;raw_wms.inventory&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Reason Text' datatype='string' name='[Calculation_1687637932258375271]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Reason Text&#13;&#10;// The reason texts (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 2 THEN &quot;Loading late, 6.0 h behind (warn after 3.0 h)&quot;&#13;&#10;END' />
      </column>
      <column caption='Late Empty Text' datatype='string' name='[Calculation_1133191930404812511]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Late Empty Text&#13;&#10;// The empty state.&#13;&#10;&quot;Every source is on time.&quot;' />
      </column>
      <column caption='Late Empty Point' datatype='spatial' name='[Calculation_2931406528209753795]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Empty Point&#13;&#10;// &quot;Every source is on time.&quot; when no late source is in the platform filter.&#13;&#10;IF [day_index] = 0 AND NOT (([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;)) THEN MAKEPOINT(0.4800, -0.9882) END' />
      </column>
      <column caption='Average Cost Per Day' datatype='real' name='[Calculation_2162546195325930241]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Average Cost Per Day&#13;&#10;// Mini KPI: window cost divided by the number of days in the window.&#13;&#10;[Calculation_2007928041536179389] / [Parameters].[Parameter 1]' />
      </column>
      <column caption='PF Snowflake Name' datatype='string' name='[Calculation_1203335104702411347]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Snowflake Name&#13;&#10;// &quot;Snowflake&quot; in its colour on the average-per-day line, when the filter shows it.&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;) THEN &quot;Snowflake&quot; END' />
      </column>
      <column caption='Cost Per Day Snowflake' datatype='real' name='[Calculation_1964666010242481635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Cost Per Day Snowflake&#13;&#10;// Sub-line part, in the Snowflake colour. NULL when another platform is selected.&#13;&#10;SUM(IF [Calculation_1409194560049525583] AND [platform_on_day] = &quot;snowflake&quot;&#13;&#10;    THEN [build_cost_usd] + [consumer_query_cost_usd] END) / [Parameters].[Parameter 1]' />
      </column>
      <column caption='PF Snowflake Per Day Text' datatype='string' name='[Calculation_4702041613127393790]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Snowflake Per Day Text&#13;&#10;// &quot; $80&quot; after the name: Snowflake&apos;s cost per day in the window ($0 when it had none).&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;) THEN &quot; $&quot; + STR(INT(ROUND(ZN([Calculation_1964666010242481635])))) END' />
      </column>
      <column caption='PF Platform Separator' datatype='string' name='[Calculation_2748686657077975214]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Platform Separator&#13;&#10;// &quot; · &quot; between the platforms when all three are shown.&#13;&#10;IF [Parameters].[Parameter 2] = &quot;All&quot; THEN &quot;  ·  &quot; END' />
      </column>
      <column caption='PF Databricks Name' datatype='string' name='[Calculation_2005008339625904292]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Databricks Name&#13;&#10;// &quot;Databricks&quot; in its colour on the average-per-day line, when the filter shows it.&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;databricks&quot;) THEN &quot;Databricks&quot; END' />
      </column>
      <column caption='Cost Per Day Databricks' datatype='real' name='[Calculation_2622736667316066365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Cost Per Day Databricks&#13;&#10;// Sub-line part, in the Databricks colour.&#13;&#10;SUM(IF [Calculation_1409194560049525583] AND [platform_on_day] = &quot;databricks&quot;&#13;&#10;    THEN [build_cost_usd] + [consumer_query_cost_usd] END) / [Parameters].[Parameter 1]' />
      </column>
      <column caption='PF Databricks Per Day Text' datatype='string' name='[Calculation_1980839361186170002]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Databricks Per Day Text&#13;&#10;// &quot; $80&quot; after the name: Databricks&apos;s cost per day in the window ($0 when it had none).&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;databricks&quot;) THEN &quot; $&quot; + STR(INT(ROUND(ZN([Calculation_2622736667316066365])))) END' />
      </column>
      <column caption='PF Redshift Name' datatype='string' name='[Calculation_2886232109293083039]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Redshift Name&#13;&#10;// &quot;Redshift&quot; in its colour on the average-per-day line, when the filter shows it.&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;redshift&quot;) THEN &quot;Redshift&quot; END' />
      </column>
      <column caption='Cost Per Day Redshift' datatype='real' name='[Calculation_1816382868067773308]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Cost Per Day Redshift&#13;&#10;// Sub-line part, in the Redshift colour. NULL in the last 30 days (Redshift was retired on 15 Sep).&#13;&#10;SUM(IF [Calculation_1409194560049525583] AND [platform_on_day] = &quot;redshift&quot;&#13;&#10;    THEN [build_cost_usd] + [consumer_query_cost_usd] END) / [Parameters].[Parameter 1]' />
      </column>
      <column caption='PF Redshift Per Day Text' datatype='string' name='[Calculation_1279538948842296469]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Redshift Per Day Text&#13;&#10;// &quot; $80&quot; after the name: Redshift&apos;s cost per day in the window ($0 when it had none).&#13;&#10;IF ([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;redshift&quot;) THEN &quot; $&quot; + STR(INT(ROUND(ZN([Calculation_1816382868067773308])))) END' />
      </column>
      <column caption='Is Model' datatype='boolean' name='[Calculation_1221533192259849042]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Model&#13;&#10;// Keeps dbt models.&#13;&#10;[resource_type] = &quot;model&quot;' />
      </column>
      <column caption='PF Slowest Rank' datatype='integer' name='[Calculation_1209399367078413203]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// PF Slowest Rank&#13;&#10;// Place of a model among the six slowest (mean of its daily average successful run in the&#13;&#10;// period), under the platform filter. Written by the build.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|All|model.acme_product.int_sessions__stitched&quot; THEN 1&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_sessions&quot; THEN 2&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;7|All|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;7|All|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;7|snowflake|model.acme_marketing.fct_attribution&quot; THEN 2&#13;&#10;WHEN &quot;7|snowflake|model.acme_marketing.int_ads__attribution&quot; THEN 3&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_finance_close&quot; THEN 4&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_gl__mapped&quot; THEN 5&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_order_items&quot; THEN 6&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_sessions__stitched&quot; THEN 1&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_sessions&quot; THEN 2&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;7|databricks|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;30|All|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;30|All|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;30|All|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;30|snowflake|model.acme_marketing.fct_attribution&quot; THEN 2&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_finance_close&quot; THEN 3&#13;&#10;WHEN &quot;30|snowflake|model.acme_marketing.int_ads__attribution&quot; THEN 4&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_gl__mapped&quot; THEN 5&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_order_items&quot; THEN 6&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;30|databricks|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;90|All|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;90|All|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;90|All|model.acme_marketing.fct_attribution&quot; THEN 6&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.dim_customer_360&quot; THEN 2&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.int_ads__attribution&quot; THEN 3&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.fct_finance_close&quot; THEN 4&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.int_ads__unified&quot; THEN 5&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.int_gl__mapped&quot; THEN 6&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;90|databricks|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Is PF Slowest Model' datatype='boolean' name='[Calculation_4911841298322152364]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is PF Slowest Model&#13;&#10;// The slowest model, for the KPI. Put on Filters (True).&#13;&#10;[Calculation_1209399367078413203] = 1' />
      </column>
      <column caption='Model Avg Runtime (Period)' datatype='real' name='[Calculation_1738092290818823641]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Model Avg Runtime (Period)&#13;&#10;// Mean of the daily average runtime over the window, in seconds. Needs avg_runtime_sec typed as Number.&#13;&#10;// 30d check: fct_sessions about 1,673 s (27.9 min) is the slowest.&#13;&#10;AVG(IF [Calculation_1409194560049525583] THEN [avg_runtime_sec] END)' />
      </column>
      <column caption='Model Runtime Label' datatype='string' name='[Calculation_2833830762735681804]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Model Runtime Label&#13;&#10;// Duration text for an aggregated runtime: &quot;45s&quot;, &quot;27.9 min&quot;, &quot;1.2 h&quot;.&#13;&#10;IF ISNULL([Calculation_1738092290818823641]) THEN &quot;-&quot;&#13;&#10;ELSEIF [Calculation_1738092290818823641] &lt; 60 THEN STR(ROUND([Calculation_1738092290818823641])) + &quot;s&quot;&#13;&#10;ELSEIF [Calculation_1738092290818823641] &lt; 3600 THEN STR(ROUND([Calculation_1738092290818823641] / 60, 1)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([Calculation_1738092290818823641] / 3600, 1)) + &quot; h&quot;&#13;&#10;END' />
      </column>
      <column caption='Runtime Trend Now' datatype='real' name='[Calculation_3083874683594051399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Runtime Trend Now&#13;&#10;// 7-day vs prior 28-day runtime change on the last day (19 Oct), as a fraction. Format ▲ 0%;▼ 0%.&#13;&#10;// Needs runtime_trend_pct typed as Number (decimal) in the data source.&#13;&#10;MAX(IF [days_before_as_of] = 0 THEN [runtime_trend_pct] END)' />
      </column>
      <column caption='PF Slowest Trend Text' datatype='string' name='[Calculation_1272621414589681895]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Slowest Trend Text&#13;&#10;// &quot;  ·  ▼ 88% 7d vs 28d&quot; after the slowest model&apos;s average run.&#13;&#10;IF ISNULL([Calculation_3083874683594051399]) THEN &quot;&quot;&#13;&#10;ELSE &quot;  ·  &quot; + (IF [Calculation_3083874683594051399] &gt; 0 THEN &quot;▲ &quot; ELSE &quot;▼ &quot; END)&#13;&#10;    + STR(INT(ROUND(ABS([Calculation_3083874683594051399]) * 100))) + &quot;% 7d vs 28d&quot;&#13;&#10;END' />
      </column>
      <column caption='Incremental Candidate Day' datatype='boolean' name='[Calculation_1364965825098171574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Incremental Candidate Day&#13;&#10;// A day in the window where the model was a full-refresh table and its runtime trend was above +25%&#13;&#10;// (thresholds from generator/config.yaml). Needs runtime_trend_pct typed as Number.&#13;&#10;[Calculation_1409194560049525583]&#13;&#10;AND [materialization_on_day] = &quot;table&quot;&#13;&#10;AND [runtime_trend_pct] &gt; 0.25' />
      </column>
      <column caption='Is Incremental Candidate' datatype='boolean' name='[Calculation_1023863511757725728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Incremental Candidate&#13;&#10;// Candidate at any point in the window, and over 10M rows. Check: only fct_sessions (at 30 days).&#13;&#10;{ FIXED [node_id] : MAX(IF [Calculation_1364965825098171574] THEN 1 ELSE 0 END) } = 1&#13;&#10;AND [max_rows_built] &gt; 10000000' />
      </column>
      <column caption='Is Switched Candidate' datatype='boolean' name='[Calculation_1162027673306844455]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Switched Candidate&#13;&#10;// A candidate that has since been made incremental (fct_sessions, 4 Oct).&#13;&#10;[Calculation_1023863511757725728]&#13;&#10;AND [materialization_now] = &quot;incremental&quot;' />
      </column>
      <column caption='Open Incremental Candidates' datatype='integer' name='[Calculation_2283342821434223938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Open Incremental Candidates&#13;&#10;// Mini KPI value: candidates not yet switched.&#13;&#10;COUNTD(IF [Calculation_1023863511757725728] AND NOT [Calculation_1162027673306844455] THEN [node_id] END)' />
      </column>
      <column caption='Switched On' datatype='date' name='[Calculation_3075289868392307480]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Switched On&#13;&#10;// First day the model ran as incremental. Only meaningful for switched candidates.&#13;&#10;{ FIXED [node_id] : MIN(IF [materialization_on_day] = &quot;incremental&quot; THEN [date] END) }' />
      </column>
      <column caption='Switched Candidate Text' datatype='string' name='[Calculation_2397197516190067563]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Switched Candidate Text&#13;&#10;// Green sub-line: &quot;fct_sessions switched 4 Oct&quot;. With more than one, the sheet lists one row each.&#13;&#10;IF [Calculation_1162027673306844455]&#13;&#10;    THEN [node_name] + &quot; switched &quot; + STR(DAY([Calculation_3075289868392307480])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [Calculation_3075289868392307480]), 3)&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='PF Switched Text' datatype='string' name='[Calculation_1653631241000378234]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Switched Text&#13;&#10;// Green: &quot;fct_sessions switched 4 Oct&quot;.&#13;&#10;MAX([Calculation_2397197516190067563])' />
      </column>
      <column caption='Open Candidate Text' datatype='string' name='[Calculation_3172225817606011454]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Open Candidate Text&#13;&#10;// Red sub-line: candidates still to fix.&#13;&#10;IF [Calculation_1023863511757725728] AND NOT [Calculation_1162027673306844455] THEN [node_name] ELSE &quot;&quot; END' />
      </column>
      <column caption='PF Open Text' datatype='string' name='[Calculation_2172685562047498037]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Open Text&#13;&#10;// Red: a candidate still to switch.&#13;&#10;MAX([Calculation_3172225817606011454])' />
      </column>
      <column caption='PF No Candidates Text' datatype='string' name='[Calculation_1470099823134721743]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF No Candidates Text&#13;&#10;// Grey, when no model qualified in the window.&#13;&#10;IF MAX(IIF([Calculation_1023863511757725728], 1, 0)) = 0 THEN &quot;None in this period&quot; END' />
      </column>
      <column caption='PF Cost Band' datatype='real' name='[Calculation_5912164231542701617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// PF Cost Band&#13;&#10;// The window band behind the cost bars: a bar to the top of the axis on days in the window. The axis&#13;&#10;// follows the data, so the top is written per platform (a round number just above the busiest day).&#13;&#10;IF MAX(IIF([Calculation_1409194560049525583], 1, 0)) = 1 THEN&#13;&#10;CASE [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;All&quot; THEN 200&#13;&#10;WHEN &quot;snowflake&quot; THEN 100&#13;&#10;WHEN &quot;databricks&quot; THEN 120&#13;&#10;WHEN &quot;redshift&quot; THEN 70&#13;&#10;ELSE NULL&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='PF Axis Anchor' datatype='real' name='[Calculation_2935097954998525570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// PF Axis Anchor&#13;&#10;// Point the date labels under the two charts are centred on (strip axis 0 to 1).&#13;&#10;IF NOT ISNULL(MIN([Calculation_2516393983253929826])) THEN 0.5 END' />
      </column>
      <column caption='PF Runtime Band' datatype='real' name='[Calculation_2957953489686931168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// PF Runtime Band&#13;&#10;// The window band behind the runtime lines, to the top of the axis (written per period and platform).&#13;&#10;IF MAX(IIF([Calculation_1409194560049525583], 1, 0)) = 1 THEN&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN 70&#13;&#10;WHEN &quot;7|snowflake&quot; THEN 3.0&#13;&#10;WHEN &quot;7|databricks&quot; THEN 70&#13;&#10;WHEN &quot;7|redshift&quot; THEN 3.0&#13;&#10;WHEN &quot;30|All&quot; THEN 70&#13;&#10;WHEN &quot;30|snowflake&quot; THEN 3.0&#13;&#10;WHEN &quot;30|databricks&quot; THEN 70&#13;&#10;WHEN &quot;30|redshift&quot; THEN 3.0&#13;&#10;WHEN &quot;90|All&quot; THEN 70&#13;&#10;WHEN &quot;90|snowflake&quot; THEN 3.0&#13;&#10;WHEN &quot;90|databricks&quot; THEN 70&#13;&#10;WHEN &quot;90|redshift&quot; THEN 3.0&#13;&#10;ELSE NULL&#13;&#10;END&#13;&#10;END' />
      </column>
      <column caption='Runtime Minutes (Daily)' datatype='real' name='[Calculation_5251881012306753110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Runtime Minutes (Daily)&#13;&#10;// Panel runtime line, in minutes. Needs avg_runtime_sec typed as Number.&#13;&#10;AVG([avg_runtime_sec]) / 60' />
      </column>
      <column caption='PF Runtime Line' datatype='real' name='[Calculation_1270312154064045063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// PF Runtime Line&#13;&#10;// Average successful run that day, in minutes.&#13;&#10;[Calculation_5251881012306753110]' />
      </column>
      <column caption='Is PF Slowest Six' datatype='boolean' name='[Calculation_1275750666985780766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is PF Slowest Six&#13;&#10;// The six lines of the runtime chart. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1209399367078413203])' />
      </column>
      <column caption='PF Line Key' datatype='string' name='[Calculation_1674664104549747405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Line Key&#13;&#10;// Colour of a runtime line: the biggest runtime change among the six (its largest 7d vs 28d&#13;&#10;// change in the period) in the accent, the rest grey.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_sessions&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_gl__mapped&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_sessions&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_sessions&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_gl__mapped&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_sessions&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_sessions&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.int_gl__mapped&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_sessions&quot; THEN &quot;Top change&quot;&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN &quot;Top change&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='Is PF Heading Row' datatype='boolean' name='[Calculation_4365700045437780035]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is PF Heading Row&#13;&#10;// The first six days of the date table: one per column title. Put on Filters (True).&#13;&#10;[day_index] &lt; 6' />
      </column>
      <column caption='PF Heading' datatype='string' name='[Calculation_2909203795951181803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// PF Heading&#13;&#10;// Column titles of the most expensive models table, one date row each.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;MODEL&quot;&#13;&#10;WHEN 1 THEN &quot;BUILT AS&quot;&#13;&#10;WHEN 2 THEN &quot;AVG RUNTIME&quot;&#13;&#10;WHEN 3 THEN &quot;7D VS 28D&quot;&#13;&#10;WHEN 4 THEN &quot;LARGEST BUILD&quot;&#13;&#10;WHEN 5 THEN &quot;COST&quot;&#13;&#10;END' />
      </column>
      <column caption='PF Heading Point' datatype='spatial' name='[Calculation_1028334264679791289]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// PF Heading Point&#13;&#10;// Middle of a column title (left or right-aligned, measured by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN MAKEPOINT(0, (24.9 - 365) / 100)&#13;&#10;WHEN 1 THEN MAKEPOINT(0, (193.1 - 365) / 100)&#13;&#10;WHEN 2 THEN MAKEPOINT(0, (323.5 - 365) / 100)&#13;&#10;WHEN 3 THEN MAKEPOINT(0, (404.5 - 365) / 100)&#13;&#10;WHEN 4 THEN MAKEPOINT(0, (482.0 - 365) / 100)&#13;&#10;WHEN 5 THEN MAKEPOINT(0, (567.0 - 365) / 100)&#13;&#10;END' />
      </column>
      <column caption='PF Cost Rank' datatype='integer' name='[Calculation_1845292614625042272]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// PF Cost Rank&#13;&#10;// Place of a model among the 15 that cost most to build in the period, under the platform filter&#13;&#10;// (worked out by the build for every period and platform, as the prototype ranks them).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|All|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;7|All|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_sessions&quot; THEN 3&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_order_items&quot; THEN 4&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_inventory_daily&quot; THEN 5&#13;&#10;WHEN &quot;7|All|model.acme_core.int_orders__enriched&quot; THEN 6&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_orders&quot; THEN 7&#13;&#10;WHEN &quot;7|All|model.acme_core.dim_customers&quot; THEN 8&#13;&#10;WHEN &quot;7|All|model.acme_core.int_inventory__snapshots&quot; THEN 9&#13;&#10;WHEN &quot;7|All|model.acme_product.int_customer_behavior&quot; THEN 10&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_payments&quot; THEN 11&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_shipments&quot; THEN 12&#13;&#10;WHEN &quot;7|All|model.acme_core.int_payments__reconciled&quot; THEN 13&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_demand_signals&quot; THEN 14&#13;&#10;WHEN &quot;7|All|model.acme_product.dim_customer_behavior&quot; THEN 15&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_order_items&quot; THEN 2&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_inventory_daily&quot; THEN 3&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_orders__enriched&quot; THEN 4&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_orders&quot; THEN 5&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.dim_customers&quot; THEN 6&#13;&#10;WHE