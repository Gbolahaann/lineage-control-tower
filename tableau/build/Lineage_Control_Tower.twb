            </column>
            <column caption='Panel Callout Reason' datatype='string' name='[Calculation_2696229332938111457]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Callout Reason&#13;&#10;// What is wrong with the panel node, wrapped to the callout width by the build (from dim_nodes).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack&quot; THEN &quot;stg_netsuite__journal_lines (Critical); dim_customers&quot; + CHAR(10) + &quot;(Warning); raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.customer_360&quot; THEN &quot;dim_customers (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.executive_revenue_dashboard&quot; THEN &quot;stg_netsuite__journal_lines (Critical); dim_customers&quot; + CHAR(10) + &quot;(Warning); raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.finance_close_tracker&quot; THEN &quot;stg_netsuite__journal_lines (Critical)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.finance_qa_agent&quot; THEN &quot;stg_netsuite__journal_lines (Critical)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.inventory_health&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.merchandising_copilot&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.store_ops_hub&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.supply_chain_ops&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_product.churn_prediction_model&quot; THEN &quot;dim_customers (Warning)&quot;&#13;&#10;WHEN &quot;exposure.acme_product.demand_forecast_app&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;exposure.observed.undeclared_pricing_agent&quot; THEN &quot;raw_wms.inventory (Warning)&quot;&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN &quot;1 test failing: unique_dim_customers_customer_id&quot;&#13;&#10;WHEN &quot;model.acme_core.stg_netsuite__journal_lines&quot; THEN &quot;Compilation Error in model stg_netsuite__journal_lines at&quot; + CHAR(10) + &quot;19 Oct, 21:25&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;Loading late, 6.0 h behind (warn after 3.0 h)&quot;&#13;&#10;END' />
            </column>
            <column caption='Panel Callout Error' datatype='string' name='[Calculation_2552850758722083609]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Callout Error&#13;&#10;// The raw error message under the reason, wrapped by the build (from dim_nodes).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.stg_netsuite__journal_lines&quot; THEN &quot;Compilation Error in model stg_netsuite__journal_lines: &apos;dict&quot; + CHAR(10) + &quot;object&apos; has no attribute &apos;currency_code&apos;. This can happen when a&quot; + CHAR(10) + &quot;macro argument is renamed.&quot;&#13;&#10;END' />
            </column>
            <column caption='Node Id (Nodes)' datatype='string' name='[node_id (dim_nodes.csv)]' role='dimension' type='nominal' />
