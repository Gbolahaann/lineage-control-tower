      <column caption='Table Status Pill Point' datatype='spatial' name='[Calculation_4072656251478419518]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Status Pill Point&#13;&#10;// Status pill (tinted, fully rounded).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (0) + 9 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((401) + (401 + CASE [Calculation_3105941082857465865] WHEN &quot;Critical&quot; THEN 57 WHEN &quot;Warning&quot; THEN 65 WHEN &quot;Healthy&quot; THEN 59 WHEN &quot;No data&quot; THEN 58 ELSE 0 END)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((401 + CASE [Calculation_3105941082857465865] WHEN &quot;Critical&quot; THEN 57 WHEN &quot;Warning&quot; THEN 65 WHEN &quot;Healthy&quot; THEN 59 WHEN &quot;No data&quot; THEN 58 ELSE 0 END) - (401)) / 2 - 9) + 9 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
      </column>
