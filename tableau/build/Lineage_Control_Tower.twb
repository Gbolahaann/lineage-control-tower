    <worksheet name='PF Cost per Data Product Bar'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Product Cost Label Tag' datatype='string' name='[Calculation_3193649455591386272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Product Cost Label Tag&#13;&#10;// &quot;unregistered&quot; tag after an exposure name in the cost bars.&#13;&#10;IF [is_declared] THEN &quot;&quot; ELSE &quot;unregistered&quot; END' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Product Cost (Period)' datatype='real' name='[Calculation_3016817971858344399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Product Cost (Period)&#13;&#10;// Allocated cost in the window: upstream build cost split across the exposures each model feeds, plus own queries.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [allocated_cost_usd] END)' />
            </column>
            <column caption='Product Cost Track' datatype='real' name='[Calculation_2011931852930701367]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Product Cost Track&#13;&#10;// Where each cost label starts, just past the longest bar (as the Why runs failed counts).&#13;&#10;// Table calc along display_name and the unregistered tag.&#13;&#10;WINDOW_MAX([Calculation_3016817971858344399]) * 1.14'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Is Top Product Cost' datatype='boolean' name='[Calculation_5716871441044921580]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Is Top Product Cost&#13;&#10;// The 12 data products that cost most in the window. Table calc filter (True).&#13;&#10;RANK_UNIQUE([Calculation_3016817971858344399]) &lt;= 12'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Product Uses (Period)' datatype='real' name='[Calculation_1159284100207867770]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Product Uses (Period)&#13;&#10;// An exposure&apos;s consumption events in the window (views, queries, sessions or calls).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [events] END)' />
            </column>
            <column caption='Uses Unit Label' datatype='string' name='[Calculation_2657459577906221023]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Uses Unit Label&#13;&#10;// Unit after a usage number: views, queries, app sessions or agent calls (Exposure Daily).&#13;&#10;CASE [consumption_type (mart_exposure_daily.csv)]&#13;&#10;WHEN &quot;view&quot;        THEN &quot;views&quot;&#13;&#10;WHEN &quot;query&quot;       THEN &quot;queries&quot;&#13;&#10;WHEN &quot;app_session&quot; THEN &quot;app sessions&quot;&#13;&#10;WHEN &quot;agent_call&quot;  THEN &quot;agent calls&quot;&#13;&#10;END' />
            </column>
            <column caption='Cost Per Use' datatype='real' name='[Calculation_2256908730979128074]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Cost Per Use&#13;&#10;// Product Cost / Product Uses. NULL (shown &quot;-&quot;) when there was no use.&#13;&#10;IF [Calculation_1159284100207867770] = 0 OR ISNULL([Calculation_1159284100207867770]) THEN NULL&#13;&#10;ELSE [Calculation_3016817971858344399] / [Calculation_1159284100207867770]&#13;&#10;END' />
            </column>
            <column caption='Allocated Cost Usd' datatype='real' name='[allocated_cost_usd]' role='measure' type='quantitative' />
            <column caption='Consumption Type (Exposure Daily)' datatype='string' name='[consumption_type (mart_exposure_daily.csv)]' role='dimension' type='nominal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Events' datatype='integer' name='[events]' role='measure' type='quantitative' />
            <column caption='Is Declared' datatype='boolean' name='[is_declared]' role='dimension' type='nominal' />
            <column caption='Platform Filter Values' datatype='string' name='[platform_filter_values]' role='dimension' type='nominal' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
