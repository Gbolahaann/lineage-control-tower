        <calculation class='tableau' formula='// Runtime Change Down Text&#13;&#10;// &quot;▼ 30%&quot; in green: runtime down more than 25%.&#13;&#10;IF [Calculation_3083874683594051399] &lt; -0.25 THEN &quot;▼ &quot; + STR(ROUND(-[Calculation_3083874683594051399] * 100)) + &quot;%&quot; END' />
      </column>
