            <column-instance column='[Calculation_2561166764669332405]' derivation='User' name='[usr:Calculation_2561166764669332405:qk]' pivot='key' type='quantitative' />
            <column-instance column='[date (dim_date.csv)]' derivation='None' name='[none:date (dim_date.csv):qk]' pivot='key' type='quantitative' />
