    <worksheet name='RUN Job Gantt'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
            <column caption='p_gantt_date' datatype='date' datatype-customized='true' name='[Parameter 6]' param-domain-type='any' role='measure' type='quantitative' value='#2026-10-19#'>
              <calculation class='tableau' formula='#2026-10-19#' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Job Schedule Label' datatype='string' name='[Calculation_3094354169785943014]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Job Schedule Label&#13;&#10;// Small grey header beside the job name: &quot;hourly&quot;, &quot;daily&quot;, &quot;on PR&quot;.&#13;&#10;REPLACE([schedule], &quot;on_pull_request&quot;, &quot;on PR&quot;)' />
            </column>
            <column caption='Gantt Start Hour' datatype='real' name='[Calculation_3122650177919167747]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Gantt Start Hour&#13;&#10;// Bar start in hours (axis 00:00 to 24:00) for runs on the selected day; other days have no mark.&#13;&#10;IF [run_date] = [Parameters].[Parameter 6] THEN [start_minute_of_day] / 60 END' />
            </column>
            <column caption='Tests Failed Marker Hour' datatype='real' name='[Calculation_2353287589358600364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Tests Failed Marker Hour&#13;&#10;// Amber dot just after a run whose tests failed. NULL (no mark) otherwise.&#13;&#10;IF [run_date] = [Parameters].[Parameter 6] AND [tests_failed] &gt; 0&#13;&#10;THEN ([start_minute_of_day] + MAX([duration_min], 3) + 4) / 60 END' />
            </column>
            <column caption='Is Platform Match Job' datatype='boolean' name='[Calculation_1147506852634392335]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Job&#13;&#10;// Platform filter for Job Runs (each run carries the platform most of its models ran on).&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform (mart_job_runs.csv)] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Job Run Outcome' datatype='string' name='[Calculation_2594716741566639131]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Job Run Outcome&#13;&#10;// Bar colour: Succeeded #9DB9D6, Failed #D2453F, Cancelled #C3C9CF.&#13;&#10;CASE [status]&#13;&#10;WHEN &quot;error&quot;     THEN &quot;Failed&quot;&#13;&#10;WHEN &quot;cancelled&quot; THEN &quot;Cancelled&quot;&#13;&#10;ELSE &quot;Succeeded&quot;&#13;&#10;END' />
            </column>
            <column caption='Job Platform Name' datatype='string' name='[Calculation_1806154904060084637]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Job Platform Name&#13;&#10;// Platform the job ran on, as written in the legend.&#13;&#10;CASE [platform (mart_job_runs.csv)] WHEN &quot;snowflake&quot; THEN &quot;Snowflake&quot; WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot; THEN &quot;Redshift&quot; ELSE [platform (mart_job_runs.csv)] END' />
            </column>
            <column caption='Gantt Started Text' datatype='string' name='[Calculation_1493742440611781298]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Gantt Started Text&#13;&#10;// &quot;05:16&quot; in the tooltip.&#13;&#10;RIGHT(&quot;0&quot; + STR(INT([start_minute_of_day] / 60)), 2) + &quot;:&quot; + RIGHT(&quot;0&quot; + STR([start_minute_of_day] % 60), 2)' />
            </column>
            <column caption='Gantt Duration Text' datatype='string' name='[Calculation_1622474558781708599]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Gantt Duration Text&#13;&#10;// &quot;5.8 min&quot; or &quot;1 h 25 min&quot; in the tooltip.&#13;&#10;IF [duration_min] &lt; 60 THEN STR(ROUND([duration_min], 1)) + &quot; min&quot;&#13;&#10;ELSE STR(INT([duration_min] / 60)) + &quot; h &quot; + STR(INT([duration_min]) % 60) + &quot; min&quot; END' />
            </column>
            <column caption='Gantt Duration Hours' datatype='real' name='[Calculation_2829640963960821448]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Gantt Duration Hours&#13;&#10;// Bar length in hours, at least 3 minutes so very short runs stay visible.&#13;&#10;MAX([duration_min], 3) / 60' />
            </column>
            <column caption='Duration Min' datatype='real' name='[duration_min]' role='measure' type='quantitative' />
            <column caption='Job Name' datatype='string' name='[job_name]' role='dimension' type='nominal' />
            <column caption='Job Run Id (Job Runs)' datatype='string' name='[job_run_id (mart_job_runs.csv)]' role='dimension' type='nominal' />
