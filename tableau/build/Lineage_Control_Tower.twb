    <worksheet name='GOV Ownership KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Is Exposure Owned' datatype='boolean' name='[Calculation_1623128277657509047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Exposure Owned&#13;&#10;// Exposures with a real owner (&quot;No owner&quot; is the mart&apos;s placeholder).&#13;&#10;[owner_name] &lt;&gt; &quot;No owner&quot;' />
            </column>
            <column caption='Ownership Coverage' datatype='real' name='[Calculation_1043060479066517021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Ownership Coverage&#13;&#10;// Exposures with an owner / all exposures, unregistered included. Check: 23 of 27 = 85%.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [Calculation_1623128277657509047] THEN 1 END))&#13;&#10;/&#13;&#10;SUM(IF [resource_type] = &quot;exposure&quot; THEN 1 END)' />
            </column>
            <column caption='Exposures Without Owner' datatype='real' name='[Calculation_1674547297219245560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures Without Owner&#13;&#10;// Sub-line &quot;4 of 27 exposures have no owner&quot;.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND NOT [Calculation_1623128277657509047] THEN 1 END))' />
            </column>
            <column caption='GOV Owned Sub Text' datatype='string' name='[Calculation_6690578235394442393]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Owned Sub Text&#13;&#10;// &quot;4 of 27 exposures have no owner&quot;.&#13;&#10;STR(INT([Calculation_1674547297219245560])) + &quot; of &quot; + STR(INT(SUM(IF [resource_type] = &quot;exposure&quot; THEN 1 END))) + &quot; exposures have no owner&quot;' />
            </column>
            <column caption='Documentation Coverage' datatype='real' name='[Calculation_1088481749157410608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Documentation Coverage&#13;&#10;// Models with a description / all models. Check: 67 of 82 = 82%.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND [has_description] THEN 1 END))&#13;&#10;/&#13;&#10;SUM(IF [resource_type] = &quot;model&quot; THEN 1 END)' />
            </column>
            <column caption='Model Test Coverage' datatype='real' name='[Calculation_2755792014614728756]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Model Test Coverage&#13;&#10;// Models with at least one test / all models. Check: 68 of 82 = 83%. Also used on Governance.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND [test_count] &gt; 0 THEN 1 END))&#13;&#10;/&#13;&#10;SUM(IF [resource_type] = &quot;model&quot; THEN 1 END)' />
            </column>
            <column caption='Has Description' datatype='boolean' name='[has_description]' role='dimension' type='nominal' />
            <column caption='Owner Name' datatype='string' name='[owner_name]' role='dimension' type='nominal' />
            <column caption='Platform Filter Values' datatype='string' name='[platform_filter_values]' role='dimension' type='nominal' />
            <column caption='Resource Type' datatype='string' name='[resource_type]' role='dimension' type='nominal' />
            <column caption='Test Count' datatype='integer' name='[test_count]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2214252331607255986]' derivation='None' name='[none:Calculation_2214252331607255986:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1043060479066517021]' derivation='User' name='[usr:Calculation_1043060479066517021:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6690578235394442393]' derivation='User' name='[usr:Calculation_6690578235394442393:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1088481749157410608]' derivation='User' name='[usr:Calculation_1088481749157410608:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2755792014614728756]' derivation='User' name='[usr:Calculation_2755792014614728756:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2214252331607255986:nk]'>
            <groupfilter function='member' level='[none:Calculation_2214252331607255986:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2214252331607255986:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
