              <calculation class='tableau' formula='// Platform Option&#13;&#10;// Scaffold: turns the first 4 days of dim_date into the 4 platform buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;snowflake&quot;&#13;&#10;WHEN 2 THEN &quot;databricks&quot;&#13;&#10;WHEN 3 THEN &quot;redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='Platform Dot Snowflake' datatype='string' name='[Calculation_1113706873550636432]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Dot Snowflake&#13;&#10;// Coloured square before &quot;Snowflake&quot; on its button. Each platform has its own field so each gets its own run colour.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;snowflake&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Platform Dot Databricks' datatype='string' name='[Calculation_2812498324364876413]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Dot Databricks&#13;&#10;// Coloured square before &quot;Databricks&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;databricks&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Platform Dot Redshift' datatype='string' name='[Calculation_2114073437937435113]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Dot Redshift&#13;&#10;// Coloured square before &quot;Redshift&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;redshift&quot; THEN &quot;■  &quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Is Active Platform Option' datatype='boolean' name='[Calculation_1733161848805935888]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Active Platform Option&#13;&#10;// Colours the selected platform button.&#13;&#10;[Calculation_1708304674625620149] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Platform Option Label' datatype='string' name='[Calculation_1669066058101174507]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;CASE [Calculation_1708304674625620149]&#13;&#10;WHEN &quot;All&quot;        THEN &quot;All&quot;&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='Platform Label Active' datatype='string' name='[Calculation_1615833699327644939]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Label Active&#13;&#10;// Button text when this button is the selected platform (Semibold Navy run).&#13;&#10;IF [Calculation_1733161848805935888] THEN [Calculation_1669066058101174507] ELSE &quot;&quot; END' />
