    <worksheet name='PF Incremental Candidates KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Model' datatype='boolean' name='[Calculation_1221533192259849042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Model&#13;&#10;// Keeps dbt models.&#13;&#10;[resource_type] = &quot;model&quot;' />
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Incremental Candidate Day' datatype='boolean' name='[Calculation_1364965825098171574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Incremental Candidate Day&#13;&#10;// A day in the window where the model was a full-refresh table and its runtime trend was above +25%&#13;&#10;// (thresholds from generator/config.yaml). Needs runtime_trend_pct typed as Number.&#13;&#10;[Calculation_1409194560049525583]&#13;&#10;AND [materialization_on_day] = &quot;table&quot;&#13;&#10;AND [runtime_trend_pct] &gt; 0.25' />
            </column>
            <column caption='Is Incremental Candidate' datatype='boolean' name='[Calculation_1023863511757725728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Incremental Candidate&#13;&#10;// Candidate at any point in the window, and over 10M rows. Check: only fct_sessions (at 30 days).&#13;&#10;{ FIXED [node_id] : MAX(IF [Calculation_1364965825098171574] THEN 1 ELSE 0 END) } = 1&#13;&#10;AND [max_rows_built] &gt; 10000000' />
            </column>
            <column caption='Is Switched Candidate' datatype='boolean' name='[Calculation_1162027673306844455]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Switched Candidate&#13;&#10;// A candidate that has since been made incremental (fct_sessions, 4 Oct).&#13;&#10;[Calculation_1023863511757725728]&#13;&#10;AND [materialization_now] = &quot;incremental&quot;' />
            </column>
            <column caption='Open Incremental Candidates' datatype='integer' name='[Calculation_2283342821434223938]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Open Incremental Candidates&#13;&#10;// Mini KPI value: candidates not yet switched.&#13;&#10;COUNTD(IF [Calculation_1023863511757725728] AND NOT [Calculation_1162027673306844455] THEN [node_id] END)' />
            </column>
            <column caption='Switched On' datatype='date' name='[Calculation_3075289868392307480]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Switched On&#13;&#10;// First day the model ran as incremental. Only meaningful for switched candidates.&#13;&#10;{ FIXED [node_id] : MIN(IF [materialization_on_day] = &quot;incremental&quot; THEN [date] END) }' />
            </column>
            <column caption='Switched Candidate Text' datatype='string' name='[Calculation_2397197516190067563]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Switched Candidate Text&#13;&#10;// Green sub-line: &quot;fct_sessions switched 4 Oct&quot;. With more than one, the sheet lists one row each.&#13;&#10;IF [Calculation_1162027673306844455]&#13;&#10;    THEN [node_name] + &quot; switched &quot; + STR(DAY([Calculation_3075289868392307480])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [Calculation_3075289868392307480]), 3)&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='PF Switched Text' datatype='string' name='[Calculation_1653631241000378234]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Switched Text&#13;&#10;// Green: &quot;fct_sessions switched 4 Oct&quot;.&#13;&#10;MAX([Calculation_2397197516190067563])' />
            </column>
            <column caption='Open Candidate Text' datatype='string' name='[Calculation_3172225817606011454]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Open Candidate Text&#13;&#10;// Red sub-line: candidates still to fix.&#13;&#10;IF [Calculation_1023863511757725728] AND NOT [Calculation_1162027673306844455] THEN [node_name] ELSE &quot;&quot; END' />
            </column>
            <column caption='PF Open Text' datatype='string' name='[Calculation_2172685562047498037]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Open Text&#13;&#10;// Red: a candidate still to switch.&#13;&#10;MAX([Calculation_3172225817606011454])' />
            </column>
            <column caption='PF No Candidates Text' datatype='string' name='[Calculation_1470099823134721743]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF No Candidates Text&#13;&#10;// Grey, when no model qualified in the window.&#13;&#10;IF MAX(IIF([Calculation_1023863511757725728], 1, 0)) = 0 THEN &quot;None in this period&quot; END' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Materialization Now' datatype='string' name='[materialization_now]' role='dimension' type='nominal' />
            <column caption='Materialization On Day' datatype='string' name='[materialization_on_day]' role='dimension' type='nominal' />
            <column caption='Max Rows Built' datatype='real' name='[max_rows_built]' role='measure' type='quantitative' />
            <column caption='Node Id' datatype='string' name='[node_id]' role='dimension' type='nominal' />
            <column caption='Node Name' datatype='string' name='[node_name]' role='dimension' type='nominal' />
            <column caption='Platform Filter Values' datatype='string' name='[platform_filter_values]' role='dimension' type='nominal' />
            <column caption='Resource Type' datatype='string' name='[resource_type]' role='dimension' type='nominal' />
            <column caption='Runtime Trend Pct' datatype='real' name='[runtime_trend_pct]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1221533192259849042]' derivation='None' name='[none:Calculation_1221533192259849042:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2214252331607255986]' derivation='None' name='[none:Calculation_2214252331607255986:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2283342821434223938]' derivation='User' name='[usr:Calculation_2283342821434223938:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1653631241000378234]' derivation='User' name='[usr:Calculation_1653631241000378234:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2172685562047498037]' derivation='User' name='[usr:Calculation_2172685562047498037:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1470099823134721743]' derivation='User' name='[usr:Calculation_1470099823134721743:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_1221533192259849042:nk]'>
            <groupfilter function='member' level='[none:Calculation_1221533192259849042:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2214252331607255986:nk]'>
            <groupfilter function='member' level='[none:Calculation_2214252331607255986:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_1221533192259849042:nk]</column>
            <column>[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2214252331607255986:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='border-style' scope='cols' value='none' />
