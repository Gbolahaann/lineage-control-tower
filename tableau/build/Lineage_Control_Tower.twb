        <cols>([federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2894482038928477351:nk] * ([federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_2313436587575898004:qk] + [federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_2496391787737110048:qk]))</cols>
        <tooltip-style tooltip-mode='none' />
      </table>
      <simple-id uuid='{4893CD93-66CB-F78B-32AF-0AD18E99992E}' />
    </worksheet>
    <worksheet name='HO Needs Attention List'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Attention Sort' datatype='integer' name='[Calculation_1867437212419901178]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Attention Sort&#13;&#10;// Worst first, then the node that feeds the most exposures. Sort Rows by this, descending.&#13;&#10;[current_status_code] * 1000 + [exposures_fed]' />
            </column>
            <column caption='Attention Order' datatype='integer' name='[Calculation_2821357717055420234]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Attention Order&#13;&#10;// Attention Sort turned around, so the natural ascending order of the rows is worst first.&#13;&#10;-[Calculation_1867437212419901178]' />
            </column>
            <column caption='Is At Risk Now' datatype='boolean' name='[Calculation_2875175252813195699]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is At Risk Now&#13;&#10;// Warning or Critical in the current snapshot. Shared by Health, Blast radius and Governance.&#13;&#10;[current_status_code] &gt;= 2' />
            </column>
            <column caption='Is Attention Node' datatype='boolean' name='[Calculation_3175454921771165665]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Attention Node&#13;&#10;// Upstream nodes (not exposures) that are Warning or Critical right now. Today: 3 nodes.&#13;&#10;[resource_type] &lt;&gt; &quot;exposure&quot;&#13;&#10;AND [Calculation_2875175252813195699]' />
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Alert Card Point' datatype='spatial' name='[Calculation_2608158557105563067]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Alert Card Point&#13;&#10;// Centre of the alert card shape.&#13;&#10;MAKEPOINT(-0.0000, 0.0000)' />
            </column>
            <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
            </column>
            <column caption='Alert Card Key' datatype='string' name='[Calculation_1711393311892565337]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Alert Card Key&#13;&#10;// Which card shape an alert gets (status colours, icon and chevron are drawn in).&#13;&#10;[Calculation_3105941082857465865]' />
            </column>
            <column caption='Shape Size' datatype='real' name='[Calculation_1110382496608795117]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Shape Size&#13;&#10;// Constant on Size for the card and pill shapes, so they can be drawn larger than the size&#13;&#10;// slider allows on its own (as in the OKRs reference workbook).&#13;&#10;MIN(1)' />
            </column>
            <column caption='Last Event Label' datatype='string' name='[Calculation_2229498162963349132]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Last Event Label&#13;&#10;// The prototype&apos;s timestamp format: &quot;19 Oct, 21:25&quot;. &quot;-&quot; when the node has never run or been checked.&#13;&#10;IF ISNULL([last_event_at]) THEN &quot;-&quot;&#13;&#10;ELSE STR(DAY([last_event_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [last_event_at]), 3) + &quot;, &quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [last_event_at])), 2) + &quot;:&quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [last_event_at])), 2)&#13;&#10;END' />
            </column>
            <column caption='Attention Reason' datatype='string' name='[Calculation_2745413474489980072]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Attention Reason&#13;&#10;// Second line of the alert: what is wrong. Failed models get the time of the failure, as in the&#13;&#10;// prototype, on its own line when the whole line would be wider than the card.&#13;&#10;[status_reason]&#13;&#10;+ IF [last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at]) THEN&#13;&#10;    IF LEN([status_reason]) &gt; 44 THEN CHAR(10) + &quot;at &quot; ELSE &quot; at &quot; END + [Calculation_2229498162963349132]&#13;&#10;  ELSE &quot;&quot;&#13;&#10;  END' />
            </column>
            <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
            </column>
            <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='Attention Where' datatype='string' name='[Calculation_7237364071094172266]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Attention Where&#13;&#10;// Start of the third alert line: &quot;Staging · Snowflake · &quot;.&#13;&#10;[Calculation_7823664326256286450] + &quot; · &quot; + [Calculation_1641578937180273009] + &quot; · &quot;' />
            </column>
            <column caption='Attention Affects' datatype='string' name='[Calculation_3193701186045745359]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Attention Affects&#13;&#10;// The bold part of the third alert line: &quot;affects 4 exposures&quot;.&#13;&#10;&quot;affects &quot; + STR([exposures_fed]) + IF [exposures_fed] = 1 THEN &quot; exposure&quot; ELSE &quot; exposures&quot; END' />
            </column>
            <column caption='Attention Open Since' datatype='string' name='[Calculation_1700778924915878744]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Attention Open Since&#13;&#10;// Tail of the meta line: &quot; · open since 19 Oct&quot;. Uses open_incident_started_at, added to dim_nodes for this.&#13;&#10;IF ISNULL([open_incident_started_at]) THEN &quot;&quot;&#13;&#10;ELSE &quot; · open since &quot; + STR(DAY([open_incident_started_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [open_incident_started_at]), 3)&#13;&#10;END' />
            </column>
            <column caption='Alert Text Point' datatype='spatial' name='[Calculation_5986950829576625363]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Alert Text Point&#13;&#10;// Top left of the alert text, right of the icon.&#13;&#10;MAKEPOINT(0.3000, -1.4900)' />
            </column>
            <column caption='Attention Name Width' datatype='real' name='[Calculation_1052386569481538431]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Attention Name Width&#13;&#10;// Width in px of the node name in Arial bold 9pt, measured by the build from dim_nodes&#13;&#10;// (Liberation Sans, metric-compatible with Arial). Places the incident tag just after the name.&#13;&#10;CASE [display_name]&#13;&#10;WHEN &quot;dim_companies&quot; THEN 90.7&#13;&#10;WHEN &quot;dim_contacts&quot; THEN 77.4&#13;&#10;WHEN &quot;dim_customer_360&quot; THEN 108.7&#13;&#10;WHEN &quot;dim_customer_behavior&quot; THEN 138.7&#13;&#10;WHEN &quot;dim_customers&quot; THEN 88.7&#13;&#10;WHEN &quot;dim_products&quot; THEN 79.3&#13;&#10;WHEN &quot;dim_stores&quot; THEN 64.0&#13;&#10;WHEN &quot;fct_ad_spend_daily&quot; THEN 111.4&#13;&#10;WHEN &quot;fct_app_engagement&quot; THEN 120.0&#13;&#10;WHEN &quot;fct_attribution&quot; THEN 80.7&#13;&#10;WHEN &quot;fct_board_kpis&quot; THEN 85.4&#13;&#10;WHEN &quot;fct_campaign_performance&quot; THEN 156.7&#13;&#10;WHEN &quot;fct_churn_features&quot; THEN 108.0&#13;&#10;WHEN &quot;fct_demand_signals&quot; THEN 115.4&#13;&#10;WHEN &quot;fct_experiment_results&quot; THEN 131.4&#13;&#10;WHEN &quot;fct_finance_close&quot; THEN 100.7&#13;&#10;WHEN &quot;fct_funnel_daily&quot; THEN 91.4&#13;&#10;WHEN &quot;fct_gl_journal&quot; THEN 78.7&#13;&#10;WHEN &quot;fct_inventory_daily&quot; THEN 109.4&#13;&#10;WHEN &quot;fct_marketing_roi&quot; THEN 100.7&#13;&#10;WHEN &quot;fct_ops_model_health&quot; THEN 126.7&#13;&#10;WHEN &quot;fct_order_items&quot; THEN 90.0&#13;&#10;WHEN &quot;fct_orders&quot; THEN 58.7&#13;&#10;WHEN &quot;fct_partner_payouts&quot; THEN 115.4&#13;&#10;WHEN &quot;fct_payments&quot; THEN 77.4&#13;&#10;WHEN &quot;fct_pipeline&quot; THEN 66.7&#13;&#10;WHEN &quot;fct_revenue_daily&quot; THEN 101.4&#13;&#10;WHEN &quot;fct_sessions&quot; THEN 72.7&#13;&#10;WHEN &quot;fct_shipments&quot; THEN 81.4&#13;&#10;WHEN &quot;fct_store_sales&quot; THEN 87.4&#13;&#10;WHEN &quot;fct_support_sla_daily&quot; THEN 123.4&#13;&#10;WHEN &quot;fct_tickets&quot; THEN 59.4&#13;&#10;WHEN &quot;int_ads__attribution&quot; THEN 114.7&#13;&#10;WHEN &quot;int_ads__unified&quot; THEN 94.7&#13;&#10;WHEN &quot;int_app__engagement&quot; THEN 126.7&#13;&#10;WHEN &quot;int_campaigns__spend_daily&quot; THEN 166.7&#13;&#10;WHEN &quot;int_contacts__lifecycle&quot; THEN 131.4&#13;&#10;WHEN &quot;int_customer_behavior&quot; THEN 132.0&#13;&#10;WHEN &quot;int_customers__deduped&quot; THEN 145.4&#13;&#10;WHEN &quot;int_deals__pipeline&quot; THEN 110.7&#13;&#10;WHEN &quot;int_experiments__assignments_enriched&quot; THEN 235.4&#13;&#10;WHEN &quot;int_funnel__steps&quot; THEN 102.0&#13;&#10;WHEN &quot;int_gl__mapped&quot; THEN 91.4&#13;&#10;WHEN &quot;int_inventory__snapshots&quot; THEN 148.7&#13;&#10;WHEN &quot;int_orders__enriched&quot; THEN 122.0&#13;&#10;WHEN &quot;int_payments__reconciled&quot; THEN 150.7&#13;&#10;WHEN &quot;int_products__catalog&quot; THEN 128.0&#13;&#10;WHEN &quot;int_revenue__daily&quot; THEN 108.1&#13;&#10;WHEN &quot;int_sessions__stitched&quot; THEN 132.1&#13;&#10;WHEN &quot;int_shipments__sla&quot; THEN 111.4&#13;&#10;WHEN &quot;int_store_sales__daily&quot; THEN 128.1&#13;&#10;WHEN &quot;int_tickets__lifecycle&quot; THEN 120.1&#13;&#10;WHEN &quot;pbi_inventory&quot; THEN 78.7&#13;&#10;WHEN &quot;pbi_marketing&quot; THEN 82.0&#13;&#10;WHEN &quot;pbi_support&quot; THEN 69.3&#13;&#10;WHEN &quot;pds_board_kpis&quot; THEN 92.0&#13;&#10;WHEN &quot;pds_commerce_sales&quot; THEN 124.7&#13;&#10;WHEN &quot;pds_finance_close&quot; THEN 107.4&#13;&#10;WHEN &quot;pds_finance_revenue&quot; THEN 122.7&#13;&#10;WHEN &quot;pds_ops_monitor&quot; THEN 100.7&#13;&#10;WHEN &quot;pds_sales_pipeline&quot; THEN 110.1&#13;&#10;WHEN &quot;pds_web_funnel&quot; THEN 94.0&#13;&#10;WHEN &quot;raw_dbt_artifacts.run_results&quot; THEN 168.1&#13;&#10;WHEN &quot;raw_events.app_events&quot; THEN 134.7&#13;&#10;WHEN &quot;raw_events.page_views&quot; THEN 136.1&#13;&#10;WHEN &quot;raw_events.search_events&quot; THEN 152.1&#13;&#10;WHEN &quot;raw_events.web_sessions&quot; THEN 150.1&#13;&#10;WHEN &quot;raw_experiments.assignments&quot; THEN 174.7&#13;&#10;WHEN &quot;raw_google_ads.ad_stats&quot; THEN 146.1&#13;&#10;WHEN &quot;raw_google_ads.campaigns&quot; THEN 160.1&#13;&#10;WHEN &quot;raw_hubspot.companies&quot; THEN 140.7&#13;&#10;WHEN &quot;raw_hubspot.contacts&quot; THEN 127.4&#13;&#10;WHEN &quot;raw_hubspot.deals&quot; THEN 108.7&#13;&#10;WHEN &quot;raw_meta_ads.ad_insights&quot; THEN 152.7&#13;&#10;WHEN &quot;raw_netsuite.accounts&quot; THEN 129.4&#13;&#10;WHEN &quot;raw_netsuite.gl_entries&quot; THEN 133.4&#13;&#10;WHEN &quot;raw_netsuite.journal_lines&quot; THEN 150.7&#13;&#10;WHEN &quot;raw_pos.store_sales&quot; THEN 118.1&#13;&#10;WHEN &quot;raw_shopify.customers&quot; THEN 133.2&#13;&#10;WHEN &quot;raw_shopify.order_items&quot; THEN 141.2&#13;&#10;WHEN &quot;raw_shopify.orders&quot; THEN 109.8&#13;&#10;WHEN &quot;raw_shopify.products&quot; THEN 123.8&#13;&#10;WHEN &quot;raw_stripe.payments&quot; THEN 119.4&#13;&#10;WHEN &quot;raw_stripe.refunds&quot; THEN 107.4&#13;&#10;WHEN &quot;raw_wms.inventory&quot; THEN 111.4&#13;&#10;WHEN &quot;raw_wms.shipments&quot; THEN 117.4&#13;&#10;WHEN &quot;raw_wms.warehouses&quot; THEN 126.7&#13;&#10;WHEN &quot;raw_zendesk.ticket_comments&quot; THEN 176.1&#13;&#10;WHEN &quot;raw_zendesk.tickets&quot; THEN 116.1&#13;&#10;WHEN &quot;sigma_customer_360&quot; THEN 122.1&#13;&#10;WHEN &quot;sigma_product_engagement&quot; THEN 163.4&#13;&#10;WHEN &quot;stg_dbt__run_results&quot; THEN 122.0&#13;&#10;WHEN &quot;stg_events__app_events&quot; THEN 142.1&#13;&#10;WHEN &quot;stg_events__app_installs&quot; THEN 145.4&#13;&#10;WHEN &quot;stg_events__page_views&quot; THEN 143.4&#13;&#10;WHEN &quot;stg_events__search_events&quot; THEN 159.4&#13;&#10;WHEN &quot;stg_events__web_sessions&quot; THEN 157.4&#13;&#10;WHEN &quot;stg_experiments__assignments&quot; THEN 182.1&#13;&#10;WHEN &quot;stg_google_ads__ad_stats&quot; THEN 153.4&#13;&#10;WHEN &quot;stg_google_ads__campaigns&quot; THEN 167.4&#13;&#10;WHEN &quot;stg_hubspot__companies&quot; THEN 148.0&#13;&#10;WHEN &quot;stg_hubspot__contacts&quot; THEN 134.7&#13;&#10;WHEN &quot;stg_hubspot__deal_stages&quot; THEN 154.0&#13;&#10;WHEN &quot;stg_hubspot__deals&quot; THEN 116.0&#13;&#10;WHEN &quot;stg_meta_ads__ad_insights&quot; THEN 160.1&#13;&#10;WHEN &quot;stg_netsuite__accounts&quot; THEN 136.7&#13;&#10;WHEN &quot;stg_netsuite__gl_entries&quot; THEN 140.7&#13;&#10;WHEN &quot;stg_netsuite__journal_lines&quot; THEN 158.1&#13;&#10;WHEN &quot;stg_pos__store_sales&quot; THEN 125.4&#13;&#10;WHEN &quot;stg_shopify__customers&quot; THEN 141.4&#13;&#10;WHEN &quot;stg_shopify__order_discounts&quot; THEN 174.7&#13;&#10;WHEN &quot;stg_shopify__order_items&quot; THEN 149.4&#13;&#10;WHEN &quot;stg_shopify__orders&quot; THEN 118.0&#13;&#10;WHEN &quot;stg_shopify__products&quot; THEN 132.0&#13;&#10;WHEN &quot;stg_stripe__payments&quot; THEN 126.7&#13;&#10;WHEN &quot;stg_stripe__refunds&quot; THEN 114.7&#13;&#10;WHEN &quot;stg_wms__inventory&quot; THEN 118.7&#13;&#10;WHEN &quot;stg_wms__shipments&quot; THEN 124.7&#13;&#10;WHEN &quot;stg_wms__warehouses&quot; THEN 134.1&#13;&#10;WHEN &quot;stg_zendesk__ticket_comments&quot; THEN 183.4&#13;&#10;WHEN &quot;stg_zendesk__tickets&quot; THEN 123.4&#13;&#10;ELSE LEN([display_name]) * 7&#13;&#10;END' />
            </column>
            <column caption='Alert Tag Point' datatype='spatial' name='[Calculation_8482078463587217548]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Alert Tag Point&#13;&#10;// Middle of the incident tag box, just after the node name.&#13;&#10;MAKEPOINT(0.2298, (37 + [Calculation_1052386569481538431] + 8 + 26 + -186) / 100)' />
            </column>
            <column caption='Attention Tag Key' datatype='string' name='[Calculation_3399448354263373002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Attention Tag Key&#13;&#10;// Shows the incident tag box only when the node has an open incident.&#13;&#10;IF [open_incident_id] &lt;&gt; &quot;&quot; THEN &quot;tag&quot; ELSE &quot;none&quot; END' />
            </column>
            <column caption='Attention Incident Tag' datatype='string' name='[Calculation_5034449253068379788]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Attention Incident Tag&#13;&#10;// Incident chip next to the node name, for example &quot;INC-008&quot;. Empty when there is no open incident.&#13;&#10;IFNULL([open_incident_id], &quot;&quot;)' />
            </column>
            <column caption='Alert Tag Text Point' datatype='spatial' name='[Calculation_2553845990692593975]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Alert Tag Text Point&#13;&#10;// Same spot as Alert Tag Point, for the tag text layer.&#13;&#10;MAKEPOINT(0.2298, (37 + [Calculation_1052386569481538431] + 8 + 26 + -186) / 100)' />
            </column>
            <column caption='Current Status Code' datatype='integer' name='[current_status_code]' role='dimension' type='ordinal' />
            <column caption='Display Name' datatype='string' name='[display_name]' role='dimension' type='nominal' />
            <column caption='Exposures Fed' datatype='integer' name='[exposures_fed]' role='measure' type='quantitative' />
            <column caption='Last Event At' datatype='datetime' name='[last_event_at]' role='dimension' type='ordinal' />
            <column caption='Last Run Status' datatype='string' name='[last_run_status]' role='dimension' type='nominal' />
            <column caption='Layer' datatype='string' name='[layer]' role='dimension' type='nominal' />
            <column caption='Node Id (Nodes)' datatype='string' name='[node_id (dim_nodes.csv)]' role='dimension' type='nominal' />
            <column caption='Node Key' datatype='integer' name='[node_key]' role='dimension' type='ordinal' />
            <column caption='Open Incident Id' datatype='string' name='[open_incident_id]' role='dimension' type='nominal' />
            <column caption='Open Incident Started At' datatype='datetime' name='[open_incident_started_at]' role='dimension' type='ordinal' />
            <column caption='Platform Filter Values' datatype='string' name='[platform_filter_values]' role='dimension' type='nominal' />
            <column caption='Platform Now' datatype='string' name='[platform_now]' role='dimension' type='nominal' />
            <column caption='Resource Type' datatype='string' name='[resource_type]' role='dimension' type='nominal' />
            <column caption='Status Reason' datatype='string' name='[status_reason]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2821357717055420234]' derivation='None' name='[none:Calculation_2821357717055420234:ok]' pivot='key' type='ordinal' />
            <column-instance column='[node_key]' derivation='None' name='[none:node_key:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_3175454921771165665]' derivation='None' name='[none:Calculation_3175454921771165665:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2214252331607255986]' derivation='None' name='[none:Calculation_2214252331607255986:nk]' pivot='key' type='nominal' />
            <column-instance column='[node_id (dim_nodes.csv)]' derivation='None' name='[none:node_id (dim_nodes.csv):nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2608158557105563067]' derivation='Collect' name='[clct:Calculation_2608158557105563067:nk]' pivot='key' type='nominal' />
            <column-instance column='[display_name]' derivation='None' name='[none:display_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1711393311892565337]' derivation='None' name='[none:Calculation_1711393311892565337:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1110382496608795117]' derivation='User' name='[usr:Calculation_1110382496608795117:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2745413474489980072]' derivation='None' name='[none:Calculation_2745413474489980072:nk]' pivot='key' type='nominal' />
