              <calculation class='tableau' formula='// GOV Gaps Warn Point&#13;&#10;// Where each warn text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(1.7200, -1.8100)&#13;&#10;WHEN &quot;All|12&quot; THEN MAKEPOINT(1.5700, -1.8100)&#13;&#10;WHEN &quot;All|14&quot; THEN MAKEPOINT(1.4200, -1.8100)&#13;&#10;WHEN &quot;All|16&quot; THEN MAKEPOINT(1.2700, -1.8100)&#13;&#10;WHEN &quot;All|18&quot; THEN MAKEPOINT(1.1200, -1.8100)&#13;&#10;WHEN &quot;All|20&quot; THEN MAKEPOINT(0.9700, -1.8100)&#13;&#10;WHEN &quot;All|22&quot; THEN MAKEPOINT(0.8200, -1.8100)&#13;&#10;WHEN &quot;All|24&quot; THEN MAKEPOINT(0.6700, -1.8100)&#13;&#10;WHEN &quot;All|26&quot; THEN MAKEPOINT(0.5200, -1.8100)&#13;&#10;WHEN &quot;All|28&quot; THEN MAKEPOINT(0.3700, -1.8100)&#13;&#10;WHEN &quot;All|30&quot; THEN MAKEPOINT(0.2200, -1.8100)&#13;&#10;WHEN &quot;All|32&quot; THEN MAKEPOINT(0.0700, -1.8100)&#13;&#10;WHEN &quot;All|34&quot; THEN MAKEPOINT(-0.0800, -1.8100)&#13;&#10;WHEN &quot;All|36&quot; THEN MAKEPOINT(-0.2300, -1.8100)&#13;&#10;WHEN &quot;All|39&quot; THEN MAKEPOINT(-0.6200, -1.8100)&#13;&#10;WHEN &quot;All|41&quot; THEN MAKEPOINT(-0.7700, -1.8100)&#13;&#10;WHEN &quot;All|43&quot; THEN MAKEPOINT(-0.9200, -1.8100)&#13;&#10;WHEN &quot;All|45&quot; THEN MAKEPOINT(-1.0700, -1.8100)&#13;&#10;WHEN &quot;All|47&quot; THEN MAKEPOINT(-1.2200, -1.8100)&#13;&#10;WHEN &quot;All|49&quot; THEN MAKEPOINT(-1.3700, -1.8100)&#13;&#10;WHEN &quot;All|51&quot; THEN MAKEPOINT(-1.5200, -1.8100)&#13;&#10;WHEN &quot;All|53&quot; THEN MAKEPOINT(-1.6700, -1.8100)&#13;&#10;WHEN &quot;All|55&quot; THEN MAKEPOINT(-1.8200, -1.8100)&#13;&#10;WHEN &quot;All|57&quot; THEN MAKEPOINT(-1.9700, -1.8100)&#13;&#10;WHEN &quot;All|59&quot; THEN MAKEPOINT(-2.1200, -1.8100)&#13;&#10;WHEN &quot;All|61&quot; THEN MAKEPOINT(-2.2700, -1.8100)&#13;&#10;WHEN &quot;All|63&quot; THEN MAKEPOINT(-2.4200, -1.8100)&#13