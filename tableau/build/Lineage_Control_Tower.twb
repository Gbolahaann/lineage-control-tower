            <column caption='GOV Hygiene Name Text' datatype='string' name='[Calculation_1213576403676399333]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Hygiene Name Text&#13;&#10;// Name texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;Marketing Analytics&quot;&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;Operations Analytics&quot;&#13;&#10;WHEN &quot;All|4&quot; THEN &quot;Product Analytics&quot;&#13;&#10;WHEN &quot;All|6&quot; THEN &quot;Commerce Analytics&quot;&#13;&#10;WHEN &quot;All|8&quot; THEN &quot;Customer Insights&quot;&#13;&#10;WHEN &quot;All|10&quot; THEN &quot;Data Platform&quot;&#13;&#10;WHEN &quot;All|12&quot; THEN &quot;Finance Analytics&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;Marketing Analytics&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;Operations Analytics&quot;&#13;&#10;WHEN &quot;snowflake|4&quot; THEN &quot;Commerce Analytics&quot;&#13;&#10;WHEN &quot;snowflake|6&quot; THEN &quot;Data Platform&quot;&#13;&#10;WHEN &quot;snowflake|8&quot; THEN &quot;Customer Insights&quot;&#13;&#10;WHEN &quot;snowflake|10&quot; THEN &quot;Finance Analytics&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Product Analytics&quot;&#13;&#10;WHEN &quot;databricks|2&quot; THEN &quot;Customer Insights&quot;&#13;&#10;WHEN &quot;databricks|4&quot; THEN &quot;Data Platform&quot;&#13;&#10;WHEN &quot;databricks|6&quot; THEN &quot;Operations Analytics&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;Marketing Analytics&quot;&#13;&#10;WHEN &quot;redshift|2&quot; THEN &quot;Data Platform&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Hygiene Name Point' datatype='spatial' name='[Calculation_2402457935745799526]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Hygiene Name Point&#13;&#10;// Where each name text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.9950, -1.4924)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.6850, -1.4658)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(0.3750, -1.5425)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(0.0650, -1.4658)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(-0.2450, -1.5219)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(-0.5550, -1.6253)&#13;&#10;WHEN &quot;All|12&quot; THEN MAKEPOINT(-0.8650, -1.5366)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.9950, -1.4924)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.6850, -1.4658)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(0.3750, -1.4658)&#13;&#10;WHEN &quot;snowflake|6&quot; THEN MAKEPOINT(0.0650, -1.6253)&#13;&#10;WHEN &quot;snowflake|8&quot; THEN MAKEPOINT(-0.2450, -1.5219)&#13;&#10;WHEN &quot;snowflake|10&quot; THEN MAKEPOINT(-0.5550, -1.5366)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.9950, -1.5425)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(0.6850, -1.5219)&#13;&#10;WHEN &quot;databricks|4&quot; THEN MAKEPOINT(0.3750, -1.6253)&#13;&#10;WHEN &quot;databricks|6&quot; THEN MAKEPOINT(0.0650, -1.4658)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(0.9950, -1.4924)&#13;&#10;WHEN &quot;redshift|2&quot; THEN MAKEPOINT(0.6850, -1.6253)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Hygiene Value Text' datatype='string' name='[Calculation_1103449527913887311]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// GOV Hygiene Value Text&#13;&#10;// Value texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;58%&quot;&#13;&#10;WHEN &quot;All|3&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;All|5&quot; THEN &quot;69%&quot;&#13;&#10;WHEN &quot;All|7&quot; THEN &quot;83%&quot;&#13;&#10;WHEN &quot;All|9&quot; THEN &quot;86%&quot;&#13;&#10;WHEN &quot;All|11&quot; THEN &quot;92%&quot;&#13;&#10;WHEN &quot;All|13&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;58%&quot;&#13;&#10;WHEN &quot;snowflake|3&quot; THEN &quot;60%&quot;&#13;&#10;WHEN &quot;snowflake|5&quot; THEN &quot;83%&quot;&#13;&#10;WHEN &quot;snowflake|7&quot; THEN &quot;94%&quot;&#13;&#10;WHEN &quot;snowflake|9&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|11&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;69%&quot;&#13;&#10;WHEN &quot;databricks|3&quot; THEN &quot;83%&quot;&#13;&#10;WHEN &quot;databricks|5&quot; THEN &quot;84%&quot;&#13;&#10;WHEN &quot;databricks|7&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;redshift|1&quot; THEN &quot;58%&quot;&#13;&#10;WHEN &quot;redshift|3&quot; THEN &quot;100%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Hygiene Value Point' datatype='spatial' name='[Calculation_2176372367208569420]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Hygiene Value Point&#13;&#10;// Where each value text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.9950, 1.8437)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(0.6850, 1.8437)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(0.3750, 1.8437)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(0.0650, 1.8437)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(-0.2450, 1.8437)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(-0.5550, 1.8437)&#13;&#10;WHEN &quot;All|13&quot; THEN MAKEPOINT(-0.8650, 1.8141)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.9950, 1.8437)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(0.6850, 1.8437)&#13;&#10;WHEN &quot;snowflake|5&quot; THEN MAKEPOINT(0.3750, 1.8437)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(0.0650, 1.8437)&#13;&#10;WHEN &quot;snowflake|9&quot; THEN MAKEPOINT(-0.2450, 1.8141)&#13;&#10;WHEN &quot;snowflake|11&quot; THEN MAKEPOINT(-0.5550, 1.8141)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.9950, 1.8437)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(0.6850, 1.8437)&#13;&#10;WHEN &quot;databricks|5&quot; THEN MAKEPOINT(0.3750, 1.8437)&#13;&#10;WHEN &quot;databricks|7&quot; THEN MAKEPOINT(0.0650, 1.8141)&#13;&#10;WHEN &quot;redshift|1&quot; THEN MAKEPOINT(0.9950, 1.8437)&#13;&#10;WHEN &quot;redshift|3&quot; THEN MAKEPOINT(0.6850, 1.8141)&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
