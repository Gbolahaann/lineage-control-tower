      </column>
      <column caption='Tile Header Chip Border Point 2' datatype='spatial' name='[Calculation_2016781804334846504]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Border Point 2&#13;&#10;// Count chip outline after the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.701171875) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Fill Point 2' datatype='spatial' name='[Calculation_3235027401630484562]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Fill Point 2&#13;&#10;// Count chip fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 6 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.701171875) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 6 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Count Point 2' datatype='spatial' name='[Calculation_1751133796904004772]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Count Point 2&#13;&#10;// Middle of the count chip.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -2.6430&#13;&#10;)' />
      </column>
      <column caption='Is Tile Group 3' datatype='boolean' name='[Calculation_1578473119693928549]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile Group 3&#13;&#10;// Keeps the tiles of one exposure group on its own sheet. Put on Filters (True).&#13;&#10;[Calculation_1368642606501877949] = 3' />
      </column>
      <column caption='Tile Header Chip Border Point 3' datatype='spatial' name='[Calculation_3479913310745802258]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Border Point 3&#13;&#10;// Count chip outline after the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.3359375) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Fill Point 3' datatype='spatial' name='[Calculation_3391211921367864302]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Fill Point 3&#13;&#10;// Count chip fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 6 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.3359375) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 6 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Count Point 3' datatype='spatial' name='[Calculation_1306975744353670788]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Count Point 3&#13;&#10;// Middle of the count chip.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -2.6466&#13;&#10;)' />
      </column>
      <column caption='Is Tile Group 4' datatype='boolean' name='[Calculation_1702540457298106261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile Group 4&#13;&#10;// Keeps the tiles of one exposure group on its own sheet. Put on Filters (True).&#13;&#10;[Calculation_1368642606501877949] = 4' />
      </column>
      <column caption='Tile Header Chip Border Point 4' datatype='spatial' name='[Calculation_1008212743854094983]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Border Point 4&#13;&#10;// Count chip outline after the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((230.1953125) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Fill Point 4' datatype='spatial' name='[Calculation_2201745012478190178]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Fill Point 4&#13;&#10;// Count chip fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 6 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((230.1953125) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 6 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
