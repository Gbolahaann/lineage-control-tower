          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Status Severity Sort' datatype='integer' name='[Calculation_1180711795357289733]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Status Severity Sort&#13;&#10;// Worst first, for lists: Critical 1, Warning 2, Healthy 3, No data 4.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN 1&#13;&#10;WHEN 2 THEN 2&#13;&#10;WHEN 1 THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
            </column>
            <column caption='Is Lineage Scope' datatype='boolean' name='[Calculation_2164541789448021386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Lineage Scope&#13;&#10;// Keeps the per-exposure layout of the selected exposure. Put on Filters (True).&#13;&#10;[layout_scope] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Is Table Row' datatype='boolean' name='[Calculation_2337355820833703565]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Table Row&#13;&#10;// Every upstream node of the graph (the exposure itself is the graph&apos;s end, not a row).&#13;&#10;[node_id (mart_lineage_layout.csv)] &lt;&gt; [layout_scope]' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Is Selected Node Box' datatype='boolean' name='[Calculation_2543776221048440310]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Selected Node Box&#13;&#10;// The clicked box, so its name can be bolded.&#13;&#10;[node_key (mart_lineage_layout.csv)] = [Parameters].[Parameter 5]' />
            </column>
            <column caption='Table Row Key' datatype='string' name='[Calculation_3315487402959781063]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Table Row Key&#13;&#10;// Highlights the selected node&apos;s row (light accent), as in the prototype.&#13;&#10;IF [Calculation_2543776221048440310] THEN &quot;Selected&quot; ELSE &quot;Default&quot; END' />
            </column>
            <column caption='Table Band Point' datatype='spatial' name='[Calculation_2585830235018675183]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Table Band Point&#13;&#10;// Row background: light accent for the selected node, otherwise white.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0.5 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (13.5) + 0 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((0) + (909)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((909) - (0)) / 2 - 0) + 0 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Panel Tags Value' datatype='string' name='[Calculation_9860372241269830816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Tags Value&#13;&#10;// What a click writes into p_panel_tags: &quot;|moved|ai|unregistered|&quot; for the tags this node carries.&#13;&#10;&quot;|&quot; + IF NOT ISNULL([migrated_from_platform]) THEN &quot;moved|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF [build_method] = &quot;ai_assisted&quot; THEN &quot;ai|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF NOT [is_declared] THEN &quot;unregistered|&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
            </column>
            <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='Node Platform Tooltip' datatype='string' name='[Calculation_2505057497825235880]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Node Platform Tooltip&#13;&#10;// &quot;Snowflake (moved from Redshift on 3 Sep)&quot; for migrated nodes.&#13;&#10;[Calculation_1641578937180273009]&#13;&#10;+ IF ISNULL([migrated_from_platform]) THEN &quot;&quot;&#13;&#10;  ELSE &quot; (moved from &quot; + PROPER([migrated_from_platform]) + &quot; on &quot;&#13;&#10;      + STR(DAY([migration_date])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [migration_date]), 3) + &quot;)&quot;&#13;&#10;  END' />
            </column>
            <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
            </column>
            <column caption='Last Runtime Label' datatype='string' name='[Calculation_1403910267805111020]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Last Runtime Label&#13;&#10;// Last model runtime in the prototype&apos;s duration format: &quot;45s&quot;, &quot;27.9 min&quot; or &quot;1.2 h&quot;.&#13;&#10;IF ISNULL([last_runtime_sec]) THEN &quot;&quot;&#13;&#10;ELSEIF [last_runtime_sec] &lt; 60 THEN STR(ROUND([last_runtime_sec])) + &quot;s&quot;&#13;&#10;ELSEIF [last_runtime_sec] &lt; 3600 THEN STR(ROUND([last_runtime_sec] / 60, 1)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([last_runtime_sec] / 3600, 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='Lag Now Label' datatype='string' name='[Calculation_2339296116464127259]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lag Now Label&#13;&#10;// Current source lag: &quot;45 min&quot; under an hour, otherwise &quot;6.0 h&quot;.&#13;&#10;IF ISNULL([freshness_lag_min]) THEN &quot;&quot;&#13;&#10;ELSEIF [freshness_lag_min] &lt; 60 THEN STR(ROUND([freshness_lag_min])) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([freshness_lag_min] / 60, 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='Table Divider Point' datatype='spatial' name='[Calculation_6679340540544191662]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Table Divider Point&#13;&#10;// The 1 px line under each row.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (-13.5 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (0.5) + 0 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((0) + (909)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((909) - (0)) / 2 - 0) + 0 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Table Platform Border Point' datatype='spatial' name='[Calculation_1035548184703788120]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Table Platform Border Point&#13;&#10;// Platform pill outline (light grey, radius 4).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (5) + 4 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((307) + (307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END) - (307)) / 2 - 4) + 4 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Table Platform Fill Point' datatype='spatial' name='[Calculation_1433063006639321125]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Table Platform Fill Point&#13;&#10;// Platform pill fill.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (5) + 3 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((308) + (307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END - 1)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END - 1) - (308)) / 2 - 3) + 3 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Table Status Key' datatype='string' name='[Calculation_1304299416300619645]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Table Status Key&#13;&#10;// Status pill fill (status tint).&#13;&#10;[Calculation_3105941082857465865]' />
            </column>
            <column caption='Table Status Pill Point' datatype='spatial' name='[Calculation_4072656251478419518]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Table Status Pill Point&#13;&#10;// Status pill (tinted, fully rounded).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (0) + 9 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((401) + (401 + CASE [Calculation_3105941082857465865] WHEN &quot;Critical&quot; THEN 57 WHEN &quot;Warning&quot; THEN 65 WHEN &quot;Healthy&quot; THEN 59 WHEN &quot;No data&quot; THEN 58 ELSE 0 END)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((401 + CASE [Calculation_3105941082857465865] WHEN &quot;Critical&quot; THEN 57 WHEN &quot;Warning&quot; THEN 65 WHEN &quot;Healthy&quot; THEN 59 WHEN &quot;No data&quot; THEN 58 ELSE 0 END) - (401)) / 2 - 9) + 9 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
            </column>
            <column caption='Table Node Text' datatype='string' name='[Calculation_1884706855628657145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Table Node Text&#13;&#10;// Table cell &quot;Node&quot;, written by the build from dim_nodes so it can be measured&#13;&#10;// (map-pane labels only centre reliably, so each cell is placed at half its width).&#13;&#10;CASE [node_id (mart_lineage_layout.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN &quot;dim_customer_360&quot;&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN &quot;dim_customers&quot;&#13;&#10;WHEN &quot;model.acme_core.dim_products&quot; THEN &quot;dim_products&quot;&#13;&#10;WHEN &quot;model.acme_core.dim_stores&quot; THEN &quot;dim_stores&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_board_kpis&quot; THEN &quot;fct_board_kpis&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_finance_close&quot; THEN &quot;fct_finance_close&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_gl_journal&quot; THEN &quot;fct_gl_journal&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_inventory_daily&quot; THEN &quot;fct_inventory_daily&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_ops_model_health&quot; THEN &quot;fct_ops_model_health&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_order_items&quot; THEN &quot;fct_order_items&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_orders&quot; THEN &quot;fct_orders&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_partner_payouts&quot; THEN &quot;fct_partner_payouts&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_payments&quot; THEN &quot;fct_payments&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_revenue_daily&quot; THEN &quot;fct_revenue_daily&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_shipments&quot; THEN &quot;fct_shipments&quot;&#13;&#10;WHEN &quot;model.acme_core.fct_store_sales&quot; THEN &quot;fct_store_sales&quot;&#13;&#10;WHEN &quot;model.acme_core.int_customers__deduped&quot; THEN &quot;int_customers__deduped&quot;&#13;&#10;WHEN &quot;model.acme_core.int_gl__mapped&quot; THEN &quot;int_gl__mapped&quot;&#13;&#10;WHEN &quot;model.acme_core.int_inve