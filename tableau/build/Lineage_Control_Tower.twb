        <calculation class='tableau' formula='// QA Issues Label Text&#13;&#10;// Row name, left.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;7|All|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;7|All|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;7|All|2&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;7|All|3&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;7|All|4&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;7|snowflake|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;7|snowflake|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;7|snowflake|2&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;7|snowflake|3&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;7|snowflake|4&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;7|databricks|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;7|databricks|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;7|databricks|2&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;7|redshift|0&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;7|redshift|1&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;7|redshift|2&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;30|All|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;30|All|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;30|All|2&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;30|All|3&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;30|All|4&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;30|snowflake|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;30|snowflake|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;30|snowflake|2&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;30|snowflake|3&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;30|snowflake|4&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;30|databricks|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;30|databricks|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;30|databricks|2&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;30|databricks|3&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;30|databricks|4&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;30|redshift|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;30|redshift|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;30|redshift|2&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;30|redshift|3&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;90|All|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;90|All|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;90|All|2&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;90|All|3&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;90|All|4&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;90|snowflake|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;90|snowflake|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;90|snowflake|2&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;90|snowflake|3&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;90|snowflake|4&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;90|databricks|0&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;90|databricks|1&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;90|databricks|2&quot; THEN &quot;custom (singular)&quot;&#13;&#10;WHEN &quot;90|databricks|3&quot; THEN &quot;relationships&quot;&#13;&#10;WHEN &quot;90|databricks|4&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;90|redshift|0&quot; THEN &quot;not_null&quot;&#13;&#10;WHEN &quot;90|redshift|1&quot; THEN &quot;unique&quot;&#13;&#10;WHEN &quot;90|redshift|2&quot; THEN &quot;accepted_values&quot;&#13;&#10;WHEN &quot;90|redshift|3&quot; THEN &quot;relationships&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
