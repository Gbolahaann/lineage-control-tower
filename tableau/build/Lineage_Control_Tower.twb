        <calculation class='tableau' formula='// Lineage Exposure Platform&#13;&#10;// Platform of the selected exposure, on every row.&#13;&#10;{ MAX(IF [node_id (dim_nodes.csv)] = [Parameters].[Parameter 3] THEN [Calculation_1641578937180273009] END) }' />
      </column>
      <column caption='Lineage Exposure Stripe Key' datatype='string' name='[Calculation_1214037053747658779]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Lineage Exposure Stripe Key&#13;&#10;// The exposure box platform stripe.&#13;&#10;[Calculation_2132277863714181032]' />
      </column>
      <column caption='Lineage Exposure Stripe Point' datatype='spatial' name='[Calculation_1235778005112457999]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Lineage Exposure Stripe Point&#13;&#10;// The exposure&apos;s platform stripe.&#13;&#10;IF [row_type] = &quot;edge&quot; AND [child_node_id] = [layout_scope] THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_3026584209685377350]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421] - 6) / 2 - (1.5)) + (1.5) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + (5) * 151.833) + 115.967)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((3) / 2 - (1.5)) + (1.5) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
      </column>
