      <column caption='Tile Header Count Point 4' datatype='spatial' name='[Calculation_2938508471437873771]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Count Point 4&#13;&#10;// Middle of the count chip.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -1.8980&#13;&#10;)' />
      </column>
      <column caption='Tile View Option' datatype='string' name='[Calculation_2894482038928477351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Option&#13;&#10;// Scaffold for the All / Needs attention buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;Needs attention&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Tile View Button Row' datatype='boolean' name='[Calculation_2058479208791343830]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile View Button Row&#13;&#10;// Keeps the 2 scaffold rows that carry the All / Needs attention buttons. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_2894482038928477351])' />
      </column>
      <column caption='Is Active Tile View' datatype='boolean' name='[Calculation_1284089094536110577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Tile View&#13;&#10;// Colours the selected tile-view button.&#13;&#10;[Calculation_2894482038928477351] = [Parameters].[Parameter 8]' />
      </column>
      <column caption='Tile View Label Active' datatype='string' name='[Calculation_1838581371832391049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Label Active&#13;&#10;// Button text when this tile view is selected (Semibold Navy run).&#13;&#10;IF [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile View Label Inactive' datatype='string' name='[Calculation_3133453958818750804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Label Inactive&#13;&#10;// Button text when this tile view is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
      </column>
      <column caption='Attention Sort' datatype='integer' name='[Calculation_1867437212419901178]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Attention Sort&#13;&#10;// Worst first, then the node that feeds the most exposures. Sort Rows by this, descending.&#13;&#10;[current_status_code] * 1000 + [exposures_fed]' />
      </column>
      <column caption='Attention Order' datatype='integer' name='[Calculation_2821357717055420234]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Attention Order&#13;&#10;// Attention Sort turned around, so the natural ascending order of the rows is worst first.&#13;&#10;-[Calculation_1867437212419901178]' />
      </column>
      <column caption='Is Attention Node' datatype='boolean' name='[Calculation_3175454921771165665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Attention Node&#13;&#10;// Upstream nodes (not exposures) that are Warning or Critical right now. Today: 3 nodes.&#13;&#10;[resource_type] &lt;&gt; &quot;exposure&quot;&#13;&#10;AND [Calculation_2875175252813195699]' />
      </column>
      <column caption='Alert Border Key' datatype='string' name='[Calculation_9934721400824060829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Alert Border Key&#13;&#10;// Alert border colour by status (critical #F2CDCA, warning #F3E0BE).&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
      </column>
      <column caption='Alert Border Point' datatype='spatial' name='[Calculation_1732233858863849972]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Border Point&#13;&#10;// Alert outline, 372 x 76 px, radius 8.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 30 + 8 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((189.5) - 189.5 + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 179.5 + 8 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Status Tint Key' datatype='string' name='[Calculation_1400495547723235965]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Status Tint Key&#13;&#10;// Same values as Status Label, kept as a separate field so it can carry the light tint palette&#13;&#10;// for tile and alert backgrounds: Healthy #FFFFFF, Warning #FDF3E1, Critical #FBEAE9, No data #F1F2F4.&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Alert Fill Point' datatype='spatial' name='[Calculation_1162418806925279858]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Fill Point&#13;&#10;// Alert fill, 1px inside the border.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 30 + 7 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((189.5) - 189.5 + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 179.5 + 7 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Alert Icon Key' datatype='string' name='[Calculation_1007352953374889853]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Alert Icon Key&#13;&#10;// Alert icon background: the status colour at 18 to 20% over the alert fill.&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Alert Icon Point' datatype='spatial' name='[Calculation_2461624597664860302]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Icon Point&#13;&#10;// Icon background: the warning triangle, or a circle for other statuses.&#13;&#10;MAKEPOINT(&#13;&#10;    IF [current_status_code] = 2 THEN CASE INT([Calculation_2690238693341099106] / 30) WHEN 0 THEN 0.2640 WHEN 1 THEN 0.1413 ELSE 0.1413 END ELSE (20 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0.005 + 7.33 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100 END,&#13;&#10;    IF [current_status_code] = 2 THEN CASE INT([Calculation_2690238693341099106] / 30) WHEN 0 THEN -1.6850 WHEN 1 THEN -1.6183 ELSE -1.7517 END ELSE ((21.0) - 189.5 + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 0.005 + 7.33 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Attention Name Width' datatype='real' name='[Calculation_1052386569481538431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Attention Name Width&#13;&#10;// Width in px of the node name in Arial bold 9pt, measured by the build from dim_nodes&#13;&#10;// (Liberation Sans, metric-compatible with Arial). Places the incident tag just after the name.&#13;&#10;CASE [display_name]&#13;&#10;WHEN &quot;dim_companies&quot; THEN 90.7&#13;&#10;WHEN &quot;dim_contacts&quot; THEN 77.4&#13;&#10;WHEN &quot;dim_customer_360&quot; THEN 108.7&#13;&#10;WHEN &quot;dim_customer_behavior&quot; THEN 138.7&#13;&#10;WHEN &quot;dim_customers&quot; THEN 88.7&#13;&#10;WHEN &quot;dim_products&quot; THEN 79.3&#13;&#10;WHEN &quot;dim_stores&quot; THEN 64.0&#13;&#10;WHEN &quot;fct_ad_spend_daily&quot; THEN 111.4&#13;&#10;WHEN &quot;fct_app_engagement&quot; THEN 120.0&#13;&#10;WHEN &quot;fct_attribution&quot; THEN 80.7&#13;&#10;WHEN &quot;fct_board_kpis&quot; THEN 85.4&#13;&#10;WHEN &quot;fct_campaign_performance&quot; THEN 156.7&#13;&#10;WHEN &quot;fct_churn_features&quot; THEN 108.0&#13;&#10;WHEN &quot;fct_demand_signals&quot; THEN 115.4&#13;&#10;WHEN &quot;fct_experiment_results&quot; THEN 131.4&#13;&#10;WHEN &quot;fct_finance_close&quot; THEN 100.7&#13;&#10;WHEN &quot;fct_funnel_daily&quot; THEN 91.4&#13;&#10;WHEN &quot;fct_gl_journal&quot; THEN 78.7&#13;&#10;WHEN &quot;fct_inventory_daily&quot; THEN 109.4&#13;&#10;WHEN &quot;fct_marketing_roi&quot; THEN 100.7&#13;&#10;WHEN &quot;fct_ops_model_health&quot; THEN 126.7&#13;&#10;WHEN &quot;fct_order_items&quot; THEN 90.0&#13;&#10;WHEN &quot;fct_orders&quot; THEN 58.7&#13;&#10;WHEN &quot;fct_partner_payouts&quot; THEN 115.4&#13;&#10;WHEN &quot;fct_payments&quot; THEN 77.4&#13;&#10;WHEN &quot;fct_pipeline&quot; THEN 66.7&#13;&#10;WHEN &quot;fct_revenue_daily&quot; THEN 101.4&#13;&#10;WHEN &quot;fct_sessions&quot; THEN 72.7&#13;&#10;WHEN &quot;fct_shipments&quot; THEN 81.4&#13;&#10;WHEN &quot;fct_store_sales&quot; THEN 87.4&#13;&#10;WHEN &quot;fct_support_sla_daily&quot; THEN 123.4&#13;&#10;WHEN &quot;fct_tickets&quot; THEN 59.4&#13;&#10;WHEN &quot;int_ads__attribution&quot; THEN 114.7&#13;&#10;WHEN &quot;int_ads__unified&quot; THEN 94.7&#13;&#10;WHEN &quot;int_app__engagement&quot; THEN 126.7&#13;&#10;WHEN &quot;int_campaigns__spend_daily&quot; THEN 166.7&#13;&#10;WHEN &quot;int_contacts__lifecycle&quot; THEN 131.4&#13;&#10;WHEN &quot;int_customer_behavior&quot; THEN 132.0&#13;&#10;WHEN &quot;int_customers__deduped&quot; THEN 145.4&#13;&#10;WHEN &quot;int_deals__pipeline&quot; THEN 110.7&#13;&#10;WHEN &quot;int_experiments__assignments_enriched&quot; THEN 235.4&#13;&#10;WHEN &quot;int_funnel__steps&quot; THEN 102.0&#13;&#10;WHEN &quot;int_gl__mapped&quot; THEN 91.4&#13;&#10;WHEN &quot;int_inventory__snapshots&quot; THEN 148.7&#13;&#10;WHEN &quot;int_orders__enriched&quot; THEN 122.0&#13;&#10;WHEN &quot;int_payments__reconciled&quot; THEN 150.7&#13;&#10;WHEN &quot;int_products__catalog&quot; THEN 128.0&#13;&#10;WHEN &quot;int_revenue__daily&quot; THEN 108.1&#13;&#10;WHEN &quot;int_sessions__stitched&quot; THEN 132.1&#13;&#10;WHEN &quot;int_shipments__sla&quot; THEN 111.4&#13;&#10;WHEN &quot;int_store_sales__daily&quot; THEN 128.1&#13;&#10;WHEN &quot;int_tickets__lifecycle&quot; THEN 120.1&#13;&#10;WHEN &quot;pbi_inventory&quot; THEN 78.7&#13;&#10;WHEN &quot;pbi_marketing&quot; THEN 82.0&#13;&#10;WHEN &quot;pbi_support&quot; THEN 69.3&#13;&#10;WHEN &quot;pds_board_kpis&quot; THEN 92.0&#13;&#10;WHEN &quot;pds_commerce_sales&quot; THEN 124.7&#13;&#10;WHEN &quot;pds_finance_close&quot; THEN 107.4&#13;&#10;WHEN &quot;pds_finance_revenue&quot; THEN 122.7&#13;&#10;WHEN &quot;pds_ops_monitor&quot; THEN 100.7&#13;&#10;WHEN &quot;pds_sales_pipeline&quot; THEN 110.1&#13;&#10;WHEN &quot;pds_web_funnel&quot; THEN 94.0&#13;&#10;WHEN &quot;raw_dbt_artifacts.run_results&quot; THEN 168.1&#13;&#10;WHEN &quot;raw_events.app_events&quot; THEN 134.7&#13;&#10;WHEN &quot;raw_events.page_views&quot; THEN 136.1&#13;&#10;WHEN &quot;raw_events.search_events&quot; THEN 152.1&#13;&#10;WHEN &quot;raw_events.web_sessions&quot; THEN 150.1&#13;&#10;WHEN &quot;raw_experiments.assignments&quot; THEN 174.7&#13;&#10;WHEN &quot;raw_google_ads.ad_stats&quot; THEN 146.1&#13;&#10;WHEN &quot;raw_google_ads.campaigns&quot; THEN 160.1&#13;&#10;WHEN &quot;raw_hubspot.companies&quot; THEN 140.7&#13;&#10;WHEN &quot;raw_hubspot.contacts&quot; THEN 127.4&#13;&#10;WHEN &quot;raw_hubspot.deals&quot; THEN 108.7&#13;&#10;WHEN &quot;raw_meta_ads.ad_insights&quot; THEN 152.7&#13;&#10;WHEN &quot;raw_netsuite.accounts&quot; THEN 129.4&#13;&#10;WHEN &quot;raw_netsuite.gl_entries&quot; THEN 133.4&#13;&#10;WHEN &quot;raw_netsuite.journal_lines&quot; THEN 150.7&#13;&#10;WHEN &quot;raw_pos.store_sales&quot; THEN 118.1&#13;&#10;WHEN &quot;raw_shopify.customers&quot; THEN 133.2&#13;&#10;WHEN &quot;raw_shopify.order_items&quot; THEN 141.2&#13;&#10;WHEN &quot;raw_shopify.orders&quot; THEN 109.8&#13;&#10;WHEN &quot;raw_shopify.products&quot; THEN 123.8&#13;&#10;WHEN &quot;raw_stripe.payments&quot; THEN 119.4&#13;&#10;WHEN &quot;raw_stripe.refunds&quot; THEN 107.4&#13;&#10;WHEN &quot;raw_wms.inventory&quot; THEN 111.4&#13;&#10;WHEN &quot;raw_wms.shipments&quot; THEN 117.4&#13;&#10;WHEN &quot;raw_wms.warehouses&quot; THEN 126.7&#13;&#10;WHEN &quot;raw_zendesk.ticket_comments&quot; THEN 176.1&#13;&#10;WHEN &quot;raw_zendesk.tickets&quot; THEN 116.1&#13;&#10;WHEN &quot;sigma_customer_360&quot; THEN 122.1&#13;&#10;WHEN &quot;sigma_product_engagement&quot; THEN 163.4&#13;&#10;WHEN &quot;stg_dbt__run_results&quot; THEN 122.0&#13;&#10;WHEN &quot;stg_events__app_events&quot; THEN 142.1&#13;&#10;WHEN &quot;stg_events__app_installs&quot; THEN 145.4&#13;&#10;WHEN &quot;stg_events__page_views&quot; THEN 143.4&#13;&#10;WHEN &quot;stg_events__search_events&quot; THEN 159.4&#13;&#10;WHEN &quot;stg_events__web_sessions&quot; THEN 157.4&#13;&#10;WHEN &quot;stg_experiments__assignments&quot; THEN 182.1&#13;&#10;WHEN &quot;stg_google_ads__ad_stats&quot; THEN 153.4&#13;&#10;WHEN &quot;stg_google_ads__campaigns&quot; THEN 167.4&#13;&#10;WHEN &quot;stg_hubspot__companies&quot; THEN 148.0&#13;&#10;WHEN &quot;stg_hubspot__contacts&quot; THEN 134.7&#13;&#10;WHEN &quot;stg_hubspot__deal_stages&quot; THEN 154.0&#13;&#10;WHEN &quot;stg_hubspot__deals&quot; THEN 116.0&#13;&#10;WHEN &quot;stg_meta_ads__ad_insights&quot; THEN 160.1&#13;&#10;WHEN &quot;stg_netsuite__accounts&quot; THEN 136.7&#13;&#10;WHEN &quot;stg_netsuite__gl_entries&quot; THEN 140.7&#13;&#10;WHEN &quot;stg_netsuite__journal_lines&quot; THEN 158.1&#13;&#10;WHEN &quot;stg_pos__store_sales&quot; THEN 125.4&#13;&#10;WHEN &quot;stg_shopify__customers&quot; THEN 141.4&#13;&#10;WHEN &quot;stg_shopify__order_discounts&quot; THEN 174.7&#13;&#10;WHEN &quot;stg_shopify__order_items&quot; THEN 149.4&#13;&#10;WHEN &quot;stg_shopify__orders&quot; THEN 118.0&#13;&#10;WHEN &quot;stg_shopify__products&quot; THEN 132.0&#13;&#10;WHEN &quot;stg_stripe__payments&quot; THEN 126.7&#13;&#10;WHEN &quot;stg_stripe__refunds&quot; THEN 114.7&#13;&#10;WHEN &quot;stg_wms__inventory&quot; THEN 118.7&#13;&#10;WHEN &quot;stg_wms__shipments&quot; THEN 124.7&#13;&#10;WHEN &quot;stg_wms__warehouses&quot; THEN 134.1&#13;&#10;WHEN &quot;stg_zendesk__ticket_comments&quot; THEN 183.4&#13;&#10;WHEN &quot;stg_zendesk__tickets&quot; THEN 123.4&#13;&#10;ELSE LEN([display_name]) * 7&#13;&#10;END' />
      </column>
      <column caption='Alert Tag Border Point' datatype='spatial' name='[Calculation_6014120892313844274]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Border Point&#13;&#10;// Incident tag outline just after the name; shrinks away without an incident.&#13;&#10;MAKEPOINT(&#13;&#10;    (21 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 4 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((73 + [Calculation_1052386569481538431]) - 189.5 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 22 + 4 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Alert Tag Fill Point' datatype='spatial' name='[Calculation_3305746185277340020]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Fill Point&#13;&#10;// Incident tag fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (21 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 3 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((73 + [Calculation_1052386569481538431]) - 189.5 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 22 + 3 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Attention Glyph Critical' datatype='string' name='[Calculation_2962787816554794745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Glyph Critical&#13;&#10;// The cross inside the critical icon.&#13;&#10;IF [current_status_code] = 3 THEN &quot;✕&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Attention Glyph Warning' datatype='string' name='[Calculation_5695537439393437054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Glyph Warning&#13;&#10;// The mark inside the warning triangle.&#13;&#10;IF [current_status_code] = 2 THEN &quot;!&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Alert Glyph Point' datatype='spatial' name='[Calculation_1489187459337658552]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Glyph Point&#13;&#10;// Middle of the icon.&#13;&#10;MAKEPOINT(&#13;&#10;    0.1950,&#13;&#10;    -1.6850&#13;&#10;)' />
      </column>
      <column caption='Alert Chevron' datatype='string' name='[Calculation_1358681441065799831]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Alert Chevron&#13;&#10;// The &quot;›&quot; at the right of each alert.&#13;&#10;&quot;›&quot;' />
      </column>
      <column caption='Alert Chevron Point' datatype='spatial' name='[Calculation_1177064986607835880]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Chevron Point&#13;&#10;// The chevron, right side, middle.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    1.6750&#13;&#10;)' />
      </column>
      <column caption='Attention Incident Tag' datatype='string' name='[Calculation_5034449253068379788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Incident Tag&#13;&#10;// Incident tag text after the node name, for example &quot;INC-008&quot;. Empty when there is no open incident.&#13;&#10;IFNULL([open_incident_id], &quot;&quot;)' />
      </column>
      <column caption='Alert Tag Text Point' datatype='spatial' name='[Calculation_2553845990692593975]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Text Point&#13;&#10;// Middle of the incident tag.&#13;&#10;MAKEPOINT(&#13;&#10;    0.2100,&#13;&#10;    ((73 + [Calculation_1052386569481538431]) - 189.5) / 100&#13;&#10;)' />
      </column>
      <column caption='Alert Name Point' datatype='spatial' name='[Calculation_1754163316052029704]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Name Point&#13;&#10;// Start of the node name.&#13;&#10;MAKEPOINT(&#13;&#10;    0.2100,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Is Attention Long Reason' datatype='boolean' name='[Calculation_2777440251005319574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Attention Long Reason&#13;&#10;// A failed model whose reason plus time would be wider than the card: the time goes on its own line.&#13;&#10;[last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at]) AND LEN([status_reason]) &gt; 44' />
      </column>
      <column caption='Last Event Label' datatype='string' name='[Calculation_2229498162963349132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Last Event Label&#13;&#10;// The prototype&apos;s timestamp format: &quot;19 Oct, 21:25&quot;. &quot;-&quot; when the node has never run or been checked.&#13;&#10;IF ISNULL([last_event_at]) THEN &quot;-&quot;&#13;&#10;ELSE STR(DAY([last_event_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [last_event_at]), 3) + &quot;, &quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [last_event_at])), 2) + &quot;:&quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [last_event_at])), 2)&#13;&#10;END' />
      </column>
      <column caption='Attention Reason' datatype='string' name='[Calculation_2745413474489980072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Reason&#13;&#10;// Second line of the alert: what is wrong, with the time of a failed run when it fits.&#13;&#10;[status_reason]&#13;&#10;+ IF [last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at]) AND NOT [Calculation_2777440251005319574]&#13;&#10;    THEN &quot; at &quot; + [Calculation_2229498162963349132] ELSE &quot;&quot; END' />
      </column>
      <column caption='Alert Reason Point' datatype='spatial' name='[Calculation_2016452764908080303]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Reason Point&#13;&#10;// Start of the reason line.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0600,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Attention Reason Time' datatype='string' name='[Calculation_6666030497926233935]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Reason Time&#13;&#10;// Third line when the reason is long: &quot;at 19 Oct, 21:25&quot;.&#13;&#10;IF [Calculation_2777440251005319574] THEN &quot;at &quot; + [Calculation_2229498162963349132] ELSE &quot;&quot; END' />
      </column>
      <column caption='Alert Time Point' datatype='spatial' name='[Calculation_8600815631618955205]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Time Point&#13;&#10;// Start of the time line (long reasons only).&#13;&#10;MAKEPOINT(&#13;&#10;    -0.0700,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
      </column>
      <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Attention Where' datatype='string' name='[Calculation_7237364071094172266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Where&#13;&#10;// Start of the last alert line: &quot;Staging · Snowflake · &quot;.&#13;&#10;[Calculation_7823664326256286450] + &quot; · &quot; + [Calculation_1641578937180273009] + &quot; · &quot;' />
      </column>
      <column caption='Attention Affects' datatype='string' name='[Calculation_3193701186045745359]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Affects&#13;&#10;// The bold part of the last alert line: &quot;affects 4 exposures&quot;.&#13;&#10;&quot;affects &quot; + STR([exposures_fed]) + IF [exposures_fed] = 1 THEN &quot; exposure&quot; ELSE &quot; exposures&quot; END' />
      </column>
      <column caption='Attention Open Since' datatype='string' name='[Calculation_1700778924915878744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Open Since&#13;&#10;// Tail of the meta line: &quot; · open since 19 Oct&quot;. Uses open_incident_started_at, added to dim_nodes for this.&#13;&#10;IF ISNULL([open_incident_started_at]) THEN &quot;&quot;&#13;&#10;ELSE &quot; · open since &quot; + STR(DAY([open_incident_started_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [open_incident_started_at]), 3)&#13;&#10;END' />
      </column>
      <column caption='Alert Meta Point' datatype='spatial' name='[Calculation_1909663387392056855]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Meta Point&#13;&#10;// Start of the where / affects line, one line lower when the time has its own line.&#13;&#10;MAKEPOINT(&#13;&#10;    IF [last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at]) AND LEN([status_reason]) &gt; 44 THEN -0.2000 ELSE -0.0700 END,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Node Count' datatype='integer' name='[Calculation_2446133016301952044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Node Count&#13;&#10;// Number of nodes in the view. dim_nodes has one row per node.&#13;&#10;COUNTD([node_id (dim_nodes.csv)])' />
      </column>
      <column caption='Layer Share' datatype='real' name='[Calculation_9282765132542256788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Share&#13;&#10;// Each status&apos;s share of the layer, so every bar spans the full width.&#13;&#10;// Table calc: compute using Status Label (along the bar).&#13;&#10;[Calculation_2446133016301952044] / TOTAL([Calculation_2446133016301952044])'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2496845894520933783]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Layer Label Position' datatype='real' name='[Calculation_2008892738692294245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Label Position&#13;&#10;// Where the &quot;1 / 27&quot; count starts: just past the end of the full bar (axis fixed 0 to 1.3).&#13;&#10;// The label sits to the right of this hairline Gantt mark.&#13;&#10;MIN(1.02)' />
      </column>
      <column caption='Status Stack Order' datatype='integer' name='[Calculation_2946817898410042583]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Status Stack Order&#13;&#10;// Healthy first, for stacked bars, as in the prototype&apos;s layer health strip: Healthy, Warning, Critical, No data.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 1 THEN 1&#13;&#10;WHEN 2 THEN 2&#13;&#10;WHEN 3 THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='Layer Stack Key' datatype='integer' name='[Calculation_2496845894520933783]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Layer Stack Key&#13;&#10;// Stack order for the layer bar, left to right: Healthy, Warning, Critical, No data.&#13;&#10;// Tableau stacks the highest value first, so Healthy gets the highest key.&#13;&#10;5 - [Calculation_2946817898410042583]' />
      </column>
      <column caption='Layer Total' datatype='integer' name='[Calculation_3311281824631653486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Total&#13;&#10;// Nodes in the layer for the selected platform. FIXED with the platform rule inside, so no context filter is needed.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] THEN 1 END) }' />
      </column>
      <column caption='Layer Total Text' datatype='string' name='[Calculation_1760329556827391948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Total Text&#13;&#10;// The layer total, in grey after the issue count: &quot;1 / 30&quot; or just &quot;21&quot;.&#13;&#10;STR([Calculation_3311281824631653486])' />
      </column>
      <column caption='Layer Has Critical' datatype='boolean' name='[Calculation_4191687787979507265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Has Critical&#13;&#10;// TRUE when any node in the layer is Critical, so the issue count shows in red rather than amber.&#13;&#10;{ FIXED [layer] : MAX(IF [Calculation_2214252331607255986] AND [current_status_code] = 3 THEN 1 ELSE 0 END) } = 1' />
      </column>
      <column caption='Layer Issues' datatype='integer' name='[Calculation_1394288337659403442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Issues&#13;&#10;// Nodes in the layer that are Warning or Critical right now, for the selected platform.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] AND [Calculation_2875175252813195699] THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Layer Issues Critical Text' datatype='string' name='[Calculation_2393800399496740184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Critical Text&#13;&#10;// &quot;1 / &quot; in red, shown when the layer has a Critical node.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Layer Issues Warning Text' datatype='string' name='[Calculation_3164047678432910206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Warning Text&#13;&#10;// &quot;1 / &quot; in amber ink #93600F, when the layer has issues but none Critical.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND NOT [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Daily Is In Window' datatype='boolean' name='[Calculation_2140717334644434396]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Daily Is In Window&#13;&#10;// The day is inside the selected 7/30/90-day window.&#13;&#10;MAX(IIF([Calculation_1409194560049525583], 1, 0)) = 1' />
      </column>
      <column caption='Is Gantt Day' datatype='boolean' name='[Calculation_9861913593929028361]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Gantt Day&#13;&#10;// The bar for the day loaded in the Gantt (reference line on the date axis instead of a colour change).&#13;&#10;[date (dim_date.csv)] = [Parameters].[Parameter 6]' />
      </column>
      <column caption='Daily Is Selected' datatype='boolean' name='[Calculation_3401260011870240614]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Daily Is Selected&#13;&#10;// The day loaded in the Gantt (clicked, or stepped to with ‹ ›).&#13;&#10;MAX(IIF([Calculation_9861913593929028361], 1, 0)) = 1' />
      </column>
      <column caption='Daily Back Height' datatype='real' name='[Calculation_9871844494807156944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Back Height&#13;&#10;// Back bars: the clicked day navy to near the top (its edge shows round the bars and the filler as&#13;&#10;// the prototype&apos;s outline), every other day in the window full height (the bars touch: the band).&#13;&#10;IF [Calculation_3401260011870240614] THEN 53.2&#13;&#10;ELSEIF [Calculation_2140717334644434396] THEN 54&#13;&#10;END' />
      </column>
      <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
      </column>
      <column caption='Daily Back Key' datatype='string' name='[Calculation_1507981906426335172]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Daily Back Key&#13;&#10;// Colour of the back bars: Selected (navy outline) or Window (the band).&#13;&#10;IF [Calculation_3401260011870240614] THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Calculation_2140717334644434396] THEN &quot;Window&quot;&#13;&#10;END' />
      </column>
      <column caption='Daily Failed Runs' datatype='real' name='[Calculation_3098460751127839790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed Runs&#13;&#10;// Red bars: failed model runs that day.&#13;&#10;SUM([runs_failed])' />
      </column>
      <column caption='Daily Skipped Runs' datatype='real' name='[Calculation_2138488070576058935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Skipped Runs&#13;&#10;// Skipped because an upstream model failed (tooltip).&#13;&#10;SUM([runs_skipped])' />
      </column>
      <column caption='Daily Failed Selected' datatype='real' name='[Calculation_4867698479288880411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed Selected&#13;&#10;// Failed runs on the clicked day (full red).&#13;&#10;IF [Calculation_3401260011870240614] THEN SUM([runs_failed]) END' />
      </column>
      <column caption='Daily Failed Other' datatype='real' name='[Calculation_2153646829052003531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed Other&#13;&#10;// Failed runs on every other day (pale red).&#13;&#10;IF NOT [Calculation_3401260011870240614] THEN SUM([runs_failed]) END' />
      </column>
      <column caption='Daily Skipped Selected' datatype='real' name='[Calculation_2611916872173414448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Skipped Selected&#13;&#10;// Skipped runs on the clicked day (full grey).&#13;&#10;IF [Calculation_3401260011870240614] THEN SUM([runs_skipped]) END' />
      </column>
      <column caption='Daily Skipped Other' datatype='real' name='[Calculation_1570278384311226378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Skipped Other&#13;&#10;// Skipped runs on every other day (pale grey).&#13;&#10;IF NOT [Calculation_3401260011870240614] THEN SUM([runs_skipped]) END' />
      </column>
      <column caption='Daily Failed And Skipped' datatype='real' name='[Calculation_2885600867321422714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed And Skipped&#13;&#10;// Grey bars behind the red ones: failed + skipped, so the grey part above the red&#13;&#10;// is the skipped runs (an overlay, exact even on the 19 node-days that had both).&#13;&#10;SUM([runs_failed]) + SUM([runs_skipped])' />
      </column>
      <column caption='Daily Fill Window' datatype='real' name='[Calculation_6153058592725765752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Fill Window&#13;&#10;// Above the clicked day&apos;s stack, up to the outline&apos;s top edge, in the band colour: the outline&#13;&#10;// stays hollow, as in the prototype.&#13;&#10;IF [Calculation_3401260011870240614] AND [Calculation_2140717334644434396] THEN 52.6 - [Calculation_2885600867321422714] END' />
      </column>
      <column caption='Daily Fill Plain' datatype='real' name='[Calculation_4018887533510383646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Fill Plain&#13;&#10;// The same filler in white when the clicked day is outside the window.&#13;&#10;IF [Calculation_3401260011870240614] AND NOT [Calculation_2140717334644434396] THEN 52.6 - [Calculation_2885600867321422714] END' />
      </column>
      <column caption='Incident Tick' datatype='real' name='[Calculation_1447918477104689102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Incident Tick&#13;&#10;// Grey tick under an incident label, on days an incident started.&#13;&#10;IF COUNT([incident_id]) &gt; 0 THEN 22 END' />
      </column>
      <column caption='Incident Label Anchor' datatype='real' name='[Calculation_3308085721278344582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Incident Label Anchor&#13;&#10;// Point the &quot;INC 4&quot; label sits above (label vertical alignment top).&#13;&#10;IF COUNT([incident_id]) &gt; 0 THEN 24 END' />
      </column>
      <column caption='Incident Marker Label' datatype='string' name='[Calculation_1454750851671812728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Incident Marker Label&#13;&#10;// &quot;INC 4&quot; above the day an incident started, as in the prototype.&#13;&#10;REPLACE([incident_id], &quot;INC-00&quot;, &quot;INC &quot;)' />
      </column>
      <column caption='Axis Date Label' datatype='string' name='[Calculation_2516393983253929826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Axis Date Label&#13;&#10;// &quot;22 Jul&quot;, &quot;1 Aug&quot; ... under the 90-day charts: the first day and every 1st of the month.&#13;&#10;IF [day_index] = 0 OR DAY([date (dim_date.csv)]) = 1&#13;&#10;THEN STR(DAY([date (dim_date.csv)])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [date (dim_date.csv)]), 3)&#13;&#10;END' />
      </column>
      <column caption='Axis Label Anchor' datatype='real' name='[Calculation_3034596744519413745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Axis Label Anchor&#13;&#10;// Point the date label is centred on (axis 0 to 52, the bars&apos; scale).&#13;&#10;IF NOT ISNULL(MIN([Calculation_2516393983253929826])) THEN 26 END' />
      </column>
      <column caption='Job Schedule Label' datatype='string' name='[Calculation_3094354169785943014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Job Schedule Label&#13;&#10;// Small grey header beside the job name: &quot;hourly&quot;, &quot;daily&quot;, &quot;on PR&quot;.&#13;&#10;REPLACE([schedule], &quot;on_pull_request&quot;, &quot;on PR&quot;)' />
      </column>
      <column caption='Gantt Start Hour' datatype='real' name='[Calculation_3122650177919167747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Gantt Start Hour&#13;&#10;// Bar start in hours (axis 00:00 to 24:00) for runs on the selected day; other days have no mark.&#13;&#10;IF [run_date] = [Parameters].[Parameter 6] THEN [start_minute_of_day] / 60 END' />
      </column>
      <column caption='Tests Failed Marker Hour' datatype='real' name='[Calculation_2353287589358600364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tests Failed Marker Hour&#13;&#10;// Amber dot just after a run whose tests failed. NULL (no mark) otherwise.&#13;&#10;IF [run_date] = [Parameters].[Parameter 6] AND [tests_failed] &gt; 0&#13;&#10;THEN ([start_minute_of_day] + MAX([duration_min], 3) + 4) / 60 END' />
      </column>
      <column caption='Is Platform Match Job' datatype='boolean' name='[Calculation_1147506852634392335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Job&#13;&#10;// Platform filter for Job Runs (each run carries the platform most of its models ran on).&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform (mart_job_runs.csv)] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Job Run Outcome' datatype='string' name='[Calculation_2594716741566639131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Job Run Outcome&#13;&#10;// Bar colour: Succeeded #9DB9D6, Failed #D2453F, Cancelled #C3C9CF.&#13;&#10;CASE [status]&#13;&#10;WHEN &quot;error&quot;     THEN &quot;Failed&quot;&#13;&#10;WHEN &quot;cancelled&quot; THEN &quot;Cancelled&quot;&#13;&#10;ELSE &quot;Succeeded&quot;&#13;&#10;END' />
      </column>
      <column caption='Job Platform Name' datatype='string' name='[Calculation_1806154904060084637]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Job Platform Name&#13;&#10;// Platform the job ran on, as written in the legend.&#13;&#10;CASE [platform (mart_job_runs.csv)] WHEN &quot;snowflake&quot; THEN &quot;Snowflake&quot; WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot; THEN &quot;Redshift&quot; ELSE [platform (mart_job_runs.csv)] END' />
      </column>
      <column caption='Gantt Started Text' datatype='string' name='[Calculation_1493742440611781298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Gantt Started Text&#13;&#10;// &quot;05:16&quot; in the tooltip.&#13;&#10;RIGHT(&quot;0&quot; + STR(INT([start_minute_of_day] / 60)), 2) + &quot;:&quot; + RIGHT(&quot;0&quot; + STR([start_minute_of_day] % 60), 2)' />
      </column>
      <column caption='Gantt Duration Text' datatype='string' name='[Calculation_1622474558781708599]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Gantt Duration Text&#13;&#10;// &quot;5.8 min&quot; or &quot;1 h 25 min&quot; in the tooltip.&#13;&#10;IF [duration_min] &lt; 60 THEN STR(ROUND([duration_min], 1)) + &quot; min&quot;&#13;&#10;ELSE STR(INT([duration_min] / 60)) + &quot; h &quot; + STR(INT([duration_min]) % 60) + &quot; min&quot; END' />
      </column>
      <column caption='Gantt Duration Hours' datatype='real' name='[Calculation_2829640963960821448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Gantt Duration Hours&#13;&#10;// Bar length in hours, at least 3 minutes so very short runs stay visible.&#13;&#10;MAX([duration_min], 3) / 60' />
      </column>
      <column caption='Is First Date Row' datatype='boolean' name='[Calculation_7201951502715406386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is First Date Row&#13;&#10;// One-row scaffold (the first day) for the Gantt day buttons and label. Put on Filters (True).&#13;&#10;[day_index] = 0' />
      </column>
      <column caption='Gantt Prev Date' datatype='date' name='[Calculation_4255842174353675499]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Gantt Prev Date&#13;&#10;// Value the ‹ button writes into p_gantt_date. Stops at the first day.&#13;&#10;IF [Parameters].[Parameter 6] &gt; { MIN([date (dim_date.csv)]) }&#13;&#10;    THEN DATE(DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 6]))&#13;&#10;ELSE [Parameters].[Parameter 6]&#13;&#10;END' />
      </column>
      <column caption='Gantt Prev Glyph' datatype='string' name='[Calculation_5461572561073485727]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Gantt Prev Glyph&#13;&#10;// ‹ on the previous-day button.&#13;&#10;MIN(&quot;‹&quot;)' />
      </column>
      <column caption='As Of Date' datatype='date' name='[Calculation_3151274114862452881]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// As Of Date&#13;&#10;// Last day in the data (19 Oct). Every &quot;now&quot; in the dashboard is measured against it.&#13;&#10;{ MAX([date (dim_date.csv)]) }' />
      </column>
      <column caption='Gantt Next Date' datatype='date' name='[Calculation_2973907925170101119]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Gantt Next Date&#13;&#10;// Value the › button writes into p_gantt_date. Stops at the last day.&#13;&#10;IF [Parameters].[Parameter 6] &lt; [Calculation_3151274114862452881]&#13;&#10;    THEN DATE(DATEADD(&apos;day&apos;, 1, [Parameters].[Parameter 6]))&#13;&#10;ELSE [Parameters].[Parameter 6]&#13;&#10;END' />
      </column>
      <column caption='Gantt Next Glyph' datatype='string' name='[Calculation_2561110447235085966]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Gantt Next Glyph&#13;&#10;// › on the next-day button.&#13;&#10;MIN(&quot;›&quot;)' />
      </column>
      <column caption='Gantt Day Label' datatype='string' name='[Calculation_1325618294935570178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Gantt Day Label&#13;&#10;// Card header between the arrows: &quot;Mon 19 Oct 2026&quot;.&#13;&#10;LEFT(DATENAME(&apos;weekday&apos;, [Parameters].[Parameter 6]), 3) + &quot; &quot;&#13;&#10;+ STR(DAY([Parameters].[Parameter 6])) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, [Parameters].[Parameter 6]), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR([Parameters].[Parameter 6]))' />
      </column>
      <column caption='Is Platform Match Error' datatype='boolean' name='[Calculation_1475933581110583641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Error&#13;&#10;// Platform filter for Run Errors: the platform the model ran on when it failed.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform (mart_run_errors.csv)] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Failed Model Runs' datatype='integer' name='[Calculation_1556808545805540049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Failed Model Runs&#13;&#10;// Count of failed model runs. 30d check: 50 (18 compilation, 17 database, 9 permission, 6 timeout).&#13;&#10;COUNT([job_run_id])' />
      </column>
      <column caption='Failed Runs Label' datatype='string' name='[Calculation_6189998033001785489]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Failed Runs Label&#13;&#10;// Card subtitle: &quot;50 failed model runs in this period&quot;.&#13;&#10;STR([Calculation_1556808545805540049]) + &quot; failed model runs in this period&quot;' />
      </column>
      <column caption='Error Category Label' datatype='string' name='[Calculation_2759662032659617150]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Category Label&#13;&#10;// Prototype names for the error categories.&#13;&#10;CASE [error_category]&#13;&#10;WHEN &quot;database&quot;      THEN &quot;Database error&quot;&#13;&#10;WHEN &quot;compilation&quot;   THEN &quot;Compilation error&quot;&#13;&#10;WHEN &quot;permission&quot;    THEN &quot;Permission denied&quot;&#13;&#10;WHEN &quot;timeout&quot;       THEN &quot;Timeout&quot;&#13;&#10;WHEN &quot;schema_change&quot; THEN &quot;Schema change&quot;&#13;&#10;ELSE [error_category]&#13;&#10;END' />
      </column>
      <column caption='Why Track' datatype='real' name='[Calculation_2807912847742869558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Why Track&#13;&#10;// Where each count label ends, right-aligned as in the mock: a little past the longest bar, so no&#13;&#10;// bar runs through a number (v24 had them on the bar end). Table calc along Error Category Label.&#13;&#10;WINDOW_MAX([Calculation_1556808545805540049]) * 1.14'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2759662032659617150]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Top Model Track' datatype='real' name='[Calculation_1053829186246530949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Top Model Track&#13;&#10;// Same for the top-models bars. Table calc along display_name.&#13;&#10;WINDOW_MAX([Calculation_1556808545805540049]) * 1.14'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Is Top Failing Model' datatype='boolean' name='[Calculation_2758321348733286171]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Is Top Failing Model&#13;&#10;// The 7 models that failed most. Table calc filter (True), along display_name.&#13;&#10;RANK_UNIQUE([Calculation_1556808545805540049]) &lt;= 7'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Error Head When' datatype='string' name='[Calculation_1842423184776706169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head When&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;WHEN&quot;' />
      </column>
      <column caption='Error Head Model' datatype='string' name='[Calculation_8180630051212121102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head Model&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;MODEL&quot;' />
      </column>
      <column caption='Error Head Category' datatype='string' name='[Calculation_2898266689643006961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head Category&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;CATEGORY&quot;' />
      </column>
      <column caption='Error Head Message' datatype='string' name='[Calculation_1745346346299597772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head Message&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;MESSAGE&quot;' />
      </column>
      <column caption='Error Order' datatype='integer' name='[Calculation_1108514369483243976]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Error Order&#13;&#10;// Newest first: minutes before the end of 2026, so the natural ascending order is newest first.&#13;&#10;DATEDIFF(&apos;minute&apos;, [run_started_at], #2026-12-31#)' />
      </column>
      <column caption='Error Key' datatype='string' name='[Calculation_1460623011763772819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Key&#13;&#10;// One row per failed model run: job run and node.&#13;&#10;[job_run_id] + &quot;|&quot; + [node_id (mart_run_errors.csv)]' />
      </column>
