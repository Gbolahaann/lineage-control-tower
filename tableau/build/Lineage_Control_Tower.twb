            <column caption='BR Who Name Text' datatype='string' name='[Calculation_4416869704477038486]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// BR Who Name Text&#13;&#10;// Name column (written by the build).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;exposure.acme_core.lineage_control_tower&quot; THEN &quot;Lineage Control Tower&quot;&#13;&#10;WHEN &quot;exposure.acme_core.customer_360&quot; THEN &quot;Customer 360&quot;&#13;&#10;WHEN &quot;exposure.acme_product.product_engagement&quot; THEN &quot;Product Engagement&quot;&#13;&#10;WHEN &quot;exposure.acme_product.churn_prediction_model&quot; THEN &quot;Churn Prediction Model&quot;&#13;&#10;WHEN &quot;exposure.acme_product.web_funnel_analysis&quot; THEN &quot;Web Funnel Analysis&quot;&#13;&#10;WHEN &quot;exposure.acme_product.pricing_experiment_analysis&quot; THEN &quot;Pricing Experiment Analysis&quot;&#13;&#10;WHEN &quot;exposure.acme_product.demand_forecast_app&quot; THEN &quot;Demand Forecast App&quot;&#13;&#10;WHEN &quot;exposure.acme_marketing.marketing_campaign_performance&quot; THEN &quot;Marketing Campaign Performa…&quot;&#13;&#10;WHEN &quot;exposure.observed.undeclared_promo_notebook&quot; THEN &quot;Unregistered: scheduled noteb…&quot;&#13;&#10;WHEN &quot;exposure.acme_core.executive_revenue_dashboard&quot; THEN &quot;Executive Revenue Dashboard&quot;&#13;&#10;WHEN &quot;exposure.acme_core.board_kpi_pack&quot; THEN &quot;Board KPI Pack&quot;&#13;&#10;WHEN &quot;exposure.acme_marketing.sales_pipeline&quot; THEN &quot;Sales Pipeline&quot;&#13;&#10;WHEN &quot;exposure.acme_core.finance_close_tracker&quot; THEN &quot;Finance Close Tracker&quot;&#13;&#10;WHEN &quot;exposure.acme_core.finance_qa_agent&quot; THEN &quot;Finance Q&amp;A Agent&quot;&#13;&#10;WHEN &quot;exposure.acme_core.supply_chain_ops&quot; THEN &quot;Supply Chain Ops&quot;&#13;&#10;WHEN &quot;exposure.acme_core.store_ops_hub&quot; THEN &quot;Store Ops Hub&quot;&#13;&#10;WHEN &quot;exposure.observed.undeclared_regional_hub&quot; THEN &quot;Unregistered: personal Claude …&quot;&#13;&#10;WHEN &quot;exposure.acme_core.partner_revenue_share&quot; THEN &quot;Partner Revenue Share&quot;&#13;&#10;WHEN &quot;exposure.acme_core.merchandising_copilot&quot; THEN &quot;Merchandising Copilot&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_overview_ai&quot; THEN &quot;Revenue Overview (AI)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_by_channel_v2&quot; THEN &quot;Revenue by Channel v2&quot;&#13;&#10;WHEN &quot;exposure.acme_core.daily_sales_snapshot&quot; THEN &quot;Daily Sales Snapshot&quot;&#13;&#10;WHEN &quot;exposure.acme_core.revenue_dashboard_copy&quot; THEN &quot;Revenue Dashboard (copy)&quot;&#13;&#10;WHEN &quot;exposure.acme_core.q3_sales_summary_ai&quot; THEN &quot;Q3 Sales Summary (AI)&quot;&#13;&#10;WHEN &quot;exposure.observed.undeclared_pricing_agent&quot; THEN &quot;Unregistered: pricing agent&quot;&#13;&#10;WHEN &quot;exposure.acme_core.inventory_health&quot; THEN &quot;Inventory Health&quot;&#13;&#10;WHEN &quot;exposure.acme_product.support_sla_tracker&quot; THEN &quot;Support SLA Tracker&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
