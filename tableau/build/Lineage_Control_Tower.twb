    <worksheet name='HO MTTR KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Platform Match Day (Episodes)' datatype='boolean' name='[Calculation_3348788321593585024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Day (Episodes)&#13;&#10;// Same rule for Recovery Episodes: the platform the node was on when the failure started.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day (mart_recovery_episodes.csv)] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='MTTR - Focus' datatype='real' name='[Calculation_1490761445074029792]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Focus&#13;&#10;// Mean hours from a node&apos;s first failure to its next success, for episodes that started in the window and have recovered.&#13;&#10;// Covers model runs, source freshness and BI refreshes. 30d check: 4.87 h.&#13;&#10;AVG(IF [Calculation_1409194560049525583] AND NOT [is_open] THEN [hours_to_recover] END)' />
            </column>
            <column caption='MTTR - Focus Label' datatype='string' name='[Calculation_6570730252120364370]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// MTTR - Focus Label&#13;&#10;// BAN text, matching the prototype: minutes under an hour, otherwise hours to 1 decimal. &quot;-&quot; when nothing recovered.&#13;&#10;IF ISNULL([Calculation_1490761445074029792]) THEN &quot;-&quot;&#13;&#10;ELSEIF [Calculation_1490761445074029792] &lt; 1&#13;&#10;    THEN STR(ROUND([Calculation_1490761445074029792] * 60)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([Calculation_1490761445074029792], 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='In Prior Period' datatype='boolean' name='[Calculation_1036360725637968047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Prior Period&#13;&#10;// TRUE for the same-length window just before the selected one.&#13;&#10;// Matches no rows at 90 days (the data starts 22 Jul), so every &quot;- Prior&quot; measure returns NULL there.&#13;&#10;[days_before_as_of] &gt;= [Parameters].[Parameter 1]&#13;&#10;AND [days_before_as_of] &lt; 2 * [Parameters].[Parameter 1]' />
            </column>
            <column caption='MTTR - Prior' datatype='real' name='[Calculation_8777189573491179478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Prior&#13;&#10;// Same average for episodes that started in the window before. NULL at 90 days.&#13;&#10;AVG(IF [Calculation_1036360725637968047] AND NOT [is_open] THEN [hours_to_recover] END)' />
            </column>
            <column caption='MTTR - Change' datatype='real' name='[Calculation_9964583792416952326]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Change&#13;&#10;// Percentage change. Inverse metric: a rise is bad.&#13;&#10;IF [Calculation_8777189573491179478] = 0 OR ISNULL([Calculation_8777189573491179478]) THEN NULL&#13;&#10;ELSE [Calculation_1490761445074029792] / [Calculation_8777189573491179478] - 1&#13;&#10;END' />
            </column>
            <column caption='MTTR - Change Good' datatype='real' name='[Calculation_2649301209160798169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Change Good&#13;&#10;// Inverse metric, so a fall (or no change) is good and shows in green. Format: ▲ 0.0%;▼ 0.0%;● 0%&#13;&#10;IF [Calculation_9964583792416952326] &lt;= 0 THEN [Calculation_9964583792416952326] END' />
            </column>
            <column caption='MTTR - Change Good Text' datatype='string' name='[Calculation_8864060235112699764]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// MTTR - Change Good Text&#13;&#10;// Inverse metric: a fall is good. Green text &quot;▼ 10.8%&quot;, or &quot;● 0%&quot; when nothing changed.&#13;&#10;IF ISNULL([Calculation_2649301209160798169]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_2649301209160798169] = 0 THEN &quot;● 0%&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_2649301209160798169]) * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_2649301209160798169]) * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='MTTR - Change Bad' datatype='real' name='[Calculation_1820979831573442882]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR - Change Bad&#13;&#10;// A rise in recovery time, in red. Same number format.&#13;&#10;IF [Calculation_9964583792416952326] &gt; 0 THEN [Calculation_9964583792416952326] END' />
            </column>
            <column caption='MTTR - Change Bad Text' datatype='string' name='[Calculation_2992056182811374933]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// MTTR - Change Bad Text&#13;&#10;// Inverse metric: a rise is bad. Red text &quot;▲ 4.2%&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_1820979831573442882]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_1820979831573442882] * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([Calculation_1820979831573442882] * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='Has Prior Period' datatype='boolean' name='[Calculation_1497969784006078758]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Has Prior Period&#13;&#10;// FALSE at 90 days, when there is no earlier window in the data.&#13;&#10;// Drives the &quot;no earlier period&quot; wording. Measures don&apos;t need it: their Prior is NULL anyway.&#13;&#10;2 * [Parameters].[Parameter 1] &lt;= { MAX([day_index]) } + 1' />
            </column>
            <column caption='Compare Label' datatype='string' name='[Calculation_1953312242491521622]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Compare Label&#13;&#10;// Grey tail of every KPI change line: &quot;vs prior 30d&quot;, or &quot;-  no earlier period&quot; at 90 days.&#13;&#10;IF [Calculation_1497969784006078758]&#13;&#10;    THEN &quot;vs prior &quot; + STR([Parameters].[Parameter 1]) + &quot;d&quot;&#13;&#10;ELSE &quot;-  no earlier period&quot;&#13;&#10;END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Hours To Recover' datatype='real' name='[hours_to_recover]' role='measure' type='quantitative' />
            <column caption='Is Open' datatype='boolean' name='[is_open]' role='dimension' type='nominal' />
            <column caption='Platform On Day (Recovery Episodes)' datatype='string' name='[platform_on_day (mart_recovery_episodes.csv)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3348788321593585024]' derivation='None' name='[none:Calculation_3348788321593585024:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_6570730252120364370]' derivation='User' name='[usr:Calculation_6570730252120364370:nk]' pivot='key' type='nominal' />
