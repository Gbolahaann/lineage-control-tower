            <column caption='Is Lineage Scope' datatype='boolean' name='[Calculation_2164541789448021386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Lineage Scope&#13;&#10;// Keeps the per-exposure layout of the selected exposure. Put on Filters (True).&#13;&#10;[layout_scope] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Selected Exposure Trust' datatype='string' name='[Calculation_1225523636867582318]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Selected Exposure Trust&#13;&#10;// Trust badge of the selected exposure, for the pill beside the picker (dynamic zone visibility).&#13;&#10;{ MAX(IF [node_id (dim_nodes.csv)] = [Parameters].[Parameter 3] THEN [trust_badge] END) }' />
            </column>
            <column caption='Trust Pill Key' datatype='string' name='[Calculation_9889241079384188661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Trust Pill Key&#13;&#10;// Fill of the trust pill beside the picker (palette by trust badge).&#13;&#10;[Calculation_1225523636867582318]' />
            </column>
            <column caption='Trust Pill Point' datatype='spatial' name='[Calculation_5092009918452207885]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Trust Pill Point&#13;&#10;// The trust pill beside the picker, drawn from the exposure&apos;s incoming edge rows.&#13;&#10;IF [row_type] = &quot;edge&quot; AND [child_node_id] = [layout_scope] THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (0) + 9 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((0) + (CASE [Calculation_1225523636867582318] WHEN &quot;Do not use&quot; THEN 80 WHEN &quot;Use with caution&quot; THEN 108 WHEN &quot;Trusted&quot; THEN 66 ELSE 0 END)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((CASE [Calculation_1225523636867582318] WHEN &quot;Do not use&quot; THEN 80 WHEN &quot;Use with caution&quot; THEN 108 WHEN &quot;Trusted&quot; THEN 66 ELSE 0 END) - (0)) / 2 - 9) + 9 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 66) / 100&#13;&#10;) END' />
            </column>
            <column caption='Trust Pill Critical' datatype='string' name='[Calculation_2921126871268436128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Trust Pill Critical&#13;&#10;// Trust pill text, red.&#13;&#10;IF [Calculation_1225523636867582318] = &quot;Do not use&quot; THEN &quot;✕  Do not use&quot; END' />
            </column>
            <column caption='Trust Pill Warning' datatype='string' name='[Calculation_1410966149898586808]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Trust Pill Warning&#13;&#10;// Trust pill text, amber ink.&#13;&#10;IF [Calculation_1225523636867582318] = &quot;Use with caution&quot; THEN &quot;▲  Use with caution&quot; END' />
            </column>
            <column caption='Trust Pill Healthy' datatype='string' name='[Calculation_2202975793804500138]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Trust Pill Healthy&#13;&#10;// Trust pill text, green.&#13;&#10;IF [Calculation_1225523636867582318] = &quot;Trusted&quot; THEN &quot;✓  Trusted&quot; END' />
            </column>
            <column caption='Trust Pill Text Point' datatype='spatial' name='[Calculation_1682128909242140249]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Trust Pill Text Point&#13;&#10;// Middle of the trust pill.&#13;&#10;MAKEPOINT(0, ((CASE [Calculation_1225523636867582318] WHEN &quot;Do not use&quot; THEN 80 WHEN &quot;Use with caution&quot; THEN 108 WHEN &quot;Trusted&quot; THEN 66 ELSE 0 END) / 2 - 66) / 100)' />
            </column>
            <column caption='Child Node Id' datatype='string' name='[child_node_id]' role='dimension' type='nominal' />
            <column caption='Layout Scope' datatype='string' name='[layout_scope]' role='dimension' type='nominal' />
            <column caption='Node Id (Nodes)' datatype='string' name='[node_id (dim_nodes.csv)]' role='dimension' type='nominal' />
            <column caption='Point Order' datatype='real' name='[point_order]' role='dimension' type='ordinal' />
            <column caption='Row Type' datatype='string' name='[row_type]' role='dimension' type='nominal' />
            <column caption='Trust Badge' datatype='string' name='[trust_badge]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2164541789448021386]' derivation='None' name='[none:Calculation_2164541789448021386:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_9889241079384188661]' derivation='None' name='[none:Calculation_9889241079384188661:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5092009918452207885]' derivation='Collect' name='[clct:Calculation_5092009918452207885:nk]' pivot='key' type='nominal' />
            <column-instance column='[point_order]' derivation='None' name='[none:point_order:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2921126871268436128]' derivation='Attribute' name='[attr:Calculation_2921126871268436128:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1410966149898586808]' derivation='Attribute' name='[attr:Calculation_1410966149898586808:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2202975793804500138]' derivation='Attribute' name='[attr:Calculation_2202975793804500138:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1682128909242140249]' derivation='Collect' name='[clct:Calculation_1682128909242140249:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
