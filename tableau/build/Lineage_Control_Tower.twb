    <worksheet name='LIN View Buttons'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Graph' caption='p_lineage_view' datatype='string' datatype-customized='true' name='[Parameter 9]' param-domain-type='list' role='measure' type='nominal' value='&quot;Graph&quot;'>
              <calculation class='tableau' formula='&quot;Graph&quot;' />
              <aliases>
                <alias key='&quot;Graph&quot;' value='Graph' />
                <alias key='&quot;Table&quot;' value='Table' />
              </aliases>
              <members>
                <member alias='Graph' value='&quot;Graph&quot;' />
                <member alias='Table' value='&quot;Table&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Lineage View Option' datatype='string' name='[Calculation_3302216381930638508]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage View Option&#13;&#10;// Scaffold for the Graph / Table buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;Graph&quot;&#13;&#10;WHEN 1 THEN &quot;Table&quot;&#13;&#10;END' />
            </column>
            <column caption='Full Bar' datatype='real' name='[Calculation_2313436587575898004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Full Bar&#13;&#10;// Bar length for a full-width background (axis fixed 0 to 1 and hidden): buttons, alert rows.&#13;&#10;MIN(1.0)' />
            </column>
            <column caption='Text Anchor Centre' datatype='real' name='[Calculation_2496391787737110048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Text Anchor Centre&#13;&#10;// Where centred text sits on a full-width background bar.&#13;&#10;MIN(0.5)' />
            </column>
            <column caption='Is Lineage View Button Row' datatype='boolean' name='[Calculation_3292968341389723114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Lineage View Button Row&#13;&#10;// Keeps the 2 scaffold rows that carry the Graph / Table buttons. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_3302216381930638508])' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Is Active Lineage View' datatype='boolean' name='[Calculation_9814064880122529524]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Active Lineage View&#13;&#10;// Colours the selected view button.&#13;&#10;[Calculation_3302216381930638508] = [Parameters].[Parameter 9]' />
            </column>
            <column caption='Lineage View Label Active' datatype='string' name='[Calculation_3232177490506046766]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage View Label Active&#13;&#10;// Button text when this view is selected (Semibold Navy run).&#13;&#10;IF [Calculation_9814064880122529524] THEN [Calculation_3302216381930638508] ELSE &quot;&quot; END' />
            </column>
            <column caption='Lineage View Label Inactive' datatype='string' name='[Calculation_1799819424796331404]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Lineage View Label Inactive&#13;&#10;// Button text when this view is not selected.&#13;&#10;IF NOT [Calculation_9814064880122529524] THEN [Calculation_3302216381930638508] ELSE &quot;&quot; END' />
