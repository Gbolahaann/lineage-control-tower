    <worksheet name='RUN MTTR Rolling Line'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='MTTR Rolling 7 Day Area' datatype='real' name='[Calculation_3037070239198132758]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR Rolling 7 Day Area&#13;&#10;// The same value for the light area under the line (a second axis needs its own field).&#13;&#10;WINDOW_SUM(SUM(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)&#13;&#10;/&#13;&#10;WINDOW_SUM(COUNT(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2904210747288447847]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='MTTR Rolling 7 Day Line' datatype='real' name='[Calculation_6430925892119406940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// MTTR Rolling 7 Day Line&#13;&#10;// Mean recovery time of episodes that started in the 7 days up to each day (episode-weighted).&#13;&#10;// Table calc along Days Back Mid (ascending = back in time, so the 6 days before are +1 to +6).&#13;&#10;WINDOW_SUM(SUM(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)&#13;&#10;/&#13;&#10;WINDOW_SUM(COUNT(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2904210747288447847]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
            </column>
            <column caption='Is Platform Match Day (Episodes)' datatype='boolean' name='[Calculation_3348788321593585024]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Day (Episodes)&#13;&#10;// Same rule for Recovery Episodes: the platform the node was on when the failure started.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day (mart_recovery_episodes.csv)] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Tooltip Day Text' datatype='string' name='[Calculation_2968828563623477298]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tooltip Day Text&#13;&#10;// &quot;Mon 12 Oct&quot; in a 90-day chart&apos;s tooltip, as an aggregate so it never splits a line or area.&#13;&#10;LEFT(DATENAME(&apos;weekday&apos;, MIN([date (dim_date.csv)])), 3) + &quot; &quot; + STR(DAY(MIN([date (dim_date.csv)]))) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, MIN([date (dim_date.csv)])), 3)' />
            </column>
            <column caption='Date (Dates)' datatype='date' name='[date (dim_date.csv)]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Hours To Recover' datatype='real' name='[hours_to_recover]' role='measure' type='quantitative' />
            <column caption='Is Open' datatype='boolean' name='[is_open]' role='dimension' type='nominal' />
            <column caption='Platform On Day (Recovery Episodes)' datatype='string' name='[platform_on_day (mart_recovery_episodes.csv)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_3037070239198132758]' derivation='User' name='[usr:Calculation_3037070239198132758:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2904210747288447847]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_6430925892119406940]' derivation='User' name='[usr:Calculation_6430925892119406940:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2904210747288447847]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Calculation_2904210747288447847]' derivation='None' name='[none:Calculation_2904210747288447847:qk]' pivot='key' type='quantitative' />
