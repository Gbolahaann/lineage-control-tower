          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is PF Heading Row' datatype='boolean' name='[Calculation_4365700045437780035]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is PF Heading Row&#13;&#10;// The first six days of the date table: one per column title. Put on Filters (True).&#13;&#10;[day_index] &lt; 6' />
            </column>
            <column caption='PF Heading' datatype='string' name='[Calculation_2909203795951181803]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Heading&#13;&#10;// Column titles of the most expensive models table, one date row each.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;MODEL&quot;&#13;&#10;WHEN 1 THEN &quot;BUILT AS&quot;&#13;&#10;WHEN 2 THEN &quot;AVG RUNTIME&quot;&#13;&#10;WHEN 3 THEN &quot;7D VS 28D&quot;&#13;&#10;WHEN 4 THEN &quot;LARGEST BUILD&quot;&#13;&#10;WHEN 5 THEN &quot;COST&quot;&#13;&#10;END' />
            </column>
            <column caption='PF Heading Point' datatype='spatial' name='[Calculation_1028334264679791289]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Heading Point&#13;&#10;// Middle of a column title (left or right-aligned, measured by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN MAKEPOINT(0, (24.9 - 365) / 100)&#13;&#10;WHEN 1 THEN MAKEPOINT(0, (193.1 - 365) / 100)&#13;&#10;WHEN 2 THEN MAKEPOINT(0, (323.5 - 365) / 100)&#13;&#10;WHEN 3 THEN MAKEPOINT(0, (404.5 - 365) / 100)&#13;&#10;WHEN 4 THEN MAKEPOINT(0, (482.0 - 365) / 100)&#13;&#10;WHEN 5 THEN MAKEPOINT(0, (567.0 - 365) / 100)&#13;&#10;END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4365700045437780035]' derivation='None' name='[none:Calculation_4365700045437780035:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2909203795951181803]' derivation='Attribute' name='[attr:Calculation_2909203795951181803:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1028334264679791289]' derivation='Collect' name='[clct:Calculation_1028334264679791289:nk]' pivot='key' type='nominal' />
            <column-instance column='[day_index]' derivation='None' name='[none:day_index:ok]' pivot='key' type='ordinal' />
