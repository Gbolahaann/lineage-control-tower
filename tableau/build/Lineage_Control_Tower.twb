|snowflake|model.acme_core.fct_orders&quot; THEN 8&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.int_inventory__snapshots&quot; THEN 9&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.dim_customers&quot; THEN 10&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.fct_campaign_performance&quot; THEN 11&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.fct_payments&quot; THEN 12&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.fct_shipments&quot; THEN 13&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.int_payments__reconciled&quot; THEN 14&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.int_customers__deduped&quot; THEN 15&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_customer_behavior&quot; THEN 3&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_demand_signals&quot; THEN 4&#13;&#10;WHEN &quot;90|databricks|model.acme_product.dim_customer_behavior&quot; THEN 5&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_app__engagement&quot; THEN 6&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_app_engagement&quot; THEN 7&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_funnel_daily&quot; THEN 8&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_churn_features&quot; THEN 9&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_funnel__steps&quot; THEN 10&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_experiment_results&quot; THEN 11&#13;&#10;WHEN &quot;90|databricks|model.acme_product.stg_events__app_events&quot; THEN 12&#13;&#10;WHEN &quot;90|databricks|model.acme_product.stg_events__app_installs&quot; THEN 13&#13;&#10;WHEN &quot;90|databricks|model.acme_product.stg_events__web_sessions&quot; THEN 14&#13;&#10;WHEN &quot;90|databricks|model.acme_product.stg_events__page_views&quot; THEN 15&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_pipeline&quot; THEN 7&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_ad_spend_daily&quot; THEN 8&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.dim_companies&quot; THEN 9&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_campaigns__spend_daily&quot; THEN 10&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_contacts__lifecycle&quot; THEN 11&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_deals__pipeline&quot; THEN 12&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_meta_ads__ad_insights&quot; THEN 13&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_google_ads__campaigns&quot; THEN 14&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_google_ads__ad_stats&quot; THEN 15&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Is PF Top Cost Model' datatype='boolean' name='[Calculation_9778059276280110608]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is PF Top Cost Model&#13;&#10;// The 15 rows of the most expensive models table. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1845292614625042272])' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
            </column>
            <column caption='PF Band Point' datatype='spatial' name='[Calculation_1590771895622862082]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Band Point&#13;&#10;// The row (white, takes the click).&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.1050 WHEN 1 THEN 0.1050 WHEN 2 THEN -0.0950 ELSE -0.0950 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN ((0) - 365) / 100 WHEN 1 THEN ((730) - 365) / 100 WHEN 2 THEN ((730) - 365) / 100 ELSE ((0) - 365) / 100 END&#13;&#10;)' />
            </column>
            <column caption='Panel Tags Value' datatype='string' name='[Calculation_9860372241269830816]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Tags Value&#13;&#10;// What a click writes into p_panel_tags: &quot;|moved|ai|unregistered|&quot; for the tags this node carries.&#13;&#10;&quot;|&quot; + IF NOT ISNULL([migrated_from_platform]) THEN &quot;moved|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF [build_method] = &quot;ai_assisted&quot; THEN &quot;ai|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF NOT [is_declared] THEN &quot;unregistered|&quot; ELSE &quot;&quot; END' />
            </column>
            <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Model Avg Runtime (Period)' datatype='real' name='[Calculation_1738092290818823641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Model Avg Runtime (Period)&#13;&#10;// Mean of the daily average runtime over the window, in seconds. Needs avg_runtime_sec typed as Number.&#13;&#10;// 30d check: fct_sessions about 1,673 s (27.9 min) is the slowest.&#13;&#10;AVG(IF [Calculation_1409194560049525583] THEN [avg_runtime_sec] END)' />
            </column>
            <column caption='Model Runtime Label' datatype='string' name='[Calculation_2833830762735681804]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Model Runtime Label&#13;&#10;// Duration text for an aggregated runtime: &quot;45s&quot;, &quot;27.9 min&quot;, &quot;1.2 h&quot;.&#13;&#10;IF ISNULL([Calculation_1738092290818823641]) THEN &quot;-&quot;&#13;&#10;ELSEIF [Calculation_1738092290818823641] &lt; 60 THEN STR(ROUND([Calculation_1738092290818823641])) + &quot;s&quot;&#13;&#10;ELSEIF [Calculation_1738092290818823641] &lt; 3600 THEN STR(ROUND([Calculation_1738092290818823641] / 60, 1)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([Calculation_1738092290818823641] / 3600, 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='Model Build Cost (Period)' datatype='real' name='[Calculation_7302196470525049811]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Model Build Cost (Period)&#13;&#10;// What a model cost to build in the window, USD (the prototype&apos;s model cost; its queries are&#13;&#10;// counted against the data products that run them).&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [build_cost_usd] END)' />
            </column>
            <column caption='PF Divider Point' datatype='spatial' name='[Calculation_2933342989103045426]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Divider Point&#13;&#10;// The 1 px line under each row.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN -0.0950 WHEN 1 THEN -0.0950 WHEN 2 THEN -0.1050 ELSE -0.1050 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN ((0) - 365) / 100 WHEN 1 THEN ((730) - 365) / 100 WHEN 2 THEN ((730) - 365) / 100 ELSE ((0) - 365) / 100 END&#13;&#10;)' />
            </column>
            <column caption='PF Dot Key' datatype='string' name='[Calculation_1314999608325738461]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Dot Key&#13;&#10;// Platform dot colour on a table row.&#13;&#10;[platform_now]' />
            </column>
            <column caption='PF Dot Point' datatype='spatial' name='[Calculation_1453579625771048523]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Dot Point&#13;&#10;// Platform dot, 8 px, rounded.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 2 + 2 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((7) + (8) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((8) / 2 - 2) + 2 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 365) / 100&#13;&#10;)' />
            </column>
            <column caption='PF Pill State' datatype='string' name='[Calculation_2255261106894237473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Pill State&#13;&#10;// Incremental flag of a table row: Switched (green pill) or Open (amber pill).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_sessions&quot; THEN &quot;Switched&quot;&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_sessions&quot; THEN &quot;Switched&quot;&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_sessions&quot; THEN &quot;Switched&quot;&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_sessions&quot; THEN &quot;Switched&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='PF Pill Text' datatype='string' name='[Calculation_2337790847276450150]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// PF Pill Text&#13;&#10;// The pill&apos;s text.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_sessions&quot; THEN &quot;✓  Switched 4 Oct&quot;&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_sessions&quot; THEN &quot;✓  Switched 4 Oct&quot;&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_sessions&quot; THEN &quot;✓  Switched 4 Oct&quot;&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_sessions&quot; THEN &quot;✓  Switched 4 Oct&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='PF Pill Point' datatype='spatial' name='[Calculation_2070122717513895019]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Pill Point&#13;&#10;// Incremental flag pill, fully rounded, only on flagged rows.&#13;&#10;IF NOT ISNULL([Calculation_2255261106894237473]) THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 8 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((620) + (CASE [Calculation_2337790847276450150] WHEN &quot;✓  Switched 4 Oct&quot; THEN 95 ELSE 0 END) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((CASE [Calculation_2337790847276450150] WHEN &quot;✓  Switched 4 Oct&quot; THEN 95 ELSE 0 END) / 2 - 8) + 8 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 365) / 100&#13;&#10;) END' />
            </column>
            <column caption='PF Name Text' datatype='string' name='[Calculation_7913630229815592506]' role='dimension' type='nominal'>
