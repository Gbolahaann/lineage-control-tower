          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Axis Month Label' datatype='string' name='[Calculation_2935527346386522897]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Axis Month Label&#13;&#10;// &quot;1 Aug&quot;, &quot;1 Sep&quot;, &quot;1 Oct&quot; under the narrow MTTR chart (no &quot;22 Jul&quot;: it ran into &quot;1 Aug&quot;).&#13;&#10;IF DAY([date (dim_date.csv)]) = 1&#13;&#10;THEN &quot;1 &quot; + LEFT(DATENAME(&apos;month&apos;, [date (dim_date.csv)]), 3)&#13;&#10;END' />
            </column>
            <column caption='Axis Label Anchor MTTR' datatype='real' name='[Calculation_4501011842619422576]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Axis Label Anchor MTTR&#13;&#10;// Same, on the MTTR chart&apos;s 0 to 25 scale.&#13;&#10;IF NOT ISNULL(MIN([Calculation_2935527346386522897])) THEN 12.5 END' />
            </column>
            <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
            </column>
            <column caption='Date (Dates)' datatype='date' name='[date (dim_date.csv)]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_4501011842619422576]' derivation='User' name='[usr:Calculation_4501011842619422576:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2904210747288447847]' derivation='None' name='[none:Calculation_2904210747288447847:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2935527346386522897]' derivation='None' name='[none:Calculation_2935527346386522897:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
