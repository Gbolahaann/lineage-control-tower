      <column caption='GOV Domain Name Text' datatype='string' name='[Calculation_8849864886376184282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Name Text&#13;&#10;// Name texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;Commerce&quot;&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;15&quot;&#13;&#10;WHEN &quot;All|5&quot; THEN &quot;Customer&quot;&#13;&#10;WHEN &quot;All|6&quot; THEN &quot;9&quot;&#13;&#10;WHEN &quot;All|10&quot; THEN &quot;Finance&quot;&#13;&#10;WHEN &quot;All|11&quot; THEN &quot;14&quot;&#13;&#10;WHEN &quot;All|15&quot; THEN &quot;Marketing&quot;&#13;&#10;WHEN &quot;All|16&quot; THEN &quot;19&quot;&#13;&#10;WHEN &quot;All|20&quot; THEN &quot;Operations&quot;&#13;&#10;WHEN &quot;All|21&quot; THEN &quot;11&quot;&#13;&#10;WHEN &quot;All|25&quot; THEN &quot;Product&quot;&#13;&#10;WHEN &quot;All|26&quot; THEN &quot;14&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;Commerce&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;15&quot;&#13;&#10;WHEN &quot;snowflake|5&quot; THEN &quot;Customer&quot;&#13;&#10;WHEN &quot;snowflake|6&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;snowflake|10&quot; THEN &quot;Finance&quot;&#13;&#10;WHEN &quot;snowflake|11&quot; THEN &quot;14&quot;&#13;&#10;WHEN &quot;snowflake|15&quot; THEN &quot;Marketing&quot;&#13;&#10;WHEN &quot;snowflake|16&quot; THEN &quot;19&quot;&#13;&#10;WHEN &quot;snowflake|20&quot; THEN &quot;Operations&quot;&#13;&#10;WHEN &quot;snowflake|21&quot; THEN &quot;10&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Customer&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;8&quot;&#13;&#10;WHEN &quot;databricks|5&quot; THEN &quot;Operations&quot;&#13;&#10;WHEN &quot;databricks|6&quot; THEN &quot;1&quot;&#13;&#10;WHEN &quot;databricks|10&quot; THEN &quot;Product&quot;&#13;&#10;WHEN &quot;databricks|11&quot; THEN &quot;14&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;Marketing&quot;&#13;&#10;WHEN &quot;redshift|1&quot; THEN &quot;19&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Domain Name Point' datatype='spatial' name='[Calculation_3222109410968612924]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Name Point&#13;&#10;// Where each name text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.7600, -1.6102)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.7600, -0.5091)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(0.4600, -1.6397)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(0.4600, -0.4795)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(0.1600, -1.6810)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(0.1600, -0.5091)&#13;&#10;WHEN &quot;All|15&quot; THEN MAKEPOINT(-0.1400, -1.6368)&#13;&#10;WHEN &quot;All|16&quot; THEN MAKEPOINT(-0.1400, -0.5091)&#13;&#10;WHEN &quot;All|20&quot; THEN MAKEPOINT(-0.4400, -1.6102)&#13;&#10;WHEN &quot;All|21&quot; THEN MAKEPOINT(-0.4400, -0.5051)&#13;&#10;WHEN &quot;All|25&quot; THEN MAKEPOINT(-0.7400, -1.6869)&#13;&#10;WHEN &quot;All|26&quot; THEN MAKEPOINT(-0.7400, -0.5091)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.7600, -1.6102)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.7600, -0.5091)&#13;&#10;WHEN &quot;snowflake|5&quot; THEN MAKEPOINT(0.4600, -1.6397)&#13;&#10;WHEN &quot;snowflake|6&quot; THEN MAKEPOINT(0.4600, -0.4795)&#13;&#10;WHEN &quot;snowflake|10&quot; THEN MAKEPOINT(0.1600, -1.6810)&#13;&#10;WHEN &quot;snowflake|11&quot; THEN MAKEPOINT(0.1600, -0.5091)&#13;&#10;WHEN &quot;snowflake|15&quot; THEN MAKEPOINT(-0.1400, -1.6368)&#13;&#10;WHEN &quot;snowflake|16&quot; THEN MAKEPOINT(-0.1400, -0.5091)&#13;&#10;WHEN &quot;snowflake|20&quot; THEN MAKEPOINT(-0.4400, -1.6102)&#13;&#10;WHEN &quot;snowflake|21&quot; THEN MAKEPOINT(-0.4400, -0.5091)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.7600, -1.6397)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.7600, -0.4795)&#13;&#10;WHEN &quot;databricks|5&quot; THEN MAKEPOINT(0.4600, -1.6102)&#13;&#10;WHEN &quot;databricks|6&quot; THEN MAKEPOINT(0.4600, -0.4795)&#13;&#10;WHEN &quot;databricks|10&quot; THEN MAKEPOINT(0.1600, -1.6869)&#13;&#10;WHEN &quot;databricks|11&quot; THEN MAKEPOINT(0.1600, -0.5091)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(0.7600, -1.6368)&#13;&#10;WHEN &quot;redshift|1&quot; THEN MAKEPOINT(0.7600, -0.5091)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Domain Good Text' datatype='string' name='[Calculation_6382971933565184669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Good Text&#13;&#10;// Good texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|3&quot; THEN &quot;93%&quot;&#13;&#10;WHEN &quot;All|8&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;All|9&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;All|12&quot; THEN &quot;93%&quot;&#13;&#10;WHEN &quot;All|13&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;All|14&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|3&quot; THEN &quot;93%&quot;&#13;&#10;WHEN &quot;snowflake|7&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|8&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|9&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|12&quot; THEN &quot;93%&quot;&#13;&#10;WHEN &quot;snowflake|13&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|14&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|3&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|4&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|7&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|8&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|9&quot; THEN &quot;100%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
