    <worksheet name='HO Run Success KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Platform Match Day' datatype='boolean' name='[Calculation_1100032193373739257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Day&#13;&#10;// Day-level platform filter for Node Daily. Migrated models count against Redshift before&#13;&#10;// their move and Snowflake after, so daily KPIs and cost split correctly by platform.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Run Success - Focus' datatype='real' name='[Calculation_1734332201503898389]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Focus&#13;&#10;// Successful model runs / all model runs in the window. The mart&apos;s runs column already excludes skipped runs.&#13;&#10;// 30d check: 99.85%.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [runs] - [runs_failed] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [runs] END)' />
            </column>
            <column caption='In Prior Period' datatype='boolean' name='[Calculation_1036360725637968047]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Prior Period&#13;&#10;// TRUE for the same-length window just before the selected one.&#13;&#10;// Matches no rows at 90 days (the data starts 22 Jul), so every &quot;- Prior&quot; measure returns NULL there.&#13;&#10;[days_before_as_of] &gt;= [Parameters].[Parameter 1]&#13;&#10;AND [days_before_as_of] &lt; 2 * [Parameters].[Parameter 1]' />
            </column>
            <column caption='Run Success - Prior' datatype='real' name='[Calculation_2698166877041094131]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Prior&#13;&#10;// Same rate for the window before. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [runs] - [runs_failed] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [runs] END)' />
            </column>
            <column caption='Run Success - Change' datatype='real' name='[Calculation_3389207884386059757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Change&#13;&#10;// Rate metric, so the change is in percentage points. 30d check: +0.10 pp.&#13;&#10;([Calculation_1734332201503898389] - [Calculation_2698166877041094131]) * 100' />
            </column>
            <column caption='Run Success - Change Good' datatype='real' name='[Calculation_2508963726874360695]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Change Good&#13;&#10;// Green part of the change line. Higher is better, so a rise (or no change) lands here.&#13;&#10;// Format: ▲ 0.00 pp;▼ 0.00 pp;● 0 pp&#13;&#10;IF [Calculation_3389207884386059757] &gt;= 0 THEN [Calculation_3389207884386059757] END' />
            </column>
            <column caption='Run Success - Change Good Text' datatype='string' name='[Calculation_9292920473058013561]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Run Success - Change Good Text&#13;&#10;// Green part of the change line as text: &quot;▲ 0.10 pp&quot;, or &quot;● 0 pp&quot; when nothing changed.&#13;&#10;// Blank when the change is bad or there is no earlier period. Two decimals, as on the BAN.&#13;&#10;IF ISNULL([Calculation_2508963726874360695]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_2508963726874360695] = 0 THEN &quot;● 0 pp&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_2508963726874360695] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_2508963726874360695] * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
            </column>
            <column caption='Run Success - Change Bad' datatype='real' name='[Calculation_6587374685601982419]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Change Bad&#13;&#10;// Red part of the change line: a fall in run success. Same number format as Change Good.&#13;&#10;IF [Calculation_3389207884386059757] &lt; 0 THEN [Calculation_3389207884386059757] END' />
            </column>
            <column caption='Run Success - Change Bad Text' datatype='string' name='[Calculation_1409042108075507256]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Run Success - Change Bad Text&#13;&#10;// Red part of the change line as text: &quot;▼ 0.03 pp&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_6587374685601982419]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_6587374685601982419]) * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND(ABS([Calculation_6587374685601982419]) * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
            </column>
            <column caption='Has Prior Period' datatype='boolean' name='[Calculation_1497969784006078758]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Has Prior Period&#13;&#10;// FALSE at 90 days, when there is no earlier window in the data.&#13;&#10;// Drives the &quot;no earlier period&quot; wording. Measures don&apos;t need it: their Prior is NULL anyway.&#13;&#10;2 * [Parameters].[Parameter 1] &lt;= { MAX([day_index]) } + 1' />
            </column>
            <column caption='Compare Label' datatype='string' name='[Calculation_1953312242491521622]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Compare Label&#13;&#10;// Grey tail of every KPI change line: &quot;vs prior 30d&quot;, or &quot;-  no earlier period&quot; at 90 days.&#13;&#10;IF [Calculation_1497969784006078758]&#13;&#10;    THEN &quot;vs prior &quot; + STR([Parameters].[Parameter 1]) + &quot;d&quot;&#13;&#10;ELSE &quot;-  no earlier period&quot;&#13;&#10;END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Platform On Day' datatype='string' name='[platform_on_day]' role='dimension' type='nominal' />
            <column caption='Runs' datatype='real' name='[runs]' role='measure' type='quantitative' />
            <column caption='Runs Failed' datatype='real' name='[runs_failed]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1100032193373739257]' derivation='None' name='[none:Calculation_1100032193373739257:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1734332201503898389]' derivation='User' name='[usr:Calculation_1734332201503898389:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_9292920473058013561]' derivation='User' name='[usr:Calculation_9292920473058013561:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1409042108075507256]' derivation='User' name='[usr:Calculation_1409042108075507256:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1953312242491521622]' derivation='Attribute' name='[attr:Calculation_1953312242491521622:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_1100032193373739257:nk]'>
            <groupfilter function='member' level='[none:Calculation_1100032193373739257:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_1100032193373739257:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='tick-color' value='#00000000' />
          </style-rule>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_1734332201503898389:qk]' value='p0.00%' />
