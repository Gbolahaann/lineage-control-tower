    <worksheet name='GOV Declared KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is First Date Row' datatype='boolean' name='[Calculation_7201951502715406386]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is First Date Row&#13;&#10;// One-row scaffold (the first day) for the Gantt day buttons and label. Put on Filters (True).&#13;&#10;[day_index] = 0' />
            </column>
            <column caption='GOV Declared Text' datatype='string' name='[Calculation_7957814189299073219]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Declared Text&#13;&#10;// Declared consumers: readers in query history mapped to a declared exposure (written by the build).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN &quot;86%&quot;&#13;&#10;WHEN &quot;7|snowflake&quot; THEN &quot;82%&quot;&#13;&#10;WHEN &quot;7|databricks&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;7|redshift&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;30|All&quot; THEN &quot;86%&quot;&#13;&#10;WHEN &quot;30|snowflake&quot; THEN &quot;82%&quot;&#13;&#10;WHEN &quot;30|databricks&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;30|redshift&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;90|All&quot; THEN &quot;86%&quot;&#13;&#10;WHEN &quot;90|snowflake&quot; THEN &quot;82%&quot;&#13;&#10;WHEN &quot;90|databricks&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;90|redshift&quot; THEN &quot;67%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Declared Red Text' datatype='string' name='[Calculation_1585692426937760911]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// GOV Declared Red Text&#13;&#10;// &quot;3 readers in query history&quot;, red when any.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;7|snowflake&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;7|redshift&quot; THEN &quot;1 reader in query history&quot;&#13;&#10;WHEN &quot;30|All&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;30|snowflake&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;30|redshift&quot; THEN &quot;1 reader in query history&quot;&#13;&#10;WHEN &quot;90|All&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;90|snowflake&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;90|redshift&quot; THEN &quot;1 reader in query history&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='GOV Declared Plain Text' datatype='string' name='[Calculation_2381971374217504579]' role='measure' type='nominal'>
