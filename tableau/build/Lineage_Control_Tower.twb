        <calculation class='tableau' formula='// BR Risk Row Point&#13;&#10;// The row (takes the click; light blue when selected).&#13;&#10;MAKEPOINT(&#13;&#10;    (0.5 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 13 + 0 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    (((0) + (1256) / 2) + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((1256) / 2 - 0) + 0 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22))) - 628) / 100&#13;&#10;)' />
      </column>
