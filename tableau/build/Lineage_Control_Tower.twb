    <worksheet name='FR Incident Markers'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
          </datasources>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Freshness Incident Tick' datatype='real' name='[Calculation_1900265801119430050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Freshness Incident Tick&#13;&#10;// Tick under a freshness incident&apos;s label (INC 6, INC 8), on the 90 % to 100 % scale.&#13;&#10;IF COUNT(IF [category] = &quot;freshness&quot; THEN [incident_id] END) &gt; 0 THEN 0.942 END' />
            </column>
            <column caption='Freshness Incident Anchor' datatype='real' name='[Calculation_8827293827650527009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Freshness Incident Anchor&#13;&#10;// Point the label sits above.&#13;&#10;IF COUNT(IF [category] = &quot;freshness&quot; THEN [incident_id] END) &gt; 0 THEN 0.946 END' />
            </column>
            <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
            </column>
            <column caption='Incident Marker Label' datatype='string' name='[Calculation_1454750851671812728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Incident Marker Label&#13;&#10;// &quot;INC 4&quot; above the day an incident started, as in the prototype.&#13;&#10;REPLACE([incident_id], &quot;INC-00&quot;, &quot;INC &quot;)' />
            </column>
            <column caption='Freshness Incident Label' datatype='string' name='[Calculation_1226887036694265486]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Freshness Incident Label&#13;&#10;// &quot;INC 6&quot; over freshness incidents only (the prototype filters to them).&#13;&#10;IF [category] = &quot;freshness&quot; THEN [Calculation_1454750851671812728] END' />
            </column>
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Incident Id' datatype='string' name='[incident_id]' role='dimension' type='nominal' />
            <column caption='Title' datatype='string' name='[title]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1900265801119430050]' derivation='User' name='[usr:Calculation_1900265801119430050:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_8827293827650527009]' derivation='User' name='[usr:Calculation_8827293827650527009:qk]' pivot='key' type='quantitative' />
