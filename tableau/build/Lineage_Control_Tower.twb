        <calculation class='tableau' formula='// QA KF Bar Point&#13;&#10;// Weekday bar: height is the share of the test&apos;s busiest weekday (written by the build).&#13;&#10;IF [Calculation_2690238693341099106] &lt; 84 THEN&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + STR(INT([Calculation_9061342006016474767])) + &quot;|&quot; + STR(INT([Calculation_2690238693341099106] / 12) * 4 + INT(([Calculation_2690238693341099106] % 12) / 3))&#13;&#10;WHEN &quot;7|All|0|0&quot; THEN MAKEPOINT(-0.0900, 0.8000)&#13;&#10;WHEN &quot;7|All|0|1&quot; THEN MAKEPOINT(-0.0900, 0.8800)&#13;&#10;WHEN &quot;7|All|0|2&quot; THEN MAKEPOINT(-0.1100, 0.8800)&#13;&#10;WHEN &quot;7|All|0|3&quot; THEN MAKEPOINT(-0.1100, 0.8000)&#13;&#10;WHEN &quot;7|All|0|4&quot; THEN MAKEPOINT(-0.0900, 0.9400)&#13;&#10;WHEN &quot;7|All|0|5&quot; THEN MAKEPOINT(-0.0900, 1.0200)&#13;&#10;WHEN &quot;7|All|0|6&quot; THEN MAKEPOINT(-0.1100, 1.0200)&#13;&#10;WHEN &quot;7|All|0|7&quot; THEN MAKEPOINT(-0.1100, 0.9400)&#13;&#10;WHEN &quot;7|All|0|8&quot; THEN MAKEPOINT(-0.0900, 1.0800)&#13;&#10;WHEN &quot;7|All|0|9&quot; THEN MAKEPOINT(-0.0900, 1.1600)&#13;&#10;WHEN &quot;7|All|0|10&quot; THEN MAKEPOINT(-0.1100, 1.1600)&#13;&#10;WHEN &quot;7|All|0|11&quot; THEN MAKEPOINT(-0.1100, 1.0800)&#13;&#10;WHEN &quot;7|All|0|12&quot; THEN MAKEPOINT(-0.0900, 1.2200)&#13;&#10;WHEN &quot;7|All|0|13&quot; THEN MAKEPOINT(-0.0900, 1.3000)&#13;&#10;WHEN &quot;7|All|0|14&quot; THEN MAKEPOINT(-0.1100, 1.3000)&#13;&#10;WHEN &quot;7|All|0|15&quot; THEN MAKEPOINT(-0.1100, 1.2200)&#13;&#10;WHEN &quot;7|All|0|16&quot; THEN MAKEPOINT(-0.0300, 1.3600)&#13;&#10;WHEN &quot;7|All|0|17&quot; THEN MAKEPOINT(-0.0300, 1.4400)&#13;&#10;WHEN &quot;7|All|0|18&quot; THEN MAKEPOINT(-0.1100, 1.4400)&#13;&#10;WHEN &quot;7|All|0|19&quot; THEN MAKEPOINT(-0.1100, 1.3600)&#13;&#10;WHEN &quot;7|All|0|20&quot; THEN MAKEPOINT(-0.0900, 1.5000)&#13;&#10;WHEN &quot;7|All|0|21&quot; THEN MAKEPOINT(-0.09