      <column caption='QA Cover Track Point' datatype='spatial' name='[Calculation_2777561286574312139]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA Cover Track Point&#13;&#10;// The light grey track under each bar (written by the build).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.6300, 1.9100)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.5900, 1.9100)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(0.3600, -1.9100)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(0.3600, 1.9100)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(0.3200, 1.9100)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(0.3200, -1.9100)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(0.0900, -1.9100)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(0.0900, 1.9100)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(0.0500, 1.9100)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(0.0500, -1.9100)&#13;&#10;WHEN &quot;All|12&quot; THEN MAKEPOINT(-0.1800, -1.9100)&#13;&#10;WHEN &quot;All|13&quot; THEN MAKEPOINT(-0.1800, 1.9100)&#13;&#10;WHEN &quot;All|14&quot; THEN MAKEPOINT(-0.2200, 1.9100)&#13;&#10;WHEN &quot;All|15&quot; THEN MAKEPOINT(-0.2200, -1.9100)&#13;&#10;WHEN &quot;All|16&quot; THEN MAKEPOINT(-0.4500, -1.9100)&#13;&#10;WHEN &quot;All|17&quot; THEN MAKEPOINT(-0.4500, 1.9100)&#13;&#10;WHEN &quot;All|18&quot; THEN MAKEPOINT(-0.4900, 1.9100)&#13;&#10;WHEN &quot;All|19&quot; THEN MAKEPOINT(-0.4900, -1.9100)&#13;&#10;WHEN &quot;All|20&quot; THEN MAKEPOINT(-0.7200, -1.9100)&#13;&#10;WHEN &quot;All|21&quot; THEN MAKEPOINT(-0.7200, 1.9100)&#13;&#10;WHEN &quot;All|22&quot; THEN MAKEPOINT(-0.7600, 1.9100)&#13;&#10;WHEN &quot;All|23&quot; THEN MAKEPOINT(-0.7600, -1.9100)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.6300, 1.9100)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.5900, 1.9100)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(0.3600, -1.9100)&#13;&#10;WHEN &quot;snowflake|5&quot; THEN MAKEPOINT(0.3600, 1.9100)&#13;&#10;WHEN &quot;snowflake|6&quot; THEN MAKEPOINT(0.3200, 1.9100)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(0.3200, -1.9100)&#13;&#10;WHEN &quot;snowflake|8&quot; THEN MAKEPOINT(0.0900, -1.9100)&#13;&#10;WHEN &quot;snowflake|9&quot; THEN MAKEPOINT(0.0900, 1.9100)&#13;&#10;WHEN &quot;snowflake|10&quot; THEN MAKEPOINT(0.0500, 1.9100)&#13;&#10;WHEN &quot;snowflake|11&quot; THEN MAKEPOINT(0.0500, -1.9100)&#13;&#10;WHEN &quot;snowflake|12&quot; THEN MAKEPOINT(-0.1800, -1.9100)&#13;&#10;WHEN &quot;snowflake|13&quot; THEN MAKEPOINT(-0.1800, 1.9100)&#13;&#10;WHEN &quot;snowflake|14&quot; THEN MAKEPOINT(-0.2200, 1.9100)&#13;&#10;WHEN &quot;snowflake|15&quot; THEN MAKEPOINT(-0.2200, -1.9100)&#13;&#10;WHEN &quot;snowflake|16&quot; THEN MAKEPOINT(-0.4500, -1.9100)&#13;&#10;WHEN &quot;snowflake|17&quot; THEN MAKEPOINT(-0.4500, 1.9100)&#13;&#10;WHEN &quot;snowflake|18&quot; THEN MAKEPOINT(-0.4900, 1.9100)&#13;&#10;WHEN &quot;snowflake|19&quot; THEN MAKEPOINT(-0.4900, -1.9100)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.6300, 1.9100)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(0.5900, 1.9100)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;WHEN &quot;databricks|4&quot; THEN MAKEPOINT(0.3600, -1.9100)&#13;&#10;WHEN &quot;databricks|5&quot; THEN MAKEPOINT(0.3600, 1.9100)&#13;&#10;WHEN &quot;databricks|6&quot; THEN MAKEPOINT(0.3200, 1.9100)&#13;&#10;WHEN &quot;databricks|7&quot; THEN MAKEPOINT(0.3200, -1.9100)&#13;&#10;WHEN &quot;databricks|8&quot; THEN MAKEPOINT(0.0900, -1.9100)&#13;&#10;WHEN &quot;databricks|9&quot; THEN MAKEPOINT(0.0900, 1.9100)&#13;&#10;WHEN &quot;databricks|10&quot; THEN MAKEPOINT(0.0500, 1.9100)&#13;&#10;WHEN &quot;databricks|11&quot; THEN MAKEPOINT(0.0500, -1.9100)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;redshift|1&quot; THEN MAKEPOINT(0.6300, 1.9100)&#13;&#10;WHEN &quot;redshift|2&quot; THEN MAKEPOINT(0.5900, 1.9100)&#13;&#10;WHEN &quot;redshift|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='QA Cover Shape Id' datatype='integer' name='[Calculation_1753492543894047313]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// QA Cover Shape Id&#13;&#10;// Which bar a date row draws (4 rows each).&#13;&#10;INT([day_index] / 4)' />
      </column>
      <column caption='QA Cover Bar Point' datatype='spatial' name='[Calculation_3185445295141628750]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA Cover Bar Point&#13;&#10;// The bar, accent blue, as long as its share of the longest.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.6300, 0.5457)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.5900, 0.5457)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(0.3600, -1.9100)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(0.3600, 0.8682)&#13;&#10;WHEN &quot;All|6&quot; THEN MAKEPOINT(0.3200, 0.8682)&#13;&#10;WHEN &quot;All|7&quot; THEN MAKEPOINT(0.3200, -1.9100)&#13;&#10;WHEN &quot;All|8&quot; THEN MAKEPOINT(0.0900, -1.9100)&#13;&#10;WHEN &quot;All|9&quot; THEN MAKEPOINT(0.0900, 0.9047)&#13;&#10;WHEN &quot;All|10&quot; THEN MAKEPOINT(0.0500, 0.9047)&#13;&#10;WHEN &quot;All|11&quot; THEN MAKEPOINT(0.0500, -1.9100)&#13;&#10;WHEN &quot;All|12&quot; THEN MAKEPOINT(-0.1800, -1.9100)&#13;&#10;WHEN &quot;All|13&quot; THEN MAKEPOINT(-0.1800, 1.6553)&#13;&#10;WHEN &quot;All|14&quot; THEN MAKEPOINT(-0.2200, 1.6553)&#13;&#10;WHEN &quot;All|15&quot; THEN MAKEPOINT(-0.2200, -1.9100)&#13;&#10;WHEN &quot;All|16&quot; THEN MAKEPOINT(-0.4500, -1.9100)&#13;&#10;WHEN &quot;All|17&quot; THEN MAKEPOINT(-0.4500, 1.9100)&#13;&#10;WHEN &quot;All|18&quot; THEN MAKEPOINT(-0.4900, 1.9100)&#13;&#10;WHEN &quot;All|19&quot; THEN MAKEPOINT(-0.4900, -1.9100)&#13;&#10;WHEN &quot;All|20&quot; THEN MAKEPOINT(-0.7200, -1.9100)&#13;&#10;WHEN &quot;All|21&quot; THEN MAKEPOINT(-0.7200, 1.9100)&#13;&#10;WHEN &quot;All|22&quot; THEN MAKEPOINT(-0.7600, 1.9100)&#13;&#10;WHEN &quot;All|23&quot; THEN MAKEPOINT(-0.7600, -1.9100)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.6300, 0.7640)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.5900, 0.7640)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(0.3600, -1.9100)&#13;&#10;WHEN &quot;snowflake|5&quot; THEN MAKEPOINT(0.3600, 0.9047)&#13;&#10;WHEN &quot;snowflake|6&quot; THEN MAKEPOINT(0.3200, 0.9047)&#13;&#10;WHEN &quot;snowflake|7&quot; THEN MAKEPOINT(0.3200, -1.9100)&#13;&#10;WHEN &quot;snowflake|8&quot; THEN MAKEPOINT(0.0900, -1.9100)&#13;&#10;WHEN &quot;snowflake|9&quot; THEN MAKEPOINT(0.0900, 1.6553)&#13;&#10;WHEN &quot;snowflake|10&quot; THEN MAKEPOINT(0.0500, 1.6553)&#13;&#10;WHEN &quot;snowflake|11&quot; THEN MAKEPOINT(0.0500, -1.9100)&#13;&#10;WHEN &quot;snowflake|12&quot; THEN MAKEPOINT(-0.1800, -1.9100)&#13;&#10;WHEN &quot;snowflake|13&quot; THEN MAKEPOINT(-0.1800, 1.9100)&#13;&#10;WHEN &quot;snowflake|14&quot; THEN MAKEPOINT(-0.2200, 1.9100)&#13;&#10;WHEN &quot;snowflake|15&quot; THEN MAKEPOINT(-0.2200, -1.9100)&#13;&#10;WHEN &quot;snowflake|16&quot; THEN MAKEPOINT(-0.4500, -1.9100)&#13;&#10;WHEN &quot;snowflake|17&quot; THEN MAKEPOINT(-0.4500, 1.9100)&#13;&#10;WHEN &quot;snowflake|18&quot; THEN MAKEPOINT(-0.4900, 1.9100)&#13;&#10;WHEN &quot;snowflake|19&quot; THEN MAKEPOINT(-0.4900, -1.9100)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.6300, 0.5457)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(0.5900, 0.5457)&#13;&#10;WHEN &quot;databricks|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;WHEN &quot;databricks|4&quot; THEN MAKEPOINT(0.3600, -1.9100)&#13;&#10;WHEN &quot;databricks|5&quot; THEN MAKEPOINT(0.3600, 1.9100)&#13;&#10;WHEN &quot;databricks|6&quot; THEN MAKEPOINT(0.3200, 1.9100)&#13;&#10;WHEN &quot;databricks|7&quot; THEN MAKEPOINT(0.3200, -1.9100)&#13;&#10;WHEN &quot;databricks|8&quot; THEN MAKEPOINT(0.0900, -1.9100)&#13;&#10;WHEN &quot;databricks|9&quot; THEN MAKEPOINT(0.0900, 1.9100)&#13;&#10;WHEN &quot;databricks|10&quot; THEN MAKEPOINT(0.0500, 1.9100)&#13;&#10;WHEN &quot;databricks|11&quot; THEN MAKEPOINT(0.0500, -1.9100)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(0.6300, -1.9100)&#13;&#10;WHEN &quot;redshift|1&quot; THEN MAKEPOINT(0.6300, 0.9047)&#13;&#10;WHEN &quot;redshift|2&quot; THEN MAKEPOINT(0.5900, 0.9047)&#13;&#10;WHEN &quot;redshift|3&quot; THEN MAKEPOINT(0.5900, -1.9100)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='QA Cover Label Text' datatype='string' name='[Calculation_5654626170845548214]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// QA Cover Label Text&#13;&#10;// Row name, left.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;Product&quot;&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;Operations&quot;&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;Marketing&quot;&#13;&#10;WHEN &quot;All|3&quot; THEN &quot;Commerce&quot;&#13;&#10;WHEN &quot;All|4&quot; THEN &quot;Customer&quot;&#13;&#10;WHEN &quot;All|5&quot; THEN &quot;Finance&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;Operations&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;Marketing&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;Commerce&quot;&#13;&#10;WHEN &quot;snowflake|3&quot; THEN &quot;Customer&quot;&#13;&#10;WHEN &quot;snowflake|4&quot; THEN &quot;Finance&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;Product&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;Customer&quot;&#13;&#10;WHEN &quot;databricks|2&quot; THEN &quot;Operations&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;Marketing&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='QA Cover Label Point' datatype='spatial' name='[Calculation_3172411778549717140]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA Cover Label Point&#13;&#10;// Where the name sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.7200, -1.7269)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.4500, -1.6502)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.1800, -1.6768)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(-0.0900, -1.6502)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(-0.3600, -1.6797)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(-0.6300, -1.7210)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.7200, -1.6502)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.4500, -1.6768)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.1800, -1.6502)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(-0.0900, -1.6797)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(-0.3600, -1.7210)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.7200, -1.7269)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.4500, -1.6797)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(0.1800, -1.6502)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(0.7200, -1.6768)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='QA Cover Value Text' datatype='string' name='[Calculation_2275269004286071011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// QA Cover Value Text&#13;&#10;// Row value, right, bold.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN &quot;64%&quot;&#13;&#10;WHEN &quot;All|1&quot; THEN &quot;73%&quot;&#13;&#10;WHEN &quot;All|2&quot; THEN &quot;74%&quot;&#13;&#10;WHEN &quot;All|3&quot; THEN &quot;93%&quot;&#13;&#10;WHEN &quot;All|4&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;All|5&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|0&quot; THEN &quot;70%&quot;&#13;&#10;WHEN &quot;snowflake|1&quot; THEN &quot;74%&quot;&#13;&#10;WHEN &quot;snowflake|2&quot; THEN &quot;93%&quot;&#13;&#10;WHEN &quot;snowflake|3&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;snowflake|4&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|0&quot; THEN &quot;64%&quot;&#13;&#10;WHEN &quot;databricks|1&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;databricks|2&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;redshift|0&quot; THEN &quot;74%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='QA Cover Value Point' datatype='spatial' name='[Calculation_2498021797292228821]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// QA Cover Value Point&#13;&#10;// Where the value sits (right-aligned, measured).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|0&quot; THEN MAKEPOINT(0.7200, 1.8037)&#13;&#10;WHEN &quot;All|1&quot; THEN MAKEPOINT(0.4500, 1.8037)&#13;&#10;WHEN &quot;All|2&quot; THEN MAKEPOINT(0.1800, 1.8037)&#13;&#10;WHEN &quot;All|3&quot; THEN MAKEPOINT(-0.0900, 1.8037)&#13;&#10;WHEN &quot;All|4&quot; THEN MAKEPOINT(-0.3600, 1.7741)&#13;&#10;WHEN &quot;All|5&quot; THEN MAKEPOINT(-0.6300, 1.7741)&#13;&#10;WHEN &quot;snowflake|0&quot; THEN MAKEPOINT(0.7200, 1.8037)&#13;&#10;WHEN &quot;snowflake|1&quot; THEN MAKEPOINT(0.4500, 1.8037)&#13;&#10;WHEN &quot;snowflake|2&quot; THEN MAKEPOINT(0.1800, 1.8037)&#13;&#10;WHEN &quot;snowflake|3&quot; THEN MAKEPOINT(-0.0900, 1.7741)&#13;&#10;WHEN &quot;snowflake|4&quot; THEN MAKEPOINT(-0.3600, 1.7741)&#13;&#10;WHEN &quot;databricks|0&quot; THEN MAKEPOINT(0.7200, 1.8037)&#13;&#10;WHEN &quot;databricks|1&quot; THEN MAKEPOINT(0.4500, 1.7741)&#13;&#10;WHEN &quot;databricks|2&quot; THEN MAKEPOINT(0.1800, 1.7741)&#13;&#10;WHEN &quot;redshift|0&quot; THEN MAKEPOINT(0.7200, 1.8037)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='BR Lead Text' datatype='string' name='[Calculation_2946862680029621195]' role='dimension' type='nominal'>
