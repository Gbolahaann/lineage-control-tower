      <column caption='Lineage Label Point' datatype='spatial' name='[Calculation_2283752602737777214]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Lineage Label Point&#13;&#10;// Middle of a box name: 16 px in from the box edge plus half the name&apos;s width.&#13;&#10;IF [row_type] = &quot;node&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([y]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END))) / 100,&#13;&#10;    (((8 + ([x]) * 151.833) + 16 + [Calculation_8207042615384186710] / 2) - 463.5) / 100&#13;&#10;) END' />
      </column>
      <column caption='Lineage View Option' datatype='string' name='[Calculation_3302216381930638508]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Lineage View Option&#13;&#10;// Scaffold for the Graph / Table buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;Graph&quot;&#13;&#10;WHEN 1 THEN &quot;Table&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Lineage View Button Row' datatype='boolean' name='[Calculation_3292968341389723114]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Lineage View Button Row&#13;&#10;// Keeps the 2 scaffold rows that carry the Graph / Table buttons. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_3302216381930638508])' />
      </column>
      <column caption='Is Active Lineage View' datatype='boolean' name='[Calculation_9814064880122529524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Lineage View&#13;&#10;// Colours the selected view button.&#13;&#10;[Calculation_3302216381930638508] = [Parameters].[Parameter 9]' />
      </column>
      <column caption='Lineage View Label Active' datatype='string' name='[Calculation_3232177490506046766]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Lineage View Label Active&#13;&#10;// Button text when this view is selected (Semibold Navy run).&#13;&#10;IF [Calculation_9814064880122529524] THEN [Calculation_3302216381930638508] ELSE &quot;&quot; END' />
      </column>
      <column caption='Lineage View Label Inactive' datatype='string' name='[Calculation_1799819424796331404]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Lineage View Label Inactive&#13;&#10;// Button text when this view is not selected.&#13;&#10;IF NOT [Calculation_9814064880122529524] THEN [Calculation_3302216381930638508] ELSE &quot;&quot; END' />
      </column>
      <column caption='Selected Exposure Trust' datatype='string' name='[Calculation_1225523636867582318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Selected Exposure Trust&#13;&#10;// Trust badge of the selected exposure, for the pill beside the picker (dynamic zone visibility).&#13;&#10;{ MAX(IF [node_id (dim_nodes.csv)] = [Parameters].[Parameter 3] THEN [trust_badge] END) }' />
      </column>
      <column caption='Trust Pill Key' datatype='string' name='[Calculation_9889241079384188661]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Trust Pill Key&#13;&#10;// Fill of the trust pill beside the picker (palette by trust badge).&#13;&#10;[Calculation_1225523636867582318]' />
      </column>
      <column caption='Trust Pill Point' datatype='spatial' name='[Calculation_5092009918452207885]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Trust Pill Point&#13;&#10;// The trust pill beside the picker, drawn from the exposure&apos;s incoming edge rows.&#13;&#10;IF [row_type] = &quot;edge&quot; AND [child_node_id] = [layout_scope] THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (0) + 9 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((0) + (CASE [Calculation_1225523636867582318] WHEN &quot;Do not use&quot; THEN 80 WHEN &quot;Use with caution&quot; THEN 108 WHEN &quot;Trusted&quot; THEN 66 ELSE 0 END)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((CASE [Calculation_1225523636867582318] WHEN &quot;Do not use&quot; THEN 80 WHEN &quot;Use with caution&quot; THEN 108 WHEN &quot;Trusted&quot; THEN 66 ELSE 0 END) - (0)) / 2 - 9) + 9 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 66) / 100&#13;&#10;) END' />
      </column>
      <column caption='Trust Pill Critical' datatype='string' name='[Calculation_2921126871268436128]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Trust Pill Critical&#13;&#10;// Trust pill text, red.&#13;&#10;IF [Calculation_1225523636867582318] = &quot;Do not use&quot; THEN &quot;✕  Do not use&quot; END' />
      </column>
      <column caption='Trust Pill Warning' datatype='string' name='[Calculation_1410966149898586808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Trust Pill Warning&#13;&#10;// Trust pill text, amber ink.&#13;&#10;IF [Calculation_1225523636867582318] = &quot;Use with caution&quot; THEN &quot;▲  Use with caution&quot; END' />
      </column>
      <column caption='Trust Pill Healthy' datatype='string' name='[Calculation_2202975793804500138]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Trust Pill Healthy&#13;&#10;// Trust pill text, green.&#13;&#10;IF [Calculation_1225523636867582318] = &quot;Trusted&quot; THEN &quot;✓  Trusted&quot; END' />
      </column>
      <column caption='Trust Pill Text Point' datatype='spatial' name='[Calculation_1682128909242140249]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Trust Pill Text Point&#13;&#10;// Middle of the trust pill.&#13;&#10;MAKEPOINT(0, ((CASE [Calculation_1225523636867582318] WHEN &quot;Do not use&quot; THEN 80 WHEN &quot;Use with caution&quot; THEN 108 WHEN &quot;Trusted&quot; THEN 66 ELSE 0 END) / 2 - 66) / 100)' />
      </column>
      <column caption='Table Heading Bucket' datatype='integer' name='[Calculation_2977506763130055823]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Table Heading Bucket&#13;&#10;// Column title number 1 to 9, from the edge rows&apos; point_order.&#13;&#10;IF [row_type] = &quot;edge&quot; AND INT([point_order]) &lt;= 9 THEN INT([point_order]) END' />
      </column>
      <column caption='Table Heading' datatype='string' name='[Calculation_1902596015588322944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Heading&#13;&#10;// Column title of the lineage table.&#13;&#10;CASE [Calculation_2977506763130055823]&#13;&#10;WHEN 1 THEN &quot;NODE&quot;&#13;&#10;WHEN 2 THEN &quot;LAYER&quot;&#13;&#10;WHEN 3 THEN &quot;PLATFORM&quot;&#13;&#10;WHEN 4 THEN &quot;STATUS&quot;&#13;&#10;WHEN 5 THEN &quot;HOPS&quot;&#13;&#10;WHEN 6 THEN &quot;LAST RUN OR CHECK&quot;&#13;&#10;WHEN 7 THEN &quot;RUNTIME&quot;&#13;&#10;WHEN 8 THEN &quot;TESTS&quot;&#13;&#10;WHEN 9 THEN &quot;OWNER&quot;&#13;&#10;END' />
      </column>
      <column caption='Table Heading Point' datatype='spatial' name='[Calculation_2046072740054445396]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Heading Point&#13;&#10;// Middle of a column title.&#13;&#10;IF NOT ISNULL([Calculation_2977506763130055823]) THEN MAKEPOINT(0, ((CASE [Calculation_2977506763130055823] WHEN 1 THEN 21.5 WHEN 2 THEN 214.5 WHEN 3 THEN 332.7 WHEN 4 THEN 419.1 WHEN 5 THEN 506.7 WHEN 6 THEN 586.0 WHEN 7 THEN 704.6 WHEN 8 THEN 794.9 WHEN 9 THEN 844.0 END) - 454.5) / 100) END' />
      </column>
      <column caption='Status Severity Sort' datatype='integer' name='[Calculation_1180711795357289733]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Status Severity Sort&#13;&#10;// Worst first, for lists: Critical 1, Warning 2, Healthy 3, No data 4.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN 1&#13;&#10;WHEN 2 THEN 2&#13;&#10;WHEN 1 THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='Is Table Row' datatype='boolean' name='[Calculation_2337355820833703565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Table Row&#13;&#10;// Every upstream node of the graph (the exposure itself is the graph&apos;s end, not a row).&#13;&#10;[node_id (mart_lineage_layout.csv)] &lt;&gt; [layout_scope]' />
      </column>
      <column caption='Table Row Key' datatype='string' name='[Calculation_3315487402959781063]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Row Key&#13;&#10;// Highlights the selected node&apos;s row (light accent), as in the prototype.&#13;&#10;IF [Calculation_2543776221048440310] THEN &quot;Selected&quot; ELSE &quot;Default&quot; END' />
      </column>
      <column caption='Table Band Point' datatype='spatial' name='[Calculation_2585830235018675183]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Band Point&#13;&#10;// Row background: light accent for the selected node, otherwise white.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0.5 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (13.5) + 0 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((0) + (909)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((909) - (0)) / 2 - 0) + 0 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
      </column>
      <column caption='Table Divider Point' datatype='spatial' name='[Calculation_6679340540544191662]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Divider Point&#13;&#10;// The 1 px line under each row.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (-13.5 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (0.5) + 0 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((0) + (909)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((909) - (0)) / 2 - 0) + 0 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
      </column>
      <column caption='Table Platform Border Point' datatype='spatial' name='[Calculation_1035548184703788120]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Platform Border Point&#13;&#10;// Platform pill outline (light grey, radius 4).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (5) + 4 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((307) + (307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END) - (307)) / 2 - 4) + 4 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
      </column>
      <column caption='Table Platform Fill Point' datatype='spatial' name='[Calculation_1433063006639321125]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Platform Fill Point&#13;&#10;// Platform pill fill.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (5) + 3 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((308) + (307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END - 1)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((307 + CASE [Calculation_1641578937180273009] WHEN &quot;Snowflake&quot; THEN 65 WHEN &quot;Databricks&quot; THEN 66 WHEN &quot;Redshift&quot; THEN 56 ELSE 0 END - 1) - (308)) / 2 - 3) + 3 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
      </column>
      <column caption='Table Status Key' datatype='string' name='[Calculation_1304299416300619645]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Table Status Key&#13;&#10;// Status pill fill (status tint).&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Table Status Pill Point' datatype='spatial' name='[Calculation_4072656251478419518]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Table Status Pill Point&#13;&#10;// Status pill (tinted, fully rounded).&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (0 + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (0) + 9 * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    (((401) + (401 + CASE [Calculation_3105941082857465865] WHEN &quot;Critical&quot; THEN 57 WHEN &quot;Warning&quot; THEN 65 WHEN &quot;Healthy&quot; THEN 59 WHEN &quot;No data&quot; THEN 58 ELSE 0 END)) / 2 + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * (((401 + CASE [Calculation_3105941082857465865] WHEN &quot;Critical&quot; THEN 57 WHEN &quot;Warning&quot; THEN 65 WHEN &quot;Healthy&quot; THEN 59 WHEN &quot;No data&quot; THEN 58 ELSE 0 END) - (401)) / 2 - 9) + 9 * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 454.5) / 100&#13;&#10;) END' />
      </column>
