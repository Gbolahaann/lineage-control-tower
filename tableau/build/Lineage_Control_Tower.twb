                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
            </column>
            <column caption='Node Count' datatype='integer' name='[Calculation_2446133016301952044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Node Count&#13;&#10;// Number of nodes in the view. dim_nodes has one row per node.&#13;&#10;COUNTD([node_id (dim_nodes.csv)])' />
            </column>
            <column caption='Layer Share' datatype='real' name='[Calculation_9282765132542256788]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Layer Share&#13;&#10;// Each status&apos;s share of the layer, so every bar spans the full width.&#13;&#10;// Table calc: compute using Status Label (along the bar).&#13;&#10;[Calculation_2446133016301952044] / TOTAL([Calculation_2446133016301952044])'>
                <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2496845894520933783]' ordering-type='Field' />
              </calculation>
            </column>
            <column caption='Layer Label Position' datatype='real' name='[Calculation_2008892738692294245]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Layer Label Position&#13;&#10;// Where the &quot;1 / 27&quot; count starts: just past the end of the full bar (axis fixed 0 to 1.3).&#13;&#10;// The label sits to the right of this hairline Gantt mark.&#13;&#10;MIN(1.02)' />
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Status Stack Order' datatype='integer' name='[Calculation_2946817898410042583]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Status Stack Order&#13;&#10;// Healthy first, for stacked bars, as in the prototype&apos;s layer health strip: Healthy, Warning, Critical, No data.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 1 THEN 1&#13;&#10;WHEN 2 THEN 2&#13;&#10;WHEN 3 THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
            </column>
            <column caption='Layer Stack Key' datatype='integer' name='[Calculation_2496845894520933783]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Layer Stack Key&#13;&#10;// Stack order for the layer bar, left to right: Healthy, Warning, Critical, No data.&#13;&#10;// Tableau stacks the highest value first, so Healthy gets the highest key.&#13;&#10;5 - [Calculation_2946817898410042583]' />
            </column>
            <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
            </column>
            <column caption='Layer Total' datatype='integer' name='[Calculation_3311281824631653486]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Layer Total&#13;&#10;// Nodes in the layer for the selected platform. FIXED with the platform rule inside, so no context filter is needed.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] THEN 1 END) }' />
            </column>
            <column caption='Layer Total Text' datatype='string' name='[Calculation_1760329556827391948]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Total Text&#13;&#10;// The layer total, in grey after the issue count: &quot;1 / 30&quot; or just &quot;21&quot;.&#13;&#10;STR([Calculation_3311281824631653486])' />
            </column>
            <column caption='Layer Has Critical' datatype='boolean' name='[Calculation_4191687787979507265]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Has Critical&#13;&#10;// TRUE when any node in the layer is Critical, so the issue count shows in red rather than amber.&#13;&#10;{ FIXED [layer] : MAX(IF [Calculation_2214252331607255986] AND [current_status_code] = 3 THEN 1 ELSE 0 END) } = 1' />
            </column>
            <column caption='Is At Risk Now' datatype='boolean' name='[Calculation_2875175252813195699]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is At Risk Now&#13;&#10;// Warning or Critical in the current snapshot. Shared by Health, Blast radius and Governance.&#13;&#10;[current_status_code] &gt;= 2' />
            </column>
            <column caption='Layer Issues' datatype='integer' name='[Calculation_1394288337659403442]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Layer Issues&#13;&#10;// Nodes in the layer that are Warning or Critical right now, for the selected platform.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] AND [Calculation_2875175252813195699] THEN 1 ELSE 0 END) }' />
            </column>
            <column caption='Layer Issues Critical Text' datatype='string' name='[Calculation_2393800399496740184]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Issues Critical Text&#13;&#10;// &quot;1 / &quot; in red, shown when the layer has a Critical node.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Layer Issues Warning Text' datatype='string' name='[Calculation_3164047678432910206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Layer Issues Warning Text&#13;&#10;// &quot;1 / &quot; in amber ink #93600F, when the layer has issues but none Critical.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND NOT [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
            </column>
            <column caption='Current Status Code' datatype='integer' name='[current_status_code]' role='dimension' type='ordinal' />
            <column caption='Layer' datatype='string' name='[layer]' role='dimension' type='nominal' />
            <column caption='Layer Column' datatype='integer' name='[layer_column]' role='dimension' type='ordinal' />
            <column caption='Node Id (Nodes)' datatype='string' name='[node_id (dim_nodes.csv)]' role='dimension' type='nominal' />
