            <column caption='Tile View Option' datatype='string' name='[Calculation_2894482038928477351]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile View Option&#13;&#10;// Scaffold for the All / Needs attention buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;Needs attention&quot;&#13;&#10;END' />
            </column>
            <column caption='Is Tile View Button Row' datatype='boolean' name='[Calculation_2058479208791343830]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Tile View Button Row&#13;&#10;// Keeps the 2 scaffold rows that carry the All / Needs attention buttons. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_2894482038928477351])' />
            </column>
            <column caption='Is Active Tile View' datatype='boolean' name='[Calculation_1284089094536110577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Active Tile View&#13;&#10;// Colours the selected tile-view button.&#13;&#10;[Calculation_2894482038928477351] = [Parameters].[Parameter 8]' />
            </column>
            <column caption='Tile View Label Active' datatype='string' name='[Calculation_1838581371832391049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile View Label Active&#13;&#10;// Button text when this tile view is selected (Semibold Navy run).&#13;&#10;IF [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile View Label Inactive' datatype='string' name='[Calculation_3133453958818750804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile View Label Inactive&#13;&#10;// Button text when this tile view is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
