    <worksheet name='PF Slowest Model KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Model' datatype='boolean' name='[Calculation_1221533192259849042]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Model&#13;&#10;// Keeps dbt models.&#13;&#10;[resource_type] = &quot;model&quot;' />
            </column>
            <column caption='PF Slowest Rank' datatype='integer' name='[Calculation_1209399367078413203]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// PF Slowest Rank&#13;&#10;// Place of a model among the six slowest (mean of its daily average successful run in the&#13;&#10;// period), under the platform filter. Written by the build.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|All|model.acme_product.int_sessions__stitched&quot; THEN 1&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_sessions&quot; THEN 2&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;7|All|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;7|All|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;7|snowflake|model.acme_marketing.fct_attribution&quot; THEN 2&#13;&#10;WHEN &quot;7|snowflake|model.acme_marketing.int_ads__attribution&quot; THEN 3&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_finance_close&quot; THEN 4&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_gl__mapped&quot; THEN 5&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_order_items&quot; THEN 6&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_sessions__stitched&quot; THEN 1&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_sessions&quot; THEN 2&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;7|databricks|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;30|All|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;30|All|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;30|All|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;30|snowflake|model.acme_marketing.fct_attribution&quot; THEN 2&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_finance_close&quot; THEN 3&#13;&#10;WHEN &quot;30|snowflake|model.acme_marketing.int_ads__attribution&quot; THEN 4&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_gl__mapped&quot; THEN 5&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_order_items&quot; THEN 6&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;30|databricks|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;90|All|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;90|All|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;90|All|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;90|All|model.acme_marketing.fct_attribution&quot; THEN 6&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.dim_customer_360&quot; THEN 2&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.int_ads__attribution&quot; THEN 3&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.fct_finance_close&quot; THEN 4&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.int_ads__unified&quot; THEN 5&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.int_gl__mapped&quot; THEN 6&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_churn_features&quot; THEN 3&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_demand_signals&quot; THEN 5&#13;&#10;WHEN &quot;90|databricks|model.acme_product.dim_customer_behavior&quot; THEN 6&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Is PF Slowest Model' datatype='boolean' name='[Calculation_4911841298322152364]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is PF Slowest Model&#13;&#10;// The slowest model, for the KPI. Put on Filters (True).&#13;&#10;[Calculation_1209399367078413203] = 1' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Model Avg Runtime (Period)' datatype='real' name='[Calculation_1738092290818823641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Model Avg Runtime (Period)&#13;&#10;// Mean of the daily average runtime over the window, in seconds. Needs avg_runtime_sec typed as Number.&#13;&#10;// 30d check: fct_sessions about 1,673 s (27.9 min) is the slowest.&#13;&#10;AVG(IF [Calculation_1409194560049525583] THEN [avg_runtime_sec] END)' />
            </column>
            <column caption='Model Runtime Label' datatype='string' name='[Calculation_2833830762735681804]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Model Runtime Label&#13;&#10;// Duration text for an aggregated runtime: &quot;45s&quot;, &quot;27.9 min&quot;, &quot;1.2 h&quot;.&#13;&#10;IF ISNULL([Calculation_1738092290818823641]) THEN &quot;-&quot;&#13;&#10;ELSEIF [Calculation_1738092290818823641] &lt; 60 THEN STR(ROUND([Calculation_1738092290818823641])) + &quot;s&quot;&#13;&#10;ELSEIF [Calculation_1738092290818823641] &lt; 3600 THEN STR(ROUND([Calculation_1738092290818823641] / 60, 1)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([Calculation_1738092290818823641] / 3600, 1)) + &quot; h&quot;&#13;&#10;END' />
            </column>
            <column caption='Runtime Trend Now' datatype='real' name='[Calculation_3083874683594051399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Runtime Trend Now&#13;&#10;// 7-day vs prior 28-day runtime change on the last day (19 Oct), as a fraction. Format ▲ 0%;▼ 0%.&#13;&#10;// Needs runtime_trend_pct typed as Number (decimal) in the data source.&#13;&#10;MAX(IF [days_before_as_of] = 0 THEN [runtime_trend_pct] END)' />
            </column>
            <column caption='PF Slowest Trend Text' datatype='string' name='[Calculation_1272621414589681895]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// PF Slowest Trend Text&#13;&#10;// &quot;  ·  ▼ 88% 7d vs 28d&quot; after the slowest model&apos;s average run.&#13;&#10;IF ISNULL([Calculation_3083874683594051399]) THEN &quot;&quot;&#13;&#10;ELSE &quot;  ·  &quot; + (IF [Calculation_3083874683594051399] &gt; 0 THEN &quot;▲ &quot; ELSE &quot;▼ &quot; END)&#13;&#10;    + STR(INT(ROUND(ABS([Calculation_3083874683594051399]) * 100))) + &quot;% 7d vs 28d&quot;&#13;&#10;END' />
            </column>
            <column caption='Avg Runtime Sec' datatype='real' name='[avg_runtime_sec]' role='measure' type='quantitative' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Node Id (Nodes)' datatype='string' name='[node_id (dim_nodes.csv)]' role='dimension' type='nominal' />
            <column caption='Node Name' datatype='string' name='[node_name]' role='dimension' type='nominal' />
            <column caption='Resource Type' datatype='string' name='[resource_type]' role='dimension' type='nominal' />
            <column caption='Runtime Trend Pct' datatype='real' name='[runtime_trend_pct]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1221533192259849042]' derivation='None' name='[none:Calculation_1221533192259849042:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_4911841298322152364]' derivation='None' name='[none:Calculation_4911841298322152364:nk]' pivot='key' type='nominal' />
            <column-instance column='[node_name]' derivation='Attribute' name='[attr:node_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2833830762735681804]' derivation='User' name='[usr:Calculation_2833830762735681804:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1272621414589681895]' derivation='User' name='[usr:Calculation_1272621414589681895:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_1221533192259849042:nk]'>
            <groupfilter function='member' level='[none:Calculation_1221533192259849042:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_4911841298322152364:nk]'>
            <groupfilter function='member' level='[none:Calculation_4911841298322152364:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
