        <calculation class='tableau' formula='// BR Chip Point&#13;&#10;// A chip: 4 Node Path Index rows each (corners), as many as the column has, up to 12.&#13;&#10;IF INT([Calculation_2690238693341099106] / 4) &lt; MIN([Calculation_4380887972763198582], 12) THEN MAKEPOINT(&#13;&#10;    (139 - (CASE INT([Calculation_2690238693341099106] % 4) WHEN 0 THEN (26 + INT([Calculation_2690238693341099106] / 4) * 21) WHEN 1 THEN (26 + INT([Calculation_2690238693341099106] / 4) * 21) ELSE (26 + INT([Calculation_2690238693341099106] / 4) * 21) + 18 END)) / 100,&#13;&#10;    ((CASE INT([Calculation_2690238693341099106] % 4) WHEN 0 THEN ([Calculation_4702348732004905100] * 208) WHEN 3 THEN ([Calculation_4702348732004905100] * 208) ELSE ([Calculation_4702348732004905100] * 208) + 195 END) - 305.5) / 100&#13;&#10;) END' />
      </column>
