              <calculation class='tableau' formula='// Is BR Heading Row&#13;&#10;// One date row per column title. Put on Filters (True).&#13;&#10;[day_index] &lt; 9' />
            </column>
            <column caption='BR Risk Heading' datatype='string' name='[Calculation_1944519661551996446]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// BR Risk Heading&#13;&#10;// Column titles, one date row each.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;#&quot;&#13;&#10;WHEN 1 THEN &quot;NODE&quot;&#13;&#10;WHEN 2 THEN &quot;LAYER&quot;&#13;&#10;WHEN 3 THEN &quot;PLATFORM&quot;&#13;&#10;WHEN 4 THEN &quot;EXPOSURES FED&quot;&#13;&#10;WHEN 5 THEN &quot;DAILY CONSUMERS&quot;&#13;&#10;WHEN 6 THEN &quot;FAILURE RATE&quot;&#13;&#10;WHEN 7 THEN &quot;RISK SCORE&quot;&#13;&#10;WHEN 8 THEN &quot;NOW&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='BR Risk Heading Point' datatype='spatial' name='[Calculation_1358600015151165025]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// BR Risk Heading Point&#13;&#10;// Middle of a column title (measured by the build).&#13;&#10;MAKEPOINT(0, (CASE [day_index]&#13;&#10;WHEN 0 THEN 10.6&#13;&#10;WHEN 1 THEN 60.5&#13;&#10;WHEN 2 THEN 261.5&#13;&#10;WHEN 3 THEN 387.7&#13;&#10;WHEN 4 THEN 557.1&#13;&#10;WHEN 5 THEN 657.7&#13;&#10;WHEN 6 THEN 772.2&#13;&#10;WHEN 7 THEN 852.2&#13;&#10;WHEN 8 THEN 1185.5&#13;&#10;ELSE 0&#13;&#10;END - 628) / 100)' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
