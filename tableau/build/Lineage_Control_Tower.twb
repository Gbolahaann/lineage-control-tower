      <column caption='Lineage Stripe Point' datatype='spatial' name='[Calculation_1153384882188955846]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Lineage Stripe Point&#13;&#10;// Platform stripe, 3 px wide, at the right end of the box.&#13;&#10;IF [row_type] = &quot;edge&quot; THEN MAKEPOINT(&#13;&#10;    (374 - ((IF [Calculation_2862554141724672958] = [Calculation_8729747500185938838] THEN 374 ELSE (34 + [Calculation_9398625473923371421] / 2) + (([Calculation_1468698324675902386]) - [Calculation_8729747500185938838]) / ([Calculation_2862554141724672958] - [Calculation_8729747500185938838]) * ((748 - 8 - [Calculation_9398625473923371421] / 2) - (34 + [Calculation_9398625473923371421] / 2)) END)) + ((IF INT((INT([point_order]) - 1) / 3) &lt; 2 THEN 1 ELSE -1 END) * (([Calculation_9398625473923371421] - 6) / 2 - (1.5)) + (1.5) * SIN(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30)))) / 100,&#13;&#10;    ((((8 + ([Calculation_3349816069477544607]) * 151.833) + 115.967)) + ((CASE INT((INT([point_order]) - 1) / 3) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * ((3) / 2 - (1.5)) + (1.5) * COS(RADIANS(INT((INT([point_order]) - 1) / 3) * 90 + ((INT([point_order]) - 1) % 3 + 0.5) * 30))) - 463.5) / 100&#13;&#10;) END' />
