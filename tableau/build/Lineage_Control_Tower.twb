  <worksheets>
    <worksheet name='GL Period Buttons'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Period Option' datatype='integer' name='[Calculation_1395152531449864650]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Period Option&#13;&#10;// Scaffold: turns the first 3 days of dim_date into the 3 period buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN 7&#13;&#10;WHEN 1 THEN 30&#13;&#10;WHEN 2 THEN 90&#13;&#10;END' />
            </column>
            <column caption='Full Bar' datatype='real' name='[Calculation_2313436587575898004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Full Bar&#13;&#10;// Bar length for a full-width background (axis fixed 0 to 1 and hidden): buttons, alert rows.&#13;&#10;MIN(1.0)' />
            </column>
            <column caption='Text Anchor Centre' datatype='real' name='[Calculation_2496391787737110048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Text Anchor Centre&#13;&#10;// Where centred text sits on a full-width background bar.&#13;&#10;MIN(0.5)' />
            </column>
            <column caption='Is Period Button Row' datatype='boolean' name='[Calculation_1896708728705539988]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Period Button Row&#13;&#10;// Keeps the 3 scaffold rows that carry a period button. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1395152531449864650])' />
            </column>
            <column caption='Is Active Period Option' datatype='boolean' name='[Calculation_1290101426377148290]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Active Period Option&#13;&#10;// Colours the selected period button (Navy fill, white text) against the rest.&#13;&#10;[Calculation_1395152531449864650] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Period Option Label' datatype='string' name='[Calculation_3141427238531064247]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Period Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;&quot;Last &quot; + STR([Calculation_1395152531449864650]) + &quot; days&quot;' />
            </column>
            <column caption='Period Label Active' datatype='string' name='[Calculation_2018629980644388562]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Period Label Active&#13;&#10;// Button text when this button is the selected period (Semibold Navy run).&#13;&#10;IF [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
            </column>
            <column caption='Period Label Inactive' datatype='string' name='[Calculation_3943248154185459554]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Period Label Inactive&#13;&#10;// Button text when this button is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1395152531449864650]' derivation='None' name='[none:Calculation_1395152531449864650:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_2313436587575898004]' derivation='User' name='[usr:Calculation_2313436587575898004:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2496391787737110048]' derivation='User' name='[usr:Calculation_2496391787737110048:qk]' pivot='key' type='quantitative' />
