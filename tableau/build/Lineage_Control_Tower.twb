            <column caption='Exposures At Risk - Trend' datatype='integer' name='[Calculation_3996116585410579374]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures At Risk - Trend&#13;&#10;// Exposures Warning or Critical at the end of each day. One row per exposure per day, so this counts exposures.&#13;&#10;SUM(IF [status_eod_code] &gt;= 2 THEN 1 ELSE 0 END)' />
            </column>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Exposures At Risk - Trend In Period' datatype='real' name='[Calculation_2107588681978104977]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures At Risk - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_3996116585410579374] END' />
            </column>
            <column caption='Exposures At Risk - Trend Out Period' datatype='real' name='[Calculation_3360750808181857461]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Exposures At Risk - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_3996116585410579374] END' />
            </column>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
