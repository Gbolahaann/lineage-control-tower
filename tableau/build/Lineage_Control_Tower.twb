      <column caption='Lineage Label On Path' datatype='string' name='[Calculation_3123359278632519899]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Lineage Label On Path&#13;&#10;// Box name in ink, for boxes on the selected path (or every box when nothing is selected).&#13;&#10;// NULL (not &quot;&quot;) on every other row: a box&apos;s name layer also holds its edge rows, and ATTR of a name&#13;&#10;// and &quot;&quot; shows &quot;*&quot; (v16).&#13;&#10;IF [row_type] = &quot;node&quot; AND [Calculation_2720870856721498789] AND [node_id (mart_lineage_layout.csv)] &lt;&gt; [layout_scope]&#13;&#10;    THEN [Calculation_3399849254129370742] END' />
      </column>
