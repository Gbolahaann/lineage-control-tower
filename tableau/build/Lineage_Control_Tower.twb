      <column caption='US Flag Retire Text' datatype='string' name='[Calculation_6286666602440498181]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// US Flag Retire Text&#13;&#10;// &quot;✕  Retire?&quot;, red, on its red pill. Written by the build per period.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|exposure.acme_product.web_funnel_analysis&quot; THEN &quot;✕  Retire?&quot;&#13;&#10;WHEN &quot;30|exposure.acme_product.web_funnel_analysis&quot; THEN &quot;✕  Retire?&quot;&#13;&#10;WHEN &quot;90|exposure.acme_product.web_funnel_analysis&quot; THEN &quot;✕  Retire?&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='US Flag Unregistered Text' datatype='string' name='[Calculation_2991054123253261005]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// US Flag Unregistered Text&#13;&#10;// &quot;Unregistered&quot;, amber, on its amber tag. Written by the build per period.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_pricing_agent&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_promo_notebook&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_regional_hub&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;30|exposure.observed.undeclared_pricing_agent&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;30|exposure.observed.undeclared_promo_notebook&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;30|exposure.observed.undeclared_regional_hub&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;90|exposure.observed.undeclared_pricing_agent&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;90|exposure.observed.undeclared_promo_notebook&quot; THEN &quot;Unregistered&quot;&#13;&#10;WHEN &quot;90|exposure.observed.undeclared_regional_hub&quot; THEN &quot;Unregistered&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='US Flag Text Point' datatype='spatial' name='[Calculation_7844733018396777962]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// US Flag Text Point&#13;&#10;// Middle of the flag.&#13;&#10;MAKEPOINT(0, (CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|exposure.acme_product.web_funnel_analysis&quot; THEN 553.6&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_pricing_agent&quot; THEN 560.3&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_promo_notebook&quot; THEN 560.3&#13;&#10;WHEN &quot;7|exposure.observed.undeclared_regional_hub&quot; THEN 560.3&#13;&#10;WHEN &quot;30|exposure.acme_product.web_funnel_analysis&quot; THEN 553.6&#13;&#10;WHEN &quot;30|exposure.observed.undeclared_pricing_agent&quot; THEN 560.3&#13;&#10;WHEN &quot;30|exposure.observed.undeclared_promo_notebook&quot; THEN 560.3&#13;&#10;WHEN &quot;30|exposure.observed.undeclared_regional_hub&quot; THEN 560.3&#13;&#10;WHEN &quot;90|exposure.acme_product.web_funnel_analysis&quot; THEN 553.6&#13;&#10;WHEN &quot;90|exposure.observed.undeclared_pricing_agent&quot; THEN 560.3&#13;&#10;WHEN &quot;90|exposure.observed.undeclared_promo_notebook&quot; THEN 560.3&#13;&#10;WHEN &quot;90|exposure.observed.undeclared_regional_hub&quot; THEN 560.3&#13;&#10;ELSE 0&#13;&#10;END - 299.5) / 100)' />
      </column>
      <column caption='Is US Semantic Heading Row' datatype='boolean' name='[Calculation_1493829991759145782]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is US Semantic Heading Row&#13;&#10;// One date row per column title. Put on Filters (True).&#13;&#10;[day_index] &lt; 7' />
      </column>
      <column caption='US Semantic Heading' datatype='string' name='[Calculation_6450195664939418127]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// US Semantic Heading&#13;&#10;// Column titles, one date row each.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;SEMANTIC OBJECT&quot;&#13;&#10;WHEN 1 THEN &quot;TOOL&quot;&#13;&#10;WHEN 2 THEN &quot;MODE&quot;&#13;&#10;WHEN 3 THEN &quot;SUCCESS&quot;&#13;&#10;WHEN 4 THEN &quot;FAILED&quot;&#13;&#10;WHEN 5 THEN &quot;AVG REFRESH&quot;&#13;&#10;WHEN 6 THEN &quot;FAILURES PER DAY&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='US Semantic Heading Point' datatype='spatial' name='[Calculation_1944630088126086288]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// US Semantic Heading Point&#13;&#10;// Middle of a column title (measured by the build).&#13;&#10;MAKEPOINT(0, (CASE [day_index]&#13;&#10;WHEN 0 THEN 52.8&#13;&#10;WHEN 1 THEN 164.6&#13;&#10;WHEN 2 THEN 217.8&#13;&#10;WHEN 3 THEN 267.3&#13;&#10;WHEN 4 THEN 315.6&#13;&#10;WHEN 5 THEN 374.8&#13;&#10;WHEN 6 THEN 466.2&#13;&#10;ELSE 0&#13;&#10;END - 302.5) / 100)' />
      </column>
