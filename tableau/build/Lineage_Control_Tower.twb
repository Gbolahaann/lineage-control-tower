      <column caption='Is Exposure Owned' datatype='boolean' name='[Calculation_1623128277657509047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Exposure Owned&#13;&#10;// Exposures with a real owner (&quot;No owner&quot; is the mart&apos;s placeholder).&#13;&#10;[owner_name] &lt;&gt; &quot;No owner&quot;' />
      </column>
      <column caption='Ownership Coverage' datatype='real' name='[Calculation_1043060479066517021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Ownership Coverage&#13;&#10;// Exposures with an owner / all exposures, unregistered included. Check: 23 of 27 = 85%.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [Calculation_1623128277657509047] THEN 1 END))&#13;&#10;/&#13;&#10;SUM(IF [resource_type] = &quot;exposure&quot; THEN 1 END)' />
      </column>
      <column caption='Exposures Without Owner' datatype='real' name='[Calculation_1674547297219245560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures Without Owner&#13;&#10;// Sub-line &quot;4 of 27 exposures have no owner&quot;.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND NOT [Calculation_1623128277657509047] THEN 1 END))' />
      </column>
      <column caption='GOV Owned Sub Text' datatype='string' name='[Calculation_6690578235394442393]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Owned Sub Text&#13;&#10;// &quot;4 of 27 exposures have no owner&quot;.&#13;&#10;STR(INT([Calculation_1674547297219245560])) + &quot; of &quot; + STR(INT(SUM(IF [resource_type] = &quot;exposure&quot; THEN 1 END))) + &quot; exposures have no owner&quot;' />
      </column>
      <column caption='Documentation Coverage' datatype='real' name='[Calculation_1088481749157410608]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Documentation Coverage&#13;&#10;// Models with a description / all models. Check: 67 of 82 = 82%.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND [has_description] THEN 1 END))&#13;&#10;/&#13;&#10;SUM(IF [resource_type] = &quot;model&quot; THEN 1 END)' />
      </column>
      <column caption='Models Without Description' datatype='real' name='[Calculation_9974315884768813384]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Models Without Description&#13;&#10;// Sub-line &quot;15 models have no description&quot;.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND NOT [has_description] THEN 1 END))' />
      </column>
      <column caption='GOV Doc Sub Text' datatype='string' name='[Calculation_7344779726033414663]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Doc Sub Text&#13;&#10;// &quot;15 models have no description&quot;.&#13;&#10;STR(INT([Calculation_9974315884768813384])) + &quot; models have no description&quot;' />
      </column>
      <column caption='GOV Test Sub Text' datatype='string' name='[Calculation_2614937689100274787]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Test Sub Text&#13;&#10;// &quot;14 models have no tests&quot;.&#13;&#10;STR(INT([Calculation_1132856952812547619])) + &quot; models have no tests&quot;' />
      </column>
      <column caption='GOV Declared Text' datatype='string' name='[Calculation_7957814189299073219]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Declared Text&#13;&#10;// Declared consumers: readers in query history mapped to a declared exposure (written by the build).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN &quot;86%&quot;&#13;&#10;WHEN &quot;7|snowflake&quot; THEN &quot;82%&quot;&#13;&#10;WHEN &quot;7|databricks&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;7|redshift&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;30|All&quot; THEN &quot;86%&quot;&#13;&#10;WHEN &quot;30|snowflake&quot; THEN &quot;82%&quot;&#13;&#10;WHEN &quot;30|databricks&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;30|redshift&quot; THEN &quot;67%&quot;&#13;&#10;WHEN &quot;90|All&quot; THEN &quot;86%&quot;&#13;&#10;WHEN &quot;90|snowflake&quot; THEN &quot;82%&quot;&#13;&#10;WHEN &quot;90|databricks&quot; THEN &quot;100%&quot;&#13;&#10;WHEN &quot;90|redshift&quot; THEN &quot;67%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Declared Red Text' datatype='string' name='[Calculation_1585692426937760911]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Declared Red Text&#13;&#10;// &quot;3 readers in query history&quot;, red when any.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;7|snowflake&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;7|redshift&quot; THEN &quot;1 reader in query history&quot;&#13;&#10;WHEN &quot;30|All&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;30|snowflake&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;30|redshift&quot; THEN &quot;1 reader in query history&quot;&#13;&#10;WHEN &quot;90|All&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;90|snowflake&quot; THEN &quot;3 readers in query history&quot;&#13;&#10;WHEN &quot;90|redshift&quot; THEN &quot;1 reader in query history&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Declared Plain Text' datatype='string' name='[Calculation_2381971374217504579]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Declared Plain Text&#13;&#10;// &quot;No readers in query history&quot; otherwise.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|databricks&quot; THEN &quot;No readers in query history&quot;&#13;&#10;WHEN &quot;30|databricks&quot; THEN &quot;No readers in query history&quot;&#13;&#10;WHEN &quot;90|databricks&quot; THEN &quot;No readers in query history&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Is GOV Heading Row' datatype='boolean' name='[Calculation_1146176054877278384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is GOV Heading Row&#13;&#10;// One date row per column title. Put on Filters (True).&#13;&#10;[day_index] &lt; 8' />
      </column>
      <column caption='GOV Unreg Heading' datatype='string' name='[Calculation_1804371275863460277]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Unreg Heading&#13;&#10;// Column titles, one date row each.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;PRINCIPAL&quot;&#13;&#10;WHEN 1 THEN &quot;KIND&quot;&#13;&#10;WHEN 2 THEN &quot;READS&quot;&#13;&#10;WHEN 3 THEN &quot;QUERIES&quot;&#13;&#10;WHEN 4 THEN &quot;SCANNED&quot;&#13;&#10;WHEN 5 THEN &quot;COST&quot;&#13;&#10;WHEN 6 THEN &quot;FIRST SEEN&quot;&#13;&#10;WHEN 7 THEN &quot;LIKELY WHAT&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Unreg Heading Point' datatype='spatial' name='[Calculation_2343564999347738570]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Unreg Heading Point&#13;&#10;// Middle of a column title (measured by the build).&#13;&#10;MAKEPOINT(0, (CASE [day_index]&#13;&#10;WHEN 0 THEN 32.9&#13;&#10;WHEN 1 THEN 199.2&#13;&#10;WHEN 2 THEN 305.0&#13;&#10;WHEN 3 THEN 466.6&#13;&#10;WHEN 4 THEN 545.7&#13;&#10;WHEN 5 THEN 607.2&#13;&#10;WHEN 6 THEN 673.1&#13;&#10;WHEN 7 THEN 757.1&#13;&#10;ELSE 0&#13;&#10;END - 416) / 100)' />
      </column>
      <column caption='GOV Unregistered Rank' datatype='integer' name='[Calculation_7324006016825600406]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// GOV Unregistered Rank&#13;&#10;// Row of an unregistered reader in the period and platform, most queries first (written by the build).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [principal]&#13;&#10;WHEN &quot;7|All|svc_shared_analytics&quot; THEN 1&#13;&#10;WHEN &quot;7|All|r.alvarez@acme-retail.example&quot; THEN 2&#13;&#10;WHEN &quot;7|All|svc_jobs_runner&quot; THEN 3&#13;&#10;WHEN &quot;7|snowflake|svc_shared_analytics&quot; THEN 1&#13;&#10;WHEN &quot;7|snowflake|r.alvarez@acme-retail.example&quot; THEN 2&#13;&#10;WHEN &quot;7|snowflake|svc_jobs_runner&quot; THEN 3&#13;&#10;WHEN &quot;7|redshift|svc_jobs_runner&quot; THEN 1&#13;&#10;WHEN &quot;30|All|svc_shared_analytics&quot; THEN 1&#13;&#10;WHEN &quot;30|All|r.alvarez@acme-retail.example&quot; THEN 2&#13;&#10;WHEN &quot;30|All|svc_jobs_runner&quot; THEN 3&#13;&#10;WHEN &quot;30|snowflake|svc_shared_analytics&quot; THEN 1&#13;&#10;WHEN &quot;30|snowflake|r.alvarez@acme-retail.example&quot; THEN 2&#13;&#10;WHEN &quot;30|snowflake|svc_jobs_runner&quot; THEN 3&#13;&#10;WHEN &quot;30|redshift|svc_jobs_runner&quot; THEN 1&#13;&#10;WHEN &quot;90|All|svc_shared_analytics&quot; THEN 1&#13;&#10;WHEN &quot;90|All|r.alvarez@acme-retail.example&quot; THEN 2&#13;&#10;WHEN &quot;90|All|svc_jobs_runner&quot; THEN 3&#13;&#10;WHEN &quot;90|snowflake|svc_shared_analytics&quot; THEN 1&#13;&#10;WHEN &quot;90|snowflake|r.alvarez@acme-retail.example&quot; THEN 2&#13;&#10;WHEN &quot;90|snowflake|svc_jobs_runner&quot; THEN 3&#13;&#10;WHEN &quot;90|redshift|svc_jobs_runner&quot; THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Is GOV Unregistered Row' datatype='boolean' name='[Calculation_1448600856121183253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is GOV Unregistered Row&#13;&#10;// Rows of the table. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_7324006016825600406])' />
      </column>
      <column caption='GOV Unreg Principal Text' datatype='string' name='[Calculation_6722298122683205174]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Unreg Principal Text&#13;&#10;// Principal cell (written by the build per period and platform).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [principal]&#13;&#10;WHEN &quot;7|All|svc_shared_analytics&quot; THEN &quot;svc_shared_analytics&quot;&#13;&#10;WHEN &quot;7|All|r.alvarez@acme-retail.example&quot; THEN &quot;r.alvarez@acme-retail.example&quot;&#13;&#10;WHEN &quot;7|All|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;7|snowflake|svc_shared_analytics&quot; THEN &quot;svc_shared_analytics&quot;&#13;&#10;WHEN &quot;7|snowflake|r.alvarez@acme-retail.example&quot; THEN &quot;r.alvarez@acme-retail.example&quot;&#13;&#10;WHEN &quot;7|snowflake|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;7|redshift|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;30|All|svc_shared_analytics&quot; THEN &quot;svc_shared_analytics&quot;&#13;&#10;WHEN &quot;30|All|r.alvarez@acme-retail.example&quot; THEN &quot;r.alvarez@acme-retail.example&quot;&#13;&#10;WHEN &quot;30|All|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;30|snowflake|svc_shared_analytics&quot; THEN &quot;svc_shared_analytics&quot;&#13;&#10;WHEN &quot;30|snowflake|r.alvarez@acme-retail.example&quot; THEN &quot;r.alvarez@acme-retail.example&quot;&#13;&#10;WHEN &quot;30|snowflake|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;30|redshift|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;90|All|svc_shared_analytics&quot; THEN &quot;svc_shared_analytics&quot;&#13;&#10;WHEN &quot;90|All|r.alvarez@acme-retail.example&quot; THEN &quot;r.alvarez@acme-retail.example&quot;&#13;&#10;WHEN &quot;90|All|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;90|snowflake|svc_shared_analytics&quot; THEN &quot;svc_shared_analytics&quot;&#13;&#10;WHEN &quot;90|snowflake|r.alvarez@acme-retail.example&quot; THEN &quot;r.alvarez@acme-retail.example&quot;&#13;&#10;WHEN &quot;90|snowflake|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;WHEN &quot;90|redshift|svc_jobs_runner&quot; THEN &quot;svc_jobs_runner&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
