      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;United States&quot;' />
      </semantic-values>
      <object-graph>
        <objects>
          <object caption='Dates' id='dim_date.csv_DF8950FB8176406B9520773745BC3E0D'>
            <properties context=''>
              <relation connection='textscan.0k5jexq0ngajdw1e8cchh0sdzqcn' name='dim_date.csv' table='[dim_date#csv]' type='table'>
                <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
                  <column datatype='date' name='date' ordinal='0' />
                  <column datatype='integer' name='year' ordinal='1' />
                  <column datatype='integer' name='quarter' ordinal='2' />
                  <column datatype='integer' name='month' ordinal='3' />
                  <column datatype='string' name='month_name' ordinal='4' />
                  <column datatype='integer' name='iso_week' ordinal='5' />
                  <column datatype='date' name='week_start' ordinal='6' />
                  <column datatype='integer' name='day_of_week' ordinal='7' />
                  <column datatype='string' name='day_name' ordinal='8' />
                  <column datatype='boolean' name='is_weekend' ordinal='9' />
                  <column datatype='boolean' name='is_month_end' ordinal='10' />
                  <column datatype='boolean' name='is_month_end_close_window' ordinal='11' />
                  <column datatype='boolean' name='is_board_prep_window' ordinal='12' />
                  <column datatype='integer' name='days_before_as_of' ordinal='13' />
                  <column datatype='integer' name='day_index' ordinal='14' />
                </columns>
              </relation>
            </properties>
          </object>
          <object caption='Nodes' id='dim_nodes.csv_273AA73B14884E2FB287033E49518972'>
            <properties context=''>
              <relation connection='textscan.0k5jexq0ngajdw1e8cchh0sdzqcn' name='dim_nodes.csv' table='[dim_nodes#csv]' type='table'>
                <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
                  <column datatype='integer' name='node_key' ordinal='0' />
                  <column datatype='string' name='node_id' ordinal='1' />
                  <column datatype='string' name='node_name' ordinal='2' />
                  <column datatype='string' name='display_name' ordinal='3' />
                  <column datatype='string' name='resource_type' ordinal='4' />
                  <column datatype='string' name='layer' ordinal='5' />
                  <column datatype='integer' name='layer_order' ordinal='6' />
                  <column datatype='string' name='platform' ordinal='7' />
                  <column datatype='string' name='dbt_project' ordinal='8' />
                  <column datatype='string' name='dbt_job' ordinal='9' />
                  <column datatype='string' name='database_name' ordinal='10' />
                  <column datatype='string' name='schema_name' ordinal='11' />
                  <column datatype='string' name='materialization' ordinal='12' />
                  <column datatype='string' name='domain' ordinal='13' />
                  <column datatype='string' name='owner_name' ordinal='14' />
                  <column datatype='string' name='owner_team' ordinal='15' />
                  <column datatype='string' name='tags' ordinal='16' />
                  <column datatype='boolean' name='has_description' ordinal='17' />
                  <column datatype='integer' name='test_count' ordinal='18' />
