            <column caption='Documentation Coverage' datatype='real' name='[Calculation_1088481749157410608]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Documentation Coverage&#13;&#10;// Models with a description / all models. Check: 67 of 82 = 82%.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND [has_description] THEN 1 END))&#13;&#10;/&#13;&#10;SUM(IF [resource_type] = &quot;model&quot; THEN 1 END)' />
            </column>
            <column caption='Models Without Description' datatype='real' name='[Calculation_9974315884768813384]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Models Without Description&#13;&#10;// Sub-line &quot;15 models have no description&quot;.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;model&quot; AND NOT [has_description] THEN 1 END))' />
            </column>
