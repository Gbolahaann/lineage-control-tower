    <worksheet name='FR Compliance by Platform Line'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Compliance Band' datatype='real' name='[Calculation_1016955751409068314]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Compliance Band&#13;&#10;// Back bars of the compliance chart: full height on days in the window (the band).&#13;&#10;IF MAX(IIF([Calculation_1409194560049525583], 1, 0)) = 1 THEN 1 END' />
            </column>
            <column caption='Freshness Pass Rate (Daily)' datatype='real' name='[Calculation_1395897941381582684]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Freshness Pass Rate (Daily)&#13;&#10;// Share of hourly checks that passed that day, per platform. Axis 90% to 100%, as in the prototype.&#13;&#10;SUM([fresh_checks_pass])&#13;&#10;/&#13;&#10;SUM([fresh_checks_pass] + [fresh_checks_warn] + [fresh_checks_error])' />
            </column>
            <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
            </column>
            <column caption='Is Platform Match Day' datatype='boolean' name='[Calculation_1100032193373739257]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Day&#13;&#10;// Day-level platform filter for Node Daily. Migrated models count against Redshift before&#13;&#10;// their move and Snowflake after, so daily KPIs and cost split correctly by platform.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day] = [Parameters].[Parameter 2]' />
            </column>
            <column caption='Platform On Day Name' datatype='string' name='[Calculation_2924358152833088820]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Platform On Day Name&#13;&#10;// Display name of the platform a node was on that day (Node Daily). Colours: Snowflake #005FAE, Databricks #4BAEE3, Redshift #5B5FC7.&#13;&#10;CASE [platform_on_day]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
            </column>
            <column caption='Tooltip Day Text' datatype='string' name='[Calculation_2968828563623477298]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Tooltip Day Text&#13;&#10;// &quot;Mon 12 Oct&quot; in a 90-day chart&apos;s tooltip, as an aggregate so it never splits a line or area.&#13;&#10;LEFT(DATENAME(&apos;weekday&apos;, MIN([date (dim_date.csv)])), 3) + &quot; &quot; + STR(DAY(MIN([date (dim_date.csv)]))) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, MIN([date (dim_date.csv)])), 3)' />
            </column>
            <column caption='Date (Dates)' datatype='date' name='[date (dim_date.csv)]' role='dimension' type='ordinal' />
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Fresh Checks Error' datatype='real' name='[fresh_checks_error]' role='measure' type='quantitative' />
            <column caption='Fresh Checks Pass' datatype='real' name='[fresh_checks_pass]' role='measure' type='quantitative' />
            <column caption='Fresh Checks Warn' datatype='real' name='[fresh_checks_warn]' role='measure' type='quantitative' />
            <column caption='Platform On Day' datatype='string' name='[platform_on_day]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1016955751409068314]' derivation='User' name='[usr:Calculation_1016955751409068314:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1395897941381582684]' derivation='User' name='[usr:Calculation_1395897941381582684:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2904210747288447847]' derivation='None' name='[none:Calculation_2904210747288447847:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1100032193373739257]' derivation='None' name='[none:Calculation_1100032193373739257:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2924358152833088820]' derivation='None' name='[none:Calculation_2924358152833088820:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2968828563623477298]' derivation='User' name='[usr:Calculation_2968828563623477298:nk]' pivot='key' type='nominal' />
