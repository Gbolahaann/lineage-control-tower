                  <zone friendly-name='DOC Actions Card' h='51200' id='1596' param='vert' type-v2='layout-flow' w='54375' x='16250' y='45600'>
                    <zone fixed-size='44' h='4400' id='1594' is-fixed='true' type-v2='text' w='51812' x='17312' y='47100'>
