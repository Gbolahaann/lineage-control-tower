    <worksheet name='HO Tile View Buttons'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_tile_view' datatype='string' datatype-customized='true' name='[Parameter 8]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Needs attention&quot;' value='Needs attention' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Needs attention' value='&quot;Needs attention&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Tile View Option' datatype='string' name='[Calculation_2894482038928477351]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile View Option&#13;&#10;// Scaffold for the All / Needs attention buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;Needs attention&quot;&#13;&#10;END' />
            </column>
            <column caption='Full Bar' datatype='real' name='[Calculation_2313436587575898004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Full Bar&#13;&#10;// Bar length for a full-width background (axis fixed 0 to 1 and hidden): buttons, alert rows.&#13;&#10;MIN(1.0)' />
            </column>
            <column caption='Text Anchor Centre' datatype='real' name='[Calculation_2496391787737110048]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Text Anchor Centre&#13;&#10;// Where centred text sits on a full-width background bar.&#13;&#10;MIN(0.5)' />
            </column>
            <column caption='Is Tile View Button Row' datatype='boolean' name='[Calculation_2058479208791343830]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Tile View Button Row&#13;&#10;// Keeps the 2 scaffold rows that carry the All / Needs attention buttons. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_2894482038928477351])' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Is Active Tile View' datatype='boolean' name='[Calculation_1284089094536110577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Active Tile View&#13;&#10;// Colours the selected tile-view button.&#13;&#10;[Calculation_2894482038928477351] = [Parameters].[Parameter 8]' />
            </column>
            <column caption='Tile View Label Active' datatype='string' name='[Calculation_1838581371832391049]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile View Label Active&#13;&#10;// Button text when this tile view is selected (Semibold Navy run).&#13;&#10;IF [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
            </column>
            <column caption='Tile View Label Inactive' datatype='string' name='[Calculation_3133453958818750804]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Tile View Label Inactive&#13;&#10;// Button text when this tile view is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
            </column>
            <column caption='Day Index' datatype='integer' name='[day_index]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2894482038928477351]' derivation='None' name='[none:Calculation_2894482038928477351:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2313436587575898004]' derivation='User' name='[usr:Calculation_2313436587575898004:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_2496391787737110048]' derivation='User' name='[usr:Calculation_2496391787737110048:qk]' pivot='key' type='quantitative' />
