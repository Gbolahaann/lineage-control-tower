      <column caption='MTTR Rolling 7 Day Area' datatype='real' name='[Calculation_3037070239198132758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR Rolling 7 Day Area&#13;&#10;// The same value for the light area under the line (a second axis needs its own field).&#13;&#10;WINDOW_SUM(SUM(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)&#13;&#10;/&#13;&#10;WINDOW_SUM(COUNT(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2904210747288447847]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='MTTR Rolling 7 Day Line' datatype='real' name='[Calculation_6430925892119406940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR Rolling 7 Day Line&#13;&#10;// Mean recovery time of episodes that started in the 7 days up to each day (episode-weighted).&#13;&#10;// Table calc along Days Back Mid (ascending = back in time, so the 6 days before are +1 to +6).&#13;&#10;WINDOW_SUM(SUM(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)&#13;&#10;/&#13;&#10;WINDOW_SUM(COUNT(IF NOT [is_open] THEN [hours_to_recover] END), 0, 6)'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2904210747288447847]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Tooltip Day Text' datatype='string' name='[Calculation_2968828563623477298]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tooltip Day Text&#13;&#10;// &quot;Mon 12 Oct&quot; in a 90-day chart&apos;s tooltip, as an aggregate so it never splits a line or area.&#13;&#10;LEFT(DATENAME(&apos;weekday&apos;, MIN([date (dim_date.csv)])), 3) + &quot; &quot; + STR(DAY(MIN([date (dim_date.csv)]))) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, MIN([date (dim_date.csv)])), 3)' />
      </column>
      <column caption='Axis Month Label' datatype='string' name='[Calculation_2935527346386522897]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Axis Month Label&#13;&#10;// &quot;1 Aug&quot;, &quot;1 Sep&quot;, &quot;1 Oct&quot; under the narrow MTTR chart (no &quot;22 Jul&quot;: it ran into &quot;1 Aug&quot;).&#13;&#10;IF DAY([date (dim_date.csv)]) = 1&#13;&#10;THEN &quot;1 &quot; + LEFT(DATENAME(&apos;month&apos;, [date (dim_date.csv)]), 3)&#13;&#10;END' />
      </column>
      <column caption='Axis Label Anchor MTTR' datatype='real' name='[Calculation_4501011842619422576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Axis Label Anchor MTTR&#13;&#10;// Same, on the MTTR chart&apos;s 0 to 25 scale.&#13;&#10;IF NOT ISNULL(MIN([Calculation_2935527346386522897])) THEN 12.5 END' />
      </column>
      <column caption='Lag Sort' datatype='real' name='[Calculation_5834561475858190025]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Lag Sort&#13;&#10;// Latest relative to its SLA first, as in the prototype.&#13;&#10;[freshness_lag_min] / [error_after_minutes]' />
      </column>
      <column caption='Bullet Order' datatype='real' name='[Calculation_1617098935289657198]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Bullet Order&#13;&#10;// Latest relative to its SLA first (Lag Sort turned around, so the natural order is the right one).&#13;&#10;-[Calculation_5834561475858190025]' />
      </column>
      <column caption='Is Source' datatype='boolean' name='[Calculation_7370041543117874643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Source&#13;&#10;// Keeps raw sources.&#13;&#10;[resource_type] = &quot;source&quot;' />
      </column>
      <column caption='Bullet Scale' datatype='real' name='[Calculation_3134732436745690889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Bullet Scale&#13;&#10;// Each source on its own scale, as the prototype: to 1.25 x its error threshold, or past its lag.&#13;&#10;MAX([error_after_minutes] * 1.25, ZN([freshness_lag_min]) * 1.05)' />
      </column>
      <column caption='Bullet Good Zone Point' datatype='spatial' name='[Calculation_3036502089728444550]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Good Zone Point&#13;&#10;// On-time zone, 0 to the warn threshold (green tint).&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * (0))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 ELSE (((210 + (327) * (0))) - 305.5) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Bullet Warn Zone Point' datatype='spatial' name='[Calculation_2518547156491336561]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Warn Zone Point&#13;&#10;// Warn zone, warn to error threshold (amber tint).&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 ELSE (((210 + (327) * ([warn_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Bullet Error Zone Point' datatype='spatial' name='[Calculation_3171746235470183154]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Error Zone Point&#13;&#10;// Past the error threshold (red tint), to the end of the scale.&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0600 WHEN 1 THEN 0.0600 WHEN 2 THEN -0.0600 ELSE -0.0600 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * (1))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * (1))) - 305.5) / 100 ELSE (((210 + (327) * ([error_after_minutes] / [Calculation_3134732436745690889]))) - 305.5) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Bullet Lag Bar Point' datatype='spatial' name='[Calculation_3137052557468375359]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Bullet Lag Bar Point&#13;&#10;// The lag now, a 4 px bar in the status colour (at least 0.5 % long, as the prototype).&#13;&#10;MAKEPOINT(&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN 0.0200 WHEN 1 THEN 0.0200 WHEN 2 THEN -0.0200 ELSE -0.0200 END,&#13;&#10;    CASE INT([Calculation_2690238693341099106] / 22) WHEN 0 THEN (((210 + (327) * (0))) - 305.5) / 100 WHEN 1 THEN (((210 + (327) * (MAX(0.005, ZN([freshness_lag_min]) / [Calculation_3134732436745690889])))) - 305.5) / 100 WHEN 2 THEN (((210 + (327) * (MAX(0.005, ZN([freshness_lag_min]) / [Calculation_3134732436745690889])))) - 305.5) / 100 ELSE (((210 + (327) * (0))) - 305.5) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Bullet Value Text' datatype='string' name='[Calculation_1613376037383014604]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Bullet Value Text&#13;&#10;// Lag now as the prototype writes it: &quot;44 min&quot;, &quot;6.0 h&quot; (written by the build from dim_nodes).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;2 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;7 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;26 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;5.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;28 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;3 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;3.1 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;2.3 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;23.2 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;6.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;4 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;22.9 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;42 min&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;44 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;13 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;9 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;4 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;9 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;14 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;11 min&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;59 min&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;2.7 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;2.7 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;5.6 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;0 min&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;21 min&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;5.4 h&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
