      <column caption='Late Chip Fill Point' datatype='spatial' name='[Calculation_3367338565339848723]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Late Chip Fill Point&#13;&#10;// Data product chip fill, 1 px inside (takes the click).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 8 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1700, -1.5250), NULL)&#13;&#10;WHEN 9 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1700, -0.1724), NULL)&#13;&#10;WHEN 10 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1500, -0.1524), NULL)&#13;&#10;WHEN 11 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.0500, -0.1524), NULL)&#13;&#10;WHEN 12 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.0300, -0.1724), NULL)&#13;&#10;WHEN 13 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.0300, -1.5250), NULL)&#13;&#10;WHEN 14 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.0500, -1.5450), NULL)&#13;&#10;WHEN 15 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1500, -1.5450), NULL)&#13;&#10;WHEN 16 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1700, -0.0724), NULL)&#13;&#10;WHEN 17 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1700, 0.6495), NULL)&#13;&#10;WHEN 18 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.1500, 0.6695), NULL)&#13;&#10;WHEN 19 THEN IIF(([Parameters].[Parameter 2] = &qu