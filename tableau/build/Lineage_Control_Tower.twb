            <column caption='Panel Node Id' datatype='string' name='[Calculation_1386184292960313328]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Node Id&#13;&#10;// Node shown in the side panel: the clicked node, or the exposure itself until a node is clicked.&#13;&#10;IF [Parameters].[Parameter 4] = &quot;&quot; THEN [Parameters].[Parameter 3]&#13;&#10;ELSE [Parameters].[Parameter 4]&#13;&#10;END' />
            </column>
            <column caption='Is Panel Node' datatype='boolean' name='[Calculation_2972930213303912559]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Panel Node&#13;&#10;// Filter for every Nodes-based panel sheet.&#13;&#10;[node_id (dim_nodes.csv)] = [Calculation_1386184292960313328]' />
            </column>
            <column caption='Error Hours Text' datatype='string' name='[Calculation_2509854475239831940]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Error Hours Text&#13;&#10;// Hours with one decimal, always (&quot;12.0&quot;, &quot;2.5&quot;): tenths as a whole number, then the point.&#13;&#10;STR(INT(ROUND([error_after_minutes] / 6) / 10)) + &quot;.&quot; + STR(INT(INT(ROUND([error_after_minutes] / 6)) % 10))' />
            </column>
            <column caption='Warn Hours Text' datatype='string' name='[Calculation_3184828284847424735]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Warn Hours Text&#13;&#10;// Hours with one decimal, always (&quot;12.0&quot;, &quot;2.5&quot;): tenths as a whole number, then the point.&#13;&#10;STR(INT(ROUND([warn_after_minutes] / 6) / 10)) + &quot;.&quot; + STR(INT(INT(ROUND([warn_after_minutes] / 6)) % 10))' />
            </column>
            <column caption='Panel Warn After Label' datatype='string' name='[Calculation_1281532667660790701]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Panel Warn After Label&#13;&#10;// &quot;warn 12.0 h · error 24.0 h&quot; under the freshness bullet, as in the mock (always one decimal).&#13;&#10;&quot;warn &quot; + [Calculation_3184828284847424735] + &quot; h · error &quot; + [Calculation_2509854475239831940] + &quot; h&quot;' />
            </column>
            <column caption='Error After Minutes' datatype='real' name='[error_after_minutes]' role='measure' type='quantitative' />
