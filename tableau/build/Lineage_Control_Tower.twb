      <column caption='GOV Domain Dash Text' datatype='string' name='[Calculation_3332040864957891626]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Dash Text&#13;&#10;// Dash texts of the scene.&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;redshift|4&quot; THEN &quot;-&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Domain Dash Point' datatype='spatial' name='[Calculation_1740983298078033503]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// GOV Domain Dash Point&#13;&#10;// Where each dash text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;redshift|4&quot; THEN MAKEPOINT(0.7600, 1.7200)&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='GOV Hygiene Rect Key' datatype='string' name='[Calculation_2818090644979265703]' role='dimension' type='nominal'>
