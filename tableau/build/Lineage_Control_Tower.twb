            <encoding attr='space' class='0' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_4501011842619422576:qk]' field-type='quantitative' fold='true' max='25' min='0' range-type='fixed' major-origin='0' major-spacing='10' scope='rows' type='space' />
            <format attr='display' class='0' field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[none:Calculation_2904210747288447847:qk]' scope='cols' value='false' />
