          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='Late Pill Border Point' datatype='spatial' name='[Calculation_1501965132719312571]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Pill Border Point&#13;&#10;// Status pill outline (written by the build).&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5600, -1.5250), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5600, -0.9086), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -0.8786), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -0.8786), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4000, -0.9086), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4000, -1.5250), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -1.5550), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -1.5550), NULL)&#13;&#10;END' />
            </column>
            <column caption='Late Shape Id' datatype='integer' name='[Calculation_5402477272524234802]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Late Shape Id&#13;&#10;// Which pill or chip a scaffold row draws (8 rows each).&#13;&#10;INT([day_index] / 8)' />
            </column>
            <column caption='Late Shape Point Order' datatype='integer' name='[Calculation_1514529175384296372]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Late Shape Point Order&#13;&#10;// Point 0 to 7 round the shape (path).&#13;&#10;[day_index] % 8' />
            </column>
            <column caption='Late Pill Key' datatype='string' name='[Calculation_2885006952513766161]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Late Pill Key&#13;&#10;// Pill colours by status.&#13;&#10;CASE INT([day_index] / 8)&#13;&#10;WHEN 0 THEN &quot;Warning&quot;&#13;&#10;END' />
            </column>
            <column caption='Late Pill Fill Point' datatype='spatial' name='[Calculation_2907567794637741529]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// Late Pill Fill Point&#13;&#10;// Status pill fill, 1 px inside.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5500, -1.5250), NULL)&#13;&#10;WHEN 1 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5500, -0.9086), NULL)&#13;&#10;WHEN 2 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -0.8886), NULL)&#13;&#10;WHEN 3 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -0.8886), NULL)&#13;&#10;WHEN 4 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4100, -0.9086), NULL)&#13;&#10;WHEN 5 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4100, -1.5250), NULL)&#13;&#10;WHEN 6 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.4300, -1.5450), NULL)&#13;&#10;WHEN 7 THEN IIF(([Parameters].[Parameter 2] = &quot;All&quot; OR [Parameters].[Parameter 2] = &quot;snowflake&quot;), MAKEPOINT(0.5300, -1.5450), NULL)&#13;&#10;END' />
            </column>
            <column caption='Late Chip Border Point' datatype='spatial' name='[Calculation_3225091204895001805]' role='measure' type='nominal'>
