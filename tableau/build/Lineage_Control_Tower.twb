    <worksheet name='PF Most Expensive Models Table'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='PF Cost Rank' datatype='integer' name='[Calculation_1845292614625042272]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// PF Cost Rank&#13;&#10;// Place of a model among the 15 that cost most to build in the period, under the platform filter&#13;&#10;// (worked out by the build for every period and platform, as the prototype ranks them).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|All|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;7|All|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_sessions&quot; THEN 3&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_order_items&quot; THEN 4&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_inventory_daily&quot; THEN 5&#13;&#10;WHEN &quot;7|All|model.acme_core.int_orders__enriched&quot; THEN 6&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_orders&quot; THEN 7&#13;&#10;WHEN &quot;7|All|model.acme_core.dim_customers&quot; THEN 8&#13;&#10;WHEN &quot;7|All|model.acme_core.int_inventory__snapshots&quot; THEN 9&#13;&#10;WHEN &quot;7|All|model.acme_product.int_customer_behavior&quot; THEN 10&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_payments&quot; THEN 11&#13;&#10;WHEN &quot;7|All|model.acme_core.fct_shipments&quot; THEN 12&#13;&#10;WHEN &quot;7|All|model.acme_core.int_payments__reconciled&quot; THEN 13&#13;&#10;WHEN &quot;7|All|model.acme_product.fct_demand_signals&quot; THEN 14&#13;&#10;WHEN &quot;7|All|model.acme_product.dim_customer_behavior&quot; THEN 15&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_order_items&quot; THEN 2&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_inventory_daily&quot; THEN 3&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_orders__enriched&quot; THEN 4&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_orders&quot; THEN 5&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.dim_customers&quot; THEN 6&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_inventory__snapshots&quot; THEN 7&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_payments&quot; THEN 8&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_shipments&quot; THEN 9&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_payments__reconciled&quot; THEN 10&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_store_sales&quot; THEN 11&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.int_customers__deduped&quot; THEN 12&#13;&#10;WHEN &quot;7|snowflake|model.acme_marketing.fct_attribution&quot; THEN 13&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_partner_payouts&quot; THEN 14&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.fct_revenue_daily&quot; THEN 15&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_sessions__stitched&quot; THEN 1&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_sessions&quot; THEN 2&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_customer_behavior&quot; THEN 3&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_demand_signals&quot; THEN 4&#13;&#10;WHEN &quot;7|databricks|model.acme_product.dim_customer_behavior&quot; THEN 5&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_app__engagement&quot; THEN 6&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_app_engagement&quot; THEN 7&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_funnel_daily&quot; THEN 8&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_churn_features&quot; THEN 9&#13;&#10;WHEN &quot;7|databricks|model.acme_product.fct_experiment_results&quot; THEN 10&#13;&#10;WHEN &quot;7|databricks|model.acme_product.int_funnel__steps&quot; THEN 11&#13;&#10;WHEN &quot;7|databricks|model.acme_product.stg_events__app_events&quot; THEN 12&#13;&#10;WHEN &quot;7|databricks|model.acme_product.stg_events__app_installs&quot; THEN 13&#13;&#10;WHEN &quot;7|databricks|model.acme_product.stg_events__search_events&quot; THEN 14&#13;&#10;WHEN &quot;7|databricks|model.acme_product.stg_events__web_sessions&quot; THEN 15&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_attribution&quot; THEN 1&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 2&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_ads__unified&quot; THEN 3&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_campaign_performance&quot; THEN 4&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.dim_contacts&quot; THEN 5&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_marketing_roi&quot; THEN 6&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_pipeline&quot; THEN 7&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.fct_ad_spend_daily&quot; THEN 8&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.dim_companies&quot; THEN 9&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_contacts__lifecycle&quot; THEN 10&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_campaigns__spend_daily&quot; THEN 11&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.int_deals__pipeline&quot; THEN 12&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 13&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.stg_google_ads__campaigns&quot; THEN 14&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.stg_meta_ads__ad_insights&quot; THEN 15&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;30|All|model.acme_core.dim_customer_360&quot; THEN 2&#13;&#10;WHEN &quot;30|All|model.acme_product.int_sessions__stitched&quot; THEN 3&#13;&#10;WHEN &quot;30|All|model.acme_core.fct_order_items&quot; THEN 4&#13;&#10;WHEN &quot;30|All|model.acme_core.fct_inventory_daily&quot; THEN 5&#13;&#10;WHEN &quot;30|All|model.acme_core.int_orders__enriched&quot; THEN 6&#13;&#10;WHEN &quot;30|All|model.acme_core.fct_orders&quot; THEN 7&#13;&#10;WHEN &quot;30|All|model.acme_core.dim_customers&quot; THEN 8&#13;&#10;WHEN &quot;30|All|model.acme_product.int_customer_behavior&quot; THEN 9&#13;&#10;WHEN &quot;30|All|model.acme_core.int_inventory__snapshots&quot; THEN 10&#13;&#10;WHEN &quot;30|All|model.acme_core.fct_shipments&quot; THEN 11&#13;&#10;WHEN &quot;30|All|model.acme_core.fct_payments&quot; THEN 12&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_demand_signals&quot; THEN 13&#13;&#10;WHEN &quot;30|All|model.acme_core.int_payments__reconciled&quot; THEN 14&#13;&#10;WHEN &quot;30|All|model.acme_product.dim_customer_behavior&quot; THEN 15&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.dim_customer_360&quot; THEN 1&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_order_items&quot; THEN 2&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_inventory_daily&quot; THEN 3&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_orders__enriched&quot; THEN 4&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_orders&quot; THEN 5&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.dim_customers&quot; THEN 6&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_inventory__snapshots&quot; THEN 7&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_shipments&quot; THEN 8&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_payments&quot; THEN 9&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_payments__reconciled&quot; THEN 10&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_store_sales&quot; THEN 11&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_customers__deduped&quot; THEN 12&#13;&#10;WHEN &quot;30|snowflake|model.acme_marketing.fct_attribution&quot; THEN 13&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_partner_payouts&quot; THEN 14&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_revenue_daily&quot; THEN 15&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_sessions&quot; THEN 1&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_sessions__stitched&quot; THEN 2&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_customer_behavior&quot; THEN 3&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_demand_signals&quot; THEN 4&#13;&#10;