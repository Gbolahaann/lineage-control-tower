              <calculation class='tableau' formula='// GOV Domain Poor Point&#13;&#10;// Where each poor text sits (centred at half its measured width).&#13;&#10;CASE [Parameters].[Parameter 2] + &quot;|&quot; + STR([day_index])&#13;&#10;WHEN &quot;All|19&quot; THEN MAKEPOINT(-0.1400, 1.7200)&#13;&#10;WHEN &quot;All|28&quot; THEN MAKEPOINT(-0.7400, 1.0200)&#13;&#10;WHEN &quot;All|29&quot; THEN MAKEPOINT(-0.7400, 1.7200)&#13;&#10;WHEN &quot;snowflake|19&quot; THEN MAKEPOINT(-0.1400, 1.7200)&#13;&#10;WHEN &quot;databricks|13&quot; THEN MAKEPOINT(0.1600, 1.0200)&#13;&#10;WHEN &quot;databricks|14&quot; THEN MAKEPOINT(0.1600, 1.7200)&#13;&#10;ELSE NULL&#13;&#10;END' />
