            <column caption='BR Risk Rank' datatype='integer' name='[Calculation_7558805367311089462]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// BR Risk Rank&#13;&#10;// Place among the 10 riskiest nodes in the period under the platform filter (risk = failure rate x&#13;&#10;// average daily downstream consumers; written by the build, the prototype&apos;s rule).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|All|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;7|All|model.acme_core.stg_netsuite__journal_lines&quot; THEN 2&#13;&#10;WHEN &quot;7|All|model.acme_core.stg_shopify__order_items&quot; THEN 3&#13;&#10;WHEN &quot;7|All|model.acme_product.dim_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;7|All|model.acme_product.stg_events__page_views&quot; THEN 5&#13;&#10;WHEN &quot;7|All|model.acme_marketing.dim_companies&quot; THEN 6&#13;&#10;WHEN &quot;7|snowflake|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.stg_netsuite__journal_lines&quot; THEN 2&#13;&#10;WHEN &quot;7|snowflake|model.acme_core.stg_shopify__order_items&quot; THEN 3&#13;&#10;WHEN &quot;7|snowflake|model.acme_marketing.dim_companies&quot; THEN 4&#13;&#10;WHEN &quot;7|databricks|model.acme_product.dim_customer_behavior&quot; THEN 1&#13;&#10;WHEN &quot;7|databricks|model.acme_product.stg_events__page_views&quot; THEN 2&#13;&#10;WHEN &quot;7|redshift|model.acme_marketing.dim_companies&quot; THEN 1&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;30|All|source.acme_core.raw_stripe.payments&quot; THEN 2&#13;&#10;WHEN &quot;30|All|source.acme_product.raw_events.page_views&quot; THEN 3&#13;&#10;WHEN &quot;30|All|model.acme_core.stg_netsuite__accounts&quot; THEN 4&#13;&#10;WHEN &quot;30|All|model.acme_core.stg_netsuite__journal_lines&quot; THEN 5&#13;&#10;WHEN &quot;30|All|semantic.tableau.pds_board_kpis&quot; THEN 6&#13;&#10;WHEN &quot;30|All|model.acme_product.fct_support_sla_daily&quot; THEN 7&#13;&#10;WHEN &quot;30|All|model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 8&#13;&#10;WHEN &quot;30|All|model.acme_core.stg_shopify__order_items&quot; THEN 9&#13;&#10;WHEN &quot;30|All|model.acme_core.int_payments__reconciled&quot; THEN 10&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;30|snowflake|source.acme_core.raw_stripe.payments&quot; THEN 2&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.stg_netsuite__accounts&quot; THEN 3&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.stg_netsuite__journal_lines&quot; THEN 4&#13;&#10;WHEN &quot;30|snowflake|semantic.tableau.pds_board_kpis&quot; THEN 5&#13;&#10;WHEN &quot;30|snowflake|model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 6&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.stg_shopify__order_items&quot; THEN 7&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.int_payments__reconciled&quot; THEN 8&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.fct_board_kpis&quot; THEN 9&#13;&#10;WHEN &quot;30|snowflake|model.acme_core.stg_wms__warehouses&quot; THEN 10&#13;&#10;WHEN &quot;30|databricks|source.acme_product.raw_events.page_views&quot; THEN 1&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_support_sla_daily&quot; THEN 2&#13;&#10;WHEN &quot;30|databricks|model.acme_product.stg_events__page_views&quot; THEN 3&#13;&#10;WHEN &quot;30|databricks|model.acme_product.dim_customer_behavior&quot; THEN 4&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_customer_behavior&quot; THEN 5&#13;&#10;WHEN &quot;30|databricks|semantic.power_bi.pbi_support&quot; THEN 6&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_demand_signals&quot; THEN 7&#13;&#10;WHEN &quot;30|databricks|model.acme_product.stg_events__app_installs&quot; THEN 8&#13;&#10;WHEN &quot;30|databricks|model.acme_product.fct_sessions&quot; THEN 9&#13;&#10;WHEN &quot;30|databricks|model.acme_product.int_funnel__steps&quot; THEN 10&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 1&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.int_deals__pipeline&quot; THEN 2&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 3&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.dim_companies&quot; THEN 4&#13;&#10;WHEN &quot;30|redshift|model.acme_marketing.fct_ad_spend_daily&quot; THEN 5&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;90|All|source.acme_product.raw_events.page_views&quot; THEN 2&#13;&#10;WHEN &quot;90|All|source.acme_core.raw_stripe.payments&quot; THEN 3&#13;&#10;WHEN &quot;90|All|source.acme_product.raw_events.app_events&quot; THEN 4&#13;&#10;WHEN &quot;90|All|model.acme_marketing.stg_hubspot__deals&quot; THEN 5&#13;&#10;WHEN &quot;90|All|model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 6&#13;&#10;WHEN &quot;90|All|source.acme_product.raw_events.web_sessions&quot; THEN 7&#13;&#10;WHEN &quot;90|All|model.acme_marketing.stg_hubspot__companies&quot; THEN 8&#13;&#10;WHEN &quot;90|All|semantic.power_bi.pbi_support&quot; THEN 9&#13;&#10;WHEN &quot;90|All|semantic.tableau.pds_finance_revenue&quot; THEN 10&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_commerce_sales&quot; THEN 1&#13;&#10;WHEN &quot;90|snowflake|source.acme_core.raw_stripe.payments&quot; THEN 2&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.stg_hubspot__deals&quot; THEN 3&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 4&#13;&#10;WHEN &quot;90|snowflake|model.acme_marketing.stg_hubspot__companies&quot; THEN 5&#13;&#10;WHEN &quot;90|snowflake|semantic.tableau.pds_finance_revenue&quot; THEN 6&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.stg_netsuite__gl_entries&quot; THEN 7&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.stg_netsuite__journal_lines&quot; THEN 8&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.stg_netsuite__accounts&quot; THEN 9&#13;&#10;WHEN &quot;90|snowflake|model.acme_core.int_gl__mapped&quot; THEN 10&#13;&#10;WHEN &quot;90|databricks|source.acme_product.raw_events.page_views&quot; THEN 1&#13;&#10;WHEN &quot;90|databricks|source.acme_product.raw_events.app_events&quot; THEN 2&#13;&#10;WHEN &quot;90|databricks|source.acme_product.raw_events.web_sessions&quot; THEN 3&#13;&#10;WHEN &quot;90|databricks|semantic.power_bi.pbi_support&quot; THEN 4&#13;&#10;WHEN &quot;90|databricks|model.acme_product.fct_support_sla_daily&quot; THEN 5&#13;&#10;WHEN &quot;90|databricks|model.acme_product.stg_events__page_views&quot; THEN 6&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_sessions__stitched&quot; THEN 7&#13;&#10;WHEN &quot;90|databricks|model.acme_product.dim_customer_behavior&quot; THEN 8&#13;&#10;WHEN &quot;90|databricks|model.acme_product.int_customer_behavior&quot; THEN 9&#13;&#10;WHEN &quot;90|databricks|model.acme_product.stg_events__app_events&quot; THEN 10&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_hubspot__deals&quot; THEN 1&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_hubspot__deal_stages&quot; THEN 2&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_hubspot__companies&quot; THEN 3&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_hubspot__contacts&quot; THEN 4&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.fct_pipeline&quot; THEN 5&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_deals__pipeline&quot; THEN 6&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.stg_google_ads__ad_stats&quot; THEN 7&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_campaigns__spend_daily&quot; THEN 8&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__unified&quot; THEN 9&#13;&#10;WHEN &quot;90|redshift|model.acme_marketing.int_ads__attribution&quot; THEN 10&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Is BR Risk Row' datatype='boolean' name='[Calculation_2784560783958257650]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is BR Risk Row&#13;&#10;// Rows of the table. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_7558805367311089462])' />
            </column>
            <column caption='Dehighlight True' datatype='boolean' name='[Calculation_1329749043964588995]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight True&#13;&#10;// Source field of the dehighlight action (clicked marks are not left greyed out).&#13;&#10;TRUE' />
            </column>
            <column caption='Dehighlight False' datatype='boolean' name='[Calculation_1841670643858094106]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Dehighlight False&#13;&#10;// Target field of the dehighlight action: matches no mark, so the selection clears at once.&#13;&#10;FALSE' />
            </column>
            <column caption='BR Risk Row Key' datatype='string' name='[Calculation_8731899347497484331]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// BR Risk Row Key&#13;&#10;// The selected node&apos;s row in light blue.&#13;&#10;IF [node_id (dim_nodes.csv)] = [Parameters].[Parameter 4] THEN &quot;Selected&quot; ELSE &quot;Default&quot; END' />
            </column>
            <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
            </column>
            <column caption='BR Risk Row Point' datatype='spatial' name='[Calculation_1520394792704928467]' role='measure' type='nominal'>
