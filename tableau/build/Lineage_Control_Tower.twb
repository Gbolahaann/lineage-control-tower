          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
            </column>
            <column caption='Run Success - Trend' datatype='real' name='[Calculation_7172698235724822835]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Trend&#13;&#10;// Bars under the card: failed model runs per day (the prototype never plots a rate on a cut baseline).&#13;&#10;SUM([runs_failed])' />
            </column>
            <column caption='Run Success - Trend In Period' datatype='real' name='[Calculation_1059166526216479784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_7172698235724822835] END' />
            </column>
            <column caption='Run Success - Trend Out Period' datatype='real' name='[Calculation_2561166764669332405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Run Success - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_7172698235724822835] END' />
