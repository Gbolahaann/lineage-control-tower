    <worksheet name='QA Failing Now KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
            </column>
            <column caption='Is Failing On Last Day' datatype='boolean' name='[Calculation_6351627516110461744]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is Failing On Last Day&#13;&#10;// A test with a failure on 19 Oct (Test Daily only holds non-pass days). Check: 2 tests, as in the prototype.&#13;&#10;[days_before_as_of] = 0&#13;&#10;AND [fails] &gt; 0' />
            </column>
            <column caption='Tests Failing Now' datatype='integer' name='[Calculation_2823121125048494252]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Tests Failing Now&#13;&#10;// Mini KPI &quot;Failing right now&quot;.&#13;&#10;COUNTD(IF [Calculation_6351627516110461744] THEN [test_id] END)' />
            </column>
            <column caption='QA Failing Now Name' datatype='string' name='[Calculation_1571669004968560095]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// QA Failing Now Name&#13;&#10;// Red sub-line: one test failing on the last day. MAX picks the same one as the prototype&#13;&#10;// (&quot;unique_dim_customers_customer_id&quot;).&#13;&#10;MAX(IF [Calculation_6351627516110461744] THEN [test_name] END)' />
            </column>
            <column caption='QA All Passing Text' datatype='string' name='[Calculation_2697130262614228201]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// QA All Passing Text&#13;&#10;// Grey sub-line when nothing fails on the last day.&#13;&#10;IF [Calculation_2823121125048494252] = 0 THEN &quot;All tests passing&quot; END' />
            </column>
            <column caption='Days Before As Of' datatype='integer' name='[days_before_as_of]' role='dimension' type='ordinal' />
            <column caption='Fails' datatype='integer' name='[fails]' role='measure' type='quantitative' />
            <column caption='Platform Filter Values' datatype='string' name='[platform_filter_values]' role='dimension' type='nominal' />
            <column caption='Test Id' datatype='string' name='[test_id]' role='dimension' type='nominal' />
            <column caption='Test Name' datatype='string' name='[test_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2214252331607255986]' derivation='None' name='[none:Calculation_2214252331607255986:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2823121125048494252]' derivation='User' name='[usr:Calculation_2823121125048494252:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1571669004968560095]' derivation='User' name='[usr:Calculation_1571669004968560095:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2697130262614228201]' derivation='User' name='[usr:Calculation_2697130262614228201:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
