                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ&#10;</run>
                <run fontcolor='#a92e29' fontname='Arial' fontsize='8' bold='true'>&lt;[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_1964810160360354757:qk]&gt;</run>
                <run fontcolor='#a92e29' fontname='Arial' fontsize='8' bold='true'>Æ critical</run>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>Æ  ·  </run>
                <run fontcolor='#7a838e' fontname='Arial' fontsize='8'>&lt;[federated.07vo3ft0hzn0yt1e7nb981upju80].[usr:Calculation_8920847743012969069:qk]&gt;</run>
