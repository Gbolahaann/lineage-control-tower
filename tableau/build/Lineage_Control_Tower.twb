          <datasource-dependencies datasource='Parameters'>
            <column alias='Hide' caption='p_show_info' datatype='boolean' datatype-customized='true' name='[Parameter 7]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='true' value='Show' />
                <alias key='false' value='Hide' />
              </aliases>
              <members>
