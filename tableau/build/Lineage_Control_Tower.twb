      <column caption='Week Start' datatype='date' name='[week_start]' role='dimension' type='ordinal' />
      <column caption='Weekday' datatype='string' name='[weekday]' role='dimension' type='nominal' />
      <column caption='Worst Test Code' datatype='integer' name='[worst_test_code]' role='dimension' type='ordinal' />
      <column caption='X' datatype='real' name='[x]' role='measure' type='quantitative' />
      <column caption='X Label' datatype='real' hidden='true' name='[x_label]' role='measure' type='quantitative' />
      <column caption='Y' datatype='real' name='[y]' role='measure' type='quantitative' />
      <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
      <column caption='Period Option' datatype='integer' name='[Calculation_1395152531449864650]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Period Option&#13;&#10;// Scaffold: turns the first 3 days of dim_date into the 3 period buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN 7&#13;&#10;WHEN 1 THEN 30&#13;&#10;WHEN 2 THEN 90&#13;&#10;END' />
      </column>
      <column caption='Full Bar' datatype='real' name='[Calculation_2313436587575898004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Full Bar&#13;&#10;// Bar length for a full-width background (axis fixed 0 to 1 and hidden): buttons, alert rows.&#13;&#10;MIN(1.0)' />
      </column>
      <column caption='Text Anchor Centre' datatype='real' name='[Calculation_2496391787737110048]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Text Anchor Centre&#13;&#10;// Where centred text sits on a full-width background bar.&#13;&#10;MIN(0.5)' />
      </column>
      <column caption='Is Period Button Row' datatype='boolean' name='[Calculation_1896708728705539988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Period Button Row&#13;&#10;// Keeps the 3 scaffold rows that carry a period button. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1395152531449864650])' />
      </column>
      <column caption='Is Active Period Option' datatype='boolean' name='[Calculation_1290101426377148290]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Period Option&#13;&#10;// Colours the selected period button (Navy fill, white text) against the rest.&#13;&#10;[Calculation_1395152531449864650] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Period Option Label' datatype='string' name='[Calculation_3141427238531064247]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;&quot;Last &quot; + STR([Calculation_1395152531449864650]) + &quot; days&quot;' />
      </column>
      <column caption='Period Label Active' datatype='string' name='[Calculation_2018629980644388562]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Label Active&#13;&#10;// Button text when this button is the selected period (Semibold Navy run).&#13;&#10;IF [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
      </column>
      <column caption='Period Label Inactive' datatype='string' name='[Calculation_3943248154185459554]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Label Inactive&#13;&#10;// Button text when this button is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1290101426377148290] THEN [Calculation_3141427238531064247] ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Option Order' datatype='integer' name='[Calculation_1997623788981524034]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Platform Option Order&#13;&#10;// Keeps the platform buttons in prototype order (All, Snowflake, Databricks, Redshift) instead of A to Z.&#13;&#10;[day_index]' />
      </column>
      <column caption='Platform Option' datatype='string' name='[Calculation_1708304674625620149]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Option&#13;&#10;// Scaffold: turns the first 4 days of dim_date into the 4 platform buttons. Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;snowflake&quot;&#13;&#10;WHEN 2 THEN &quot;databricks&quot;&#13;&#10;WHEN 3 THEN &quot;redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Platform Button Row' datatype='boolean' name='[Calculation_1766699502863314635]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Button Row&#13;&#10;// Keeps the 4 scaffold rows that carry a platform button. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_1708304674625620149])' />
      </column>
      <column caption='Is Active Platform Option' datatype='boolean' name='[Calculation_1733161848805935888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Platform Option&#13;&#10;// Colours the selected platform button.&#13;&#10;[Calculation_1708304674625620149] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Platform Dot Snowflake' datatype='string' name='[Calculation_1113706873550636432]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Snowflake&#13;&#10;// Coloured square before &quot;Snowflake&quot; on its button. Each platform has its own field so each gets its own run colour.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;snowflake&quot; THEN &quot;■ &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Dot Databricks' datatype='string' name='[Calculation_2812498324364876413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Databricks&#13;&#10;// Coloured square before &quot;Databricks&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;databricks&quot; THEN &quot;■ &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Dot Redshift' datatype='string' name='[Calculation_2114073437937435113]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Dot Redshift&#13;&#10;// Coloured square before &quot;Redshift&quot; on its button.&#13;&#10;IF [Calculation_1708304674625620149] = &quot;redshift&quot; THEN &quot;■ &quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Option Label' datatype='string' name='[Calculation_1669066058101174507]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Option Label&#13;&#10;// Button text, as in the prototype.&#13;&#10;CASE [Calculation_1708304674625620149]&#13;&#10;WHEN &quot;All&quot;        THEN &quot;All&quot;&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Platform Label Active' datatype='string' name='[Calculation_1615833699327644939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Label Active&#13;&#10;// Button text when this button is the selected platform (Semibold Navy run).&#13;&#10;IF [Calculation_1733161848805935888] THEN [Calculation_1669066058101174507] ELSE &quot;&quot; END' />
      </column>
      <column caption='Platform Label Inactive' datatype='string' name='[Calculation_3045694386135075059]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Label Inactive&#13;&#10;// Button text when this button is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1733161848805935888] THEN [Calculation_1669066058101174507] ELSE &quot;&quot; END' />
      </column>
      <column caption='Has Prior Period' datatype='boolean' name='[Calculation_1497969784006078758]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Has Prior Period&#13;&#10;// FALSE at 90 days, when there is no earlier window in the data.&#13;&#10;// Drives the &quot;no earlier period&quot; wording. Measures don&apos;t need it: their Prior is NULL anyway.&#13;&#10;2 * [Parameters].[Parameter 1] &lt;= { MAX([day_index]) } + 1' />
      </column>
      <column caption='Period Hint Label' datatype='string' name='[Calculation_2651474984799504069]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Period Hint Label&#13;&#10;// Hint text at the right of the filter band, as in the prototype.&#13;&#10;IF [Calculation_1497969784006078758]&#13;&#10;    THEN &quot;Changes compare with the &quot; + STR([Parameters].[Parameter 1]) + &quot; days before&quot;&#13;&#10;ELSE &quot;No earlier period in the data to compare with&quot;&#13;&#10;END' />
      </column>
      <column caption='Data Updated Date Text' datatype='string' name='[Calculation_2445757024107576062]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Data Updated Date Text&#13;&#10;// The date part of the header stamp, shown bold after &quot;Data updated on &quot;.&#13;&#10;STR(DAY({ MAX([date (dim_date.csv)]) })) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, { MAX([date (dim_date.csv)]) }), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR({ MAX([date (dim_date.csv)]) }))&#13;&#10;+ &quot;, 23:59&quot;' />
      </column>
      <column caption='History Label' datatype='string' name='[Calculation_2111610048197173466]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// History Label&#13;&#10;// Second line of the header stamp: &quot;90 days of history from 22 Jul 2026&quot;.&#13;&#10;STR({ COUNTD([date (dim_date.csv)]) }) + &quot; days of history from &quot;&#13;&#10;+ STR(DAY({ MIN([date (dim_date.csv)]) })) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, { MIN([date (dim_date.csv)]) }), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR({ MIN([date (dim_date.csv)]) }))' />
      </column>
      <column caption='Is Info Button Row' datatype='boolean' name='[Calculation_6860269217128732528]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Info Button Row&#13;&#10;// One scaffold row for the single-mark info button. Put on Filters (True).&#13;&#10;[day_index] = 0' />
      </column>
      <column caption='Info Button Glyph' datatype='string' name='[Calculation_1055782736416529768]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Info Button Glyph&#13;&#10;// The header icon: &quot;ⓘ&quot; opens the info panel, &quot;✕&quot; closes it.&#13;&#10;IF [Parameters].[Parameter 7] THEN &quot;✕&quot; ELSE &quot;ⓘ&quot; END' />
      </column>
      <column caption='Info Toggle Value' datatype='boolean' name='[Calculation_1949193342976572784]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Info Toggle Value&#13;&#10;// The value the info button writes into p_show_info: the opposite of the current state.&#13;&#10;NOT [Parameters].[Parameter 7]' />
      </column>
      <column caption='Is Platform Match Day' datatype='boolean' name='[Calculation_1100032193373739257]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Day&#13;&#10;// Day-level platform filter for Node Daily. Migrated models count against Redshift before&#13;&#10;// their move and Snowflake after, so daily KPIs and cost split correctly by platform.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='In Period' datatype='boolean' name='[Calculation_1409194560049525583]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// In Period&#13;&#10;// TRUE for days inside the selected window: the last 7, 30 or 90 days up to 19 Oct.&#13;&#10;// Used by every &quot;- Focus&quot; measure and to colour the window on trend bars.&#13;&#10;[days_before_as_of] &lt; [Parameters].[Parameter 1]' />
      </column>
      <column caption='Run Success - Focus' datatype='real' name='[Calculation_1734332201503898389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Focus&#13;&#10;// Successful model runs / all model runs in the window. The mart&apos;s runs column already excludes skipped runs.&#13;&#10;// 30d check: 99.85%.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [runs] - [runs_failed] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [runs] END)' />
      </column>
      <column caption='In Prior Period' datatype='boolean' name='[Calculation_1036360725637968047]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// In Prior Period&#13;&#10;// TRUE for the same-length window just before the selected one.&#13;&#10;// Matches no rows at 90 days (the data starts 22 Jul), so every &quot;- Prior&quot; measure returns NULL there.&#13;&#10;[days_before_as_of] &gt;= [Parameters].[Parameter 1]&#13;&#10;AND [days_before_as_of] &lt; 2 * [Parameters].[Parameter 1]' />
      </column>
      <column caption='Run Success - Prior' datatype='real' name='[Calculation_2698166877041094131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Prior&#13;&#10;// Same rate for the window before. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [runs] - [runs_failed] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [runs] END)' />
      </column>
      <column caption='Run Success - Change' datatype='real' name='[Calculation_3389207884386059757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Change&#13;&#10;// Rate metric, so the change is in percentage points. 30d check: +0.10 pp.&#13;&#10;([Calculation_1734332201503898389] - [Calculation_2698166877041094131]) * 100' />
      </column>
      <column caption='Run Success - Change Good' datatype='real' name='[Calculation_2508963726874360695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Change Good&#13;&#10;// Green part of the change line. Higher is better, so a rise (or no change) lands here.&#13;&#10;// Format: ▲ 0.00 pp;▼ 0.00 pp;● 0 pp&#13;&#10;IF [Calculation_3389207884386059757] &gt;= 0 THEN [Calculation_3389207884386059757] END' />
      </column>
      <column caption='Run Success - Change Good Text' datatype='string' name='[Calculation_9292920473058013561]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Run Success - Change Good Text&#13;&#10;// Green part of the change line as text: &quot;▲ 0.10 pp&quot;, or &quot;● 0 pp&quot; when nothing changed.&#13;&#10;// Blank when the change is bad or there is no earlier period. Two decimals, as on the BAN.&#13;&#10;IF ISNULL([Calculation_2508963726874360695]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_2508963726874360695] = 0 THEN &quot;● 0 pp&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_2508963726874360695] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_2508963726874360695] * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Run Success - Change Bad' datatype='real' name='[Calculation_6587374685601982419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Change Bad&#13;&#10;// Red part of the change line: a fall in run success. Same number format as Change Good.&#13;&#10;IF [Calculation_3389207884386059757] &lt; 0 THEN [Calculation_3389207884386059757] END' />
      </column>
      <column caption='Run Success - Change Bad Text' datatype='string' name='[Calculation_1409042108075507256]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Run Success - Change Bad Text&#13;&#10;// Red part of the change line as text: &quot;▼ 0.03 pp&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_6587374685601982419]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_6587374685601982419]) * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND(ABS([Calculation_6587374685601982419]) * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Compare Label' datatype='string' name='[Calculation_1953312242491521622]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Compare Label&#13;&#10;// Grey tail of every KPI change line: &quot;vs prior 30d&quot;, or &quot;-  no earlier period&quot; at 90 days.&#13;&#10;IF [Calculation_1497969784006078758]&#13;&#10;    THEN &quot;vs prior &quot; + STR([Parameters].[Parameter 1]) + &quot;d&quot;&#13;&#10;ELSE &quot;-  no earlier period&quot;&#13;&#10;END' />
      </column>
      <column caption='Run Success - Trend' datatype='real' name='[Calculation_7172698235724822835]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Trend&#13;&#10;// Bars under the card: failed model runs per day (the prototype never plots a rate on a cut baseline).&#13;&#10;SUM([runs_failed])' />
      </column>
      <column caption='Run Success - Trend In Period' datatype='real' name='[Calculation_1059166526216479784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_7172698235724822835] END' />
      </column>
      <column caption='Run Success - Trend Out Period' datatype='real' name='[Calculation_2561166764669332405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Run Success - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_7172698235724822835] END' />
      </column>
      <column caption='Test Pass - Focus' datatype='real' name='[Calculation_1484671631694661168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Focus&#13;&#10;// Passing tests / all tests run in the window. Warnings count as not passing. 30d check: 99.41%.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [tests_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [tests_pass] + [tests_warn] + [tests_fail] END)' />
      </column>
      <column caption='Test Pass - Prior' datatype='real' name='[Calculation_2137113554368486090]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Prior&#13;&#10;// Same rate for the window before. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [tests_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [tests_pass] + [tests_warn] + [tests_fail] END)' />
      </column>
      <column caption='Test Pass - Change' datatype='real' name='[Calculation_2084733784715193085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Change&#13;&#10;// Rate metric, percentage points.&#13;&#10;([Calculation_1484671631694661168] - [Calculation_2137113554368486090]) * 100' />
      </column>
      <column caption='Test Pass - Change Good' datatype='real' name='[Calculation_5917572901775054444]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Change Good&#13;&#10;// Higher is better. Format: ▲ 0.00 pp;▼ 0.00 pp;● 0 pp&#13;&#10;IF [Calculation_2084733784715193085] &gt;= 0 THEN [Calculation_2084733784715193085] END' />
      </column>
      <column caption='Test Pass - Change Good Text' datatype='string' name='[Calculation_1950607229902710421]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Test Pass - Change Good Text&#13;&#10;// Green part of the change line as text: &quot;▲ 0.10 pp&quot;, or &quot;● 0 pp&quot; when nothing changed.&#13;&#10;// Blank when the change is bad or there is no earlier period. Two decimals, as on the BAN.&#13;&#10;IF ISNULL([Calculation_5917572901775054444]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_5917572901775054444] = 0 THEN &quot;● 0 pp&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_5917572901775054444] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_5917572901775054444] * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Test Pass - Change Bad' datatype='real' name='[Calculation_3363780124593530695]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Change Bad&#13;&#10;// A fall in the pass rate. Same number format.&#13;&#10;IF [Calculation_2084733784715193085] &lt; 0 THEN [Calculation_2084733784715193085] END' />
      </column>
      <column caption='Test Pass - Change Bad Text' datatype='string' name='[Calculation_1148189262971748201]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Test Pass - Change Bad Text&#13;&#10;// Red part of the change line as text: &quot;▼ 0.03 pp&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_3363780124593530695]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_3363780124593530695]) * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND(ABS([Calculation_3363780124593530695]) * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Test Pass - Trend' datatype='real' name='[Calculation_2879388710444902546]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Trend&#13;&#10;// Bars: failing or warning test executions per day. The Monday spikes are story 2.&#13;&#10;SUM([tests_warn] + [tests_fail])' />
      </column>
      <column caption='Test Pass - Trend In Period' datatype='real' name='[Calculation_5039955109046369523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_2879388710444902546] END' />
      </column>
      <column caption='Test Pass - Trend Out Period' datatype='real' name='[Calculation_4452841432140642752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Test Pass - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_2879388710444902546] END' />
      </column>
      <column caption='Freshness SLA - Focus' datatype='real' name='[Calculation_1872933243208732540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Focus&#13;&#10;// Hourly source freshness checks that passed / all checks in the window. 30d check: 99.87%.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [fresh_checks_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [fresh_checks_pass] + [fresh_checks_warn] + [fresh_checks_error] END)' />
      </column>
      <column caption='Freshness SLA - Prior' datatype='real' name='[Calculation_3014479629346497840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Prior&#13;&#10;// Same rate for the window before. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [fresh_checks_pass] END)&#13;&#10;/&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [fresh_checks_pass] + [fresh_checks_warn] + [fresh_checks_error] END)' />
      </column>
      <column caption='Freshness SLA - Change' datatype='real' name='[Calculation_1466251191431629742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Change&#13;&#10;// Rate metric, percentage points.&#13;&#10;([Calculation_1872933243208732540] - [Calculation_3014479629346497840]) * 100' />
      </column>
      <column caption='Freshness SLA - Change Good' datatype='real' name='[Calculation_1299950345497314843]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Change Good&#13;&#10;// Higher is better. Format: ▲ 0.00 pp;▼ 0.00 pp;● 0 pp&#13;&#10;IF [Calculation_1466251191431629742] &gt;= 0 THEN [Calculation_1466251191431629742] END' />
      </column>
      <column caption='Freshness SLA - Change Good Text' datatype='string' name='[Calculation_3150169085595565380]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Freshness SLA - Change Good Text&#13;&#10;// Green part of the change line as text: &quot;▲ 0.10 pp&quot;, or &quot;● 0 pp&quot; when nothing changed.&#13;&#10;// Blank when the change is bad or there is no earlier period. Two decimals, as on the BAN.&#13;&#10;IF ISNULL([Calculation_1299950345497314843]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_1299950345497314843] = 0 THEN &quot;● 0 pp&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_1299950345497314843] * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND([Calculation_1299950345497314843] * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Freshness SLA - Change Bad' datatype='real' name='[Calculation_9932674774647368440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Change Bad&#13;&#10;// A fall in freshness compliance. Same number format.&#13;&#10;IF [Calculation_1466251191431629742] &lt; 0 THEN [Calculation_1466251191431629742] END' />
      </column>
      <column caption='Freshness SLA - Change Bad Text' datatype='string' name='[Calculation_1352644649828212213]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Freshness SLA - Change Bad Text&#13;&#10;// Red part of the change line as text: &quot;▼ 0.03 pp&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_9932674774647368440]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_9932674774647368440]) * 100) / 100)) + &quot;.&quot; + RIGHT(&quot;0&quot; + STR(INT(ROUND(ABS([Calculation_9932674774647368440]) * 100)) % 100), 2) + &quot; pp&quot;&#13;&#10;END' />
      </column>
      <column caption='Freshness SLA - Trend' datatype='real' name='[Calculation_2466217536611413858]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Trend&#13;&#10;// Bars: late source checks (warn or error) per day. The 1 Oct spike is the Stripe outage (story 5).&#13;&#10;SUM([fresh_checks_warn] + [fresh_checks_error])' />
      </column>
      <column caption='Freshness SLA - Trend In Period' datatype='real' name='[Calculation_1084932894337796393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_2466217536611413858] END' />
      </column>
      <column caption='Freshness SLA - Trend Out Period' datatype='real' name='[Calculation_2103565215221969907]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Freshness SLA - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_2466217536611413858] END' />
      </column>
      <column caption='Is Platform Match Node' datatype='boolean' name='[Calculation_2214252331607255986]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Node&#13;&#10;// Node-level platform filter (dim_nodes). A migrated node matches both Redshift and Snowflake,&#13;&#10;// so it still shows when someone looks at Redshift history.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR CONTAINS([platform_filter_values], &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot;)' />
      </column>
      <column caption='Is At Risk Now' datatype='boolean' name='[Calculation_2875175252813195699]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is At Risk Now&#13;&#10;// Warning or Critical in the current snapshot. Shared by Health, Blast radius and Governance.&#13;&#10;[current_status_code] &gt;= 2' />
      </column>
      <column caption='Exposures At Risk Now' datatype='integer' name='[Calculation_2866140559093986658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk Now&#13;&#10;// Exposures whose upstream chain is Warning or Critical in the current snapshot. Check: 12.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [Calculation_2875175252813195699] THEN 1 END))' />
      </column>
      <column caption='Exposures In Scope' datatype='integer' name='[Calculation_3186893425654714520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures In Scope&#13;&#10;// All exposures for the selected platform, including unregistered ones. Check: 27.&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; THEN 1 END))' />
      </column>
      <column caption='Exposures At Risk Of Label' datatype='string' name='[Calculation_2683875477335081578]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Exposures At Risk Of Label&#13;&#10;// Small grey suffix after the BAN: &quot;of 27 now&quot;.&#13;&#10;&quot;of &quot; + STR([Calculation_3186893425654714520]) + &quot; now&quot;' />
      </column>
      <column caption='Exposures Critical Now' datatype='integer' name='[Calculation_1964810160360354757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures Critical Now&#13;&#10;// Change-line lead, in red: &quot;4 critical&quot;. Format: 0 &quot;critical&quot;&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [current_status_code] = 3 THEN 1 END))' />
      </column>
      <column caption='Exposures Warning Now' datatype='integer' name='[Calculation_8920847743012969069]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures Warning Now&#13;&#10;// Change-line tail, in grey: &quot;· 8 warning&quot;. Format: &quot;· &quot;0&quot; warning&quot;&#13;&#10;ZN(SUM(IF [resource_type] = &quot;exposure&quot; AND [current_status_code] = 2 THEN 1 END))' />
      </column>
      <column caption='Exposures At Risk - Trend' datatype='integer' name='[Calculation_3996116585410579374]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk - Trend&#13;&#10;// Exposures Warning or Critical at the end of each day. One row per exposure per day, so this counts exposures.&#13;&#10;SUM(IF [status_eod_code] &gt;= 2 THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Exposures At Risk - Trend In Period' datatype='real' name='[Calculation_2107588681978104977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_3996116585410579374] END' />
      </column>
      <column caption='Exposures At Risk - Trend Out Period' datatype='real' name='[Calculation_3360750808181857461]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Exposures At Risk - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_3996116585410579374] END' />
      </column>
      <column caption='Is Platform Match Day (Episodes)' datatype='boolean' name='[Calculation_3348788321593585024]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Day (Episodes)&#13;&#10;// Same rule for Recovery Episodes: the platform the node was on when the failure started.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform_on_day (mart_recovery_episodes.csv)] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='MTTR - Focus' datatype='real' name='[Calculation_1490761445074029792]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Focus&#13;&#10;// Mean hours from a node&apos;s first failure to its next success, for episodes that started in the window and have recovered.&#13;&#10;// Covers model runs, source freshness and BI refreshes. 30d check: 4.87 h.&#13;&#10;AVG(IF [Calculation_1409194560049525583] AND NOT [is_open] THEN [hours_to_recover] END)' />
      </column>
      <column caption='MTTR - Focus Label' datatype='string' name='[Calculation_6570730252120364370]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// MTTR - Focus Label&#13;&#10;// BAN text, matching the prototype: minutes under an hour, otherwise hours to 1 decimal. &quot;-&quot; when nothing recovered.&#13;&#10;IF ISNULL([Calculation_1490761445074029792]) THEN &quot;-&quot;&#13;&#10;ELSEIF [Calculation_1490761445074029792] &lt; 1&#13;&#10;    THEN STR(ROUND([Calculation_1490761445074029792] * 60)) + &quot; min&quot;&#13;&#10;ELSE STR(ROUND([Calculation_1490761445074029792], 1)) + &quot; h&quot;&#13;&#10;END' />
      </column>
      <column caption='MTTR - Prior' datatype='real' name='[Calculation_8777189573491179478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Prior&#13;&#10;// Same average for episodes that started in the window before. NULL at 90 days.&#13;&#10;AVG(IF [Calculation_1036360725637968047] AND NOT [is_open] THEN [hours_to_recover] END)' />
      </column>
      <column caption='MTTR - Change' datatype='real' name='[Calculation_9964583792416952326]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Change&#13;&#10;// Percentage change. Inverse metric: a rise is bad.&#13;&#10;IF [Calculation_8777189573491179478] = 0 OR ISNULL([Calculation_8777189573491179478]) THEN NULL&#13;&#10;ELSE [Calculation_1490761445074029792] / [Calculation_8777189573491179478] - 1&#13;&#10;END' />
      </column>
      <column caption='MTTR - Change Good' datatype='real' name='[Calculation_2649301209160798169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Change Good&#13;&#10;// Inverse metric, so a fall (or no change) is good and shows in green. Format: ▲ 0.0%;▼ 0.0%;● 0%&#13;&#10;IF [Calculation_9964583792416952326] &lt;= 0 THEN [Calculation_9964583792416952326] END' />
      </column>
      <column caption='MTTR - Change Good Text' datatype='string' name='[Calculation_8864060235112699764]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// MTTR - Change Good Text&#13;&#10;// Inverse metric: a fall is good. Green text &quot;▼ 10.8%&quot;, or &quot;● 0%&quot; when nothing changed.&#13;&#10;IF ISNULL([Calculation_2649301209160798169]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_2649301209160798169] = 0 THEN &quot;● 0%&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_2649301209160798169]) * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_2649301209160798169]) * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='MTTR - Change Bad' datatype='real' name='[Calculation_1820979831573442882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Change Bad&#13;&#10;// A rise in recovery time, in red. Same number format.&#13;&#10;IF [Calculation_9964583792416952326] &gt; 0 THEN [Calculation_9964583792416952326] END' />
      </column>
      <column caption='MTTR - Change Bad Text' datatype='string' name='[Calculation_2992056182811374933]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// MTTR - Change Bad Text&#13;&#10;// Inverse metric: a rise is bad. Red text &quot;▲ 4.2%&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_1820979831573442882]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_1820979831573442882] * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([Calculation_1820979831573442882] * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='MTTR - Trend' datatype='real' name='[Calculation_7021360273238040373]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Trend&#13;&#10;// Bars: mean recovery time of episodes that started each day. Days with no episodes stay empty.&#13;&#10;AVG(IF NOT [is_open] THEN [hours_to_recover] END)' />
      </column>
      <column caption='MTTR - Trend In Period' datatype='real' name='[Calculation_2182700666057493534]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_7021360273238040373] END' />
      </column>
      <column caption='MTTR - Trend Out Period' datatype='real' name='[Calculation_2828040696381880192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// MTTR - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_7021360273238040373] END' />
      </column>
      <column caption='Warehouse Cost - Focus' datatype='real' name='[Calculation_2007928041536179389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Focus&#13;&#10;// dbt build cost plus direct consumer query cost, USD, in the window. 30d check: $4,189.&#13;&#10;SUM(IF [Calculation_1409194560049525583] THEN [build_cost_usd] + [consumer_query_cost_usd] END)' />
      </column>
      <column caption='Warehouse Cost - Prior' datatype='real' name='[Calculation_4337567063949269036]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Prior&#13;&#10;// Same total for the window before. 30d check: $4,935. NULL at 90 days.&#13;&#10;SUM(IF [Calculation_1036360725637968047] THEN [build_cost_usd] + [consumer_query_cost_usd] END)' />
      </column>
      <column caption='Warehouse Cost - Change' datatype='real' name='[Calculation_2589026499509165578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Change&#13;&#10;// Percentage change. Inverse metric: a rise is bad. 30d check: -15.1%.&#13;&#10;IF [Calculation_4337567063949269036] = 0 OR ISNULL([Calculation_4337567063949269036]) THEN NULL&#13;&#10;ELSE [Calculation_2007928041536179389] / [Calculation_4337567063949269036] - 1&#13;&#10;END' />
      </column>
      <column caption='Warehouse Cost - Change Good' datatype='real' name='[Calculation_1563871595510825643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Good&#13;&#10;// A fall in cost, in green. Format: ▲ 0.0%;▼ 0.0%;● 0%&#13;&#10;IF [Calculation_2589026499509165578] &lt;= 0 THEN [Calculation_2589026499509165578] END' />
      </column>
      <column caption='Warehouse Cost - Change Good Text' datatype='string' name='[Calculation_6597731815754042260]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Good Text&#13;&#10;// Inverse metric: a fall is good. Green text &quot;▼ 10.8%&quot;, or &quot;● 0%&quot; when nothing changed.&#13;&#10;IF ISNULL([Calculation_1563871595510825643]) THEN &quot;&quot;&#13;&#10;ELSEIF [Calculation_1563871595510825643] = 0 THEN &quot;● 0%&quot;&#13;&#10;ELSE &quot;▼ &quot; + STR(INT(ROUND(ABS([Calculation_1563871595510825643]) * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_1563871595510825643]) * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Warehouse Cost - Change Bad' datatype='real' name='[Calculation_3322367611289919336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Bad&#13;&#10;// A rise in cost, in red. Same number format.&#13;&#10;IF [Calculation_2589026499509165578] &gt; 0 THEN [Calculation_2589026499509165578] END' />
      </column>
      <column caption='Warehouse Cost - Change Bad Text' datatype='string' name='[Calculation_3322579375304469107]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Warehouse Cost - Change Bad Text&#13;&#10;// Inverse metric: a rise is bad. Red text &quot;▲ 4.2%&quot;. Blank otherwise.&#13;&#10;IF ISNULL([Calculation_3322367611289919336]) THEN &quot;&quot;&#13;&#10;ELSE &quot;▲ &quot; + STR(INT(ROUND([Calculation_3322367611289919336] * 100 * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([Calculation_3322367611289919336] * 100 * 10)) % 10) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='Warehouse Cost - Trend' datatype='real' name='[Calculation_2340317715032000993]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Trend&#13;&#10;// Bars: daily cost. The early-October drop is fct_sessions going incremental (story 1).&#13;&#10;SUM([build_cost_usd] + [consumer_query_cost_usd])' />
      </column>
      <column caption='Warehouse Cost - Trend In Period' datatype='real' name='[Calculation_3253353875959333377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Trend In Period&#13;&#10;// The trend bars inside the selected window (accent colour set on the pane).&#13;&#10;IF ATTR([Calculation_1409194560049525583]) THEN [Calculation_2340317715032000993] END' />
      </column>
      <column caption='Warehouse Cost - Trend Out Period' datatype='real' name='[Calculation_4504844918117665692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Warehouse Cost - Trend Out Period&#13;&#10;// The trend bars outside the selected window (grey #D9DCD7 set on the pane).&#13;&#10;IF NOT ATTR([Calculation_1409194560049525583]) THEN [Calculation_2340317715032000993] END' />
      </column>
      <column caption='Tile Row' datatype='integer' name='[Calculation_1091687039505899741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tile Row&#13;&#10;// Row inside each group. Same compute-using and sort as Tile Column. Make it discrete.&#13;&#10;INT((INDEX() - 1) / 5) + 1'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_4441281616373123992]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Tile Column' datatype='integer' name='[Calculation_7154026945591774946]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tile Column&#13;&#10;// Column 1 to 5 in the tile grid (the prototype shows 5 tiles per row).&#13;&#10;// Table calc: Specific dimensions = exposure_group, node_id (dim_nodes.csv); restart every exposure_group;&#13;&#10;// sort by Tile Sort Key, MIN, ascending. Make it discrete.&#13;&#10;(INDEX() - 1) % 5 + 1'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_4441281616373123992]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Is Exposure' datatype='boolean' name='[Calculation_8377152860883702219]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Exposure&#13;&#10;// Keeps exposure rows only. Put on Filters (True).&#13;&#10;[resource_type] = &quot;exposure&quot;' />
      </column>
      <column caption='Show Exposure Tile' datatype='boolean' name='[Calculation_1065115793061580082]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Show Exposure Tile&#13;&#10;// The All / Needs attention switch above the grid.&#13;&#10;[Parameters].[Parameter 8] = &quot;All&quot;&#13;&#10;OR [Calculation_2875175252813195699]' />
      </column>
      <column caption='Exposure Group Sort' datatype='integer' name='[Calculation_1368642606501877949]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Exposure Group Sort&#13;&#10;// Prototype group order: BI dashboards, Apps ML and notebooks, AI agents and data hubs, Unregistered.&#13;&#10;CASE [exposure_group]&#13;&#10;WHEN &quot;BI dashboards&quot;                        THEN 1&#13;&#10;WHEN &quot;Apps, ML and notebooks&quot;               THEN 2&#13;&#10;WHEN &quot;AI agents and data hubs&quot;              THEN 3&#13;&#10;WHEN &quot;Unregistered, found in query history&quot; THEN 4&#13;&#10;END' />
      </column>
      <column caption='Is Tile Group 1' datatype='boolean' name='[Calculation_8860039790701088011]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile Group 1&#13;&#10;// Keeps the tiles of one exposure group on its own sheet. Put on Filters (True).&#13;&#10;[Calculation_1368642606501877949] = 1' />
      </column>
      <column caption='Tile Sort Key' datatype='string' name='[Calculation_4441281616373123992]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Sort Key&#13;&#10;// Worst first, then name, inside each group: &quot;6...&quot; Critical, &quot;7...&quot; Warning, &quot;8...&quot; Healthy.&#13;&#10;// Used as the custom sort (MIN, ascending) of the tile INDEX.&#13;&#10;STR(9 - [current_status_code]) + [display_name]' />
      </column>
      <column caption='Status Label' datatype='string' name='[Calculation_3105941082857465865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Status Label&#13;&#10;// One status vocabulary for every sheet. Assign the palette once on this field:&#13;&#10;// Healthy #2F9E6B, Warning #E8A33D, Critical #D2453F, No data #A3ADB8.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 3 THEN &quot;Critical&quot;&#13;&#10;WHEN 2 THEN &quot;Warning&quot;&#13;&#10;WHEN 1 THEN &quot;Healthy&quot;&#13;&#10;ELSE &quot;No data&quot;&#13;&#10;END' />
      </column>
      <column caption='Tile Border Key' datatype='string' name='[Calculation_2146754034371610369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Border Key&#13;&#10;// Tile border colour by status (#E6E7E2, warning #F1DDB8, critical #EDC3C0).&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Exposure Path Index' datatype='integer' name='[Calculation_2209184240857417826]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Exposure Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Exposure Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date (mart_exposure_daily.csv)]) }, [date (mart_exposure_daily.csv)]), 87)' />
      </column>
      <column caption='Tile Border Point' datatype='spatial' name='[Calculation_3333512912099760788]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Border Point&#13;&#10;// Tile outline, 162 x 62 px, radius 8.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 23 + 8 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((84.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 72 + 8 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Clear Node Value' datatype='string' name='[Calculation_1962397006096080865]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Clear Node Value&#13;&#10;// Empty string a parameter action can write into p_selected_node, to clear it (prototype: opening an exposure clears the node).&#13;&#10;&quot;&quot;' />
      </column>
      <column caption='Clear Node Key Value' datatype='integer' name='[Calculation_7177065549275409274]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Clear Node Key Value&#13;&#10;// Companion to Clear Node Value for p_selected_node_key. -1 matches no node.&#13;&#10;-1' />
      </column>
      <column caption='Panel Tags Value' datatype='string' name='[Calculation_9860372241269830816]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Panel Tags Value&#13;&#10;// What a click writes into p_panel_tags: &quot;|moved|ai|unregistered|&quot; for the tags this node carries.&#13;&#10;&quot;|&quot; + IF NOT ISNULL([migrated_from_platform]) THEN &quot;moved|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF [build_method] = &quot;ai_assisted&quot; THEN &quot;ai|&quot; ELSE &quot;&quot; END&#13;&#10;+ IF NOT [is_declared] THEN &quot;unregistered|&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Score Text' datatype='string' name='[Calculation_1659843968626155727]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Score Text&#13;&#10;// 7-day health score on the tile, one decimal: &quot;99.7&quot;.&#13;&#10;IF ISNULL([health_score_now]) THEN &quot;&quot;&#13;&#10;ELSE STR(INT(ROUND([health_score_now] * 10) / 10)) + &quot;.&quot; + STR(INT(ROUND([health_score_now] * 10)) % 10)&#13;&#10;END' />
      </column>
      <column caption='Tile Tooltip Why' datatype='string' name='[Calculation_1883889205833775337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Tooltip Why&#13;&#10;// Tooltip &quot;Why&quot; block: the upstream nodes behind the status, or a reassurance line.&#13;&#10;IF [culprit_count] &gt; 0 THEN [culprit_nodes]&#13;&#10;ELSE &quot;Every upstream step is healthy&quot;&#13;&#10;END' />
      </column>
      <column caption='Tile Fill Key' datatype='string' name='[Calculation_2950369687746909721]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Fill Key&#13;&#10;// Tile fill by status: white, critical #FBEAE9.&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Tile Fill Point' datatype='spatial' name='[Calculation_1871695570403440015]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Fill Point&#13;&#10;// Tile fill, 1px inside the border.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 23 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((84.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 72 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Edge Key' datatype='string' name='[Calculation_2561198721248056038]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Edge Key&#13;&#10;// The 3px top edge of a tile: critical #D2453F, warning #FDF3E1, otherwise the fill.&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Tile Edge Point' datatype='spatial' name='[Calculation_1113835329291751442]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Edge Point&#13;&#10;// The coloured top edge: the fill cut to its top 3px.&#13;&#10;MAKEPOINT(&#13;&#10;    MAX((0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 23 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100, 0.2700),&#13;&#10;    ((84.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 72 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Dot Point' datatype='spatial' name='[Calculation_1781533279255170688]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Dot Point&#13;&#10;// Status dot, 8px, top right.&#13;&#10;MAKEPOINT(&#13;&#10;    (15 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 4 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((149.0) - 84 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 0 + 4 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile AI Border Point' datatype='spatial' name='[Calculation_2037306926675212976]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile AI Border Point&#13;&#10;// AI-built pill outline after the trust badge; shrinks away when the tile is not AI-built.&#13;&#10;MAKEPOINT(&#13;&#10;    (-17 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 4 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((4 + CASE [current_status_code] WHEN 3 THEN 87.3 WHEN 2 THEN 113.0 ELSE 72.9 END) - 84 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 19.5 + 4 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile AI Fill Point' datatype='spatial' name='[Calculation_1853842245305432435]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile AI Fill Point&#13;&#10;// AI-built pill fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (-17 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 3 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((4 + CASE [current_status_code] WHEN 3 THEN 87.3 WHEN 2 THEN 113.0 ELSE 72.9 END) - 84 + IIF(IFNULL([build_method], &quot;&quot;) = &quot;ai_assisted&quot;, 1, 0) * ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 19.5 + 3 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Name Short' datatype='string' name='[Calculation_8990803335852813669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Name Short&#13;&#10;// Tile title cut to fit the card beside the status dot: 17 characters, then &quot;…&quot;.&#13;&#10;IF LEN([display_name]) &gt; 18 THEN LEFT([display_name], 17) + &quot;…&quot; ELSE [display_name] END' />
      </column>
      <column caption='Tile Name Point' datatype='spatial' name='[Calculation_2021794883042844412]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Name Point&#13;&#10;// Start of the tile name.&#13;&#10;MAKEPOINT(&#13;&#10;    0.1500,&#13;&#10;    -0.7400&#13;&#10;)' />
      </column>
      <column caption='Consumer Type Label' datatype='string' name='[Calculation_2336170961516567926]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Consumer Type Label&#13;&#10;// Tile meta line: the BI tool for dashboards, otherwise the consumer type.&#13;&#10;IF NOT ISNULL([bi_tool]) THEN&#13;&#10;    CASE [bi_tool]&#13;&#10;    WHEN &quot;tableau&quot;  THEN &quot;Tableau&quot;&#13;&#10;    WHEN &quot;sigma&quot;    THEN &quot;Sigma&quot;&#13;&#10;    WHEN &quot;power_bi&quot; THEN &quot;Power BI&quot;&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    CASE [exposure_type]&#13;&#10;    WHEN &quot;dashboard&quot; THEN &quot;Dashboard&quot;&#13;&#10;    WHEN &quot;notebook&quot;  THEN &quot;Notebook&quot;&#13;&#10;    WHEN &quot;ml&quot;        THEN &quot;ML model&quot;&#13;&#10;    WHEN &quot;data_app&quot;  THEN &quot;Data app&quot;&#13;&#10;    WHEN &quot;agent&quot;     THEN &quot;AI agent&quot;&#13;&#10;    WHEN &quot;data_hub&quot;  THEN &quot;Data hub&quot;&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Tile Owner Text' datatype='string' name='[Calculation_3035768374696072600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Owner Text&#13;&#10;// Owner on the tile meta line, grey. Empty when there is no owner (the red version takes over).&#13;&#10;IF [owner_name] &lt;&gt; &quot;No owner&quot; THEN [owner_name] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Meta Text' datatype='string' name='[Calculation_9469610853407196222]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Meta Text&#13;&#10;// Second tile line, grey: &quot;Tableau · Priya Raman&quot; (the red &quot;No owner&quot; follows when there is none).&#13;&#10;[Calculation_2336170961516567926] + &quot; · &quot; + [Calculation_3035768374696072600]' />
      </column>
      <column caption='Tile Owner Missing Text' datatype='string' name='[Calculation_2565169924538089914]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Owner Missing Text&#13;&#10;// &quot;No owner&quot; in red bold on the meta line (story 8 and the unregistered consumers).&#13;&#10;IF [owner_name] = &quot;No owner&quot; THEN &quot;No owner&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Meta Point' datatype='spatial' name='[Calculation_2094161589767259837]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Meta Point&#13;&#10;// Start of the tool and owner line.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.0100,&#13;&#10;    -0.7400&#13;&#10;)' />
      </column>
      <column caption='Tile Trust Critical' datatype='string' name='[Calculation_2803746157308900676]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Trust Critical&#13;&#10;// Trust badge in red. Only one of the three trust fields is filled for a tile.&#13;&#10;IF [current_status_code] = 3 THEN [trust_badge] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Trust Warning' datatype='string' name='[Calculation_1833995497923574551]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Trust Warning&#13;&#10;// Trust badge in the warning text colour #93600F.&#13;&#10;IF [current_status_code] = 2 THEN [trust_badge] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Trust Healthy' datatype='string' name='[Calculation_1522121282636949905]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile Trust Healthy&#13;&#10;// Trust badge in green.&#13;&#10;IF [current_status_code] &lt; 2 THEN [trust_badge] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile Trust Point' datatype='spatial' name='[Calculation_1637570669490700936]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Trust Point&#13;&#10;// Start of the trust badge.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.1700,&#13;&#10;    -0.7400&#13;&#10;)' />
      </column>
      <column caption='Tile AI Tag' datatype='string' name='[Calculation_4692392410293798022]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile AI Tag&#13;&#10;// &quot;AI-built&quot; chip text for ai_assisted exposures (story 10 and the agents).&#13;&#10;IF [build_method] = &quot;ai_assisted&quot; THEN &quot;AI-built&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile AI Text Point' datatype='spatial' name='[Calculation_2807702554943169410]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile AI Text Point&#13;&#10;// Middle of the AI-built pill.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.1700,&#13;&#10;    ((4 + CASE [current_status_code] WHEN 3 THEN 87.3 WHEN 2 THEN 113.0 ELSE 72.9 END) - 84) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Score Point' datatype='spatial' name='[Calculation_3365331846570732051]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Score Point&#13;&#10;// Right end of the score: 15px in from the card edge, as GB set it on v13.&#13;&#10;MAKEPOINT(&#13;&#10;    -0.1700,&#13;&#10;    0.6500&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Border Point 1' datatype='spatial' name='[Calculation_1129826418626077172]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Border Point 1&#13;&#10;// Count chip outline after the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((105.16796875) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Fill Point 1' datatype='spatial' name='[Calculation_3269593527923829219]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Fill Point 1&#13;&#10;// Count chip fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 6 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((105.16796875) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 6 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Title Point' datatype='spatial' name='[Calculation_1239260752454714087]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Title Point&#13;&#10;// Start of the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -4.1600&#13;&#10;)' />
      </column>
      <column caption='Tile Group Count' datatype='integer' name='[Calculation_2601468149520387165]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tile Group Count&#13;&#10;// Tiles in this group after the Platform filter and the All / Needs attention switch.&#13;&#10;COUNTD([node_id (dim_nodes.csv)])' />
      </column>
      <column caption='Tile Header Count Point 1' datatype='spatial' name='[Calculation_2166497026583613469]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Count Point 1&#13;&#10;// Middle of the count chip.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -3.1483&#13;&#10;)' />
      </column>
      <column caption='Is Tile Group 2' datatype='boolean' name='[Calculation_1617075257079254832]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile Group 2&#13;&#10;// Keeps the tiles of one exposure group on its own sheet. Put on Filters (True).&#13;&#10;[Calculation_1368642606501877949] = 2' />
      </column>
      <column caption='Tile Header Chip Border Point 2' datatype='spatial' name='[Calculation_2016781804334846504]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Border Point 2&#13;&#10;// Count chip outline after the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.701171875) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Fill Point 2' datatype='spatial' name='[Calculation_3235027401630484562]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Fill Point 2&#13;&#10;// Count chip fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 6 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.701171875) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 6 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Count Point 2' datatype='spatial' name='[Calculation_1751133796904004772]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Count Point 2&#13;&#10;// Middle of the count chip.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -2.6430&#13;&#10;)' />
      </column>
      <column caption='Is Tile Group 3' datatype='boolean' name='[Calculation_1578473119693928549]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile Group 3&#13;&#10;// Keeps the tiles of one exposure group on its own sheet. Put on Filters (True).&#13;&#10;[Calculation_1368642606501877949] = 3' />
      </column>
      <column caption='Tile Header Chip Border Point 3' datatype='spatial' name='[Calculation_3479913310745802258]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Border Point 3&#13;&#10;// Count chip outline after the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.3359375) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Fill Point 3' datatype='spatial' name='[Calculation_3391211921367864302]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Fill Point 3&#13;&#10;// Count chip fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 6 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((155.3359375) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 6 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Count Point 3' datatype='spatial' name='[Calculation_1306975744353670788]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Count Point 3&#13;&#10;// Middle of the count chip.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -2.6466&#13;&#10;)' />
      </column>
      <column caption='Is Tile Group 4' datatype='boolean' name='[Calculation_1702540457298106261]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile Group 4&#13;&#10;// Keeps the tiles of one exposure group on its own sheet. Put on Filters (True).&#13;&#10;[Calculation_1368642606501877949] = 4' />
      </column>
      <column caption='Tile Header Chip Border Point 4' datatype='spatial' name='[Calculation_1008212743854094983]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Border Point 4&#13;&#10;// Count chip outline after the group name.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 7 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((230.1953125) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 7 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Chip Fill Point 4' datatype='spatial' name='[Calculation_2201745012478190178]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Chip Fill Point 4&#13;&#10;// Count chip fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2209184240857417826] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0 + 6 * SIN(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((230.1953125) - 420 + ((CASE INT([Calculation_2209184240857417826] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 5 + 6 * COS(RADIANS(INT([Calculation_2209184240857417826] / 22) * 90 + ([Calculation_2209184240857417826] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Tile Header Count Point 4' datatype='spatial' name='[Calculation_2938508471437873771]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Tile Header Count Point 4&#13;&#10;// Middle of the count chip.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    -1.8980&#13;&#10;)' />
      </column>
      <column caption='Tile View Option' datatype='string' name='[Calculation_2894482038928477351]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Option&#13;&#10;// Scaffold for the All / Needs attention buttons (first 2 days of dim_date). Filter to non-null.&#13;&#10;CASE [day_index]&#13;&#10;WHEN 0 THEN &quot;All&quot;&#13;&#10;WHEN 1 THEN &quot;Needs attention&quot;&#13;&#10;END' />
      </column>
      <column caption='Is Tile View Button Row' datatype='boolean' name='[Calculation_2058479208791343830]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Tile View Button Row&#13;&#10;// Keeps the 2 scaffold rows that carry the All / Needs attention buttons. Put on Filters (True).&#13;&#10;NOT ISNULL([Calculation_2894482038928477351])' />
      </column>
      <column caption='Is Active Tile View' datatype='boolean' name='[Calculation_1284089094536110577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Active Tile View&#13;&#10;// Colours the selected tile-view button.&#13;&#10;[Calculation_2894482038928477351] = [Parameters].[Parameter 8]' />
      </column>
      <column caption='Tile View Label Active' datatype='string' name='[Calculation_1838581371832391049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Label Active&#13;&#10;// Button text when this tile view is selected (Semibold Navy run).&#13;&#10;IF [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
      </column>
      <column caption='Tile View Label Inactive' datatype='string' name='[Calculation_3133453958818750804]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Tile View Label Inactive&#13;&#10;// Button text when this tile view is not selected (Book grey run).&#13;&#10;IF NOT [Calculation_1284089094536110577] THEN [Calculation_2894482038928477351] ELSE &quot;&quot; END' />
      </column>
      <column caption='Attention Sort' datatype='integer' name='[Calculation_1867437212419901178]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Attention Sort&#13;&#10;// Worst first, then the node that feeds the most exposures. Sort Rows by this, descending.&#13;&#10;[current_status_code] * 1000 + [exposures_fed]' />
      </column>
      <column caption='Attention Order' datatype='integer' name='[Calculation_2821357717055420234]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Attention Order&#13;&#10;// Attention Sort turned around, so the natural ascending order of the rows is worst first.&#13;&#10;-[Calculation_1867437212419901178]' />
      </column>
      <column caption='Is Attention Node' datatype='boolean' name='[Calculation_3175454921771165665]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Attention Node&#13;&#10;// Upstream nodes (not exposures) that are Warning or Critical right now. Today: 3 nodes.&#13;&#10;[resource_type] &lt;&gt; &quot;exposure&quot;&#13;&#10;AND [Calculation_2875175252813195699]' />
      </column>
      <column caption='Alert Border Key' datatype='string' name='[Calculation_9934721400824060829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Alert Border Key&#13;&#10;// Alert border colour by status (critical #F2CDCA, warning #F3E0BE).&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
      </column>
      <column caption='Alert Border Point' datatype='spatial' name='[Calculation_1732233858863849972]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Border Point&#13;&#10;// Alert outline, 372 x 76 px, radius 8.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 30 + 8 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((189.5) - 189.5 + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 179.5 + 8 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Status Tint Key' datatype='string' name='[Calculation_1400495547723235965]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Status Tint Key&#13;&#10;// Same values as Status Label, kept as a separate field so it can carry the light tint palette&#13;&#10;// for tile and alert backgrounds: Healthy #FFFFFF, Warning #FDF3E1, Critical #FBEAE9, No data #F1F2F4.&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Alert Fill Point' datatype='spatial' name='[Calculation_1162418806925279858]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Fill Point&#13;&#10;// Alert fill, 1px inside the border.&#13;&#10;MAKEPOINT(&#13;&#10;    (0 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 30 + 7 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((189.5) - 189.5 + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 179.5 + 7 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Alert Icon Key' datatype='string' name='[Calculation_1007352953374889853]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Alert Icon Key&#13;&#10;// Alert icon background: the status colour at 18 to 20% over the alert fill.&#13;&#10;[Calculation_3105941082857465865]' />
      </column>
      <column caption='Alert Icon Point' datatype='spatial' name='[Calculation_2461624597664860302]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Icon Point&#13;&#10;// Icon background: the warning triangle, or a circle for other statuses.&#13;&#10;MAKEPOINT(&#13;&#10;    IF [current_status_code] = 2 THEN CASE INT([Calculation_2690238693341099106] / 30) WHEN 0 THEN 0.2640 WHEN 1 THEN 0.1413 ELSE 0.1413 END ELSE (20 + ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 0.005 + 7.33 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100 END,&#13;&#10;    IF [current_status_code] = 2 THEN CASE INT([Calculation_2690238693341099106] / 30) WHEN 0 THEN -1.6850 WHEN 1 THEN -1.6183 ELSE -1.7517 END ELSE ((21.0) - 189.5 + ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 0.005 + 7.33 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100 END&#13;&#10;)' />
      </column>
      <column caption='Attention Name Width' datatype='real' name='[Calculation_1052386569481538431]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Attention Name Width&#13;&#10;// Width in px of the node name in Arial bold 9pt, measured by the build from dim_nodes&#13;&#10;// (Liberation Sans, metric-compatible with Arial). Places the incident tag just after the name.&#13;&#10;CASE [display_name]&#13;&#10;WHEN &quot;dim_companies&quot; THEN 90.7&#13;&#10;WHEN &quot;dim_contacts&quot; THEN 77.4&#13;&#10;WHEN &quot;dim_customer_360&quot; THEN 108.7&#13;&#10;WHEN &quot;dim_customer_behavior&quot; THEN 138.7&#13;&#10;WHEN &quot;dim_customers&quot; THEN 88.7&#13;&#10;WHEN &quot;dim_products&quot; THEN 79.3&#13;&#10;WHEN &quot;dim_stores&quot; THEN 64.0&#13;&#10;WHEN &quot;fct_ad_spend_daily&quot; THEN 111.4&#13;&#10;WHEN &quot;fct_app_engagement&quot; THEN 120.0&#13;&#10;WHEN &quot;fct_attribution&quot; THEN 80.7&#13;&#10;WHEN &quot;fct_board_kpis&quot; THEN 85.4&#13;&#10;WHEN &quot;fct_campaign_performance&quot; THEN 156.7&#13;&#10;WHEN &quot;fct_churn_features&quot; THEN 108.0&#13;&#10;WHEN &quot;fct_demand_signals&quot; THEN 115.4&#13;&#10;WHEN &quot;fct_experiment_results&quot; THEN 131.4&#13;&#10;WHEN &quot;fct_finance_close&quot; THEN 100.7&#13;&#10;WHEN &quot;fct_funnel_daily&quot; THEN 91.4&#13;&#10;WHEN &quot;fct_gl_journal&quot; THEN 78.7&#13;&#10;WHEN &quot;fct_inventory_daily&quot; THEN 109.4&#13;&#10;WHEN &quot;fct_marketing_roi&quot; THEN 100.7&#13;&#10;WHEN &quot;fct_ops_model_health&quot; THEN 126.7&#13;&#10;WHEN &quot;fct_order_items&quot; THEN 90.0&#13;&#10;WHEN &quot;fct_orders&quot; THEN 58.7&#13;&#10;WHEN &quot;fct_partner_payouts&quot; THEN 115.4&#13;&#10;WHEN &quot;fct_payments&quot; THEN 77.4&#13;&#10;WHEN &quot;fct_pipeline&quot; THEN 66.7&#13;&#10;WHEN &quot;fct_revenue_daily&quot; THEN 101.4&#13;&#10;WHEN &quot;fct_sessions&quot; THEN 72.7&#13;&#10;WHEN &quot;fct_shipments&quot; THEN 81.4&#13;&#10;WHEN &quot;fct_store_sales&quot; THEN 87.4&#13;&#10;WHEN &quot;fct_support_sla_daily&quot; THEN 123.4&#13;&#10;WHEN &quot;fct_tickets&quot; THEN 59.4&#13;&#10;WHEN &quot;int_ads__attribution&quot; THEN 114.7&#13;&#10;WHEN &quot;int_ads__unified&quot; THEN 94.7&#13;&#10;WHEN &quot;int_app__engagement&quot; THEN 126.7&#13;&#10;WHEN &quot;int_campaigns__spend_daily&quot; THEN 166.7&#13;&#10;WHEN &quot;int_contacts__lifecycle&quot; THEN 131.4&#13;&#10;WHEN &quot;int_customer_behavior&quot; THEN 132.0&#13;&#10;WHEN &quot;int_customers__deduped&quot; THEN 145.4&#13;&#10;WHEN &quot;int_deals__pipeline&quot; THEN 110.7&#13;&#10;WHEN &quot;int_experiments__assignments_enriched&quot; THEN 235.4&#13;&#10;WHEN &quot;int_funnel__steps&quot; THEN 102.0&#13;&#10;WHEN &quot;int_gl__mapped&quot; THEN 91.4&#13;&#10;WHEN &quot;int_inventory__snapshots&quot; THEN 148.7&#13;&#10;WHEN &quot;int_orders__enriched&quot; THEN 122.0&#13;&#10;WHEN &quot;int_payments__reconciled&quot; THEN 150.7&#13;&#10;WHEN &quot;int_products__catalog&quot; THEN 128.0&#13;&#10;WHEN &quot;int_revenue__daily&quot; THEN 108.1&#13;&#10;WHEN &quot;int_sessions__stitched&quot; THEN 132.1&#13;&#10;WHEN &quot;int_shipments__sla&quot; THEN 111.4&#13;&#10;WHEN &quot;int_store_sales__daily&quot; THEN 128.1&#13;&#10;WHEN &quot;int_tickets__lifecycle&quot; THEN 120.1&#13;&#10;WHEN &quot;pbi_inventory&quot; THEN 78.7&#13;&#10;WHEN &quot;pbi_marketing&quot; THEN 82.0&#13;&#10;WHEN &quot;pbi_support&quot; THEN 69.3&#13;&#10;WHEN &quot;pds_board_kpis&quot; THEN 92.0&#13;&#10;WHEN &quot;pds_commerce_sales&quot; THEN 124.7&#13;&#10;WHEN &quot;pds_finance_close&quot; THEN 107.4&#13;&#10;WHEN &quot;pds_finance_revenue&quot; THEN 122.7&#13;&#10;WHEN &quot;pds_ops_monitor&quot; THEN 100.7&#13;&#10;WHEN &quot;pds_sales_pipeline&quot; THEN 110.1&#13;&#10;WHEN &quot;pds_web_funnel&quot; THEN 94.0&#13;&#10;WHEN &quot;raw_dbt_artifacts.run_results&quot; THEN 168.1&#13;&#10;WHEN &quot;raw_events.app_events&quot; THEN 134.7&#13;&#10;WHEN &quot;raw_events.page_views&quot; THEN 136.1&#13;&#10;WHEN &quot;raw_events.search_events&quot; THEN 152.1&#13;&#10;WHEN &quot;raw_events.web_sessions&quot; THEN 150.1&#13;&#10;WHEN &quot;raw_experiments.assignments&quot; THEN 174.7&#13;&#10;WHEN &quot;raw_google_ads.ad_stats&quot; THEN 146.1&#13;&#10;WHEN &quot;raw_google_ads.campaigns&quot; THEN 160.1&#13;&#10;WHEN &quot;raw_hubspot.companies&quot; THEN 140.7&#13;&#10;WHEN &quot;raw_hubspot.contacts&quot; THEN 127.4&#13;&#10;WHEN &quot;raw_hubspot.deals&quot; THEN 108.7&#13;&#10;WHEN &quot;raw_meta_ads.ad_insights&quot; THEN 152.7&#13;&#10;WHEN &quot;raw_netsuite.accounts&quot; THEN 129.4&#13;&#10;WHEN &quot;raw_netsuite.gl_entries&quot; THEN 133.4&#13;&#10;WHEN &quot;raw_netsuite.journal_lines&quot; THEN 150.7&#13;&#10;WHEN &quot;raw_pos.store_sales&quot; THEN 118.1&#13;&#10;WHEN &quot;raw_shopify.customers&quot; THEN 133.2&#13;&#10;WHEN &quot;raw_shopify.order_items&quot; THEN 141.2&#13;&#10;WHEN &quot;raw_shopify.orders&quot; THEN 109.8&#13;&#10;WHEN &quot;raw_shopify.products&quot; THEN 123.8&#13;&#10;WHEN &quot;raw_stripe.payments&quot; THEN 119.4&#13;&#10;WHEN &quot;raw_stripe.refunds&quot; THEN 107.4&#13;&#10;WHEN &quot;raw_wms.inventory&quot; THEN 111.4&#13;&#10;WHEN &quot;raw_wms.shipments&quot; THEN 117.4&#13;&#10;WHEN &quot;raw_wms.warehouses&quot; THEN 126.7&#13;&#10;WHEN &quot;raw_zendesk.ticket_comments&quot; THEN 176.1&#13;&#10;WHEN &quot;raw_zendesk.tickets&quot; THEN 116.1&#13;&#10;WHEN &quot;sigma_customer_360&quot; THEN 122.1&#13;&#10;WHEN &quot;sigma_product_engagement&quot; THEN 163.4&#13;&#10;WHEN &quot;stg_dbt__run_results&quot; THEN 122.0&#13;&#10;WHEN &quot;stg_events__app_events&quot; THEN 142.1&#13;&#10;WHEN &quot;stg_events__app_installs&quot; THEN 145.4&#13;&#10;WHEN &quot;stg_events__page_views&quot; THEN 143.4&#13;&#10;WHEN &quot;stg_events__search_events&quot; THEN 159.4&#13;&#10;WHEN &quot;stg_events__web_sessions&quot; THEN 157.4&#13;&#10;WHEN &quot;stg_experiments__assignments&quot; THEN 182.1&#13;&#10;WHEN &quot;stg_google_ads__ad_stats&quot; THEN 153.4&#13;&#10;WHEN &quot;stg_google_ads__campaigns&quot; THEN 167.4&#13;&#10;WHEN &quot;stg_hubspot__companies&quot; THEN 148.0&#13;&#10;WHEN &quot;stg_hubspot__contacts&quot; THEN 134.7&#13;&#10;WHEN &quot;stg_hubspot__deal_stages&quot; THEN 154.0&#13;&#10;WHEN &quot;stg_hubspot__deals&quot; THEN 116.0&#13;&#10;WHEN &quot;stg_meta_ads__ad_insights&quot; THEN 160.1&#13;&#10;WHEN &quot;stg_netsuite__accounts&quot; THEN 136.7&#13;&#10;WHEN &quot;stg_netsuite__gl_entries&quot; THEN 140.7&#13;&#10;WHEN &quot;stg_netsuite__journal_lines&quot; THEN 158.1&#13;&#10;WHEN &quot;stg_pos__store_sales&quot; THEN 125.4&#13;&#10;WHEN &quot;stg_shopify__customers&quot; THEN 141.4&#13;&#10;WHEN &quot;stg_shopify__order_discounts&quot; THEN 174.7&#13;&#10;WHEN &quot;stg_shopify__order_items&quot; THEN 149.4&#13;&#10;WHEN &quot;stg_shopify__orders&quot; THEN 118.0&#13;&#10;WHEN &quot;stg_shopify__products&quot; THEN 132.0&#13;&#10;WHEN &quot;stg_stripe__payments&quot; THEN 126.7&#13;&#10;WHEN &quot;stg_stripe__refunds&quot; THEN 114.7&#13;&#10;WHEN &quot;stg_wms__inventory&quot; THEN 118.7&#13;&#10;WHEN &quot;stg_wms__shipments&quot; THEN 124.7&#13;&#10;WHEN &quot;stg_wms__warehouses&quot; THEN 134.1&#13;&#10;WHEN &quot;stg_zendesk__ticket_comments&quot; THEN 183.4&#13;&#10;WHEN &quot;stg_zendesk__tickets&quot; THEN 123.4&#13;&#10;ELSE LEN([display_name]) * 7&#13;&#10;END' />
      </column>
      <column caption='Alert Tag Border Point' datatype='spatial' name='[Calculation_6014120892313844274]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Border Point&#13;&#10;// Incident tag outline just after the name; shrinks away without an incident.&#13;&#10;MAKEPOINT(&#13;&#10;    (21 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 4 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((73 + [Calculation_1052386569481538431]) - 189.5 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 22 + 4 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Alert Tag Fill Point' datatype='spatial' name='[Calculation_3305746185277340020]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Fill Point&#13;&#10;// Incident tag fill.&#13;&#10;MAKEPOINT(&#13;&#10;    (21 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((IF INT([Calculation_2690238693341099106] / 22) &lt; 2 THEN 1 ELSE -1 END) * 4 + 3 * SIN(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100,&#13;&#10;    ((73 + [Calculation_1052386569481538431]) - 189.5 + IIF(IFNULL([open_incident_id], &quot;&quot;) &lt;&gt; &quot;&quot;, 1, 0) * ((CASE INT([Calculation_2690238693341099106] / 22) WHEN 1 THEN -1 WHEN 2 THEN -1 ELSE 1 END) * 22 + 3 * COS(RADIANS(INT([Calculation_2690238693341099106] / 22) * 90 + ([Calculation_2690238693341099106] % 22 + 0.5) * 90 / 22)))) / 100&#13;&#10;)' />
      </column>
      <column caption='Attention Glyph Critical' datatype='string' name='[Calculation_2962787816554794745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Glyph Critical&#13;&#10;// The cross inside the critical icon.&#13;&#10;IF [current_status_code] = 3 THEN &quot;✕&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Attention Glyph Warning' datatype='string' name='[Calculation_5695537439393437054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Glyph Warning&#13;&#10;// The mark inside the warning triangle.&#13;&#10;IF [current_status_code] = 2 THEN &quot;!&quot; ELSE &quot;&quot; END' />
      </column>
      <column caption='Alert Glyph Point' datatype='spatial' name='[Calculation_1489187459337658552]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Glyph Point&#13;&#10;// Middle of the icon.&#13;&#10;MAKEPOINT(&#13;&#10;    0.1950,&#13;&#10;    -1.6850&#13;&#10;)' />
      </column>
      <column caption='Alert Chevron' datatype='string' name='[Calculation_1358681441065799831]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Alert Chevron&#13;&#10;// The &quot;›&quot; at the right of each alert.&#13;&#10;&quot;›&quot;' />
      </column>
      <column caption='Alert Chevron Point' datatype='spatial' name='[Calculation_1177064986607835880]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Chevron Point&#13;&#10;// The chevron, right side, middle.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0000,&#13;&#10;    1.6750&#13;&#10;)' />
      </column>
      <column caption='Attention Incident Tag' datatype='string' name='[Calculation_5034449253068379788]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Incident Tag&#13;&#10;// Incident tag text after the node name, for example &quot;INC-008&quot;. Empty when there is no open incident.&#13;&#10;IFNULL([open_incident_id], &quot;&quot;)' />
      </column>
      <column caption='Alert Tag Text Point' datatype='spatial' name='[Calculation_2553845990692593975]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Tag Text Point&#13;&#10;// Middle of the incident tag.&#13;&#10;MAKEPOINT(&#13;&#10;    0.2100,&#13;&#10;    ((73 + [Calculation_1052386569481538431]) - 189.5) / 100&#13;&#10;)' />
      </column>
      <column caption='Alert Name Point' datatype='spatial' name='[Calculation_1754163316052029704]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Name Point&#13;&#10;// Start of the node name.&#13;&#10;MAKEPOINT(&#13;&#10;    0.2100,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Is Attention Long Reason' datatype='boolean' name='[Calculation_2777440251005319574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Attention Long Reason&#13;&#10;// A failed model whose reason plus time would be wider than the card: the time goes on its own line.&#13;&#10;[last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at]) AND LEN([status_reason]) &gt; 44' />
      </column>
      <column caption='Last Event Label' datatype='string' name='[Calculation_2229498162963349132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Last Event Label&#13;&#10;// The prototype&apos;s timestamp format: &quot;19 Oct, 21:25&quot;. &quot;-&quot; when the node has never run or been checked.&#13;&#10;IF ISNULL([last_event_at]) THEN &quot;-&quot;&#13;&#10;ELSE STR(DAY([last_event_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [last_event_at]), 3) + &quot;, &quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;hour&apos;, [last_event_at])), 2) + &quot;:&quot;&#13;&#10;    + RIGHT(&quot;0&quot; + STR(DATEPART(&apos;minute&apos;, [last_event_at])), 2)&#13;&#10;END' />
      </column>
      <column caption='Attention Reason' datatype='string' name='[Calculation_2745413474489980072]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Reason&#13;&#10;// Second line of the alert: what is wrong, with the time of a failed run when it fits.&#13;&#10;[status_reason]&#13;&#10;+ IF [last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at]) AND NOT [Calculation_2777440251005319574]&#13;&#10;    THEN &quot; at &quot; + [Calculation_2229498162963349132] ELSE &quot;&quot; END' />
      </column>
      <column caption='Alert Reason Point' datatype='spatial' name='[Calculation_2016452764908080303]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Reason Point&#13;&#10;// Start of the reason line.&#13;&#10;MAKEPOINT(&#13;&#10;    0.0600,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Attention Reason Time' datatype='string' name='[Calculation_6666030497926233935]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Reason Time&#13;&#10;// Third line when the reason is long: &quot;at 19 Oct, 21:25&quot;.&#13;&#10;IF [Calculation_2777440251005319574] THEN &quot;at &quot; + [Calculation_2229498162963349132] ELSE &quot;&quot; END' />
      </column>
      <column caption='Alert Time Point' datatype='spatial' name='[Calculation_8600815631618955205]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Time Point&#13;&#10;// Start of the time line (long reasons only).&#13;&#10;MAKEPOINT(&#13;&#10;    -0.0700,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Layer Name' datatype='string' name='[Calculation_7823664326256286450]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Name&#13;&#10;// Prototype column names for the lineage layers.&#13;&#10;CASE [layer]&#13;&#10;WHEN &quot;source&quot;       THEN &quot;Sources&quot;&#13;&#10;WHEN &quot;staging&quot;      THEN &quot;Staging&quot;&#13;&#10;WHEN &quot;intermediate&quot; THEN &quot;Intermediate&quot;&#13;&#10;WHEN &quot;mart&quot;         THEN &quot;Marts&quot;&#13;&#10;WHEN &quot;semantic&quot;     THEN &quot;BI semantic layer&quot;&#13;&#10;WHEN &quot;exposure&quot;     THEN &quot;Exposures&quot;&#13;&#10;END' />
      </column>
      <column caption='Platform Name' datatype='string' name='[Calculation_1641578937180273009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Platform Name&#13;&#10;// Display casing for the current platform.&#13;&#10;CASE [platform_now]&#13;&#10;WHEN &quot;snowflake&quot;  THEN &quot;Snowflake&quot;&#13;&#10;WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot;   THEN &quot;Redshift&quot;&#13;&#10;END' />
      </column>
      <column caption='Attention Where' datatype='string' name='[Calculation_7237364071094172266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Where&#13;&#10;// Start of the last alert line: &quot;Staging · Snowflake · &quot;.&#13;&#10;[Calculation_7823664326256286450] + &quot; · &quot; + [Calculation_1641578937180273009] + &quot; · &quot;' />
      </column>
      <column caption='Attention Affects' datatype='string' name='[Calculation_3193701186045745359]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Affects&#13;&#10;// The bold part of the last alert line: &quot;affects 4 exposures&quot;.&#13;&#10;&quot;affects &quot; + STR([exposures_fed]) + IF [exposures_fed] = 1 THEN &quot; exposure&quot; ELSE &quot; exposures&quot; END' />
      </column>
      <column caption='Attention Open Since' datatype='string' name='[Calculation_1700778924915878744]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Attention Open Since&#13;&#10;// Tail of the meta line: &quot; · open since 19 Oct&quot;. Uses open_incident_started_at, added to dim_nodes for this.&#13;&#10;IF ISNULL([open_incident_started_at]) THEN &quot;&quot;&#13;&#10;ELSE &quot; · open since &quot; + STR(DAY([open_incident_started_at])) + &quot; &quot;&#13;&#10;    + LEFT(DATENAME(&apos;month&apos;, [open_incident_started_at]), 3)&#13;&#10;END' />
      </column>
      <column caption='Alert Meta Point' datatype='spatial' name='[Calculation_1909663387392056855]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Alert Meta Point&#13;&#10;// Start of the where / affects line, one line lower when the time has its own line.&#13;&#10;MAKEPOINT(&#13;&#10;    IF [last_run_status] = &quot;error&quot; AND NOT ISNULL([last_event_at]) AND LEN([status_reason]) &gt; 44 THEN -0.2000 ELSE -0.0700 END,&#13;&#10;    -1.5450&#13;&#10;)' />
      </column>
      <column caption='Node Count' datatype='integer' name='[Calculation_2446133016301952044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Node Count&#13;&#10;// Number of nodes in the view. dim_nodes has one row per node.&#13;&#10;COUNTD([node_id (dim_nodes.csv)])' />
      </column>
      <column caption='Layer Share' datatype='real' name='[Calculation_9282765132542256788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Share&#13;&#10;// Each status&apos;s share of the layer, so every bar spans the full width.&#13;&#10;// Table calc: compute using Status Label (along the bar).&#13;&#10;[Calculation_2446133016301952044] / TOTAL([Calculation_2446133016301952044])'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2496845894520933783]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Layer Label Position' datatype='real' name='[Calculation_2008892738692294245]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Label Position&#13;&#10;// Where the &quot;1 / 27&quot; count starts: just past the end of the full bar (axis fixed 0 to 1.3).&#13;&#10;// The label sits to the right of this hairline Gantt mark.&#13;&#10;MIN(1.02)' />
      </column>
      <column caption='Status Stack Order' datatype='integer' name='[Calculation_2946817898410042583]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Status Stack Order&#13;&#10;// Healthy first, for stacked bars, as in the prototype&apos;s layer health strip: Healthy, Warning, Critical, No data.&#13;&#10;CASE [current_status_code]&#13;&#10;WHEN 1 THEN 1&#13;&#10;WHEN 2 THEN 2&#13;&#10;WHEN 3 THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='Layer Stack Key' datatype='integer' name='[Calculation_2496845894520933783]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Layer Stack Key&#13;&#10;// Stack order for the layer bar, left to right: Healthy, Warning, Critical, No data.&#13;&#10;// Tableau stacks the highest value first, so Healthy gets the highest key.&#13;&#10;5 - [Calculation_2946817898410042583]' />
      </column>
      <column caption='Layer Total' datatype='integer' name='[Calculation_3311281824631653486]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Total&#13;&#10;// Nodes in the layer for the selected platform. FIXED with the platform rule inside, so no context filter is needed.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] THEN 1 END) }' />
      </column>
      <column caption='Layer Total Text' datatype='string' name='[Calculation_1760329556827391948]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Total Text&#13;&#10;// The layer total, in grey after the issue count: &quot;1 / 30&quot; or just &quot;21&quot;.&#13;&#10;STR([Calculation_3311281824631653486])' />
      </column>
      <column caption='Layer Has Critical' datatype='boolean' name='[Calculation_4191687787979507265]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Has Critical&#13;&#10;// TRUE when any node in the layer is Critical, so the issue count shows in red rather than amber.&#13;&#10;{ FIXED [layer] : MAX(IF [Calculation_2214252331607255986] AND [current_status_code] = 3 THEN 1 ELSE 0 END) } = 1' />
      </column>
      <column caption='Layer Issues' datatype='integer' name='[Calculation_1394288337659403442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Layer Issues&#13;&#10;// Nodes in the layer that are Warning or Critical right now, for the selected platform.&#13;&#10;{ FIXED [layer] : SUM(IF [Calculation_2214252331607255986] AND [Calculation_2875175252813195699] THEN 1 ELSE 0 END) }' />
      </column>
      <column caption='Layer Issues Critical Text' datatype='string' name='[Calculation_2393800399496740184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Critical Text&#13;&#10;// &quot;1 / &quot; in red, shown when the layer has a Critical node.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Layer Issues Warning Text' datatype='string' name='[Calculation_3164047678432910206]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Layer Issues Warning Text&#13;&#10;// &quot;1 / &quot; in amber ink #93600F, when the layer has issues but none Critical.&#13;&#10;IF [Calculation_1394288337659403442] &gt; 0 AND NOT [Calculation_4191687787979507265]&#13;&#10;    THEN STR([Calculation_1394288337659403442]) + &quot; / &quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Daily Is In Window' datatype='boolean' name='[Calculation_2140717334644434396]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Daily Is In Window&#13;&#10;// The day is inside the selected 7/30/90-day window.&#13;&#10;MAX(IIF([Calculation_1409194560049525583], 1, 0)) = 1' />
      </column>
      <column caption='Is Gantt Day' datatype='boolean' name='[Calculation_9861913593929028361]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Gantt Day&#13;&#10;// The bar for the day loaded in the Gantt (reference line on the date axis instead of a colour change).&#13;&#10;[date (dim_date.csv)] = [Parameters].[Parameter 6]' />
      </column>
      <column caption='Daily Is Selected' datatype='boolean' name='[Calculation_3401260011870240614]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Daily Is Selected&#13;&#10;// The day loaded in the Gantt (clicked, or stepped to with ‹ ›).&#13;&#10;MAX(IIF([Calculation_9861913593929028361], 1, 0)) = 1' />
      </column>
      <column caption='Daily Back Height' datatype='real' name='[Calculation_9871844494807156944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Back Height&#13;&#10;// Back bars: the clicked day navy to near the top (its edge shows round the bars and the filler as&#13;&#10;// the prototype&apos;s outline), every other day in the window full height (the bars touch: the band).&#13;&#10;IF [Calculation_3401260011870240614] THEN 53.2&#13;&#10;ELSEIF [Calculation_2140717334644434396] THEN 54&#13;&#10;END' />
      </column>
      <column caption='Days Back Mid' datatype='real' name='[Calculation_2904210747288447847]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='// Days Back Mid&#13;&#10;// x of every 90-day chart on this tab: days before the as-of date + 0.5, on an axis fixed&#13;&#10;// 0 to 90 and reversed, so day d fills [d, d + 1] and the window is everything below p_period.&#13;&#10;[days_before_as_of] + 0.5' />
      </column>
      <column caption='Daily Back Key' datatype='string' name='[Calculation_1507981906426335172]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Daily Back Key&#13;&#10;// Colour of the back bars: Selected (navy outline) or Window (the band).&#13;&#10;IF [Calculation_3401260011870240614] THEN &quot;Selected&quot;&#13;&#10;ELSEIF [Calculation_2140717334644434396] THEN &quot;Window&quot;&#13;&#10;END' />
      </column>
      <column caption='Daily Failed Runs' datatype='real' name='[Calculation_3098460751127839790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed Runs&#13;&#10;// Red bars: failed model runs that day.&#13;&#10;SUM([runs_failed])' />
      </column>
      <column caption='Daily Skipped Runs' datatype='real' name='[Calculation_2138488070576058935]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Skipped Runs&#13;&#10;// Skipped because an upstream model failed (tooltip).&#13;&#10;SUM([runs_skipped])' />
      </column>
      <column caption='Daily Failed Selected' datatype='real' name='[Calculation_4867698479288880411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed Selected&#13;&#10;// Failed runs on the clicked day (full red).&#13;&#10;IF [Calculation_3401260011870240614] THEN SUM([runs_failed]) END' />
      </column>
      <column caption='Daily Failed Other' datatype='real' name='[Calculation_2153646829052003531]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed Other&#13;&#10;// Failed runs on every other day (pale red).&#13;&#10;IF NOT [Calculation_3401260011870240614] THEN SUM([runs_failed]) END' />
      </column>
      <column caption='Daily Skipped Selected' datatype='real' name='[Calculation_2611916872173414448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Skipped Selected&#13;&#10;// Skipped runs on the clicked day (full grey).&#13;&#10;IF [Calculation_3401260011870240614] THEN SUM([runs_skipped]) END' />
      </column>
      <column caption='Daily Skipped Other' datatype='real' name='[Calculation_1570278384311226378]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Skipped Other&#13;&#10;// Skipped runs on every other day (pale grey).&#13;&#10;IF NOT [Calculation_3401260011870240614] THEN SUM([runs_skipped]) END' />
      </column>
      <column caption='Daily Failed And Skipped' datatype='real' name='[Calculation_2885600867321422714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Failed And Skipped&#13;&#10;// Grey bars behind the red ones: failed + skipped, so the grey part above the red&#13;&#10;// is the skipped runs (an overlay, exact even on the 19 node-days that had both).&#13;&#10;SUM([runs_failed]) + SUM([runs_skipped])' />
      </column>
      <column caption='Daily Fill Window' datatype='real' name='[Calculation_6153058592725765752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Fill Window&#13;&#10;// Above the clicked day&apos;s stack, up to the outline&apos;s top edge, in the band colour: the outline&#13;&#10;// stays hollow, as in the prototype.&#13;&#10;IF [Calculation_3401260011870240614] AND [Calculation_2140717334644434396] THEN 52.6 - [Calculation_2885600867321422714] END' />
      </column>
      <column caption='Daily Fill Plain' datatype='real' name='[Calculation_4018887533510383646]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Daily Fill Plain&#13;&#10;// The same filler in white when the clicked day is outside the window.&#13;&#10;IF [Calculation_3401260011870240614] AND NOT [Calculation_2140717334644434396] THEN 52.6 - [Calculation_2885600867321422714] END' />
      </column>
      <column caption='Incident Tick' datatype='real' name='[Calculation_1447918477104689102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Incident Tick&#13;&#10;// Grey tick under an incident label, on days an incident started.&#13;&#10;IF COUNT([incident_id]) &gt; 0 THEN 22 END' />
      </column>
      <column caption='Incident Label Anchor' datatype='real' name='[Calculation_3308085721278344582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Incident Label Anchor&#13;&#10;// Point the &quot;INC 4&quot; label sits above (label vertical alignment top).&#13;&#10;IF COUNT([incident_id]) &gt; 0 THEN 24 END' />
      </column>
      <column caption='Incident Marker Label' datatype='string' name='[Calculation_1454750851671812728]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Incident Marker Label&#13;&#10;// &quot;INC 4&quot; above the day an incident started, as in the prototype.&#13;&#10;REPLACE([incident_id], &quot;INC-00&quot;, &quot;INC &quot;)' />
      </column>
      <column caption='Axis Date Label' datatype='string' name='[Calculation_2516393983253929826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Axis Date Label&#13;&#10;// &quot;22 Jul&quot;, &quot;1 Aug&quot; ... under the 90-day charts: the first day and every 1st of the month.&#13;&#10;IF [day_index] = 0 OR DAY([date (dim_date.csv)]) = 1&#13;&#10;THEN STR(DAY([date (dim_date.csv)])) + &quot; &quot; + LEFT(DATENAME(&apos;month&apos;, [date (dim_date.csv)]), 3)&#13;&#10;END' />
      </column>
      <column caption='Axis Label Anchor' datatype='real' name='[Calculation_3034596744519413745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Axis Label Anchor&#13;&#10;// Point the date label is centred on (axis 0 to 52, the bars&apos; scale).&#13;&#10;IF NOT ISNULL(MIN([Calculation_2516393983253929826])) THEN 26 END' />
      </column>
      <column caption='Job Schedule Label' datatype='string' name='[Calculation_3094354169785943014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Job Schedule Label&#13;&#10;// Small grey header beside the job name: &quot;hourly&quot;, &quot;daily&quot;, &quot;on PR&quot;.&#13;&#10;REPLACE([schedule], &quot;on_pull_request&quot;, &quot;on PR&quot;)' />
      </column>
      <column caption='Gantt Start Hour' datatype='real' name='[Calculation_3122650177919167747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Gantt Start Hour&#13;&#10;// Bar start in hours (axis 00:00 to 24:00) for runs on the selected day; other days have no mark.&#13;&#10;IF [run_date] = [Parameters].[Parameter 6] THEN [start_minute_of_day] / 60 END' />
      </column>
      <column caption='Tests Failed Marker Hour' datatype='real' name='[Calculation_2353287589358600364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Tests Failed Marker Hour&#13;&#10;// Amber dot just after a run whose tests failed. NULL (no mark) otherwise.&#13;&#10;IF [run_date] = [Parameters].[Parameter 6] AND [tests_failed] &gt; 0&#13;&#10;THEN ([start_minute_of_day] + MAX([duration_min], 3) + 4) / 60 END' />
      </column>
      <column caption='Is Platform Match Job' datatype='boolean' name='[Calculation_1147506852634392335]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Job&#13;&#10;// Platform filter for Job Runs (each run carries the platform most of its models ran on).&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform (mart_job_runs.csv)] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Job Run Outcome' datatype='string' name='[Calculation_2594716741566639131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Job Run Outcome&#13;&#10;// Bar colour: Succeeded #9DB9D6, Failed #D2453F, Cancelled #C3C9CF.&#13;&#10;CASE [status]&#13;&#10;WHEN &quot;error&quot;     THEN &quot;Failed&quot;&#13;&#10;WHEN &quot;cancelled&quot; THEN &quot;Cancelled&quot;&#13;&#10;ELSE &quot;Succeeded&quot;&#13;&#10;END' />
      </column>
      <column caption='Job Platform Name' datatype='string' name='[Calculation_1806154904060084637]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Job Platform Name&#13;&#10;// Platform the job ran on, as written in the legend.&#13;&#10;CASE [platform (mart_job_runs.csv)] WHEN &quot;snowflake&quot; THEN &quot;Snowflake&quot; WHEN &quot;databricks&quot; THEN &quot;Databricks&quot;&#13;&#10;WHEN &quot;redshift&quot; THEN &quot;Redshift&quot; ELSE [platform (mart_job_runs.csv)] END' />
      </column>
      <column caption='Gantt Started Text' datatype='string' name='[Calculation_1493742440611781298]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Gantt Started Text&#13;&#10;// &quot;05:16&quot; in the tooltip.&#13;&#10;RIGHT(&quot;0&quot; + STR(INT([start_minute_of_day] / 60)), 2) + &quot;:&quot; + RIGHT(&quot;0&quot; + STR([start_minute_of_day] % 60), 2)' />
      </column>
      <column caption='Gantt Duration Text' datatype='string' name='[Calculation_1622474558781708599]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Gantt Duration Text&#13;&#10;// &quot;5.8 min&quot; or &quot;1 h 25 min&quot; in the tooltip.&#13;&#10;IF [duration_min] &lt; 60 THEN STR(ROUND([duration_min], 1)) + &quot; min&quot;&#13;&#10;ELSE STR(INT([duration_min] / 60)) + &quot; h &quot; + STR(INT([duration_min]) % 60) + &quot; min&quot; END' />
      </column>
      <column caption='Gantt Duration Hours' datatype='real' name='[Calculation_2829640963960821448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Gantt Duration Hours&#13;&#10;// Bar length in hours, at least 3 minutes so very short runs stay visible.&#13;&#10;MAX([duration_min], 3) / 60' />
      </column>
      <column caption='Is First Date Row' datatype='boolean' name='[Calculation_7201951502715406386]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is First Date Row&#13;&#10;// One-row scaffold (the first day) for the Gantt day buttons and label. Put on Filters (True).&#13;&#10;[day_index] = 0' />
      </column>
      <column caption='Gantt Prev Date' datatype='date' name='[Calculation_4255842174353675499]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Gantt Prev Date&#13;&#10;// Value the ‹ button writes into p_gantt_date. Stops at the first day.&#13;&#10;IF [Parameters].[Parameter 6] &gt; { MIN([date (dim_date.csv)]) }&#13;&#10;    THEN DATE(DATEADD(&apos;day&apos;, -1, [Parameters].[Parameter 6]))&#13;&#10;ELSE [Parameters].[Parameter 6]&#13;&#10;END' />
      </column>
      <column caption='Gantt Prev Glyph' datatype='string' name='[Calculation_5461572561073485727]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Gantt Prev Glyph&#13;&#10;// ‹ on the previous-day button.&#13;&#10;MIN(&quot;‹&quot;)' />
      </column>
      <column caption='As Of Date' datatype='date' name='[Calculation_3151274114862452881]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// As Of Date&#13;&#10;// Last day in the data (19 Oct). Every &quot;now&quot; in the dashboard is measured against it.&#13;&#10;{ MAX([date (dim_date.csv)]) }' />
      </column>
      <column caption='Gantt Next Date' datatype='date' name='[Calculation_2973907925170101119]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Gantt Next Date&#13;&#10;// Value the › button writes into p_gantt_date. Stops at the last day.&#13;&#10;IF [Parameters].[Parameter 6] &lt; [Calculation_3151274114862452881]&#13;&#10;    THEN DATE(DATEADD(&apos;day&apos;, 1, [Parameters].[Parameter 6]))&#13;&#10;ELSE [Parameters].[Parameter 6]&#13;&#10;END' />
      </column>
      <column caption='Gantt Next Glyph' datatype='string' name='[Calculation_2561110447235085966]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Gantt Next Glyph&#13;&#10;// › on the next-day button.&#13;&#10;MIN(&quot;›&quot;)' />
      </column>
      <column caption='Gantt Day Label' datatype='string' name='[Calculation_1325618294935570178]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Gantt Day Label&#13;&#10;// Card header between the arrows: &quot;Mon 19 Oct 2026&quot;.&#13;&#10;LEFT(DATENAME(&apos;weekday&apos;, [Parameters].[Parameter 6]), 3) + &quot; &quot;&#13;&#10;+ STR(DAY([Parameters].[Parameter 6])) + &quot; &quot;&#13;&#10;+ LEFT(DATENAME(&apos;month&apos;, [Parameters].[Parameter 6]), 3) + &quot; &quot;&#13;&#10;+ STR(YEAR([Parameters].[Parameter 6]))' />
      </column>
      <column caption='Is Platform Match Error' datatype='boolean' name='[Calculation_1475933581110583641]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Is Platform Match Error&#13;&#10;// Platform filter for Run Errors: the platform the model ran on when it failed.&#13;&#10;[Parameters].[Parameter 2] = &quot;All&quot;&#13;&#10;OR [platform (mart_run_errors.csv)] = [Parameters].[Parameter 2]' />
      </column>
      <column caption='Failed Model Runs' datatype='integer' name='[Calculation_1556808545805540049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Failed Model Runs&#13;&#10;// Count of failed model runs. 30d check: 50 (18 compilation, 17 database, 9 permission, 6 timeout).&#13;&#10;COUNT([job_run_id])' />
      </column>
      <column caption='Failed Runs Label' datatype='string' name='[Calculation_6189998033001785489]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Failed Runs Label&#13;&#10;// Card subtitle: &quot;50 failed model runs in this period&quot;.&#13;&#10;STR([Calculation_1556808545805540049]) + &quot; failed model runs in this period&quot;' />
      </column>
      <column caption='Error Category Label' datatype='string' name='[Calculation_2759662032659617150]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Category Label&#13;&#10;// Prototype names for the error categories.&#13;&#10;CASE [error_category]&#13;&#10;WHEN &quot;database&quot;      THEN &quot;Database error&quot;&#13;&#10;WHEN &quot;compilation&quot;   THEN &quot;Compilation error&quot;&#13;&#10;WHEN &quot;permission&quot;    THEN &quot;Permission denied&quot;&#13;&#10;WHEN &quot;timeout&quot;       THEN &quot;Timeout&quot;&#13;&#10;WHEN &quot;schema_change&quot; THEN &quot;Schema change&quot;&#13;&#10;ELSE [error_category]&#13;&#10;END' />
      </column>
      <column caption='Why Track' datatype='real' name='[Calculation_2807912847742869558]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Why Track&#13;&#10;// Where each count label ends, right-aligned as in the mock: a little past the longest bar, so no&#13;&#10;// bar runs through a number (v24 had them on the bar end). Table calc along Error Category Label.&#13;&#10;WINDOW_MAX([Calculation_1556808545805540049]) * 1.14'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[Calculation_2759662032659617150]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Top Model Track' datatype='real' name='[Calculation_1053829186246530949]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Top Model Track&#13;&#10;// Same for the top-models bars. Table calc along display_name.&#13;&#10;WINDOW_MAX([Calculation_1556808545805540049]) * 1.14'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Is Top Failing Model' datatype='boolean' name='[Calculation_2758321348733286171]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// Is Top Failing Model&#13;&#10;// The 7 models that failed most. Table calc filter (True), along display_name.&#13;&#10;RANK_UNIQUE([Calculation_1556808545805540049]) &lt;= 7'>
          <table-calc ordering-field='[federated.07vo3ft0hzn0yt1e7nb981upju80].[display_name]' ordering-type='Field' />
        </calculation>
      </column>
      <column caption='Error Head When' datatype='string' name='[Calculation_1842423184776706169]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head When&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;WHEN&quot;' />
      </column>
      <column caption='Error Head Model' datatype='string' name='[Calculation_8180630051212121102]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head Model&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;MODEL&quot;' />
      </column>
      <column caption='Error Head Category' datatype='string' name='[Calculation_2898266689643006961]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head Category&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;CATEGORY&quot;' />
      </column>
      <column caption='Error Head Message' datatype='string' name='[Calculation_1745346346299597772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Head Message&#13;&#10;// Column title over the Recent errors table.&#13;&#10;&quot;MESSAGE&quot;' />
      </column>
      <column caption='Error Order' datatype='integer' name='[Calculation_1108514369483243976]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Error Order&#13;&#10;// Newest first: minutes before the end of 2026, so the natural ascending order is newest first.&#13;&#10;DATEDIFF(&apos;minute&apos;, [run_started_at], #2026-12-31#)' />
      </column>
      <column caption='Error Key' datatype='string' name='[Calculation_1460623011763772819]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Error Key&#13;&#10;// One row per failed model run: job run and node.&#13;&#10;[job_run_id] + &quot;|&quot; + [node_id (mart_run_errors.csv)]' />
      </column>
