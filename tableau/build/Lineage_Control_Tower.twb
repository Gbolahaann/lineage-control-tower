      <column caption='Bullet Warn Tip' datatype='string' name='[Calculation_8960573281369348412]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Bullet Warn Tip&#13;&#10;// WARN AFTER in the tooltip.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;10.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;10.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;48.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;48.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;2.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;1.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;24.0 h&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Bullet Error Tip' datatype='string' name='[Calculation_2611258565758139959]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Bullet Error Tip&#13;&#10;// ERROR AFTER in the tooltip.&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.orders&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.order_items&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.customers&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_shopify.products&quot; THEN &quot;24.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.payments&quot; THEN &quot;6.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_stripe.refunds&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.gl_entries&quot; THEN &quot;18.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.journal_lines&quot; THEN &quot;18.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_netsuite.accounts&quot; THEN &quot;72.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.inventory&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.shipments&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_wms.warehouses&quot; THEN &quot;72.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_pos.store_sales&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_core.raw_dbt_artifacts.run_results&quot; THEN &quot;4.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.web_sessions&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.page_views&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.search_events&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_events.app_events&quot; THEN &quot;3.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.tickets&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_zendesk.ticket_comments&quot; THEN &quot;8.0 h&quot;&#13;&#10;WHEN &quot;source.acme_product.raw_experiments.assignments&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.campaigns&quot; THEN &quot;36.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_google_ads.ad_stats&quot; THEN &quot;36.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_meta_ads.ad_insights&quot; THEN &quot;36.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.deals&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.contacts&quot; THEN &quot;12.0 h&quot;&#13;&#10;WHEN &quot;source.acme_marketing.raw_hubspot.companies&quot; THEN &quot;36.0 h&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
