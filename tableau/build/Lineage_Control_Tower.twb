            <column caption='US Sem Success Low Text' datatype='string' name='[Calculation_2085614902708489128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// US Sem Success Low Text&#13;&#10;// Success below 98%, red bold (written by the build per period).&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;7|semantic.tableau.pds_commerce_sales&quot; THEN &quot;78.6%&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_commerce_sales&quot; THEN &quot;90.8%&quot;&#13;&#10;WHEN &quot;30|semantic.tableau.pds_board_kpis&quot; THEN &quot;96.6%&quot;&#13;&#10;WHEN &quot;90|semantic.tableau.pds_commerce_sales&quot; THEN &quot;96.1%&quot;&#13;&#10;WHEN &quot;90|semantic.power_bi.pbi_support&quot; THEN &quot;97.7%&quot;&#13;&#10;ELSE NULL&#13;&#10;END' />
