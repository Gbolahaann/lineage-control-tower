    <worksheet name='QA Keeps Failing Tests'>
      <table>
        <view>
          <datasources>
            <datasource caption='Lineage Control Tower' name='federated.07vo3ft0hzn0yt1e7nb981upju80' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Last 30 days' caption='p_period' datatype='integer' datatype-customized='true' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='30'>
              <calculation class='tableau' formula='30' />
              <aliases>
                <alias key='7' value='Last 7 days' />
                <alias key='30' value='Last 30 days' />
                <alias key='90' value='Last 90 days' />
              </aliases>
              <members>
                <member alias='Last 7 days' value='7' />
                <member alias='Last 30 days' value='30' />
                <member alias='Last 90 days' value='90' />
              </members>
            </column>
            <column alias='All' caption='p_platform' datatype='string' datatype-customized='true' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;snowflake&quot;' value='Snowflake' />
                <alias key='&quot;databricks&quot;' value='Databricks' />
                <alias key='&quot;redshift&quot;' value='Redshift' />
              </aliases>
              <members>
                <member alias='All' value='&quot;All&quot;' />
                <member alias='Snowflake' value='&quot;snowflake&quot;' />
                <member alias='Databricks' value='&quot;databricks&quot;' />
                <member alias='Redshift' value='&quot;redshift&quot;' />
              </members>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07vo3ft0hzn0yt1e7nb981upju80'>
            <column caption='QA KF Slot' datatype='integer' name='[Calculation_9061342006016474767]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// QA KF Slot&#13;&#10;// Row of the list a carrier model&apos;s Node Daily rows draw (a scaffold: the content is the test&apos;s,&#13;&#10;// written by the build per period and platform).&#13;&#10;CASE [node_id (dim_nodes.csv)]&#13;&#10;WHEN &quot;model.acme_core.dim_customer_360&quot; THEN 0&#13;&#10;WHEN &quot;model.acme_core.dim_customers&quot; THEN 1&#13;&#10;WHEN &quot;model.acme_core.dim_products&quot; THEN 2&#13;&#10;WHEN &quot;model.acme_core.dim_stores&quot; THEN 3&#13;&#10;WHEN &quot;model.acme_core.fct_board_kpis&quot; THEN 4&#13;&#10;WHEN &quot;model.acme_core.fct_finance_close&quot; THEN 5&#13;&#10;WHEN &quot;model.acme_core.fct_gl_journal&quot; THEN 6&#13;&#10;WHEN &quot;model.acme_core.fct_inventory_daily&quot; THEN 7&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Is QA KF Row' datatype='boolean' name='[Calculation_2537301615494657624]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// Is QA KF Row&#13;&#10;// Rows that have a test in this period and platform. Put on Filters (True).&#13;&#10;[Calculation_9061342006016474767] &lt; CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2]&#13;&#10;WHEN &quot;7|All&quot; THEN 8&#13;&#10;WHEN &quot;7|snowflake&quot; THEN 8&#13;&#10;WHEN &quot;7|databricks&quot; THEN 7&#13;&#10;WHEN &quot;7|redshift&quot; THEN 4&#13;&#10;WHEN &quot;30|All&quot; THEN 8&#13;&#10;WHEN &quot;30|snowflake&quot; THEN 8&#13;&#10;WHEN &quot;30|databricks&quot; THEN 8&#13;&#10;WHEN &quot;30|redshift&quot; THEN 8&#13;&#10;WHEN &quot;90|All&quot; THEN 8&#13;&#10;WHEN &quot;90|snowflake&quot; THEN 8&#13;&#10;WHEN &quot;90|databricks&quot; THEN 8&#13;&#10;WHEN &quot;90|redshift&quot; THEN 8&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Node Path Index' datatype='integer' name='[Calculation_2690238693341099106]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Node Path Index&#13;&#10;// Point number 0 to 87 along a card outline, from the 90 days of Node Daily.&#13;&#10;MIN(DATEDIFF(&apos;day&apos;, { MIN([date]) }, [date]), 87)' />
            </column>
            <column caption='QA KF Bar Id' datatype='integer' name='[Calculation_3812163153577257373]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// QA KF Bar Id&#13;&#10;// Which weekday bar a Node Daily row draws (12 rows each, up to 84).&#13;&#10;IF [Calculation_2690238693341099106] &lt; 84 THEN INT([Calculation_2690238693341099106] / 12) END' />
            </column>
            <column caption='QA KF Bar Key' datatype='string' name='[Calculation_3739048857491135836]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// QA KF Bar Key&#13;&#10;// Bar colour: red for a test that failed, amber for one that only warned, grey with no issue that weekday.&#13;&#10;CASE STR([Parameters].[Parameter 1]) + &quot;|&quot; + [Parameters].[Parameter 2] + &quot;|&quot; + STR(INT([Calculation_9061342006016474767])) + &quot;|&quot; + STR([Calculation_3812163153577257373])&#13;&#10;WHEN &quot;7|All|0|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|0|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|0|2&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|0|3&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|0|4&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|0|5&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|0|6&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|1|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|1|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|1|2&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|1|3&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|1|4&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|1|5&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|1|6&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|2|0&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|2|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|2|2&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|2|3&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|2|4&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|2|5&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|2|6&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|3|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|3|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|3|2&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|3|3&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|3|4&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|3|5&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|3|6&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|4|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|4|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|4|2&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|4|3&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|4|4&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|4|5&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|4|6&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|5|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|5|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|5|2&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|5|3&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|5|4&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|5|5&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|5|6&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|6|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|6|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|6|2&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|6|3&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|6|4&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|6|5&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|6|6&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|7|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|7|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|7|2&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|All|7|3&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|7|4&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|7|5&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|All|7|6&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|snowflake|0|0&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|snowflake|0|1&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|snowflake|0|2&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|snowflake|0|3&quot; THEN &quot;None&quot;&#13;&#10;WHEN &quot;7|snowflake|0|4&quot; THEN &quot;Fail&quot;&#13;&#10;WHEN &quot;7|snowflake|0|5&